BASELINE_SUBSET_HINT = ("基线只单独跑了当前失败所在的文件：某条用例单独跑能过、整套跑才失败（执行顺序、共享状态）时会被误报成新增。"
                        "遇到时在当前 worktree 也单独跑这个文件：也能过、diff 又没碰它相关的代码，就不是这次引入的；单独跑仍失败才是真的新增")


class DroverError(Exception):
    """可预期的失败：带上下文信息，最终以 JSON 输出。"""

    def __init__(self, message: str, **extra: Any) -> None:
        super().__init__(message)
        self.message = message
        self.extra = extra


# ---------------------------------------------------------------- 基础工具

def emit(obj: dict) -> None:
    print(json.dumps(obj, ensure_ascii=False, indent=2), flush=True)


def tail(text: str, limit: int = 1500) -> str:
    text = (text or "").strip()
    return text if len(text) <= limit else "…" + text[-limit:]


def stop_tree(proc: subprocess.Popen) -> None:
    """停掉还在跑的 proc：先给它的进程树（git commit 的 hook、git fetch 的 ssh 都在里面）发 SIGTERM，等它自己退出最多
    HEAVY_KILL_GRACE 秒，还在再 SIGKILL 整棵树。等的时候又来信号（再按 Ctrl-C、heavy_on_signal）就不等了。
    git 收到 SIGTERM / SIGINT 会在信号处理里删掉自己拿着的 index.lock 再退出，SIGKILL 接不住：写 index 的 git（add -N、
    update-index、commit、cherry-pick、rebase）被强杀就留下 0 字节的锁（git 刚建出锁文件、还没装上信号处理的那一瞬间
    收到 SIGTERM 也会留，那是 git 自己的窗口）。"""
    if proc.poll() is not None:
        return
    signal_tree(proc.pid, signal.SIGTERM)
    try:
        proc.communicate(timeout=HEAVY_KILL_GRACE)  # 接着读管道：子进程不会因为写满管道卡住
        return
    except (subprocess.TimeoutExpired, HeavyInterrupted, KeyboardInterrupt):
        pass
    if proc.poll() is None:
        signal_tree(proc.pid, signal.SIGKILL)
    proc.wait()


def capture_run(cmd: list, *, cwd: Optional[str] = None, timeout: Optional[float] = None, input=None,
                env: Optional[dict] = None, text: bool = True) -> subprocess.CompletedProcess:
    """subprocess.run(capture_output=True) 的替身，只差在超时、被中断时怎么停：subprocess.run 直接 SIGKILL 子进程，这里交给
    stop_tree（先 SIGTERM，等 HEAVY_KILL_GRACE 秒再 SIGKILL）。子进程照旧留在 drover 的进程组里（不开新会话），终端的
    Ctrl-C 还是直接到它。超时照旧抛 TimeoutExpired（stdout 是到那时为止的输出），找不到命令照旧抛 FileNotFoundError。"""
    with subprocess.Popen(cmd, cwd=cwd, env=env, text=text, stdin=subprocess.PIPE if input is not None else None,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE) as proc:
        try:
            out, err = proc.communicate(input, timeout=timeout)
        except BaseException:
            stop_tree(proc)
            raise
        return subprocess.CompletedProcess(cmd, proc.returncode, out, err)


def run(cmd: list, *, cwd: Optional[str] = None, timeout: Optional[float] = None,
        input_text: Optional[str] = None, env: Optional[dict] = None) -> subprocess.CompletedProcess:
    """env 是在当前环境上额外设的变量（如临时 index 的 GIT_INDEX_FILE）。超时、被中断时先 SIGTERM 再 SIGKILL（capture_run）。"""
    try:
        return capture_run(cmd, cwd=cwd, timeout=timeout, input=input_text, env={**os.environ, **env} if env else None)
    except FileNotFoundError:
        raise DroverError(f"找不到命令 {cmd[0]}，请确认已安装并在 PATH 里")
    except subprocess.TimeoutExpired as exc:
        raise DroverError(f"命令超时（{timeout} 秒）：{shlex.join(cmd)}", output=tail(str(exc.stdout or "")))


# drover 起的 git 一律带上（git() / git_bytes() 合在调用方给的 env 后面）：只读的 git status 默认会顺手刷新 index 并写回，
# 写的时候拿 index.lock，持锁时被强杀就留下 0 字节的锁，之后的 git add / commit 都报 "index.lock: File exists"
# （一个大前端仓库里出现过两次）。git-status 文档 BACKGROUND REFRESH：后台跑的用 --no-optional-locks，git(1)：等价于
# GIT_OPTIONAL_LOCKS=0。真要写 index 的（add、commit、cherry-pick、merge、rebase、worktree add / remove）拿的是必需锁，不受影响。
GIT_NO_OPTIONAL_LOCKS = {"GIT_OPTIONAL_LOCKS": "0"}
# 比对工作区的 git diff 不看 GIT_OPTIONAL_LOCKS，照样刷新并改写 index（git 2.51 实测），要靠 diff.autoRefreshIndex=false。
# 关掉之后"内容没变、只改了时间"的文件会出现在 --name-only / --name-status 的输出里，所以不放进公共入口，只加在输出不受它
# 影响的调用上：完整 diff、--stat、--diff-filter=U（这类文件是 M，筛掉了）。
DIFF_NO_REFRESH = ("-c", "diff.autoRefreshIndex=false")


def git(repo: str, *args: str, timeout: float = 120, input_text: Optional[str] = None,
        env: Optional[dict] = None) -> subprocess.CompletedProcess:
    return run(["git", "-C", repo, *args], timeout=timeout, input_text=input_text,
               env={**(env or {}), **GIT_NO_OPTIONAL_LOCKS})


def c_locale_env() -> dict:
    """要按 git 的原话做判断的命令用这个环境跑（C locale）：中文 locale 下 git 会把这些话翻译掉。环境在调用时取：
    update --auto 运行中才改 os.environ（auto_update_unattended）。"""
    return {**os.environ, "LC_ALL": "C"}


def git_bytes(repo: str, *args: str, env: Optional[dict] = None, input_bytes: Optional[bytes] = None,
              timeout: float = 600) -> subprocess.CompletedProcess:
    """git 按字节读写（补丁里可能有不是 UTF-8 的文本，按文本解码会出错）。超时同 run（capture_run）。"""
    try:
        return capture_run(["git", "-C", repo, *args], input=input_bytes, timeout=timeout, text=False,
                           env={**os.environ, **(env or {}), **GIT_NO_OPTIONAL_LOCKS})
    except subprocess.TimeoutExpired:
        raise DroverError(f"命令超时（{timeout} 秒）：git -C {repo} {shlex.join(args)}")


def git_out(repo: str, *args: str) -> str:
    p = git(repo, *args)
    if p.returncode != 0:
        raise DroverError(f"git {' '.join(args)} 失败", repo=repo, stderr=tail(p.stderr))
    # 只去掉末尾换行：status --porcelain 的第一行开头是有意义的空格（" M"）。
    return p.stdout.rstrip()


def git_net(repo: str, *args: str) -> tuple[subprocess.CompletedProcess, int]:
    """fetch / push / ls-remote：失败原因是会自己好的（GIT_TRANSIENT_RE）才隔 5 秒重试，最多 GIT_NET_TRIES 次；
    仓库不存在这类永久错误第一次就返回。返回 (结果, 尝试次数)。"""
    p = git_net_once(repo, args)
    tries = 1
    while p.returncode != 0 and tries < GIT_NET_TRIES and GIT_TRANSIENT_RE.search(p.stderr or ""):
        time.sleep(5)
        p = git_net_once(repo, args)
        tries += 1
    return p, tries


def git_net_once(repo: str, args: tuple) -> subprocess.CompletedProcess:
    """联网的 git 跑一次，最多 GIT_NET_TIMEOUT 秒。超时（run 把它转成了 DroverError）当成这次联网失败（退出码 124），
    由调用方按失败处理、说各自的话：网络不通、远端连不上时 ssh 卡在建连接上，是"连不上"，不是别的错。
    调用方按 git 的原话判断（GIT_TRANSIENT_RE、REMOTE_REF_MISSING_RE），所以用 C locale 跑。"""
    try:
        return git(repo, *args, timeout=GIT_NET_TIMEOUT, env=c_locale_env())
    except DroverError as exc:
        return subprocess.CompletedProcess(["git", "-C", repo, *args], 124, "", exc.message)


def find_key(obj: Any, key: str) -> Any:
    """在嵌套的 JSON 里找第一个 key，herdr 不同命令的返回结构不完全一样。"""
    if isinstance(obj, dict):
        if key in obj:
            return obj[key]
        for value in obj.values():
            found = find_key(value, key)
            if found is not None:
                return found
    elif isinstance(obj, list):
        for value in obj:
            found = find_key(value, key)
            if found is not None:
                return found
    return None


def parse_herdr_error(text: str) -> Optional[dict]:
    for line in reversed((text or "").strip().splitlines()):
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(obj, dict) and isinstance(obj.get("error"), dict):
            return obj["error"]
    return None


def herdr(args: list, *, timeout: Optional[float] = 120) -> tuple[bool, dict]:
    """调用 herdr。成功返回 (True, result)，失败返回 (False, error)，error 至少有 code 和 message。"""
    p = run(["herdr", *args], timeout=timeout)
    if p.returncode == 0:
        try:
            body = json.loads(p.stdout)
        except json.JSONDecodeError:
            return True, {"raw": p.stdout.strip()}
        return True, body.get("result", body)
    err = parse_herdr_error(p.stderr) or parse_herdr_error(p.stdout)
    if not err:
        err = {"code": f"exit_{p.returncode}", "message": tail(p.stderr or p.stdout)}
    return False, err


def is_under(path: str, root: Path) -> bool:
    try:
        Path(path).resolve().relative_to(root.resolve())
        return True
    except ValueError:
        return False


def check_agent_name(name: str) -> None:
    if not AGENT_NAME_RE.match(name):
        raise DroverError(f"agent 名 {name!r} 不合法：必须匹配 [a-z][a-z0-9_-]{{0,31}}（小写字母开头，最长 32 个字符）")


def check_slug(slug: str) -> None:
    # slug 会拼进 ~/.drover/<slug>/ 路径，挡住 ../ 之类的值，也不能和状态目录下的固定目录重名。
    if not SLUG_RE.match(slug):
        raise DroverError(f"slug {slug!r} 不合法：只能用小写字母、数字和 -，以字母或数字开头")
    if slug in RESERVED_SLUGS:
        raise DroverError(f"slug {slug!r} 是保留名：{'、'.join(RESERVED_SLUGS)} 是状态目录 {STATE_HOME} 下的固定目录，"
                          "换一个任务 slug")


def save_json(path_str: str, obj: dict) -> str:
    path = Path(path_str).expanduser()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2))
    return str(path)


def resolve_repo(value: str) -> str:
    """仓库参数可以是路径（仓库内任意位置）或仓库名；仓库名按配置的 repo_dirs 顺序找（没配置时只看当前目录下）。"""
    candidates = [Path(value).expanduser()]
    if "/" not in value:
        candidates += [d / value for d in REPO_DIRS]
    for candidate in candidates:
        if candidate.exists():
            p = git(str(candidate), "rev-parse", "--show-toplevel")
            if p.returncode == 0:
                return p.stdout.strip()
    if not REPO_DIRS:
        raise DroverError(f"找不到仓库 {value}：不是仓库路径（相对路径按当前目录算）；{CONFIG_FILE} 里没有配置 "
                            "repo_dirs / workspace，按名字只在当前目录下找。写绝对路径，或者先跑 install.py 配好主工作台")
    raise DroverError(f"找不到仓库 {value}：既不是仓库路径，也不在 {', '.join(map(str, REPO_DIRS))} 下"
                        f"（目录在 {CONFIG_FILE} 的 repo_dirs 里配）")


def git_common_dir(path: str) -> Optional[Path]:
    """仓库的 .git 目录；在 worktree 里调用也返回源仓库的那个，用来判断 worktree 属于哪个仓库。"""
    p = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return Path(p.stdout.strip()).resolve() if p.returncode == 0 else None


# ---------------------------------------------------------------- 团队 profile 和 playbook

# 规则分三层：包默认（flow/dispatch.md、flow/coding-rules.md 和本脚本）→ 团队 profile（config 的 profile）→ 个人覆盖
# （config 的 playbook_dirs，按顺序）。后两层的目录布局相同，后读的优先：
#   general.md             对所有仓库适用、编排者读的规则（drover playbook 输出）
#   coding-rules.md        编码规范，brief 追加进 worker 任务书（claude、codex 都加：哪个宿主都不会自动加载它）
#   repos/<仓库目录名>.md   仓库专属 playbook（迁移步骤、worktree 位置、基线有失败的命令、给 worker 的约束），编排者读
# 包默认的编码规范（flow/coding-rules.md）排在各层 coding-rules.md 前面；config 的 default_coding_rules 为 false 时不加，
# 只关这一份，安全和流程规则（任务书模板的固定约束、dispatch.md）不跟着关。
# 包里的 profiles/README.md 说明三层关系和怎么写新的团队 profile；命令不读它。
PROFILES_DIR = PKG_ROOT / "profiles"
PLAYBOOK_GENERAL = "general.md"
PLAYBOOK_CODING_RULES = "coding-rules.md"
PLAYBOOK_REPOS_DIR = "repos"
DEFAULT_CODING_RULES = PKG_ROOT / "flow" / "coding-rules.md"
# playbook 里给维护者看的说明写成 HTML 注释，读出来时去掉，不进 playbook 输出和 worker 任务书。
HTML_COMMENT_RE = re.compile(r"<!--.*?-->[ \t]*\n?", re.S)
# coding-rules.md 的分节标记：独占一行的 <!-- drover:section 名字 --> 开始一节，到下一个标记或文件末尾。第一个标记之前的
# 部分总带；有标记的节只在这次涉及的仓库用得上时带（coding_rules_sections 认得的名字：mysql、java）。
CODING_RULES_SECTION_RE = re.compile(r"^<!-- drover:section (\S+) -->[ \t]*\n?", re.M)
# 认 Java 仓库：根目录有这几个构建文件之一（deps 判断要不要装 Java 依赖也按它）。
JAVA_BUILD_FILES = ("pom.xml", "build.gradle", "build.gradle.kts")
# 认 MySQL 仓库时看的依赖清单（仓库里任意一层被 git 跟踪的）。lockfile 不看：传递依赖里的 mysql 不算这个仓库在用。
DEPS_MANIFEST_RE = re.compile(r"(^|/)(pom\.xml|build\.gradle(\.kts)?|package\.json|requirements[^/]*\.txt|pyproject\.toml)$")
MYSQL_DEP_RE = re.compile(r"mysql|mariadb", re.I)


def config_dir(value: str) -> Path:
    """config 里写的目录：~ 展开；相对路径按 config.json 所在的目录算。"""
    path = Path(value).expanduser()
    return path if path.is_absolute() else CONFIG_FILE.parent / path


def available_profiles() -> list:
    return sorted(p.name for p in PROFILES_DIR.iterdir() if p.is_dir()) if PROFILES_DIR.is_dir() else []


def profile_info() -> dict:
    """解析 config 的 profile：写名字 → <包根>/profiles/<名>/；带 / 或以 ~ 开头 → 那个目录（团队自己维护的 profile 仓库）。
    没配置时 name、dir 都是 None（只有包默认规则）。配置了但目录不存在时带 error：这时迁移规则会悄悄丢掉，调用方不能静默。"""
    raw = CONFIG.get("profile")
    if not raw or not str(raw).strip():
        return {"configured": None, "name": None, "dir": None, "exists": None}
    raw = str(raw).strip()
    by_path = "/" in raw or raw.startswith("~")
    path = config_dir(raw) if by_path else PROFILES_DIR / raw
    info = {"configured": raw, "name": path.name if by_path else raw, "dir": str(path), "exists": path.is_dir()}
    if not info["exists"]:
        info["error"] = (f"{CONFIG_FILE} 的 profile 是 {raw!r}，但目录 {path} 不存在：团队规则（迁移流程、推送前确认、"
                         "编码规范）会读不到。修法：profile 写包里有的名字（"
                         + ("、".join(available_profiles()) or f"{PROFILES_DIR} 下没有")
                         + "）或团队 profile 目录的路径（在 drover 包目录里跑 `python3 install.py --profile <名字|目录>`，"
                         "或直接编辑 config.json）；不用团队 profile 就去掉这个键（`python3 install.py --profile none`）。")
    return info


def personal_dirs() -> list:
    """config 的 playbook_dirs（个人覆盖目录），按顺序：[{configured, dir, exists}]。写成单个字符串也认。"""
    dirs = CONFIG.get("playbook_dirs") or []
    if isinstance(dirs, str):
        dirs = [dirs]
    out = []
    for raw in dirs:
        path = config_dir(str(raw))
        out.append({"configured": str(raw), "dir": str(path), "exists": path.is_dir()})
    return out


def playbook_layers() -> tuple[list, list]:
    """按读的顺序列出存在的层：[{layer, name, dir}]，团队 profile 在前，playbook_dirs 依次在后（后读的优先）。
    返回 (层, 提示)：个人覆盖目录不存在只进提示；团队 profile 目录不存在由调用方看 profile_info() 的 error。"""
    layers, notes = [], []
    prof = profile_info()
    if prof["dir"] and prof["exists"]:
        layers.append({"layer": "profile", "name": prof["name"], "dir": Path(prof["dir"])})
    for d in personal_dirs():
        if d["exists"]:
            layers.append({"layer": "personal", "name": d["configured"], "dir": Path(d["dir"])})
        else:
            notes.append(f"{CONFIG_FILE} 的 playbook_dirs 里 {d['configured']} 不存在（{d['dir']}），跳过")
    return layers, notes


def layer_label(layer: dict) -> str:
    return f"团队 profile：{layer['name']}" if layer["layer"] == "profile" else f"个人覆盖：{layer['name']}"


def read_playbook_file(path: Path) -> str:
    return HTML_COMMENT_RE.sub("", path.read_text()).strip()


def default_coding_rules_enabled() -> bool:
    """config 的 default_coding_rules：没写或 true 时加包默认的编码规范，false 时不加。"""
    return CONFIG.get("default_coding_rules") is not False


def coding_rules_files(layers: list) -> list:
    """生效的编码规范文件，按追加的顺序（后面的优先）：[(小节标题里的来源, 路径)]。包默认（flow/coding-rules.md）在最前，
    default_coding_rules 关掉时不算；团队 profile、个人覆盖依次在后，没有 coding-rules.md 的层跳过。"""
    out = []
    if default_coding_rules_enabled() and DEFAULT_CODING_RULES.is_file():
        out.append(("drover 默认；必须遵守，仓库规范冲突时按仓库的", DEFAULT_CODING_RULES))
    out += [(f"{layer_label(l)}；必须遵守", l["dir"] / PLAYBOOK_CODING_RULES) for l in layers
            if (l["dir"] / PLAYBOOK_CODING_RULES).is_file()]
    return out


def uses_mysql(wt: Path) -> bool:
    """仓库用 MySQL：有被 git 跟踪的 .sql 文件，或依赖清单（DEPS_MANIFEST_RE）里出现 mysql / mariadb 字样。
    只有 ORM（SQLAlchemy、Hibernate、Prisma…）、没有这两个字样的不算：ORM 可能连的是别的数据库。"""
    for rel in git_out(str(wt), "ls-files", "-z").split("\0"):
        if rel.lower().endswith(".sql"):
            return True
        manifest = wt / rel
        # 跟踪着、工作区里删了的清单读不到，跳过
        if DEPS_MANIFEST_RE.search(rel) and manifest.is_file() and MYSQL_DEP_RE.search(manifest.read_text(errors="replace")):
            return True
    return False


def coding_rules_sections(paths: list) -> set:
    """编码规范里有分节标记的几节，这次带哪几节：paths（brief 是任务书涉及的各 worktree，playbook 是各 --repo）任一满足就带。
    java：根目录有 JAVA_BUILD_FILES 之一；mysql：uses_mysql。判断错了只是多带或少带一节，验收按整份核对（dispatch.md 第 6.1 节）。"""
    sections = set()
    if any((Path(p) / name).is_file() for p in paths for name in JAVA_BUILD_FILES):
        sections.add("java")
    if any(uses_mysql(Path(p)) for p in paths):
        sections.add("mysql")
    return sections


def read_coding_rules(path: Path, sections: set) -> tuple[list, str]:
    """读一份 coding-rules.md：第一个分节标记之前的部分（记作 general）总带，标记开始的节只带名字在 sections 里的；
    去掉 HTML 注释（标记本身也是注释）。返回 (带了的节名，按文件里的顺序, 正文)。没有标记的文件整份就是 general。"""
    parts = CODING_RULES_SECTION_RE.split(path.read_text())
    names, chunks = ["general"], [parts[0]]
    for name, body in zip(parts[1::2], parts[2::2]):
        if name in sections:
            names.append(name)
            chunks.append(body)
    return names, HTML_COMMENT_RE.sub("", "".join(chunks)).strip()


def playbook_coding_rules(warnings: list, paths: list) -> list:
    """各层编码规范的正文：[(来源, 正文)]，顺序同 coding_rules_files；有分节标记的节按 paths（任务书涉及的 worktree）
    取舍（coding_rules_sections）。团队 profile 目录不存在时记 warning，不中断 brief。"""
    prof = profile_info()
    if prof.get("error"):
        warnings.append("团队编码规范没有追加进 prompt：" + prof["error"])
    layers, notes = playbook_layers()
    warnings.extend(notes)
    sections = coding_rules_sections(paths)
    out = []
    for source, path in coding_rules_files(layers):
        _, body = read_coding_rules(path, sections)
        if body:
            out.append((source, body))
    return out


def cmd_playbook(a: argparse.Namespace) -> dict:
    prof = profile_info()
    if prof.get("error"):
        raise DroverError(prof["error"], profile=prof)
    repos: list = []
    for value in a.repo:
        root = resolve_repo(value)
        name = history_repo_name(root)  # worktree 路径按它所属的源仓库算
        if name not in [r["name"] for r in repos]:
            repos.append({"arg": value, "name": name, "path": root, "has_playbook": False})
    layers, notes = playbook_layers()
    files, chunks = [], []
    for layer in layers:
        targets = [("general", None, layer["dir"] / PLAYBOOK_GENERAL)]
        targets += [("repo", r, layer["dir"] / PLAYBOOK_REPOS_DIR / f"{r['name']}.md") for r in repos]
        for kind, repo, path in targets:
            if not path.is_file():
                continue
            if repo is not None:
                repo["has_playbook"] = True
            files.append({"path": str(path), "layer": layer["layer"], "layer_name": layer["name"], "kind": kind,
                          "repo": repo["name"] if repo else None})
            body = read_playbook_file(path)
            if body:
                scope = "所有仓库" if repo is None else f"仓库 {repo['name']}"
                chunks.append(f"=== 来源：{path}（{layer_label(layer)}；{scope}）===\n\n{body}\n")
    available = []
    for layer in layers:
        repo_dir = layer["dir"] / PLAYBOOK_REPOS_DIR
        names = sorted(p.stem for p in repo_dir.glob("*.md")) if repo_dir.is_dir() else []
        available.append({"layer": layer["layer"], "name": layer["name"], "repos": names})
    rules_on = default_coding_rules_enabled()
    result = {
        "ok": True,
        "profile": prof,
        "playbook_dirs": personal_dirs(),
        "repos": repos,
        "files": files,
        "text": "\n".join(chunks),
        # 编码规范不在 text 里（brief 自动追加给 worker）；验收 DDL 这类改动时按这些文件核对。包默认的那份开着时排第一，
        # default_coding_rules 标明它是哪个、开没开（coding_rules 仍是路径列表，旧的读法照样用）；sections 是按这几个 --repo
        # 算、brief 会带它的哪几节（general 总带；mysql、java 见 coding_rules_sections），关着时为空。
        "coding_rules": [str(path) for _, path in coding_rules_files(layers)],
        "default_coding_rules": {
            "enabled": rules_on,
            "path": str(DEFAULT_CODING_RULES),
            "sections": (read_coding_rules(DEFAULT_CODING_RULES, coding_rules_sections([r["path"] for r in repos]))[0]
                         if rules_on else []),
        },
        "available_repos": available,
    }
    if notes:
        result["warnings"] = notes
    if not chunks:
        result["note"] = ("没有配置团队 profile 和个人覆盖目录（config.json 的 profile / playbook_dirs），只有包默认规则（flow/dispatch.md）。"
                          if not layers else
                          "各层都没有 general.md，也没有这些仓库的 repos/<仓库名>.md：按包默认规则（flow/dispatch.md）做。"
                          "有 playbook 的仓库见 available_repos。")
    return result


def cmd_playbook_text(a: argparse.Namespace) -> int:
    """playbook --text：只打印拼好的正文（给人看、前后对比用）；没有内容时把 note 打到 stderr。"""
    result = cmd_playbook(a)
    sys.stdout.write(result["text"])
    for line in result.get("warnings", []) + ([result["note"]] if result.get("note") else []):
        print(line, file=sys.stderr)
    return 0


# ---------------------------------------------------------------- preflight

def config_info() -> dict:
    """本机配置的情况（preflight 报出来）：有没有 config.json、主工作台和按名字找仓库的目录。
    没配置主工作台时带 warning（只是提示，不让 preflight 失败：orch-start 会单独报错）。"""
    info = {"file": str(CONFIG_FILE), "exists": CONFIG_FILE.is_file(),
            "workspace": str(TRUSTED_ROOT) if TRUSTED_ROOT else None, "repo_dirs": [str(d) for d in REPO_DIRS]}
    if TRUSTED_ROOT is None:
        info["warning"] = (NO_WORKSPACE_ERROR + "。在这之前 orch-start 起不了编排者，wt 遇到要信任仓库时不会自动加 "
                           "--trust-repository，按名字找仓库只看当前目录。")
    return info


def cmd_preflight(a: argparse.Namespace) -> dict:
    if os.environ.get("HERDR_ENV") != "1":
        raise DroverError("不在 Herdr 中（HERDR_ENV 不是 1），无法派发。请在 Herdr 管理的 pane 里运行。")
    if not shutil.which("herdr"):
        raise DroverError("找不到 herdr 命令")
    p = run(["herdr", "status"], timeout=30)
    m = re.search(r"^server:\s*\n\s+status:\s*(\S+)", p.stdout, re.M)
    server_status = m.group(1) if m else "unknown"
    if server_status != "running":
        raise DroverError("herdr server 没在运行", server_status=server_status, output=tail(p.stdout))
    tools = ["git", "jq", "uv", "bun", "pnpm", "npm", "yarn", "code-review-graph", "claude", "codex"]
    return {
        "ok": True,
        "server": server_status,
        "caller": {
            "workspace": os.environ.get("HERDR_WORKSPACE_ID"),
            "tab": os.environ.get("HERDR_TAB_ID"),
            "pane": os.environ.get("HERDR_PANE_ID"),
        },
        "tools": {t: bool(shutil.which(t)) for t in tools},
        # 本机配置：没有 config.json / 没配置主工作台时带 warning（不影响 ok），按提示先跑 install.py。
        "config": config_info(),
        # 团队 profile 的解析结果：配置了但目录不存在时带 error（playbook 会报 ok: false），先修好再派发。
        "profile": profile_info(),
        "playbook_dirs": personal_dirs(),
    }


# ---------------------------------------------------------------- wt

def branch_exists(repo: str, branch: str) -> bool:
    return git(repo, "show-ref", "--verify", "--quiet", f"refs/heads/{branch}").returncode == 0


def repo_primary_workspaces(repo: str) -> set:
    """源仓库主检出对应的 workspace（不含 worktree 的 workspace）。

    实测：源仓库的 workspace 关着时，herdr worktree create 会自动把它重新打开（worktree workspace 要挂在它下面）。
    建 worktree 前后各取一次，差集就是这次被自动打开的，任务收尾时可以关掉。
    """
    ok, res = herdr(["workspace", "list"], timeout=30)
    if not ok:
        return set()
    target = Path(repo).resolve()
    found = set()
    for ws in res.get("workspaces", []):
        info = ws.get("worktree") or {}
        if info.get("is_linked_worktree") is False and info.get("checkout_path"):
            if Path(info["checkout_path"]).resolve() == target:
                found.add(ws.get("workspace_id"))
    return found


def untracked_repo_docs(repo: str) -> list:
    """源仓库根目录里存在、但没被 git 跟踪的规范文件，返回 [(文件名, 是否被 .gitignore 忽略)]。

    很多仓库把 CLAUDE.md / AGENTS.md 写进了 .gitignore，worktree 里就没有，
    派出去的 agent 读不到仓库规范；实际见到的仓库都只在根目录放这些文件，所以只看根目录。
    """
    found = []
    for name in REPO_DOC_NAMES:
        if (Path(repo) / name).is_file() and git(repo, "ls-files", "--error-unmatch", name).returncode != 0:
            found.append((name, git(repo, "check-ignore", "-q", name).returncode == 0))
    return found


def is_tracked(repo: str, rel: str) -> bool:
    return git(repo, "ls-files", "--error-unmatch", "--", rel).returncode == 0


def local_file_candidates(repo: str) -> list:
    """本地运行需要、要从源仓库复制的文件：.claude/settings.local.json 和根目录的 .env*，返回 [(相对路径, 源仓库是否跟踪)]。"""
    found = []
    if (Path(repo) / ".claude" / "settings.local.json").is_file():
        found.append(".claude/settings.local.json")
    found += [f.name for f in sorted(Path(repo).glob(".env*")) if f.is_file()]
    return [(rel, is_tracked(repo, rel)) for rel in found]


def ignored_paths(repo: str, rels: list) -> set:
    """rels 里按 repo 自己的规则（.gitignore、.git/info/exclude、core.excludesFile）被忽略的那些；跟踪着的不算。"""
    if not rels:
        return set()
    p = git(repo, "check-ignore", "-z", "--stdin", input_text="\0".join(rels) + "\0")
    if p.returncode not in (0, 1):  # 0：有被忽略的，1：一个都没有
        raise DroverError("git check-ignore 失败", repo=repo, stderr=tail(p.stderr))
    return {rel for rel in p.stdout.split("\0") if rel}


def worktree_include_files(repo: str, handled: set) -> tuple[list, list]:
    """源仓库根目录 .worktreeinclude 匹配到、在源仓库被忽略的未跟踪文件，返回 (要复制的, 源路径是符号链接的)，相对路径、排好序。
    没有这个文件返回两个空表；handled 里的（.env*、规范文件，各有自己的规则）不算在内。

    沿用 Claude Code 的约定（claude --worktree 认同一个文件）：gitignore 语法，匹配某条模式且被 gitignore 的才复制，跟踪的不复制。
    匹配全交给 git：ls-files --others --ignored --exclude-from 只按这份模式列未跟踪文件（注释、! 取反、/ 锚定、**、
    目录模式展开成其中的文件都是 git 自己的语义），再用 check-ignore 留下按仓库自己的规则被忽略的。ls-files 要走一遍
    未跟踪目录（node_modules、target 也走，只读目录项）：实测 1.3G 的 node_modules 不到 1 秒；没有这个文件的仓库不走。
    """
    include = Path(repo) / WORKTREE_INCLUDE
    if not include.is_file():
        return [], []
    p = git(repo, "ls-files", "-z", "--others", "--ignored", f"--exclude-from={include}")
    if p.returncode != 0:
        raise DroverError(f"按 {include} 列文件失败", repo=repo, stderr=tail(p.stderr))
    matched = [rel for rel in p.stdout.split("\0") if rel and rel not in handled]
    ignored = sorted(ignored_paths(repo, matched))
    symlinks = [rel for rel in ignored if (Path(repo) / rel).is_symlink()]
    return [rel for rel in ignored if rel not in symlinks], symlinks


def copy_local_files(repo: str, wt: str, dry_run: bool) -> tuple[list, list, list]:
    """复制源仓库里本地运行需要的文件。只复制，不覆盖 worktree 里已有的。

    .claude/settings.local.json 和 .env*：源仓库没跟踪的照复制；源仓库跟踪着的不复制（基线分支上有它就随 checkout
    带过来了，没有就说明那条分支本来就没有，复制过去会成为未跟踪文件，挡住要新增它的 cherry-pick），
    除非它在 worktree 里被 .gitignore 忽略（以 worktree 自己的规则为准：基线分支已把 .env 移出 git 并忽略，
    主检出所在的分支还跟踪着，worker 仍要这份本地配置）。

    规范文件只复制在 worktree 里同样被忽略的：不会出现在 git status / diff 里，也不会被 agent 顺手提交进仓库。
    没提交也没被忽略的复制过去会变成未跟踪文件，改由 brief 让 agent 去读源仓库的原文。

    仓库声明的额外文件：源仓库根目录 .worktreeinclude 匹配到、在源仓库被忽略的未跟踪文件（worktree_include_files）。
    来由：一个 Java 服务的本地启动配置 src/main/resources/config/*.yml 和本地测试页 tools/
    都被忽略，新 worktree 里没有，起不了服务、打不开测试页。.worktreeinclude 自己多半也只在本机忽略（.git/info/exclude，
    各 worktree 共用），worktree 里读不到，所以从源仓库读。规则同规范文件：只复制在 worktree 里同样被忽略的，
    不被忽略的（分支的 .gitignore 不同）不复制；源路径是符号链接的不复制；和 .env*、规范文件重复的只按上面的规则走一次。

    返回 (已复制, 没复制的规范文件, .worktreeinclude 匹配了但没复制的 [{path, reason}])。
    """
    copied, skipped = [], []
    candidates, docs = local_file_candidates(repo), untracked_repo_docs(repo)
    for rel, tracked in candidates:
        target = Path(wt) / rel
        if target.exists():
            continue
        if tracked and not (Path(wt).is_dir() and git(wt, "check-ignore", "-q", "--", rel).returncode == 0):
            continue
        if not dry_run:
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(Path(repo) / rel, target)
        copied.append(rel)
    for name, ignored in docs:
        target = Path(wt) / name
        if target.exists():
            continue
        if Path(wt).is_dir():
            # 以 worktree 自己的 .gitignore 为准（分支不同，规则可能不同）。
            ignored = git(wt, "check-ignore", "-q", name).returncode == 0
        if not ignored:
            skipped.append(name)
            continue
        if not dry_run:
            shutil.copy2(Path(repo) / name, target)
        copied.append(name)
    include, symlinks = worktree_include_files(repo, {rel for rel, _ in candidates} | {name for name, _ in docs})
    include_skipped = [{"path": rel, "reason": "源仓库里是符号链接，不复制"} for rel in symlinks]
    missing = [rel for rel in include if not (Path(wt) / rel).exists()]
    # worktree 不在了（复用时 herdr 记录里还有、目录已删）只可能是 --dry-run：按源仓库的忽略规则预估。
    ignored_in_wt = ignored_paths(wt, missing) if Path(wt).is_dir() else set(missing)
    for rel in missing:
        if rel not in ignored_in_wt:
            include_skipped.append({"path": rel, "reason": "在 worktree 里没被 .gitignore 忽略，复制过去会出现在 git status 里"})
            continue
        if not dry_run:
            target = Path(wt) / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(Path(repo) / rel, target)
        copied.append(rel)
    return copied, skipped, include_skipped


def new_worktree_copy_note(repo: str) -> str:
    """wt --dry-run 新建时的 would_copy：worktree 还没建，按源仓库这边说明会复制什么、各自的条件；
    有 .worktreeinclude 时把匹配到的文件逐个列出，用户和编排者能直接核对会带哪些。"""
    candidates, docs = local_file_candidates(repo), untracked_repo_docs(repo)
    parts = ["、".join(f"{rel}（源仓库跟踪着，在新 worktree 里被 .gitignore 忽略才复制）" if tracked else rel
                       for rel, tracked in candidates)] if candidates else []
    parts.append("以及被 .gitignore 忽略的 " + " / ".join(REPO_DOC_NAMES))
    if (Path(repo) / WORKTREE_INCLUDE).is_file():
        include, _ = worktree_include_files(repo, {rel for rel, _ in candidates} | {name for name, _ in docs})
        parts.append(f"以及 {WORKTREE_INCLUDE} 匹配到的（在新 worktree 里同样被忽略才复制）：" + "、".join(include)
                     if include else f"{WORKTREE_INCLUDE} 没匹配到要复制的文件")
    return "（新 worktree 建好后复制：" + "；".join(parts) + "）"


# wt 新建前同步源仓库主检出（几次发布后主目录停在旧提交，之后从它建的 worktree 都从旧代码起步）。
# fetch 主检出的上游，主检出干净且落后时快进（只快进，不硬覆盖），起点保证是远端最新。复用已有 worktree 时不做。

def repo_sync_lock_path(repo: str) -> Path:
    real = os.path.realpath(repo)
    return STATE_HOME / "locks" / f"wt-sync-{Path(real).name}-{hashlib.sha1(real.encode()).hexdigest()[:10]}.lock"


@contextlib.contextmanager
def repo_sync_lock(repo: str):
    """同一仓库的 fetch + 主检出快进加锁（flock，按仓库路径区分，进程退出自动释放）：几个编排者同时对同一个仓库跑
    wt / integrate 时，避免 index.lock / ref lock 冲突。不进 heavy 调度：那是全机构建 / 测试排队用的，fetch 不该排在全量测试后面。
    同一进程里不能嵌套拿（flock 按打开的文件算，第二次会等自己）。拿不到锁文件（沙箱不能写）时不加锁照常执行。
    yield 等锁的秒数（没加锁时 None）。"""
    path = repo_sync_lock_path(repo)
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        fh = open(path, "a+")
    except OSError:
        yield None
        return
    started = time.time()
    try:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield round(time.time() - started, 1)
    finally:
        with contextlib.suppress(OSError):
            fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()


def current_branch(repo: str) -> Optional[str]:
    """主检出所在的分支；detached HEAD 返回 None。"""
    p = git(repo, "symbolic-ref", "--quiet", "--short", "HEAD")
    return p.stdout.strip() if p.returncode == 0 and p.stdout.strip() else None


def is_ancestor(repo: str, older: str, newer: str) -> bool:
    return git(repo, "merge-base", "--is-ancestor", older, newer).returncode == 0


def commit_count(repo: str, rev_range: str) -> int:
    return int(git_out(repo, "rev-list", "--count", rev_range) or 0)


def remote_branch_of(ref: Optional[str], remotes: list) -> Optional[tuple]:
    """<远端名>/<分支>（远端名在 git remote 里）→ (远端名, 分支)；本地分支名、sha 等返回 None。"""
    for remote in sorted(remotes, key=len, reverse=True):
        if ref and ref.startswith(remote + "/") and len(ref) > len(remote) + 1:
            return remote, ref[len(remote) + 1:]
    return None


def source_upstream(repo: str, branch: Optional[str], remotes: list) -> dict:
    """主检出当前分支的上游：{ref（如 origin/master；None 表示没有上游）, remote, branch, configured, reason}。
    配了上游（@{u}）用配的；没配就用 origin/<当前分支>（configured=False：远端有没有这条分支，fetch 时才知道）。"""
    if not branch:
        return {"ref": None, "reason": "主目录是 detached HEAD"}
    remote = git(repo, "config", f"branch.{branch}.remote").stdout.strip()
    merge = git(repo, "config", f"branch.{branch}.merge").stdout.strip()
    if remote and merge:
        merge_branch = merge[len("refs/heads/"):] if merge.startswith("refs/heads/") else merge
        if remote == ".":
            return {"ref": None, "reason": f"{branch} 的上游是本地分支 {merge_branch}"}
        if remote not in remotes:
            return {"ref": None, "reason": f"{branch} 的上游远端 {remote} 不在 git remote 里"}
        p = git(repo, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
        ref = p.stdout.strip() if p.returncode == 0 and p.stdout.strip() else f"{remote}/{merge_branch}"
        return {"ref": ref, "remote": remote, "branch": merge_branch, "configured": True}
    if "origin" not in remotes:
        return {"ref": None, "reason": f"{branch} 没配上游，仓库也没有远端 origin"}
    return {"ref": f"origin/{branch}", "remote": "origin", "branch": branch, "configured": False}


def remote_default_branch(repo: str, remote: str) -> Optional[str]:
    """本地记录的 <远端>/HEAD 指向的分支名（如 main）。只读本地的 refs/remotes/<远端>/HEAD，不联网；解析不出返回 None。"""
    p = git(repo, "symbolic-ref", "--quiet", "--short", f"refs/remotes/{remote}/HEAD")
    ref = p.stdout.strip() if p.returncode == 0 else ""
    return ref[len(remote) + 1:] if ref.startswith(remote + "/") and len(ref) > len(remote) + 1 else None


def default_branch_note(repo: str, branch: Optional[str], up: dict, remotes: list) -> tuple:
    """主检出不在远端默认分支上时给一句提示（主目录停在别的分支上用户自己不一定知道），不切分支、不改起点。
    按上游分支名比，没上游按本地分支名；远端用上游的远端，没上游用 origin。返回 (远端默认分支如 origin/main 或 None, 提示或 None)。"""
    remote = up.get("remote") or ("origin" if "origin" in remotes else None)
    default = remote_default_branch(repo, remote) if branch and remote else None
    if not default:
        return None, None
    if (up.get("branch") or branch) == default:
        return f"{remote}/{default}", None
    return f"{remote}/{default}", (f"主目录在 {branch} 上，不是 {remote} 的默认分支 {default}；worktree 跟着主目录的分支走，"
                                   f"要从别的分支起请传 --base {remote}/<分支>")


def fast_forward_source(repo: str, upstream: str, up_sha: str, sync: dict, merge: bool = True) -> None:
    """主检出相对上游的位置；在分支上、没有已跟踪改动、没有进行中的操作、落后时 merge --ff-only。结果写进 sync。
    带 --no-overwrite-ignore：git 默认会用上游新跟踪的同名文件覆盖被忽略的本地文件（用户的本地配置），不覆盖、按快进失败记。
    merge=False（update --dry-run）只判断，能快进时记 status=behind，不执行 merge。"""
    head = sync["before"]
    if head == up_sha:
        sync.update(status="up_to_date", reason=f"主目录已是 {upstream} 最新")
        return
    if is_ancestor(repo, up_sha, head):
        n = commit_count(repo, f"{up_sha}..{head}")
        sync.update(status="ahead", ahead=n, reason=f"主目录领先 {upstream} {n} 个提交（没推送）")
        return
    behind = commit_count(repo, f"{head}..{up_sha}")
    sync["behind"] = behind
    if not is_ancestor(repo, head, up_sha):
        ahead = commit_count(repo, f"{up_sha}..{head}")
        sync.update(status="diverged", ahead=ahead,
                    reason=f"主目录和 {upstream} 分叉了（本地多 {ahead} 个提交，落后 {behind} 个）")
        return
    dirty = git_out(repo, "status", "--porcelain", "--untracked-files=no").splitlines()
    if dirty:
        sync.update(status="dirty", dirty_files=[line[3:] for line in dirty[:20]],
                    reason=f"主目录落后 {upstream} {behind} 个提交，但有 {len(dirty)} 个已跟踪文件的改动，没快进")
        return
    op = in_progress_op(repo)
    if op:
        sync.update(status="in_progress", reason=f"主目录落后 {upstream} {behind} 个提交，但有进行中的 {op}，没快进")
        return
    if not merge:
        sync.update(status="behind", reason=f"主目录落后 {upstream} {behind} 个提交，可以快进（没执行）")
        return
    try:
        p = git(repo, "merge", "--ff-only", "--no-overwrite-ignore", upstream, timeout=300)
    except DroverError as exc:  # 超时：多半是仓库的 post-merge hook 跑太久。不阻断，按快进失败记，HEAD 以实际为准
        p = subprocess.CompletedProcess([], 1, "", exc.message)
    if p.returncode != 0:
        err = p.stderr or p.stdout
        sync.update(status="ff_failed", ff_stderr=tail(err, 600), after=git_out(repo, "rev-parse", "HEAD"),
                    reason=f"主目录落后 {upstream} {behind} 个提交，git merge --ff-only 失败：{tail(err, 200)}")
        return
    sync.update(status="fast_forwarded", after=git_out(repo, "rev-parse", "HEAD"),
                reason=f"主目录从 {head[:12]} 快进到 {upstream}（{behind} 个提交）")


def wt_fetch_error(command: str, tries: int, stderr: str) -> str:
    """wt / integrate 的 fetch 失败文案（update 用 update_fetch_error）。"""
    return (f"{command} 失败（试了 {tries} 次），没有建 worktree：{tail(stderr, 300)}。"
            "网络 / 认证问题处理好后重跑；确认要用本地已有的代码建，加 --no-sync 重跑")


def fetch_ref(repo: str, sync: dict, prefetched: dict, fail, ref: str, remote: str, remote_branch: str,
              missing_ok: bool = False, extra: tuple = ()) -> bool:
    """fetch 一条远端分支（extra 是同一次 fetch 里顺带的 refspec，update 用它带上版本 tag，见 update_fetch_extra），结果记进
    sync["fetch"]。prefetched 里的不再 fetch；missing_ok 时远端没有这条分支返回 False；
    其他失败抛 DroverError，文案由 fail(命令, 尝试次数, stderr) 给（wt 和 update 要说各自的话）。"""
    if ref in prefetched:
        sync["fetch"].append({"ref": ref, "ok": True, "tries": prefetched[ref], "note": "调用方已 fetch，不重复"})
        return True
    p, tries = git_net(repo, "fetch", remote, remote_branch, *extra)
    command = shlex.join(["git", "fetch", remote, remote_branch, *extra])
    entry = {"ref": ref, "command": command, "ok": p.returncode == 0, "tries": tries}
    sync["fetch"].append(entry)
    if p.returncode == 0:
        return True
    if missing_ok and REMOTE_REF_MISSING_RE.search(p.stderr or ""):
        entry["note"] = "远端没有这条分支"
        return False
    entry["stderr"] = tail(p.stderr, 600)
    raise DroverError(fail(command, tries, p.stderr), repo=repo, source_sync=sync)


def fetch_upstream(repo: str, explicit: Optional[str], prefetched: dict, fail, extra=lambda up: ()) -> tuple:
    """fetch 主检出当前分支的上游（和显式 --base 的远端分支，同一条只 fetch 一次，prefetched 里的不再 fetch；extra(认出的上游)
    给跟着上游那次 fetch 顺带的 refspec），定出上游。返回 (sync, up, remotes, branch)：有上游时 sync 里有 upstream /
    upstream_sha、status 还是 None（位置由调用方判断：fetch_source 和上游比，update 按通道定目标）；没有上游时 status 是
    detached / upstream_gone / no_upstream。fetch 失败的文案由 fail 给（见 fetch_ref）。调用方持有 repo_sync_lock。"""
    remotes = git_out(repo, "remote").split()
    branch = current_branch(repo)
    up = source_upstream(repo, branch, remotes)
    head = git_out(repo, "rev-parse", "HEAD")
    sync: dict = {"branch": branch, "upstream": up["ref"], "before": head, "after": head, "status": None,
                  "reason": None, "fetch": []}
    upstream, gone = up["ref"], False
    if upstream:
        # 远端没有这条分支不算错：没配上游时是本地分支；配了上游的多半是合并后被删了（不少仓库的
        # 主检出停在旧的 feature / bugfix 分支上）。integrate 显式传了 --base，不能因此失败。
        if not fetch_ref(repo, sync, prefetched, fail, upstream, up["remote"], up["branch"], missing_ok=True,
                         extra=extra(up)):
            gone = up["configured"]
            up["reason"] = (f"{branch} 的上游 {upstream} 在远端已经没有了" if gone else
                            f"{branch} 没配上游，远端 origin 也没有这条分支")
            upstream = None
        elif not rev_commit(repo, upstream):
            upstream, up["reason"] = None, (f"fetch 了 {up['remote']} {up['branch']}，但本地没有远端跟踪分支 {upstream}"
                                            "（远端的 fetch 规则没包含它）")
    sync["upstream"] = upstream
    target = remote_branch_of(explicit, remotes)
    if target and explicit != upstream:
        fetch_ref(repo, sync, prefetched, fail, explicit, *target)

    if upstream:
        sync["upstream_sha"] = git_out(repo, "rev-parse", upstream)
    else:
        sync.update(status="detached" if not branch else "upstream_gone" if gone else "no_upstream",
                    reason=up["reason"])
    return sync, up, remotes, branch


def fetch_source(repo: str, explicit: Optional[str], prefetched: dict, fail) -> tuple:
    """fetch_upstream，再按 fast_forward_source 判断主检出相对上游的位置，落后就快进。返回 (sync, up, remotes, branch)。
    sync_source（wt / integrate）用；update 用 fetch_upstream 再按更新通道自己定目标（update_sync）。调用方持有 repo_sync_lock。"""
    sync, up, remotes, branch = fetch_upstream(repo, explicit, prefetched, fail)
    if sync["upstream"]:
        fast_forward_source(repo, sync["upstream"], sync["upstream_sha"], sync)
    return sync, up, remotes, branch


def sync_source(repo: str, base: Optional[str], prefetched: dict) -> tuple:
    """fetch 主检出的上游（和显式 --base 的远端分支，同一条只 fetch 一次，prefetched 里的不再 fetch），快进主检出，定起点。
    返回 (source_sync, base_ref, warnings)。fetch 失败（网络、认证等）抛 DroverError（不建 worktree）；
    没有上游（detached、上游是本地分支、没有远端、远端没有这条分支，或配了上游但远端已经删了）不算错。
    调用方持有 repo_sync_lock。"""
    explicit = base if base and base != "HEAD" else None
    sync, up, remotes, branch = fetch_source(repo, explicit, prefetched, wt_fetch_error)
    upstream = sync["upstream"]
    sync["remote_default"], default_note = default_branch_note(repo, branch, up, remotes)

    warnings = []
    reason = sync["reason"]
    if explicit:
        base_ref = explicit
        if sync["status"] in ("dirty", "in_progress", "diverged", "ff_failed"):
            warnings.append(f"主目录没更新：{reason}（worktree 的起点是 --base {explicit}，不受影响）")
    elif not upstream:
        base_ref = "HEAD"
        warnings.append(f"没法判断上游（{reason}），worktree 从主目录当前 HEAD 起")
    elif is_ancestor(repo, sync["upstream_sha"], sync["after"]):
        base_ref = "HEAD"  # 快进成功、本来就是最新、本地领先
        if sync["status"] == "ahead":
            warnings.append(f"worktree 带着主目录 {sync['ahead']} 个没推送的提交（{branch} 领先 {upstream}）")
    else:
        base_ref = upstream  # 有改动没快进、分叉、快进失败：从远端最新起
        warnings.append(f"主目录没更新：{reason}；worktree 从 {upstream} 起，不含主目录的本地提交 / 改动")
    if default_note and not explicit:
        warnings.append(default_note)
    return sync, base_ref, warnings


def plan_source_sync(repo: str, base: Optional[str], prefetched: dict) -> tuple:
    """--dry-run：不 fetch、不快进，报主检出现状和会执行的 git 命令。
    返回 (source_sync, 计划的命令, 按本地记录预测的起点, warnings（只有"不在远端默认分支上"这种不用联网就知道的）)。"""
    explicit = base if base and base != "HEAD" else None
    remotes = git_out(repo, "remote").split()
    branch = current_branch(repo)
    up = source_upstream(repo, branch, remotes)
    head = git_out(repo, "rev-parse", "HEAD")
    upstream = up["ref"]
    up_sha = rev_commit(repo, upstream)
    dirty = git_out(repo, "status", "--porcelain", "--untracked-files=no").splitlines()
    op = in_progress_op(repo)
    remote_default, default_note = default_branch_note(repo, branch, up, remotes)
    sync = {"status": "dry_run", "branch": branch, "upstream": upstream, "upstream_configured": up.get("configured"),
            "head": head, "upstream_sha_local": up_sha, "dirty": bool(dirty),
            "dirty_files": [line[3:] for line in dirty[:20]], "in_progress": op, "remote_default": remote_default}
    planned = []

    def plan_fetch(ref: str, remote: str, remote_branch: str, note: str) -> None:
        planned.append(f"（调用方已 fetch {ref}，不重复）" if ref in prefetched else
                       f"git -C {repo} fetch {remote} {remote_branch}（{note}）")

    if upstream:
        plan_fetch(upstream, up["remote"], up["branch"],
                   "主检出的上游；偶发认证 / 网络错误自动重试；远端已经没有这条分支就当作没有上游，"
                   "其他失败报错、不建 worktree" if up["configured"] else
                   f"{branch} 没配上游，按 origin/{branch} 试；远端没有这条分支就当作没有上游")
    else:
        sync["reason"] = up["reason"]
    target = remote_branch_of(explicit, remotes)
    if target and explicit != upstream:
        plan_fetch(explicit, *target, "--base 是远端分支，先 fetch 再用；失败就报错、不建 worktree")
    if upstream:
        planned.append(f"git -C {repo} merge --ff-only --no-overwrite-ignore {upstream}（fetch 后主检出在分支上、"
                       "没有已跟踪改动、没有进行中的 merge / rebase / cherry-pick、落后上游时才执行；其余情况不动主目录）")
    if explicit:
        base_ref = explicit
    elif not upstream or not up_sha:
        base_ref = "HEAD"
    elif is_ancestor(repo, up_sha, head) or (is_ancestor(repo, head, up_sha) and not dirty and not op):
        base_ref = "HEAD"
    else:
        base_ref = upstream
    return sync, planned, base_ref, [default_note] if default_note and not explicit else []


# ---------------------------------------------------------------- 推送记录、新一轮的起点
# 每次推送都记下分支和提交，不管走没走 integrate（旧版 patch 模式没有集成状态，它的推送也记）。推送过什么是任务级的事实，和集成 worktree 怎么建、
# 建了几次无关，所以记在 <slug>/pushes.jsonl（一行一次推送，只追加），不挂在 integrate 状态上：那份一个仓库一份，
# 重建或换目标分支时整个换掉（以前推两条分支要手工改名归档）。读它的：wt / integrate 定新一轮的起点并核实、cleanup 核实
# 内容已在推过的远端分支里、wrapup 列提交。旧任务的推送记在 integrate-*.json 的 pushes 里，task_pushes 一起读。
# 记录里除了 remote 名还记推送时的地址 remote_url：remote 名只是本地别名，仓库换了托管地址以后 origin 指的是另一个仓库，
# 拿推到旧地址的记录去核实新地址会误报漏推（push_moved）。
PUSHES_FILE = "pushes.jsonl"
CARRY_FILE = "carry.jsonl"  # wt / integrate --carry、integrate --carry-base 带上别的提交的记录：理由、起点、带上的提交
# wt 新建条目 worktree 时的起点（--carry 带上上一轮提交之前的 HEAD）：一行一个 worktree。integrate 只摘起点之后的提交
# （item_starts）；没有这个记录时只能按"目标分支没有的提交"摘，会把起点带着的别人的提交、主检出没推的本地提交一起摘走。
STARTS_FILE = "starts.jsonl"


def read_jsonl(path: Path) -> list:
    """一行一个 JSON 对象的文件；没有文件是 []，坏行跳过。"""
    try:
        return jsonl_rows(path.read_text())
    except OSError:
        return []


def jsonl_rows(text: str) -> list:
    out = []
    for line in text.splitlines():
        with contextlib.suppress(ValueError):
            obj = json.loads(line)
            if isinstance(obj, dict):
                out.append(obj)
    return out


def append_jsonl(path: Path, obj: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as fh:
        fh.write(json.dumps(obj, ensure_ascii=False) + "\n")


@contextlib.contextmanager
def locked_append(path: Path, *, best_effort: bool = False):
    """拿着 flock(path) 读-追加：yield (现有内容, 要追加的片段列表)，退出时把片段接到文件末尾。只追加、不整份重写：几个进程同时
    写，谁也盖不掉谁，也读不到别人写了一半的（以前状态文件是整份读出、拼上、整份写回，几个 brief 同时跑实测 240 次丢 75 段、
    7 次连原有内容都冲掉，还读到过半个汉字）。状态文件、上层状态文件、时间线、heavy 流水共用。文件只追加、不替换，所以直接锁它。
    best_effort：写不了（目录只读）不影响调用方（时间线、流水这类统计记录）。"""
    chunks: list = []
    with flock_file(path, None):
        try:
            text = path.read_text()
        except OSError:
            text = ""
        yield text, chunks
        if chunks:
            try:
                with open(path, "a") as fh:
                    fh.write("".join(chunks))
            except OSError:
                if not best_effort:
                    raise


def task_slugs() -> list:
    """状态目录下的全部任务 slug（task_owner 按它判断分支归哪个任务）。"""
    return [p.name for p in STATE_HOME.iterdir() if p.is_dir() and p.name not in RESERVED_SLUGS] \
        if STATE_HOME.is_dir() else []


def task_dir(slug: str) -> Path:
    """--slug 给的任务目录：slug 合法、目录已经在（编排者开工时建好）；写错了报错，不悄悄记进一个新目录。"""
    check_slug(slug)
    d = STATE_HOME / slug
    if not d.is_dir():
        raise DroverError(f"没有任务目录 {d}：--slug 写错了，或者这个任务不是 drover 派发的")
    return d


def state_pushes(state: dict, source: str) -> list:
    """integrate 状态文件里的 pushes（旧代码记在这里）换成推送记录的格式：仓库、目标分支、集成分支、worktree 取那份文件的。"""
    upstream = state.get("upstream") or ""
    remote, _, target = upstream.partition("/")
    return [{**p, "repo": state.get("repo"), "remote": remote, "target": target, "upstream": upstream,
             "branch": state.get("branch"), "worktree_path": state.get("worktree_path"), "source": source}
            for p in state.get("pushes") or [] if isinstance(p, dict)]


def task_pushes(slug: str) -> list:
    """这个任务的全部推送记录，从旧到新：旧 integrate-*.json（含改名归档的）里的按时间排在前，pushes.jsonl 的按文件顺序
    在后（新代码只写 pushes.jsonl）。同一仓库、同一目标分支、推上去的同一个提交只算一次：归档时复制的、integrate 重建时
    转进 pushes.jsonl 的都会重复。每条带上 record_file：这条是从哪个文件读的（要用户改记录时给出它；转进 pushes.jsonl
    的记录还带着原来的 source，但它在 pushes.jsonl 里）。"""
    legacy: list = []
    for f in sorted((STATE_HOME / slug).glob("integrate-*.json")):
        with contextlib.suppress(OSError, ValueError):
            state = json.loads(f.read_text())
            if isinstance(state, dict):
                legacy += [{**p, "record_file": str(f)} for p in state_pushes(state, f.name)]
    legacy.sort(key=lambda p: str(p.get("at") or ""))
    jsonl = STATE_HOME / slug / PUSHES_FILE
    seen, out = set(), []
    for p in legacy + [{**p, "record_file": str(jsonl)} for p in read_jsonl(jsonl)]:
        key = (os.path.realpath(p.get("repo") or "/nonexistent"), p.get("upstream"),
               p.get("remote_sha") or p.get("range"))
        if key not in seen:
            seen.add(key)
            out.append(p)
    return out


def repo_pushes(pushes: list, repo: str) -> list:
    real = os.path.realpath(repo)
    return [p for p in pushes if os.path.realpath(p.get("repo") or "/nonexistent") == real]


def push_target(p: dict) -> tuple:
    """(远端, 目标分支)。"""
    return p.get("remote") or "", p.get("target") or ""


def push_end(repo: str, p: dict) -> Optional[str]:
    """推上去的提交（完整 sha）；旧记录 remote_sha 是空的时取 range 的后一半。本地没有这个对象返回 None。"""
    return rev_commit(repo, p.get("remote_sha") or (p.get("range") or "").partition("..")[2])


def push_start(repo: str, p: dict) -> Optional[str]:
    """推送前的远端头；旧记录没有 from，取 range 的前一半。"""
    return rev_commit(repo, p.get("from") or (p.get("range") or "").partition("..")[0])


def pushed_branches(pushes: list) -> list:
    """推过的目标分支，按最后一次推送从旧到新：[{ref, last_at, last_sha}]。"""
    last: dict = {}
    for p in pushes:
        last.pop(push_target(p), None)
        last[push_target(p)] = p
    return [{"ref": p.get("upstream") or "/".join(k), "last_at": p.get("at"),
             "last_sha": (p.get("remote_sha") or (p.get("range") or "").partition("..")[2])[:12]}
            for k, p in last.items()]


@functools.lru_cache(maxsize=None)
def remote_push_url(repo: str, remote: str) -> Optional[str]:
    """remote 现在的推送地址（git remote get-url --push，git 已展开 insteadOf / pushInsteadOf）；不是 remote 名（比如传的是
    地址）、这个 remote 已经不在了返回 None。一条命令里不会变，同一个仓库的同一个 remote 只查一次。"""
    p = git(repo, "remote", "get-url", "--push", remote)
    return (p.stdout.strip() or None) if p.returncode == 0 else None


def remote_url_key(url: str) -> str:
    """比较地址用：同一个仓库的几种写法比的是主机 + 路径（git@example.com:o/r.git、ssh://git@example.com/o/r、
    https://example.com/o/r 算同一个）。scheme://[user@]host[:port]/path（ssh、https、git…）和 scp 写法 [user@]host:path
    （git 的规则：第一个 / 之前有 : 才算）都换成 host/path：去掉协议、用户名、端口，主机转小写，路径大小写不动；
    file:///abs/path 是 /abs/path，本地路径照原样；最后去掉首尾空白、末尾的 / 和 .git。别的不归一（不查 DNS、不认托管
    平台的大小写或改名重定向）：对不上的只是不拿那些推送核实、给出提示，不会挡人。"""
    s = url.strip()
    if "://" in s:
        parts = urlsplit(s)
        s = parts.path if parts.scheme == "file" else f"{parts.hostname or ''}{parts.path}"
    elif ":" in s.partition("/")[0]:
        host, _, path = s.partition(":")
        s = f"{host.rpartition('@')[2].lower()}/{path.lstrip('/')}"
    return s.rstrip("/").removesuffix(".git")


def push_moved(repo: str, p: dict) -> Optional[dict]:
    """这次推送是不是推到了别处：记录里有推送时的地址 remote_url，而现在这个仓库里同名 remote 的推送地址和它不同（仓库换了
    托管地址，origin 指的是另一个仓库了），或者这个 remote 已经不在了。是就返回 {remote, remote_url, remote_url_now}（不在了
    是 None），不是返回 None。没有 remote_url 的旧记录（这个版本之前写的）当作推到现在这个远端，照旧核实。
    wt / integrate 定新一轮的起点（split_by_remote）和 wrapup 核对远端都按它认。"""
    old = p.get("remote_url")
    if not old:
        return None
    remote = push_target(p)[0]
    now = remote_push_url(repo, remote)
    if now and remote_url_key(now) == remote_url_key(old):
        return None
    return {"remote": remote, "remote_url": old, "remote_url_now": now}


def split_by_remote(repo: str, pushes: list) -> tuple[list, list]:
    """(推到现在这个远端的推送记录, 推到别处的 [{at, upstream, remote, remote_url, remote_url_now}])，见 push_moved。"""
    here, away = [], []
    for p in pushes:
        moved = push_moved(repo, p)
        if moved:
            away.append({"at": p.get("at"), "upstream": p.get("upstream"), **moved})
        else:
            here.append(p)
    return here, away


def remote_now_text(remote: str, url: Optional[str]) -> str:
    return f"现在 {remote} 是 {url}" if url else f"现在没有 {remote} 这个远端"


def moved_text(away: list) -> str:
    """"推到的是 <旧地址>，现在 <remote> 是 <新地址>"；几组不同的用"；"连起来。"""
    return "；".join(dict.fromkeys(f"推到的是 {m['remote_url']}，{remote_now_text(m['remote'], m['remote_url_now'])}"
                                  for m in away))


# 新一轮的起点：起点 = 这一轮要推的那条远端分支（fetch 到最新），不是主检出所在的分支；没说推哪条的
# 按上一轮推的那条起。建之前核实上一轮推到远端的提交在起点里，不过就拒绝建、列出缺的提交，交用户定：--carry 带上这些
# 提交在新分支上起，或者 --base 指回上一轮的分支接着改。没有推送记录（第一轮）起点照旧。推到别处的推送（remote 换过
# 地址，见 push_moved）不拿来定起点、不拿来核实：那些提交本来就不在新远端里，--carry 会把那边的提交带到现在的仓库。
ROUND_REUSED = {"status": "skipped", "reason": "复用已有 worktree：没有新起点，不核实"}

def round_default_base(repo: str, pushes: list) -> Optional[str]:
    """wt 没传 --base 时的起点：这个任务在这个仓库推过的那条远端分支。没有推送记录返回 None（第一轮，起点照旧）；
    推过两条以上（一轮推两条，或者中途换过分支）不猜：命令不知道哪条是这一轮主要的，报错要求显式 --base。"""
    if not pushes:
        return None
    branches = pushed_branches(pushes)
    if len(branches) > 1:
        raise DroverError(
            "这个任务在这个仓库推过 " + "、".join(f"{b['ref']}（最后一次 {b['last_at']} 推到 {b['last_sha'][:9]}）"
                                       for b in branches)
            + "，没传 --base 不知道这一轮从哪条起，没有建 worktree：按用户这一轮要推的分支加 --base <远端>/<分支> 重跑"
            "（一轮推两条的从主要那条起，另一条集成时各自核实）", repo=repo, pushed_branches=branches)
    return branches[0]["ref"]


def cherry_marks(repo: str, upstream: str, head: str, limit: Optional[str] = None) -> Optional[list]:
    """补丁相同的公共判断（integrate 摘提交、cleanup 核对已提交的、新一轮起点核实三处共用）：head 上（limit 之后）不在
    upstream 里的提交，从旧到新 [(标记, sha)]。标记同 git cherry："-" 是 upstream 那边（head..upstream）有补丁内容相同的
    提交，"+" 是没有。git cherry 比的补丁号去掉了空白、也没有配置能关（实测只改缩进的两个提交判 "-"），Python / YAML /
    Makefile 里只改缩进的修正会被当成已应用：所以 "-" 再按保留空白的补丁号（git patch-id --verbatim）在 upstream 那边找一次，
    找不到的改成 "+"。合并提交不比（同 git cherry）。git 失败返回 None。"""
    c = git(repo, "cherry", upstream, head, *([limit] if limit else []))
    if c.returncode != 0:
        return None
    marks = [(line[0], line.split()[1]) for line in c.stdout.splitlines() if line[:2] in ("+ ", "- ")]
    same = [sha for mark, sha in marks if mark == "-"]
    return verbatim_marks(repo, upstream, head, marks, same) if same else marks


def verbatim_marks(repo: str, upstream: str, head: str, marks: list, same: list) -> Optional[list]:
    """git cherry 判 "-" 的（same）再按保留空白的补丁号核一次：upstream 那边（head..upstream）没有同号的改成 "+"。"""
    theirs, ours = verbatim_patch_ids(repo, [f"{head}..{upstream}"]), verbatim_patch_ids(repo, ["--no-walk", *same])
    if theirs is None or ours is None:
        return None
    found = set(theirs.values())
    return [("-" if mark == "-" and ours.get(sha) in found else "+", sha) for mark, sha in marks]


def verbatim_patch_ids(repo: str, revs: list) -> Optional[dict]:
    """{提交: 保留空白的补丁号}：git log -p 的输出交给 git patch-id --verbatim（每个提交以 "commit <sha>" 开头）。
    带 --binary（二进制改动按内容算）、--no-renames（不受 diff.renames 配置影响），两边同一种写法才可比。"""
    log = git_bytes(repo, "log", "--no-merges", "-p", "--binary", "--no-renames", "--no-color", "--no-ext-diff",
                    "--format=commit %H", *revs)
    if log.returncode != 0:
        return None
    pid = git_bytes(repo, "patch-id", "--verbatim", input_bytes=log.stdout)
    if pid.returncode != 0:
        return None
    return {sha: patch for patch, sha in (row.split() for row in pid.stdout.decode().splitlines() if row.strip())}


def cherry_plus(repo: str, upstream: str, end: str, begin: str) -> Optional[list]:
    """begin..end 里在 upstream 那边没有的提交（cherry_marks 的 "+"，从旧到新）；upstream 已经包含的（祖先，不列出）和补丁
    内容相同的（"-"）都不算。git 失败返回 None。"""
    marks = cherry_marks(repo, upstream, end, begin)
    return None if marks is None else [sha for mark, sha in marks if mark == "+"]


def push_short(repo: str, p: dict, start_sha: str, also: tuple) -> tuple[list, Optional[str]]:
    """一次推送推上去的提交里起点 start_sha 没有的（git cherry 的 "+"；also 里已有的不算，见 round_check）：(缺的 sha, None)；
    核实不了返回 ([], 原因)。"""
    end, begin = push_end(repo, p), push_start(repo, p)
    if not end or not begin:
        return [], "推送记录里的提交本地找不到"
    plus = cherry_plus(repo, start_sha, end, begin)
    if plus is None:
        return [], "git cherry 失败"
    for rev in also:
        other = cherry_plus(repo, rev, end, begin) if plus else []
        if other is not None:
            plus = [s for s in plus if s in other]
    return plus, None


def round_check(repo: str, pushes: list, start: str, remotes: list, also: tuple = ()) -> dict:
    """起点 start 含不含这个任务上一轮推到远端的提交（pushes 只含推到现在这个远端的，见 split_by_remote）。参照：start 是
    <远端>/<T> 且推过 T 的按 T 自己的推送（同一条分支）；否则（换了分支）按最近一次推送的那条分支。参照里最后一次推上去的
    提交是 start 的祖先 → 过；否则逐次推送用 git cherry 按补丁内容比（挑到别的分支上的也算），剩下的就是缺的。合并提交
    git cherry 不比，合并带进来的普通提交照比。
    also 是 integrate 接着要摘进来的条目分支（--from）：缺的提交已在其中的（一轮推两条分支时，第二条集成的
    就是同一批条目提交；条目 worktree 用 --carry 带上过的）不算缺，integrate 会把它们摘进来。
    返回 {status: no_records / ok / missing, …}；推送记录里的提交本地找不到时列进 unknown，也算 missing（核实不了）。
    缺提交、核实不了的推送里没记远端地址的（旧版本写的）列进 no_remote_url：分不清推的是不是现在这个远端，拒绝时多说一段。"""
    if not pushes:
        return {"status": "no_records", "note": "这个任务在这个仓库还没有推送记录（第一轮），起点照旧"}
    rb = remote_branch_of(start, remotes)
    same = [p for p in pushes if rb and push_target(p) == rb]
    ref = same or [p for p in pushes if push_target(p) == push_target(pushes[-1])]
    against = ref[-1].get("upstream") or "/".join(push_target(ref[-1]))
    start_sha = rev_commit(repo, start)
    out: dict = {"start": start, "start_sha": start_sha, "against": against, "same_branch": bool(same),
                 "last_push": {k: ref[-1].get(k) for k in ("at", "remote_sha", "range")}}
    if not start_sha:
        return {**out, "status": "missing", "missing": [], "unknown": [f"起点 {start} 本地解析不到提交"]}
    last = push_end(repo, ref[-1])
    if last and is_ancestor(repo, last, start_sha):
        return {**out, "status": "ok", "how": "ancestor"}
    missing, unknown, no_url, seen = [], [], [], set()
    for p in ref:
        plus, why = push_short(repo, p, start_sha, also)
        if why:
            unknown.append(f"{p.get('at')} 推到 {p.get('upstream')} 的 {p.get('range') or p.get('remote_sha')}：{why}")
        for sha in plus:
            if sha not in seen:
                seen.add(sha)
                missing.append({"sha": sha, "short": sha[:9], "subject": git_out(repo, "log", "-1", "--format=%s", sha),
                                "pushed_to": p.get("upstream"), "pushed_at": p.get("at")})
        if (plus or why) and not p.get("remote_url"):
            remote = push_target(p)[0]
            no_url.append({"at": p.get("at"), "upstream": p.get("upstream"), "range": p.get("range"), "remote": remote,
                           "remote_url_now": remote_push_url(repo, remote), "file": p.get("record_file")})
    if also:
        out["covered_by"] = list(also)
    if not missing and not unknown:
        return {**out, "status": "ok", "how": "patch"}
    return {**out, "status": "missing", "how": "patch", "missing": missing, "unknown": unknown, "no_remote_url": no_url}


def round_other_remote(check: dict, away: list) -> tuple[dict, list]:
    """推到别处的推送（split_by_remote）不拿来核实，列在 round_check 的 other_remote 里。这个仓库的推送全都推到了别处时
    （round_check 是 no_records）status 是 other_remote：起点按第一轮的规则定。返回 (round_check, 要进 warnings 的话)。"""
    if not away:
        return check, []
    if check["status"] == "no_records":
        note = f"上一轮{moved_text(away)}：不拿这些推送核实起点，起点按第一轮的规则定"
        return {**check, "status": "other_remote", "note": note, "other_remote": away}, [note]
    return {**check, "other_remote": away}, \
        [f"另有 {len(away)} 次推送{moved_text(away)}：不拿它们核实起点，只核实推到现在这个地址的"]


def no_url_note(check: dict) -> str:
    """缺的提交来自没记远端地址的旧记录（round_check 的 no_remote_url）时，拒绝的报错末尾加的一段：remote 换过地址的话这些
    提交本来就不在新远端里，--carry 会把那边的提交带到现在的仓库；给记录补上当时的地址，就按推到别处处理、不拿它们核实。"""
    legacy = check.get("no_remote_url") or []
    if not legacy:
        return ""
    where = "；".join(f"{p['at']} 推到 {p['upstream']}（记在 {p['file']}）" for p in legacy)
    remotes = "、".join(dict.fromkeys(p["remote"] for p in legacy))
    now = "；".join(dict.fromkeys(remote_now_text(p["remote"], p["remote_url_now"]) for p in legacy))
    return (f"。另外，这几次推送是旧版本记的、没记远端地址：{where}。如果 {remotes} 之后换过地址（{now}）、上一轮推的是另一个"
            "仓库，这些提交本来就不在新远端里，不要 --carry（会把那边的提交带到现在的仓库）：在记录所在的文件里给这几条记录补上 "
            "\"remote_url\": \"<当时的地址>\" 再重跑，就不拿它们核实了")


def round_refusal(check: dict, base_flag: str, synced: bool, carry: Optional[str]) -> DroverError:
    """核实不过时的报错，写成编排者能直接搬给用户的中文：缺哪几个提交（短 sha + 标题、什么时候推到哪条分支）、两种做法；
    缺的来自没记远端地址的旧记录时再加一段怎么补（no_url_note，结构化的在 no_remote_url）。
    base_flag 是"在旧分支上接着改"的写法（wt 是 --base <远端>/<分支>，integrate 是 --target <分支>）。"""
    start, against = check["start"], check["against"]
    sha = f"（{check['start_sha'][:9]}）" if check.get("start_sha") else ""
    text = f"起点 {start}{sha} 不含这个任务上一轮推到 {against} 的提交，没有建 worktree"
    if not synced:
        text += "（--no-sync：按本地记录判断，没 fetch）"
    missing = check.get("missing") or []
    if missing:
        text += f"。缺 {len(missing)} 个：" + "；".join(f"{m['short']} {m['subject']}（{m['pushed_at']} 推到 {m['pushed_to']}）"
                                                    for m in missing)
    choices = [{"do": "base", "text": f"在上一轮的分支 {against} 上接着改：重跑改成 {base_flag}"}]
    if check.get("unknown"):
        text += "。核实不了：" + "；".join(check["unknown"])
        if carry:
            text += "（--carry 带不上本地找不到的提交）"
    else:
        choices.insert(0, {"do": "carry", "text": f"带上这些提交在 {start} 上起：重跑加 --carry \"<理由>\"，新 worktree 建好后"
                                                  "先把它们按顺序 cherry-pick 进来（理由记进任务目录的 carry.jsonl）"})
    marks = "①②"
    text += "。做法交用户定：" + "；".join(f"{marks[i]}{c['text']}" for i, c in enumerate(choices)) + no_url_note(check)
    return DroverError(text, round_check=check, missing=missing, choices=choices,
                       no_remote_url=check.get("no_remote_url", []))


def carry_commits(wt: str, slug: str, repo: str, branch: str, check: dict, reason: str) -> list:
    """--carry：在新 worktree 里按从旧到新 cherry-pick 起点缺的上一轮提交，记进 <slug>/carry.jsonl。一条 cherry-pick 命令：
    git 自己按顺序摘，冲突时停在那个提交上，解完 --continue 接着摘剩下的。返回带上的提交 [{sha, subject, new_sha}]。
    带上的提交在 worktree 里是提交、BASE_SHA（head_sha）在它们之后：条目分支里有它们，integrate 核实时按 --from
    算作已覆盖，摘条目提交时一起摘进集成分支（旧版 patch 模式补丁只含 worker 的改动，集成 worktree 用 wt --carry 建、先带上再
    叠补丁）。漏了的都会被核实挡住（集成 worktree 的起点不含、--from 里也没有）。"""
    missing = check["missing"]
    record = {"at": time.strftime("%m-%d %H:%M:%S"), "ts": round(time.time(), 3), "repo": repo, "branch": branch,
              "worktree_path": wt, "start": check["start"], "start_sha": check["start_sha"],
              "against": check["against"], "reason": reason,
              "commits": [{k: m[k] for k in ("sha", "subject", "pushed_to", "pushed_at")} for m in missing]}
    cp = git(wt, "cherry-pick", *[m["sha"] for m in missing], timeout=600)
    record["status"] = "picked" if cp.returncode == 0 else "stopped"
    append_jsonl(STATE_HOME / slug / CARRY_FILE, record)
    if cp.returncode != 0:
        raise DroverError(
            f"带上上一轮的提交时 cherry-pick 停下了（worktree 已建在 {wt}）：解完冲突 → git -C {wt} add <文件> → "
            f"git -C {wt} -c core.editor=true cherry-pick --continue（会接着摘剩下的）；摘完后的 HEAD 就是这个 worktree 的 "
            "BASE_SHA", worktree_path=wt, conflicts=conflicted_files(wt), stderr=tail(cp.stderr or cp.stdout, 800),
            carry_file=str(STATE_HOME / slug / CARRY_FILE))
    picked = git_out(wt, "rev-list", "--reverse", f"{check['start_sha']}..HEAD").splitlines()
    return [{"sha": m["sha"], "subject": m["subject"], "new_sha": new} for m, new in zip(missing, picked)]


def herdr_trusted(cmd: list, repo: str) -> tuple[bool, dict, bool]:
    """跑一条 herdr worktree 命令；herdr 要求信任仓库时，只对主工作台（config 的 workspace）下的仓库自动加
    --trust-repository 重试一次，其他位置报错（先问用户确认可信）。返回 (成功, 结果或错误, 是否加了信任)。wt、cleanup 共用。"""
    ok, res = herdr(cmd)
    if ok or "trust" not in f"{res.get('code', '')} {res.get('message', '')}".lower():
        return ok, res, False
    if TRUSTED_ROOT is None:
        raise DroverError(
            f"herdr 要求信任仓库 {repo}；没有配置主工作台（{CONFIG_FILE} 的 workspace），不自动信任任何目录。"
            "先问用户确认可信，再手动加 --trust-repository。", error=res)
    if not is_under(repo, TRUSTED_ROOT):
        raise DroverError(
            f"herdr 要求信任仓库，但 {repo} 不在 {TRUSTED_ROOT} 下。先问用户确认可信，再手动加 --trust-repository。",
            error=res)
    ok, res = herdr(cmd + ["--trust-repository"])
    return ok, res, ok


def record_item_start(slug: Optional[str], skip: bool, repo: str, branch: str, wt_path: str, base_ref: str) -> None:
    """新建的条目 worktree 把起点（--carry 带上的上一轮提交之前的 HEAD）记进 <slug>/starts.jsonl，integrate 只摘它之后的
    提交（item_starts）。复用的、integrate 自己建的集成 worktree（skip）、定不了任务的不记。"""
    if slug and not skip:
        append_jsonl(STATE_HOME / slug / STARTS_FILE, {
            "at": time.strftime("%m-%d %H:%M:%S"), "ts": round(time.time(), 3), "repo": repo, "branch": branch,
            "worktree_path": wt_path, "start": git_out(wt_path, "rev-parse", "HEAD"), "base_ref": base_ref})


def cmd_wt(a: argparse.Namespace) -> dict:
    repo = git_out(a.repo, "rev-parse", "--show-toplevel")
    branch = a.branch
    base = getattr(a, "base", None)
    no_sync = getattr(a, "no_sync", False)
    # integrate 调用时传：调用前已经 fetch 过的远端分支 {ref: 尝试次数}，这里不重复 fetch。
    prefetched = getattr(a, "prefetched", None) or {}
    ok, listing = herdr(["worktree", "list", "--cwd", repo])
    if not ok:
        raise DroverError("herdr worktree list 失败", error=listing)
    existing = [w for w in listing.get("worktrees", []) if w.get("branch") == branch]

    # 新一轮的起点（见 round_check 上面的说明）：任务来自 --slug，或分支 task/<slug>… 的归属。
    carry = getattr(a, "carry", None)
    via_integrate = getattr(a, "via_integrate", False)
    slug = getattr(a, "slug", None)
    if slug and not via_integrate:  # integrate 已核过 slug，任务目录由它在写状态时建
        task_dir(slug)
    elif not slug:
        slug = task_owner(branch, task_slugs())
    # 推到别处的（remote 换过地址，见 push_moved）不拿来定起点、不拿来核实，列在 round_check 的 other_remote 里
    pushes, away = split_by_remote(repo, repo_pushes(task_pushes(slug), repo) if slug else [])
    remotes = git_out(repo, "remote").split()
    base_from = None
    if not existing and base is None and pushes:
        base, base_from = round_default_base(repo, pushes), "这个任务上一轮推的分支"
    also = tuple(getattr(a, "round_also", None) or ())  # integrate 接着要摘的条目分支，见 round_check

    def check_round(start: str, synced: bool) -> dict:
        """核实起点，推到别处的推送进 warnings；不过就抛错（带了 --carry、缺的提交都找得到时放行，建好后 carry_commits
        带上）。--dry-run 按本地记录预测（would_refuse），不报错：实际执行时 fetch 后再核实。"""
        check, notes = round_other_remote(round_check(repo, pushes, start, remotes, also), away)
        warnings.extend(notes)
        refuse = check["status"] == "missing" and (not carry or bool(check.get("unknown")))
        if a.dry_run:
            return {**check, "would_refuse": refuse, "note": "按本地记录预测（没 fetch）；实际执行 fetch 后再核实"} \
                if check["status"] == "missing" else check
        if refuse:
            against = check["against"]
            raise round_refusal(check, f"--target {against.partition('/')[2]}" if via_integrate else f"--base {against}",
                                synced, carry)
        return check

    renamed_from = None
    reused = bool(existing)
    if not reused:
        candidate, n = branch, 2
        while branch_exists(repo, candidate):
            candidate = f"{branch}-{n}"
            n += 1
        if candidate != branch:
            renamed_from, branch = branch, candidate
    path_args = ["--path", a.path] if a.path else []

    def create_cmd(start: str) -> list:
        return ["worktree", "create", "--cwd", repo, "--branch", branch, "--base", start, "--label", a.label,
                "--no-focus", *path_args]

    open_cmd = ["worktree", "open", "--cwd", repo, "--branch", branch, "--label", a.label, "--no-focus", *path_args]
    warnings: list = []
    if reused:
        cmd, base_ref = open_cmd, None
        sync = {"status": "reused", "reason": "复用已有 worktree：不 fetch、不动主目录"}
    elif no_sync:
        base_ref = base or "HEAD"
        cmd = create_cmd(base_ref)
        head = git_out(repo, "rev-parse", "HEAD")
        src_branch = current_branch(repo)
        remote_default, default_note = default_branch_note(repo, src_branch,
                                                           source_upstream(repo, src_branch, remotes), remotes)
        sync = {"status": "not_synced", "reason": "--no-sync：没 fetch、没动主目录", "branch": src_branch,
                "before": head, "after": head, "remote_default": remote_default}
        warnings.append(f"没同步上游（--no-sync）：worktree 从 {base_ref} 起，不一定是远端最新")
        if default_note and base_ref == "HEAD":
            warnings.append(default_note)

    if a.dry_run:
        planned = []
        if not reused and not no_sync:
            sync, planned, base_ref, warnings = plan_source_sync(repo, base, prefetched)
            cmd = create_cmd(base_ref)
        planned.append("herdr " + shlex.join(cmd))
        check = check_round(base_ref, False) if not reused else ROUND_REUSED
        return {
            "ok": True, "dry_run": True, "repo": repo, "branch": branch,
            "branch_renamed_from": renamed_from, "reused": reused,
            "existing_worktree_path": existing[0].get("path") if existing else None,
            "source_sync": sync,
            "base_ref": base_ref,
            "base_ref_note": None if reused or no_sync else
            "按本地记录的上游预测；实际起点 fetch 后再定：上游是主检出 HEAD 的祖先（快进成功、本来就是最新、本地领先）用 HEAD，"
            "否则用上游；显式 --base 照用",
            "base_from": base_from, "task": slug, "round_check": check,
            # 不用联网就知道的提示（主目录不在远端默认分支上、--no-sync）；主目录没更新之类要 fetch 后才知道
            "warnings": warnings,
            "planned": planned,
            "would_copy": copy_local_files(repo, existing[0]["path"], True)[0] if existing else
            new_worktree_copy_note(repo),
            "untracked_repo_docs": [{"name": n, "ignored": i} for n, i in untracked_repo_docs(repo)],
        }

    if not reused and not no_sync:
        with repo_sync_lock(repo) as waited:
            sync, base_ref, warnings = sync_source(repo, base, prefetched)
        if waited:
            sync["lock_waited_seconds"] = waited
        cmd = create_cmd(base_ref)
    check = check_round(base_ref, not no_sync) if not reused else dict(ROUND_REUSED)
    if carry and check["status"] != "missing":
        warnings.append(f"--carry 没用上：{check.get('note') or '起点已经包含上一轮推的提交'}"
                        if check["status"] != "skipped" else "--carry 没用上：复用已有 worktree，没有新起点")

    primary_before = repo_primary_workspaces(repo)
    ok, res, trusted = herdr_trusted(cmd, repo)
    if not ok:
        raise DroverError("herdr worktree 命令失败", command="herdr " + shlex.join(cmd), error=res, source_sync=sync)

    ws_id = (res.get("workspace") or {}).get("workspace_id") or find_key(res, "workspace_id")
    wt_path = (res.get("worktree") or {}).get("path")
    if not ws_id or not wt_path:
        raise DroverError("herdr 返回里缺 workspace.workspace_id 或 worktree.path", result=res)

    ok, panes = herdr(["pane", "list", "--workspace", ws_id])
    pane_id = panes["panes"][0]["pane_id"] if ok and panes.get("panes") else None
    record_item_start(slug, reused or via_integrate, repo, branch, wt_path, base_ref)
    carried = []
    if check["status"] == "missing":
        # 先带上再复制本地文件：复制过去的未跟踪文件会挡住要新增它的 cherry-pick（见 copy_local_files）
        try:
            carried = carry_commits(wt_path, slug, repo, branch, check, carry)
        except DroverError as exc:
            exc.extra.update(workspace_id=ws_id, pane_id=pane_id, round_check=check)
            raise
    opened = sorted(repo_primary_workspaces(repo) - primary_before)
    copied, docs_not_copied, include_skipped = copy_local_files(repo, wt_path, False)

    result = {
        "ok": True,
        "repo": repo,
        "branch": branch,
        "branch_renamed_from": renamed_from,
        "reused": reused,
        "trusted_repository_added": trusted,
        "workspace_id": ws_id,
        "worktree_path": wt_path,
        "pane_id": pane_id,
        "source_workspace_opened": opened[0] if opened else None,
        "head_sha": git_out(wt_path, "rev-parse", "HEAD"),
        # 新建时实际用的起点写法（HEAD、origin/<分支> 或显式 --base）；复用时为 None。
        "base_ref": base_ref,
        # 主检出同步：status 见 sync_source / fast_forward_source（fast_forwarded、up_to_date、ahead、dirty、in_progress、
        # diverged、ff_failed、detached、no_upstream、upstream_gone、not_synced、reused），reason 是中文说明，
        # fetch 列出每次 fetch 和尝试次数，remote_default 是本地记录的远端默认分支（如 origin/main）。
        "source_sync": sync,
        # 编排者要在汇报里提一句的事：主目录没更新、worktree 带着没推送的提交、没法判断上游（含上游在远端已删）、
        # 主目录不在远端默认分支上、--no-sync、上一轮的推送推到了别处（remote 换过地址）。
        "warnings": warnings,
        "copied": copied,
        # 新一轮的起点：task 是推送记录按哪个任务取的（没有就是 null）；base_from 非空表示起点是按推送记录定的；
        # round_check 的 status：no_records（第一轮，起点照旧）、ok（含上一轮推的提交，how 是 ancestor / patch）、
        # missing（带了 --carry，carried 是带上的提交）、skipped（复用）、other_remote（推送全推到了别处：remote 换过地址，
        # 起点照第一轮的规则定）；other_remote 列出推到别处的推送（有的推到这里时也在，只核实推到这里的）。
        "task": slug, "base_from": base_from, "round_check": check,
        **({"carried": carried} if carried else {}),
        "note": ("复用了已有 worktree：BASE_SHA 用状态文件里原来记录的，没有记录才用 head_sha 并在汇报里说明。"
                 if reused else "新建 worktree：head_sha 就是 BASE_SHA。" + (
                     "（--carry 带上的上一轮提交已在它之前）" if carried else "")),
    }
    if SLUG_RISKY_WORDS.search(a.label):
        result["warning"] = ("label / slug 里有 import 或 include：结果文件路径会带上它，用 jq 读时会被判成加载模块、弹强制审批；"
                             "读验收结果用 drover accept-summary")
    if docs_not_copied:
        result["docs_not_copied"] = docs_not_copied
        result["docs_note"] = ("这些规范文件在源仓库里既没提交也没被忽略，复制过去会出现在 worktree 的 git status 里，所以没复制；"
                               "brief 会让 agent 去读源仓库里的原文。")
    if include_skipped:
        # .worktreeinclude 匹配到、源仓库里被忽略，但没复制的文件和原因（worktree 里没被忽略、源路径是符号链接）。
        result["worktreeinclude_skipped"] = include_skipped
    return result


# ---------------------------------------------------------------- deps

def venv_python_version(venv: Path) -> Optional[str]:
    cfg = venv / "pyvenv.cfg"
    if cfg.is_file():
        for line in cfg.read_text(errors="replace").splitlines():
            key, _, value = line.partition("=")
            if key.strip() in ("version", "version_info"):
                m = re.match(r"\s*(\d+\.\d+\.\d+)", value)
                if m:
                    return m.group(1)
    py = venv / "bin" / "python"
    if py.exists():
        p = run([str(py), "-c", "import sys; print('%d.%d.%d' % sys.version_info[:3])"], timeout=30)
        if p.returncode == 0:
            return p.stdout.strip()
    return None


def nested_lockfiles(wt: Path, max_depth: int = 3) -> dict:
    """按子目录归组列出 lockfile：{子目录: [lockfile 名, ...]}，不含 worktree 根目录。"""
    found: dict = {}
    root_depth = len(wt.parts)
    for dirpath, dirnames, filenames in os.walk(wt):
        depth = len(Path(dirpath).parts) - root_depth
        dirnames[:] = [d for d in dirnames if d not in SCAN_SKIP_DIRS and depth < max_depth]
        if depth == 0:
            continue
        locks = sorted(name for name in filenames if name in LOCKFILE_NAMES)
        if locks:
            found[str(Path(dirpath).relative_to(wt))] = locks
    return dict(sorted(found.items()))


class DepsPlan:
    """记录每一项依赖的处理结果，同时生成给 agent 看的中文摘要。"""

    def __init__(self, dry_run: bool) -> None:
        self.dry_run = dry_run
        self.items: list = []

    def step(self, cmd: list, timeout: float = 1800) -> tuple[bool, str, float]:
        if self.dry_run:
            return True, "dry-run", 0.0
        started = time.time()
        p = run(cmd, timeout=timeout, input_text=DEPS_NO_INPUT)
        return p.returncode == 0, tail(p.stderr or p.stdout, 600), round(time.time() - started, 1)

    def add(self, kind: str, action: str, summary: str, **extra: Any) -> None:
        self.items.append({"kind": kind, "action": action, "summary": summary, **extra})

    def record(self, dep_dir: Path, inputs: dict) -> None:
        """安装成功后在依赖目录里记下这次的输入（DEPS_STAMP），去掉复刻没做完的标记（VENV_CLONE_UNFINISHED）；dry-run 不记。
        包管理器没建目录（没有要装的包）时建个空的。"""
        if not self.dry_run:
            dep_dir.mkdir(exist_ok=True)
            (dep_dir / DEPS_STAMP).write_text(json.dumps(inputs, ensure_ascii=False, indent=1) + "\n")
            (dep_dir / VENV_CLONE_UNFINISHED).unlink(missing_ok=True)

    def mark_unfinished(self, dep_dir: Path) -> None:
        """多步的安装（复刻源 venv）开始改动依赖目录了：放上 VENV_CLONE_UNFINISHED，做完时 record 去掉；dry-run 不放。"""
        if not self.dry_run:
            (dep_dir / VENV_CLONE_UNFINISHED).touch()

    def forget(self, dep_dir: Path) -> None:
        """开始安装前删掉旧记录：装到一半失败或被打断时依赖目录可能已经动过，之后输入改回原样也不能按旧记录跳过。"""
        if not self.dry_run:
            (dep_dir / DEPS_STAMP).unlink(missing_ok=True)

    def skip_link(self, kind: str, dep_dir: Path, **extra: Any) -> None:
        """依赖目录是软链：不经它安装、不往里写记录（经软链安装会把包装进链接目标，多半是源仓库），记一条 skipped。"""
        target = os.readlink(dep_dir)
        self.add(kind, "skipped",
                 f"worktree 里的 {dep_dir.name} 是软链（指向 {target}），没有经它安装：经软链安装会把包装进链接目标。"
                 f"要在 worktree 里独立安装，先删掉这个链接（rm {dep_dir}，只删链接本身）再跑 deps。",
                 link_target=target, **extra)


def deps_inputs(wt: Path, rels: tuple | list, command: list) -> dict:
    """一次安装的输入：安装命令和各输入文件（相对 worktree，不存在的不列）内容的 sha256。按内容算，不看 mtime。"""
    files = {rel: hashlib.sha256((wt / rel).read_bytes()).hexdigest()
             for rel in sorted(set(rels)) if (wt / rel).is_file()}
    return {"command": command, "files": files}


def read_deps_stamp(dep_dir: Path) -> Optional[dict]:
    try:
        stamp = json.loads((dep_dir / DEPS_STAMP).read_text())
    except (OSError, ValueError):
        return None
    return stamp if isinstance(stamp, dict) and isinstance(stamp.get("files"), dict) else None


def deps_changes(old: dict, new: dict) -> list:
    """old 是上次记的输入，new 是这次的：列出变了的（"<文件> 变了 / 新增 / 删了"、"安装命令变了"）。"""
    before, after = old["files"], new["files"]
    changes = [f"{rel} {'新增' if rel not in before else '删了' if rel not in after else '变了'}"
               for rel in sorted(set(before) | set(after)) if before.get(rel) != after.get(rel)]
    if old.get("command") != new["command"]:
        changes.append("安装命令变了")
    return changes


def deps_stale_reason(dep_dir: Path, inputs: dict) -> Optional[str]:
    """依赖目录和这次的输入对得上（上次 drover 装成功时记的输入和这次一样）返回 None，否则返回要装的原因。"""
    if not dep_dir.exists():
        return f"worktree 里原来没有 {dep_dir.name}"
    stamp = read_deps_stamp(dep_dir)
    if stamp is None:
        return f"已有的 {dep_dir.name} 没有 drover 的安装记录（旧版 drover 或 worker 自己装的），照常严格安装"
    changes = deps_changes(stamp, inputs)
    if not changes:
        return None
    shown = "、".join(changes[:6]) + (f" 等 {len(changes)} 项" if len(changes) > 6 else "")
    return f"依赖清单自上次安装以来变了：{shown}，所以重装"


def install_if_stale(plan: DepsPlan, kind: str, dep_dir: Path, inputs: dict, texts: dict, **extra: Any) -> None:
    """依赖目录和这次的输入对得上就跳过（不调用包管理器）；否则跑 inputs 里的安装命令，成功后在依赖目录里记下这次的输入，
    失败不记（下次照样重试）。texts 是四种结果的摘要：skipped / no_tool / installed / failed。"""
    reason = deps_stale_reason(dep_dir, inputs)
    if reason is None:
        plan.add(kind, "skipped", texts["skipped"], **extra)
        return
    cmd = inputs["command"]
    if not shutil.which(cmd[0]):
        plan.add(kind, "failed", texts["no_tool"], reason=reason, **extra)
        return
    plan.forget(dep_dir)
    ok, out, secs = plan.step(cmd)
    if not ok:
        plan.add(kind, "failed", f"{texts['failed']}错误尾部：{out[-200:]}", reason=reason,
                 command=shlex.join(cmd), error=out, seconds=secs, **extra)
        return
    plan.record(dep_dir, inputs)
    plan.add(kind, "installed", f"{texts['installed']}；{reason}。", reason=reason,
             command=shlex.join(cmd), seconds=secs, **extra)


def js_install_cmd(tool: str, wt: Path) -> list:
    """按根目录 lockfile 严格安装、不改写 lockfile 的命令。pnpm 带 confirm-modules-purge=false：已有的 node_modules 和当前设置
    不兼容（pnpm 升了版本、改了 hoist / node-linker 这类布局配置）时 pnpm 要清空重装，默认先问一句、只有 --force 或 CI 才不问
    （pnpm 10.12.4 dist/pnpm.cjs 的 purgeModulesDirsOfImporters、validateModules），不判断是不是终端：stdin 是终端就一直等，
    stdin 是 EOF 则退出码 0 却没重装（实测）。node_modules 是 worktree 自己的（软链已排除），清空重装就是对的结果，同 npm ci。"""
    return {
        "bun": ["bun", "install", "--cwd", str(wt), "--frozen-lockfile"],
        "pnpm": ["pnpm", "install", "--dir", str(wt), "--frozen-lockfile", "--config.confirm-modules-purge=false"],
        "yarn": ["yarn", "--cwd", str(wt), "install", "--frozen-lockfile"],
        "npm": ["npm", "ci", "--prefix", str(wt)],
    }[tool]


def js_manifests(wt: Path) -> list:
    """worktree 里的 package.json：根目录和各工作区包（已跟踪的加没被忽略的未跟踪文件，新加的工作区包也算），
    不含 node_modules 里装出来的。按 git 的忽略规则列，构建产物里的 package.json 不会让依赖白白重装。"""
    out = git_out(str(wt), "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--",
                  ":(glob)**/package.json", ":(exclude,glob)**/node_modules/**")
    return [rel for rel in out.split("\0") if rel]


def deps_js(plan: DepsPlan, wt: Path) -> None:
    if not (wt / "package.json").is_file():
        return
    lock = next(((name, tool) for name, tool in JS_LOCKFILES if (wt / name).is_file()), None)
    if lock is None:
        plan.add("js", "not_installed", "有 package.json 但没有 lockfile，未安装 JS 依赖；需要时请在 worktree 内自行安装。")
        return
    lockname, tool = lock
    node_modules = wt / "node_modules"
    if node_modules.is_symlink():
        plan.skip_link("js", node_modules, tool=tool)
        return
    inputs = deps_inputs(wt, [lockname, *JS_INSTALL_CONFIG, *js_manifests(wt)], js_install_cmd(tool, wt))
    install_if_stale(plan, "js", node_modules, inputs, {
        "skipped": f"依赖清单（{lockname}、各 package.json、安装配置）自上次安装以来没变，未重装 node_modules。",
        "no_tool": f"仓库用 {lockname}，但本机找不到 {tool}，未安装 JS 依赖；需要时请自行安装。",
        "installed": f"JS 依赖已按 {lockname} 装好（{tool}，worktree 内独立的 node_modules，不是源仓库的软链）",
        "failed": f"JS 依赖按 {lockname} 严格安装失败（lockfile 可能和 package.json 不一致），node_modules 可能不完整；"
                  "需要时请在 worktree 内自行安装。",
    }, tool=tool)


def deps_python(plan: DepsPlan, repo: Path, wt: Path) -> None:
    wt_venv = wt / ".venv"
    has_py_project = any((wt / f).is_file() for f in ("requirements.txt", "pyproject.toml", "uv.lock"))
    if not has_py_project and not (repo / ".venv").exists():
        return
    if wt_venv.is_symlink():
        plan.skip_link("python", wt_venv)
    elif (wt / "uv.lock").is_file():
        deps_uv_sync(plan, wt)
    elif wt_venv.exists() and not (wt_venv / VENV_CLONE_UNFINISHED).exists():
        deps_venv_topup(plan, wt)
    elif not shutil.which("uv"):
        plan.add("python", "failed", "找不到 uv，未建 Python 环境；需要时请自行创建 ./.venv。")
    else:
        deps_venv_clone(plan, repo, wt)


def deps_uv_sync(plan: DepsPlan, wt: Path) -> None:
    """有 uv.lock：按它同步 ./.venv（已有的 .venv 上照样跑，uv 自己让它和 uv.lock 一致）。"""
    inputs = deps_inputs(wt, UV_SYNC_INPUTS, ["uv", "sync", "--frozen", "--project", str(wt)])
    install_if_stale(plan, "python", wt / ".venv", inputs, {
        "skipped": "依赖清单（uv.lock、pyproject.toml）自上次同步以来没变，未重新同步 ./.venv。",
        "no_tool": "找不到 uv，未同步 Python 环境；需要时请自行处理 ./.venv。",
        "installed": "Python 环境已按 uv.lock 同步到 ./.venv（uv sync --frozen）",
        "failed": "uv sync --frozen 失败，./.venv 可能不完整；需要时请自行处理。",
    })


def venv_topup_inputs(wt: Path) -> dict:
    """复刻源仓库 venv 那条路里 worktree 自己的输入：requirements.txt 和补装它的命令。"""
    cmd = ["uv", "pip", "install", "--python", str(wt / ".venv" / "bin" / "python"), "-r", str(wt / "requirements.txt")]
    return deps_inputs(wt, ["requirements.txt"], cmd)


def deps_venv_topup(plan: DepsPlan, wt: Path) -> None:
    """没有 uv.lock、已有 .venv：requirements.txt 变了（或 .venv 不是 drover 建的）就在已有 .venv 上补装，不删掉重建。"""
    if not (wt / "requirements.txt").is_file():
        plan.add("python", "skipped", "worktree 里已有 .venv，没有 requirements.txt 要补装，未改动。")
        return
    install_if_stale(plan, "python", wt / ".venv", venv_topup_inputs(wt), {
        "skipped": "requirements.txt 自上次安装以来没变，未改动 ./.venv。",
        "no_tool": "找不到 uv，没能按 requirements.txt 补装 ./.venv；需要时请自行处理。",
        "installed": "已有 ./.venv，按 worktree 的 requirements.txt 补装（uv pip install -r，没有重建）",
        "failed": "按 worktree 的 requirements.txt 补装失败，./.venv 可能不完整；需要时请自行处理。",
    })


def deps_venv_clone(plan: DepsPlan, repo: Path, wt: Path) -> None:
    """worktree 里还没有 .venv（或者只有上次复刻到一半的，见 VENV_CLONE_UNFINISHED）、也没有 uv.lock：复刻源仓库的 .venv
    （同版本解释器 + 同一份包），再按 worktree 的 requirements.txt 补装，源 venv 里指向本仓库的可编辑安装改指向 worktree。
    都做完才记安装记录（requirements.txt 的指纹）；有可编辑安装没改指过来，这一项记 failed（不报"已建好"）。"""
    src_venv, wt_venv = repo / ".venv", wt / ".venv"
    reason = venv_clone_reason(plan, wt_venv)
    src_py = src_venv / "bin" / "python"
    if not src_py.exists():
        plan.add("python", "not_installed", "源仓库没有 .venv，worktree 里没有建 Python 环境；需要时请自行创建 ./.venv。")
        return
    version = venv_python_version(src_venv)
    if not version:
        plan.add("python", "failed", "读不出源仓库 .venv 的 Python 版本，未建 Python 环境。")
        return
    started = time.time()
    commands = []
    cmd = ["uv", "venv", "--seed", "--python", version, str(wt_venv)]
    commands.append(shlex.join(cmd))
    ok, out, _ = plan.step(cmd, timeout=600)
    if not ok:
        plan.add("python", "failed", f"uv venv 创建失败（Python {version}）。错误尾部：{out[-200:]}", error=out)
        return
    plan.mark_unfinished(wt_venv)
    editable = clone_src_packages(plan, src_py, wt_venv, commands)
    if editable is None:
        return
    topup = venv_topup_inputs(wt)
    has_req = (wt / "requirements.txt").is_file()
    if has_req:
        commands.append(shlex.join(topup["command"]))
        ok, out, _ = plan.step(topup["command"])
        if not ok:
            plan.add("python", "failed", f"按 worktree 的 requirements.txt 补装失败。错误尾部：{out[-200:]}", error=out,
                     commands=commands)
            return
    reinstalled = repoint_editables(plan, editable, repo, wt, commands)
    action, summary = venv_clone_outcome(version, has_req, reinstalled)
    if action == "installed":
        plan.record(wt_venv, topup)
    plan.add("python", action, summary, reason=reason, commands=commands, editable=reinstalled,
             seconds=round(time.time() - started, 1))


def venv_clone_reason(plan: DepsPlan, wt_venv: Path) -> str:
    """复刻之前：worktree 的 .venv 是上次复刻到一半的（带 VENV_CLONE_UNFINISHED）就删掉重来（dry-run 不删），返回这次复刻的原因。"""
    if not (wt_venv / VENV_CLONE_UNFINISHED).exists():
        return "worktree 里原来没有 .venv"
    if not plan.dry_run:
        shutil.rmtree(wt_venv)
    return "上次复刻源仓库 .venv 没做完（中途失败、被打断，或者可编辑安装没改指过来），删掉重新复刻"


def clone_src_packages(plan: DepsPlan, src_py: Path, wt_venv: Path, commands: list) -> Optional[list]:
    """把源仓库 venv 的包（uv pip freeze 去掉 -e 行）装进 worktree 的 .venv，返回源 venv 里的可编辑安装行；
    失败记一条 failed、返回 None。"""
    if plan.dry_run:
        commands.append(f"uv pip freeze --python {src_py} → 去掉 -e 行写入 .venv/base-freeze.txt → uv pip install -r")
        return []
    p = run(["uv", "pip", "freeze", "--python", str(src_py)], timeout=300, input_text=DEPS_NO_INPUT)
    if p.returncode != 0:
        plan.add("python", "failed", "读取源仓库 venv 的包列表失败。", error=tail(p.stderr))
        return None
    editable, pinned = [], []
    for line in p.stdout.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        (editable if line.startswith("-e ") else pinned).append(line)
    freeze = wt_venv / "base-freeze.txt"
    freeze.write_text("\n".join(pinned) + "\n")
    cmd = ["uv", "pip", "install", "--python", str(wt_venv / "bin" / "python"), "-r", str(freeze)]
    commands.append(shlex.join(cmd))
    ok, out, _ = plan.step(cmd)
    if not ok:
        plan.add("python", "failed", f"按源仓库 venv 的包列表安装失败。错误尾部：{out[-200:]}", error=out,
                 commands=commands)
        return None
    return editable


def repoint_editables(plan: DepsPlan, editable: list, repo: Path, wt: Path, commands: list) -> list:
    """源 venv 里以可编辑方式装的本仓库，换成 worktree 里的同一路径重装，避免 import 到源仓库的代码。
    失败的那一条带 error（错误尾部）。"""
    reinstalled = []
    for line in editable:
        target = line[3:].strip()
        target_path = target[len("file://"):] if target.startswith("file://") else target
        if target_path and is_under(target_path, repo):
            target_path = str(wt / Path(target_path).resolve().relative_to(repo.resolve()))
        cmd = ["uv", "pip", "install", "--python", str(wt / ".venv" / "bin" / "python"), "-e", target_path]
        commands.append(shlex.join(cmd))
        ok, out, _ = plan.step(cmd)
        entry = {"source": target, "installed_as": target_path, "ok": ok}
        if not ok:
            entry["error"] = out[-200:]
        reinstalled.append(entry)
    return reinstalled


def venv_clone_outcome(version: str, has_req: bool, reinstalled: list) -> tuple[str, str]:
    """复刻源 venv 的结果 (action, 摘要)。有可编辑安装没改指过来时是 failed，摘要写明是哪个、错误尾部：复刻时去掉了
    -e 行，worktree 的环境里就没有它。"""
    done = f"./.venv（Python {version}）复刻了源仓库 venv 的包" + ("，并按 requirements.txt 补装" if has_req else "")
    failed = [e for e in reinstalled if not e["ok"]]
    if failed:
        which = "；".join(f"{e['installed_as']}（错误尾部：{e['error']}）" for e in failed)
        return "failed", (f"Python 环境没装完：{done}，但 {len(failed)} 个可编辑安装没能改指向 worktree：{which}。"
                          "worktree 的环境里没有它，import 不到；需要时在 worktree 里自行 uv pip install -e <路径>"
                          "（再跑 deps 会删掉这个 ./.venv 重新复刻）。")
    repointed = f"；{len(reinstalled)} 个可编辑安装已改指向 worktree" if reinstalled else ""
    return "installed", f"Python 环境已建好：{done}{repointed}。"


def cmd_deps(a: argparse.Namespace) -> dict:
    repo = Path(git_out(a.repo, "rev-parse", "--show-toplevel"))
    wt = Path(a.wt).resolve()
    if not wt.is_dir():
        raise DroverError(f"worktree 目录不存在：{wt}")
    plan = DepsPlan(a.dry_run)
    deps_js(plan, wt)
    deps_python(plan, repo, wt)
    if any((wt / f).is_file() for f in JAVA_BUILD_FILES):
        plan.add("java", "skipped", "Java 依赖走全局缓存（~/.m2 / ~/.gradle），无需安装。")
    for subdir, locks in nested_lockfiles(wt).items():
        plan.add("nested", "not_installed",
                 f"子项目 {subdir}（{'、'.join(locks)}）的依赖没有安装；改到这个子项目时请在 worktree 内自行安装。",
                 path=subdir)
    if not plan.items:
        plan.add("none", "skipped", "未检测到需要安装的依赖。")
    lines = [item["summary"] for item in plan.items]
    result = {
        "ok": True,
        "dry_run": a.dry_run,
        "worktree_path": str(wt),
        "items": plan.items,
        "has_failure": any(i["action"] == "failed" for i in plan.items),
        "summary_for_prompt": "\n".join(f"- {line}" for line in lines),
    }
    if a.save:
        # brief 从这里取依赖摘要和类型，编排者不必再抄一遍。dry-run 也存（带 dry_run 标记，brief 会提示）。
        result["saved_to"] = save_json(a.save, result)
    return result


# ---------------------------------------------------------------- agent

def agent_status(name: str) -> Optional[str]:
    ok, res = herdr(["agent", "get", name], timeout=30)
    return find_key(res, "agent_status") if ok else None


def agent_screen(name: str, lines: int = 40) -> str:
    p = run(["herdr", "agent", "read", name, "--source", "visible", "--lines", str(lines)], timeout=30)
    return p.stdout if p.returncode == 0 else ""


def pane_output(pane: str, lines: int = 30) -> str:
    p = run(["herdr", "pane", "read", pane, "--source", "recent", "--lines", str(lines)], timeout=30)
    return p.stdout if p.returncode == 0 else ""


def cursor_option(screen: str) -> Optional[str]:
    current = None
    for line in screen.splitlines():
        m = CURSOR_LINE_RE.match(line)
        if m:
            current = m.group(1)
    return current


def select_affirmative(name: str) -> bool:
    """把选择菜单的光标移到肯定项（Yes / trust / allow）再回车。找不到肯定项就什么都不确认。"""
    for _ in range(5):
        option = cursor_option(agent_screen(name))
        if option is None:
            return False
        if AFFIRMATIVE_RE.search(option) and not NEGATIVE_START_RE.match(option):
            herdr(["agent", "send-keys", name, "enter"], timeout=30)
            return True
        herdr(["agent", "send-keys", name, "down"], timeout=30)
        time.sleep(0.5)
    return False


# codex 0.157 起交互模式默认连共享后台 server，本机配置下会直接报错退出，必须加 --no-daemon。
# check_for_update_on_startup=false：codex 有新版本时，新起和续上都先弹 "Update available" 升级框、停在那里等按键（herdr 重启后
# 按续命令拉回的 codex 没人按就一直卡着）。这个开关关掉启动时的版本检查（openai/codex codex-rs/tui/src/updates.rs 的
# get_upgrade_version / get_upgrade_version_for_popup 先看它）；实测 codex 0.170.0（有 0.171.0）带上它新起、续上都不弹，
# 不带都弹。worker、编排者、复审、续上和报给 herdr 的续命令都从这里来。
CODEX_BASE_ARGS = ["--no-daemon", "--no-alt-screen", "-c", "check_for_update_on_startup=false"]
# 编排者、worker、复审的模型和 effort，优先级：命令行的 --model / --effort > 任务默认（orch.json 的 model / effort，
# task_model）> config.json 的 claude_model / claude_effort / codex_effort（没有 1M 上下文档位的账号起不来 opus[1m]）
# > 下面的默认值。codex 没指定模型就不传，用 ~/.codex/config.toml 的默认。
CLAUDE_DEFAULT_MODEL = "opus[1m]"
CLAUDE_DEFAULT_EFFORT = "xhigh"
# codex 默认 effort 和 claude 对齐成 xhigh：不传时会继承 ~/.codex/config.toml 的 ultra
# （"Maximum reasoning with automatic task delegation"），实测 worker 改两个文件花了 19 分钟。
CODEX_DEFAULT_EFFORT = "xhigh"


def model_defaults(kind: str, model: Optional[str], effort: Optional[str]) -> tuple:
    """(model, effort) 补上 config / 内置默认之后的值；codex 没指定模型是 None（不传，用 ~/.codex/config.toml 的）。
    agent-start 把补完的值记进 worker 记录，续上时原样用（config 之后改了也不变）。"""
    if kind == "claude":
        return (model or CONFIG.get("claude_model") or CLAUDE_DEFAULT_MODEL,
                effort or CONFIG.get("claude_effort") or CLAUDE_DEFAULT_EFFORT)
    return model, effort or CONFIG.get("codex_effort") or CODEX_DEFAULT_EFFORT


def claude_model_args(model: Optional[str], effort: Optional[str]) -> list:
    model, effort = model_defaults("claude", model, effort)
    return ["--model", model, "--effort", effort]


def codex_model_args(model: Optional[str], effort: Optional[str]) -> list:
    # `codex --help`、`codex resume --help` 都有 "-m, --model <MODEL>  Model the agent should use"。
    model, effort = model_defaults("codex", model, effort)
    return [*(["-m", model] if model else []), "-c", f"model_reasoning_effort={effort}"]


def task_model(kind: str, model: Optional[str], effort: Optional[str], *slugs: Optional[str]) -> tuple:
    """命令行给的 (model, effort)，没给的取任务默认：slugs 里第一份宿主是 kind、记了 model 或 effort 的 orch.json
    （orch-start 时给的，或它继承来的）。宿主不同的不继承：模型 ID 只对一种宿主有效，两边的 effort 取值也不全一样。
    orch-start 传自己和上层的 slug：换编排者（resume）沿用前任记的，子编排者继承上层的。"""
    for slug in filter(None, slugs):
        meta = read_json_dict(STATE_HOME / slug / "orch.json")
        if meta.get("kind") == kind and (meta.get("model") or meta.get("effort")):
            return model or meta.get("model"), effort or meta.get("effort")
    return model, effort
# agent start 刚返回时 herdr 可能还把一个马上要退出的进程看成 idle，等几秒再确认一次。
STARTUP_SETTLE_SECONDS = 4
# 新 pane 的 shell 还没就绪时（agent_pane_busy）的重试次数和间隔。
PANE_READY_RETRIES = 5
PANE_READY_WAIT_SECONDS = 2
# Claude Code 处理完启动弹框（信任框）以后，herdr 马上报 done / idle（屏幕上有输入框了），会话其实还没开始：实测最后一个
# 弹框确认后 0.4～2 秒，SessionStart hook 才跑、herdr 的 agent_session 才有值（新起和 --resume 都一样，机器忙时更久）。
# 这中间发的话会留在输入框里、回车被吞掉，herdr 报 agent_prompt_stalled（释放后自动续上、紧接着发话，机器忙时实测两次
# 都这样）。所以 claude 起到 idle 以后再等会话开始才算就绪。没装 herdr 的 claude 状态 hook 时一直等不到，等满照常返回。
# codex 第一轮对话之后才报会话，不等。
SESSION_START_WAIT = 15
SESSION_START_POLL = 0.5


def wait_session_start(name: str) -> Optional[str]:
    """等 herdr 报出这个 agent 的会话 ID（见 SESSION_START_WAIT 上面的说明），最多 SESSION_START_WAIT 秒。返回会话 ID，
    没等到（或 agent 不在了）是 None。"""
    deadline = time.time() + SESSION_START_WAIT
    while True:
        ok, res = herdr(["agent", "get", name], timeout=30)
        session = ((res.get("agent") or {}).get("agent_session") or {}).get("value") if ok else None
        if session or not ok or time.time() >= deadline:
            return session
        time.sleep(SESSION_START_POLL)


def start_agent(name: str, kind: str, pane: str, agent_args: list, dry_run: bool) -> dict:
    check_agent_name(name)
    cmd = ["agent", "start", name, "--kind", kind, "--pane", pane, "--timeout", "120000", "--", *agent_args]
    if dry_run:
        return {"ok": True, "dry_run": True, "planned": ["herdr " + shlex.join(cmd)]}

    ok, listing = herdr(["agent", "list"], timeout=30)
    if ok and any(x.get("name") == name for x in listing.get("agents", [])):
        raise DroverError(f"agent 名 {name} 已被占用，换一个名字")

    # 刚分屏 / 新建 tab 的 pane，shell 可能还没初始化完，herdr 会报 agent_pane_busy（复审起不来过）。
    # 这种情况等一下再试；其它错误照旧直接失败。
    for attempt in range(PANE_READY_RETRIES + 1):
        ok, res = herdr(cmd, timeout=150)
        if ok or res.get("code") != "agent_pane_busy" or attempt == PANE_READY_RETRIES:
            break
        time.sleep(PANE_READY_WAIT_SECONDS)
    if not ok and res.get("code") != "agent_not_ready":
        raise DroverError("herdr agent start 失败", command="herdr " + shlex.join(cmd), error=res)
    started = (res.get("agent") or {}) if ok else {}  # herdr 报的工作目录、会话 ID（会话开始了才有，见 SESSION_START_WAIT）
    seen = {k: v for k, v in (("cwd", started.get("cwd")),
                              ("session_id", (started.get("agent_session") or {}).get("value"))) if v}

    handled: list = []
    status: Optional[str] = None
    for _ in range(6):
        time.sleep(STARTUP_SETTLE_SECONDS if not handled else 1)
        status = agent_status(name)
        if status is None:
            return {"ok": False, "name": name, "pane_id": pane, "status": "gone",
                    "startup_dialogs_handled": handled,
                    "pane_output": tail(pane_output(pane), 3000),
                    "command": "herdr " + shlex.join(cmd),
                    "error": "agent 启动后又退出了，看 pane_output 里的报错；修正参数后可在同一个 pane 重新 agent-start"}
        if status in ("idle", "done"):
            break
        if status != "blocked":
            # working / unknown：启动期的瞬时状态（比如接受信任后加载配置），等它稳定再看。
            herdr(["agent", "wait", name, "--timeout", "60000"], timeout=90)
            continue
        screen = agent_screen(name)
        match = next(((key, label) for pattern, key, label in STARTUP_DIALOGS if pattern.search(screen)), None)
        if match is None:
            return {"ok": False, "name": name, "pane_id": pane, "status": status,
                    "startup_dialogs_handled": handled, "screen": tail(screen, 3000),
                    "error": "agent 卡在不认识的界面上，按 dispatch.md 第 7 节决策表处理"}
        action, label = match
        if action == "select_yes":
            if not select_affirmative(name):
                return {"ok": False, "name": name, "pane_id": pane, "status": status,
                        "startup_dialogs_handled": handled, "screen": tail(agent_screen(name), 3000),
                        "error": "识别到信任弹窗，但没找到可选的肯定项，没有按任何确认键；看 screen 手动处理"}
        else:
            herdr(["agent", "send-keys", name, action], timeout=30)
        herdr(["agent", "wait", name, "--timeout", "60000"], timeout=90)
        handled.append(label)
    else:
        return {"ok": False, "name": name, "pane_id": pane, "status": status,
                "startup_dialogs_handled": handled, "screen": tail(agent_screen(name), 3000),
                "error": "启动后状态一直没稳定到 idle（连续处理弹窗或等待后仍不就绪），看 screen 后按第 7 节决策表处理"}
    if kind == "claude":
        session = wait_session_start(name)
        if session:
            seen["session_id"] = session
    return {"ok": status in ("idle", "done"), "name": name, "kind": kind, "pane_id": pane, "status": status,
            "startup_dialogs_handled": handled, **seen,
            "command": "herdr " + shlex.join(cmd)}


def split_pane(pane: str, wt: str) -> str:
    """在 pane 右侧分屏，新 pane 的工作目录是 wt；返回新 pane 的 ID。"""
    ok, res = herdr(["pane", "split", pane, "--direction", "right", "--cwd", wt, "--no-focus"])
    if not ok:
        raise DroverError("herdr pane split 失败", error=res)
    pane_id = (res.get("pane") or {}).get("pane_id")
    if not pane_id:
        raise DroverError("herdr pane split 返回里缺 pane.pane_id", result=res)
    return pane_id


# 没写 --kind 时宿主跟主会话走（主会话是 Codex 时，派出的编排者和 worker 仍是 Claude Code）。
# 认调用方用 herdr：HERDR_PANE_ID 那个 pane 里 agent 的类型（agent get 的 agent 字段，和 agent start --kind 同一套取值）。
# 不看 CLAUDECODE / CODEX_* 环境变量：子进程会继承祖先的，实测从 Claude Code 里起的 codex 两种都有，认不出最近一层。
HOST_KINDS = ("claude", "codex")
NO_CALLER_KIND = "认不出调用方的宿主（不在 Herdr 的 pane 里，或这个 pane 里没有 claude / codex agent）"


def agent_kind(target: str) -> Optional[str]:
    """herdr 里这个 agent（pane ID 或 agent 名）的宿主；查不到、类型不是 claude / codex 时 None。"""
    kind = (pane_agent(target) or {}).get("agent")
    return kind if kind in HOST_KINDS else None


def caller_kind() -> Optional[str]:
    """调用这条命令的 agent 的宿主：主会话跑 orch-start、编排者跑 agent-start 时就是它们自己。"""
    pane = os.environ.get("HERDR_PANE_ID")
    return agent_kind(pane) if pane else None


def task_default_kind(slug: str) -> tuple[Optional[str], str]:
    """任务里没指定宿主时 worker 用哪个，返回 (kind, 来由)：orch.json 的 default_kind（orch-start 记的主会话宿主）是 "orch"；
    没有 orch.json（主会话直接编排）或没有这个字段时是调用方的宿主，"caller"（认不出时 kind 为 None）。"""
    kind = read_json_dict(STATE_HOME / slug / "orch.json").get("default_kind")
    return (kind, "orch") if kind else (caller_kind(), "caller")


def worker_args(kind: str, slug: str, model: Optional[str], effort: Optional[str], add_dirs: list) -> list:
    """agent-start 起 worker 交给宿主的参数（不含续会话的那几个）：~/.drover/<slug> 和每个 add_dirs 加为可访问目录。
    agent-start 和续上（resume_worker）共用这一份，续上时按 worker 记录里的值原样重放。"""
    dirs = [str(STATE_HOME / slug), *add_dirs]
    if kind == "claude":
        args = [*claude_model_args(model, effort), "--permission-mode", "acceptEdits", "--name", f"worker-{slug}"]
    else:
        # codex worker 跑在 workspace-write 沙箱里，写不了 heavy 的调度目录就不排队直接跑、调度器也看不见它的负载。
        # --add-dir 让目录可写：`codex --help` 写明 "Additional directories that should be writable alongside the
        # primary workspace"，用 codex exec 实测过加进去的目录能建文件、别的目录被拒。
        # claude worker 默认不在沙箱里，不加（加了还会多弹一次 "Adding a new directory" 信任框）。
        dirs.append(str(HEAVY_DIR))
        args = ["-a", "on-request", "-s", "workspace-write", *CODEX_BASE_ARGS]
    for d in dirs:
        args += ["--add-dir", d]
    return args if kind == "claude" else args + codex_model_args(model, effort)


def resume_args(kind: str, args: list, session_id: Optional[str]) -> list:
    """在同一个 pane 接着上次的会话（选项照旧）：有会话 ID 按 ID 续（claude --resume <id>，codex resume <id>；两种都实测过
    带原来的选项续上、上下文完整，--name、--add-dir、沙箱参数照旧生效）；没有时 claude --continue、codex resume --last，
    都是按工作目录取最近一次，同一个目录里有过两个会话时会续到别人的——只有 agent-start --resume 找不到记下的会话 ID 时
    才走这条（老用法）；释放 → 续上那条路上一定有会话 ID（没有的不释放，见 release_checks）。"""
    if kind == "codex":
        return ["resume", session_id or "--last", *args]
    return [*args, *(["--resume", session_id] if session_id else ["--continue"])]


# ---------------------------------------------------------------- 给 herdr 报续命令（herdr 重启后按原参数拉回）
# herdr 重启后会把 pane 里的 claude / codex 续上，但它自己拼的续命令只有会话 ID（herdr 0.9.5 src/agent_resume.rs:204-213：
# claude --resume <id>、codex resume <id>），agent start -- <参数> 的参数只敲进 shell、不存（src/app/agents.rs:197-201）：
# 拉回来的模型、effort 回到本机默认，--add-dir、codex 的沙箱都没了（11-22 那次重启实测）。herdr 0.9.2 起启动方可以报一条完整
# 续命令（pane report-agent-session … -- <argv>，存进快照 src/persist/snapshot.rs:374-389，恢复时优先用 src/persist/restore.rs:824-830），
# drover 起的编排者、子编排者、worker 就由 drover 报（report_resume）：
# - 报的是"起它用的参数 + 续当前会话"（resume_args 同一个形状），source / agent 用 herdr 官方集成的 herdr:<kind> / <kind>。herdr 把
#   续命令绑在报的那个会话上：报的会话不是它当前的会话时静默丢掉、照样回成功（src/app/api/panes.rs:1632-1657、1678-1680）。所以
#   会话 ID 一律取 herdr 当时报的 agent_session，不取记录里的：报旧 ID 会被丢掉，drover 却记成"报过"，就再也补不上了。herdr 还没
#   有会话 ID 时不报（codex 发出第一句话、第一轮一开始 herdr 才有，实测；释放后续上的 codex 也是，进程退出时 herdr 清了会话），
#   交给后台维护补报。
# - 会话变了要重报：herdr 不跟着改报过的续命令（官方 hook 只在 SessionStart 报会话、不带续命令），claude /clear 之后不重报的话
#   重启会续回 /clear 之前的旧会话（实测）。后台维护（upkeep）每分钟核对一次（sync_resume_reports），报上的会话 ID 记在 worker
#   记录 / orch.json 的 resume_reported_session 里。
# - 进程退出 herdr 就清掉续命令（src/terminal/state.rs:561-569）：释放时删掉记录里的 resume_reported_session，续上以后重报。
# - seq 用纳秒时间戳，和官方 hook 一样（time.time_ns()）：herdr 按 source 只收比上次大的，不够新的静默丢掉；drover 的报告也会
#   抬高这个序号（src/terminal/state.rs:1591、1742-1750），比纳秒大的值会挡住之后 hook 的报告。
# - 报失败（herdr 报错、invalid_resume_argv、resume_not_accepted、超时）只写进返回，不影响启动、发话、watch、看板。
# 管不到的：herdr 的 API 读不到存着的续命令，drover 只能比"上次报的会话 ID"——用户在 pane 里自己退出又手动续同一个会话时
# （herdr 清了续命令、会话 ID 没变）看不出来。herdr 按续命令拉回的 claude 会先弹一次 "Adding a new directory" 信任框（问
# --add-dir 的状态目录；这个框的信任只管一个进程，续同一个会话也要重新批，实测），drover 起、续的时候 start_agent 自动批，herdr
# 拉回的由后台维护顺带批（approve_trust_dialogs）。复审不报：一次性的只读 codex，没有记录
# 可以按它重建参数（后台维护补不了）；herdr 重启打断了它唯一的一轮，拉回来的是裸续（沙箱回到 config 默认）、停在 idle。
RESUME_REPORT_KEY = "resume_reported_session"
NO_SESSION_REASON = ("herdr 还没报它的会话 ID（codex 发出第一句话才有；起来又退出了的也没有）：后台维护（drover upkeep）"
                     "拿到以后补报")


def report_resume(pane: str, kind: str, args: list, session: Optional[str]) -> dict:
    """把续命令（[kind, *resume_args(kind, args, session)]）报给 herdr，见本节开头。args 是起它用的参数（不含续会话的），session
    是 herdr 当时报的会话 ID。返回 {reported: true, session_id, argv} 或 {reported: false, reason（, argv）}，不抛异常。"""
    if not session:
        return {"reported": False, "reason": NO_SESSION_REASON}
    argv = [kind, *resume_args(kind, args, session)]
    cmd = ["pane", "report-agent-session", pane, "--source", f"herdr:{kind}", "--agent", kind,
           "--agent-session-id", session, "--seq", str(time.time_ns()), "--", *argv]
    try:
        ok, res = herdr(cmd, timeout=30)
    except DroverError as exc:  # 超时、找不到 herdr
        ok, res = False, {"code": "failed", "message": exc.message}
    if not ok:
        return {"reported": False, "argv": argv,
                "reason": f"herdr pane report-agent-session 失败（{res.get('code')}：{res.get('message')}）"}
    return {"reported": True, "session_id": session, "argv": argv}


def agent_start_kind(a: argparse.Namespace, previous: Optional[dict]) -> tuple[str, str]:
    """agent-start 的宿主和来由：--kind（explicit）> 续的那个 worker 记录里的（record，只在 --resume 时）> 任务默认
    （task_default_kind）。都没有报错。"""
    if a.kind:
        return a.kind, "explicit"
    if previous and previous.get("kind") in HOST_KINDS:
        return previous["kind"], "record"
    kind, source = task_default_kind(a.slug)
    if kind is None:
        raise DroverError(f"{STATE_HOME / a.slug / 'orch.json'} 里没有 default_kind，又{NO_CALLER_KIND}：加 --kind claude|codex",
                          caller_pane=os.environ.get("HERDR_PANE_ID"))
    return kind, source


@contextlib.contextmanager
def start_lock(name: str, dry_run: bool):
    """agent-start 读记录、起 agent、写记录期间拿着这个名字的锁（agent_lock）：后台维护批信任框、同步续命令时跳过它，不和
    start_agent 抢着按键（--resume 在原 pane 续上时，旧记录的 pane 和宿主都对得上，见 approve_trust_dialogs）。正在给它发话、
    释放、续上，等了 AGENT_LOCK_WAIT 秒还拿不到就报错。dry-run 不拿。"""
    with contextlib.nullcontext(True) if dry_run else agent_lock(name, AGENT_LOCK_WAIT) as got:
        if got is False:
            raise DroverError(f"{name} 正在被发话、释放或续上（等了 {AGENT_LOCK_WAIT} 秒锁还没放开），稍后再试")
        yield


def cmd_agent_start(a: argparse.Namespace) -> dict:
    if bool(a.pane) == bool(a.split_from):
        raise DroverError("--pane 和 --split-from 必须且只能给一个")
    if a.split_from and not a.wt:
        raise DroverError("--split-from 要配合 --wt（新 pane 的工作目录）")
    check_slug(a.slug)
    check_agent_name(a.name)
    with start_lock(a.name, a.dry_run):
        previous = find_agent_record(a.name, a.slug) if a.resume else None  # --resume 续的是这个任务里记下的那个 worker
        kind, kind_source = agent_start_kind(a, previous)
        if not a.dry_run:
            (STATE_HOME / a.slug).mkdir(parents=True, exist_ok=True)
            if kind == "codex":
                HEAVY_DIR.mkdir(parents=True, exist_ok=True)
            check_name_free(a.name, a.slug)
        model, effort = model_defaults(kind, *task_model(kind, a.model, a.effort, a.slug))
        base = worker_args(kind, a.slug, model, effort, a.add_dir)
        # agent 意外退出后在同一个 pane 接着上次的会话：按 worker 记录里的会话 ID 续，没记下的按工作目录取最近一次。
        args = resume_args(kind, base, (previous or {}).get("session_id")) if a.resume else base
        if a.split_from:
            # 同一个 worktree 换 agent（换 kind、缩小范围重开）：在旧 agent 旁边新开 pane，旧 pane 由编排者确认报告存档后关闭。
            if a.dry_run:
                planned = start_agent(a.name, kind, "<新 pane>", args, True)["planned"]
                result = {"ok": True, "dry_run": True,
                          "planned": [f"herdr pane split {a.split_from} --direction right --cwd {a.wt} --no-focus", *planned]}
            else:
                pane = split_pane(a.split_from, str(Path(a.wt).expanduser().resolve()))
                result = start_agent(a.name, kind, pane, args, False)
                result["split_from"] = a.split_from
                result["pane_id"] = pane
                result.setdefault("cwd", str(Path(a.wt).expanduser().resolve()))
        else:
            result = start_agent(a.name, kind, a.pane, args, a.dry_run)
        result.update(kind=kind, kind_source=kind_source)
        if not a.dry_run and result.get("status") != "gone":
            # 起来了就报续命令、记（卡在不认识的启动弹窗上、ok 是 false 的也记：编排者处理完它照常干活，没有记录就永远不会被释放）。
            result["herdr_resume"] = report_resume(result["pane_id"], kind, base, result.get("session_id"))
            result["record"] = write_worker_record(a.name, a.slug, kind, (model, effort), a.add_dir, result, previous)
        return result


# ---------------------------------------------------------------- 释放空闲的 worker、发话时续上（release）
# worker 做完以后进程一直不退（以前的规矩是留到清理 / 收尾，"方便复用它的上下文"）：11-22 一个任务积了 64 个 herdr agent、
# 53 个 done，24G 内存用满、持续换页。上下文在磁盘上的会话里，进程退了按会话 ID 照样续得上（claude --resume <id>、
# codex resume <id> 带原来的选项都实测过：答得出退出前告诉它的口令），所以进程的寿命跟着"有没有活"走：
# - 释放（drover release，或闲置满 worker_idle_release_minutes 分钟后台自动放）：给 pane 的前台进程组发 SIGTERM，pane 留着回到
#   shell，workspace、worktree、分支都不动；会话 ID 记进 worker 记录。MCP 子进程跟着退（实测）：claude 的都在这个组里；
#   codex 的各在自己的进程组里（前台进程组里只有 codex 一个进程），codex 一退它们 3 秒内也都退了。
# - 续上：drover prompt / brief --send 发给已经释放的 worker 时，先在原 pane 按记录里的参数和会话 ID 起回来再发（deliver）。
#   正在跑的旧编排者不知道有释放这回事，照旧 prompt / brief --send 就会续上；watch 报 released，不报 gone。
# - 只碰 agent-start 起的 worker：它写 worker 记录 <slug>/<name>.agent.json（WORKER_RECORD），编排者（orch-start）、复审（review）、
#   主会话、用户自己开的 agent、这版之前起的 worker 都没有，自然不碰，不用名单。
# - 没有会话 ID 的不放、没经 drover 发过话的不放（release_checks）：前一种放了只能按工作目录取最近一次会话续，同一个 worktree
#   里有过两个会话时会续到别人的；后一种会话里没有内容，按 ID 续不上（claude 实测报 No conversation found 退出）。
#   会话 ID 是 herdr 的状态 hook 报的（herdr integration install claude / codex 装的 SessionStart hook 调
#   pane.report_agent_session，agent get / list 里的 agent_session，source 是 herdr:claude 这类；install.py 会装）。
# - 释放和发话对同一个 agent 拿同一把锁（agent_lock）：刚判定空闲、正要退出时进来的 prompt 等它放完再续上；发话拿着锁一直到
#   agent 开工，之后的释放看到 working 就不放。
# - 记录先改成 released 再发信号（stop_worker）：进程一退 herdr 就清掉名字，watch 这时读到的记录已经是 released，不会在
#   "进程没了、记录还没写"的空当里报 gone 把编排者叫醒去重启。
# 不用 /exit 退：它要往输入框里打字，输入框里有半截字时会拼成一条 prompt 发出去；SIGTERM 两种宿主一样、不看界面
# （claude 收到后正常退出、打印 resume 提示；codex 被信号结束，会话照样续得上，都实测过）。
WORKER_RECORD = "{name}.agent.json"
AGENT_LOCK_WAIT = 120     # 秒：发话等释放 / 续上做完（释放最多十几秒，续上最多等 agent 启动的 150 秒的一部分）
RELEASE_LOCK_WAIT = 30    # 秒：手动 release 等正在进行的发话
RELEASE_TERM_SECONDS = 10  # SIGTERM 之后最多等这么久，还在就 SIGKILL 整个进程组
RELEASE_KILL_SECONDS = 5
RELEASE_NAME_SECONDS = 5  # 进程没了以后等 herdr 清掉名字（实测立刻就清）
# 释放前按屏幕修正后的状态不是 done / idle 时，为什么不放。
RELEASE_REFUSALS = {
    "working": "在干活",
    "blocked": "卡在确认框上，要先处理",
    "api-error": "停在接口错误上（这一轮被打断了，要先让它接着做）",
    "unknown": "herdr 认不出它的状态",
}
RESUME_HOW = "给它发话（drover prompt / brief --send）时自动在原 pane 按会话 ID 续上"


def agent_record_path(slug: str, name: str) -> Path:
    return STATE_HOME / slug / WORKER_RECORD.format(name=name)


def worker_records(name: str = "*", slug: str = "*") -> dict:
    """名字 → 它最新的 worker 记录（带上 "path"）。同名在几个任务里都有时取修改时间最新的（同 latest_orch_metas：名字会被
    后来的任务复用）。不给名字是全部（闲置扫描一次 glob 拿完），给了 slug 只看那个任务。"""
    best: dict = {}
    for path in STATE_HOME.glob(f"{slug}/" + WORKER_RECORD.format(name=name)):
        rec = read_json_dict(path)
        with contextlib.suppress(OSError):
            mtime = path.stat().st_mtime
            if rec.get("name") and (rec["name"] not in best or mtime > best[rec["name"]][0]):
                best[rec["name"]] = (mtime, {**rec, "path": str(path)})
    return {n: rec for n, (_, rec) in best.items()}


def find_agent_record(name: str, slug: Optional[str] = None) -> Optional[dict]:
    """这个名字最新的 worker 记录，没有返回 None；给了 slug 只看那个任务。"""
    return worker_records(name, slug or "*").get(name)


def update_agent_record(rec: dict, **changes: Any) -> dict:
    """改 worker 记录（调用方拿着这个 agent 的锁）；值是 None 的字段删掉。返回改完的记录。"""
    new = {k: v for k, v in {**rec, **changes}.items() if k != "path" and v is not None}
    write_json_atomic(Path(rec["path"]), new)
    return {**new, "path": rec["path"]}


def write_worker_record(name: str, slug: str, kind: str, model_effort: tuple, add_dirs: list, result: dict,
                        previous: Optional[dict]) -> str:
    """agent-start 起好以后写 <slug>/<name>.agent.json：续上时按它原样重放参数（worker_args），释放只认有它的 agent。
    字段：name、slug、kind、model / effort（补完默认值的，codex 没指定模型时没有 model）、add_dirs（--add-dir 给的）、pane_id、
    cwd（herdr 报的工作目录，--split-from 时是 --wt）、started_at、session_id（claude 等到会话开始就有；codex 发出第一句话之后才有，
    释放时再取）、state（running / released）、resume_reported_session（报给 herdr 的续命令用的会话 ID，herdr 收下了才有；见
    report_resume 上面的说明：后台维护拿它和 herdr 现在的会话比，不一样就重报、改它；释放时删掉，续上报了再写）。之后加的：
    prompted_at（最近一次经 drover 给它发话的时间，deliver 记；没发过话的不释放）、released_at、release_reason（manual / idle）、
    freed_kb（释放时）、resumed_at（续上时）。
    previous 是 --resume 续的那份旧记录：herdr 这次没报会话 ID 时沿用它的，发过话的也沿用（同一个会话）。"""
    path = agent_record_path(slug, name)
    old = previous or {}
    write_json_atomic(path, {k: v for k, v in {
        "name": name, "slug": slug, "kind": kind, "model": model_effort[0], "effort": model_effort[1],
        "add_dirs": list(add_dirs), "pane_id": result["pane_id"], "cwd": result.get("cwd"), "started_at": time.time(),
        "session_id": result.get("session_id") or old.get("session_id"), "prompted_at": old.get("prompted_at"),
        "state": "running", RESUME_REPORT_KEY: result.get("herdr_resume", {}).get("session_id")}.items()
        if v is not None})
    return str(path)


def pane_processes(pane: str) -> Optional[dict]:
    """herdr pane process-info 的 process_info（实测 herdr 的输出）：foreground_process_group_id、shell_pid、
    foreground_processes（每个有 pid、argv0、name，多数还有 argv、cmdline、cwd）。
    pane 不在了返回 None——只认 herdr 明确报的 pane_not_found。别的失败（超时、herdr 一时连不上、旧版 herdr 没有这个命令、
    返回里没有 process_info）是"不知道"，抛 DroverError：当成不在的话，续上会误报 pane 没了，同名检查会误放行。"""
    try:
        ok, res = herdr(["pane", "process-info", "--pane", pane], timeout=30)
    except DroverError as exc:  # 超时、找不到 herdr
        ok, res = False, {"code": "failed", "message": exc.message}
    if ok and isinstance(res.get("process_info"), dict):
        return res["process_info"]
    if not ok and res.get("code") == "pane_not_found":
        return None
    why = f"{res.get('code')}：{res.get('message')}" if not ok else "返回里没有 process_info"
    raise DroverError(f"herdr pane process-info --pane {pane} 没拿到结果（{why}）：不知道这个 pane 现在的情况，稍后重试；"
                      "一直这样的话看 herdr 是不是太旧（herdr pane 的帮助里要有 process-info）")


def at_shell(info: dict) -> bool:
    """pane 回到了 shell：前台进程组就是 shell 自己。"""
    return isinstance(info.get("shell_pid"), int) and info.get("foreground_process_group_id") == info["shell_pid"]


def check_name_free(name: str, slug: str) -> None:
    """释放以后名字在 herdr 里空出来了，别的任务要是用同一个名字起 agent，旧编排者再 prompt 它就会发给新的那个。所以最新的
    worker 记录是别的任务释放了的、而且它的 pane 还在（还能在那里续上）时不让用；pane 已经不在了（续不了）不拦。
    pane 在不在查不到（pane_processes 抛错）时也不让用：报错里写的是 herdr 调用失败，稍后重试。"""
    rec = find_agent_record(name)
    if (rec and rec.get("slug") != slug and rec.get("state") == "released"
            and pane_processes(str(rec.get("pane_id"))) is not None):
        raise DroverError(f"agent 名 {name} 是任务 {rec.get('slug')} 释放了的 worker（pane {rec.get('pane_id')} 还在，给它发话"
                          "会在那里续上），换一个名字", record=rec["path"])


@contextlib.contextmanager
def agent_lock(name: str, wait: Optional[float]):
    """释放和发话对同一个 agent 互斥（见本节开头）。yield 同 flock_file：True 拿到、False 没等到、None 锁文件建不了。"""
    with flock_file(STATE_HOME / "locks" / f"agent-{name}.lock", wait) as got:
        yield got


def process_names(proc: dict) -> set:
    """这个进程可能叫什么：argv0、name、argv 里第一个不是选项的参数（解释器跑脚本时的脚本路径），都只取文件名。"""
    argv = [str(x) for x in proc.get("argv") or []]
    script = next((x for x in argv[1:] if not x.startswith("-")), None)
    return {Path(str(x)).name for x in (proc.get("argv0"), proc.get("name"), *argv[:1], script) if x}


def host_group(info: dict, kind: str) -> Optional[int]:
    """pane 的前台进程组是 kind 这个宿主时返回组号，认不出返回 None（不发信号）。
    主要依据在调用方：herdr 认定这个 pane 里是这个宿主的 agent、状态 done / idle（release_checks）。这里只防 herdr 的认定
    过时了（agent 刚退、pane 里已经在跑别的东西）时杀错：组号不是 shell 自己的，组里至少有一个进程叫 kind（process_names）。
    不要求组长的 argv0 就是 claude / codex，不同装法组长不一样（herdr pane process-info 的实测输出和各装法的启动方式）：
    - 原生安装：组长 argv0 是 claude（name 是版本号，如 2.1.330）；
    - npm 装的：入口是 #!/usr/bin/env node 的脚本，组长是 node <…/bin/claude> 或 node <…/bin/codex>，脚本名对得上；
    - codex 的 npm 包再起原生二进制：子进程的 argv0 是 …/codex，和 node 在同一个组里。
    都认不出时调用方拒绝，原因里列出看到的进程（seen_processes）。"""
    pgid = info.get("foreground_process_group_id")
    if not isinstance(pgid, int) or at_shell(info):
        return None
    return pgid if any(kind in process_names(p) for p in info.get("foreground_processes") or []) else None


def seen_processes(info: dict) -> str:
    """拒绝原因里给人看的：前台进程组里有哪些进程（pid 和命令行，命令行太长截断）。"""
    procs = info.get("foreground_processes") or []
    return "；".join(f"pid {p.get('pid')} {str(p.get('cmdline') or p.get('argv0') or p.get('name'))[:120]}"
                     for p in procs) or "没有进程"


def group_alive(pgid: int) -> bool:
    """进程组里还有进程。EPERM 也算还在：macOS 上组里只剩刚被杀、还没被回收的进程时 killpg(pgid, 0) 报 EPERM（自测里实测），
    回收完才报 ESRCH。"""
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def stop_group(pgid: int) -> str:
    """SIGTERM 整个进程组，等 RELEASE_TERM_SECONDS 秒；还在就 SIGKILL，再等 RELEASE_KILL_SECONDS 秒。返回用了哪个信号；
    没权限发信号（drover 自己跑在沙箱里）、两个信号之后还在都抛 DroverError。"""
    for sig, seconds in ((signal.SIGTERM, RELEASE_TERM_SECONDS), (signal.SIGKILL, RELEASE_KILL_SECONDS)):
        try:
            os.killpg(pgid, sig)
        except ProcessLookupError:
            pass
        except PermissionError as exc:
            raise DroverError(f"没有权限给进程组 {pgid} 发信号（{exc}）：drover 跑在沙箱里时发不了，没有释放")
        deadline = time.time() + seconds
        while group_alive(pgid) and time.time() < deadline:
            time.sleep(0.2)
        if not group_alive(pgid):
            return sig.name
    raise DroverError(f"进程组 {pgid} SIGTERM、SIGKILL 之后还在，没有释放")


def group_rss_kb(pgid: int) -> Optional[int]:
    """组长和它的子孙（MCP 子进程，含 codex 那种不在这个进程组里的）的 RSS 合计（KB）；ps 用不了时 None。"""
    table = ps_table()
    return sum(table[p][1] for p in tree_pids(pgid, table) if p in table) if table else None


def release_status(name: str, agent: dict, kind: str) -> str:
    """释放前的状态：herdr 报的，done / idle 时按屏幕修正（确认框 → blocked、接口错误 → api-error、后台命令 →
    waiting-background(N)，同 watch 的 screen_override）。"""
    status = agent.get("agent_status") or "unknown"
    if status in ("done", "idle"):
        status = screen_override(status, screen_or_empty(name), kind) or status
    return status


def refusal(name: str, status: str) -> str:
    why = (RELEASE_REFUSALS.get(status) or
           ("挂着后台命令或 Monitor，会自己接着干" if status.startswith("waiting-background") else f"状态是 {status}"))
    return f"{name} {why}，没有释放（只在 done / idle 时放）"


def worker_agent(name: str, rec: dict) -> Optional[dict]:
    """herdr 里的这个 worker（agent get 的 agent）；已经释放了（herdr 明确说没有这个名字、记录是 released）返回 None。
    别的都抛 DroverError：herdr 调用失败、名字没了而记录不是 released（它自己退出的）、名字现在指的不是记录的那个 pane / 宿主。"""
    ok, res = herdr(["agent", "get", name], timeout=30)
    if not ok and res.get("code") != "agent_not_found":
        raise DroverError(f"herdr agent get {name} 失败（{res.get('code')}：{res.get('message')}），没有释放，稍后重试")
    if not ok and rec.get("state") == "released":
        return None
    if not ok:
        raise DroverError(f"herdr 里没有 agent {name}：它已经退出了（不是 drover 释放的），没有可放的进程")
    agent = res.get("agent") or {}
    if (agent.get("pane_id"), agent.get("agent")) != (rec.get("pane_id"), rec.get("kind")):
        raise DroverError(f"{name} 现在是 pane {agent.get('pane_id')} 里的 {agent.get('agent')}，不是 agent-start 记下的那个 "
                          f"worker（pane {rec.get('pane_id')}、{rec.get('kind')}），不碰")
    return agent


def release_checks(name: str, rec: dict, agent: dict) -> tuple:
    """放之前的核对，都过了返回 (会话 ID, 状态, 前台进程组号)；不过抛 DroverError（原因）：
    - 有会话 ID（herdr 这时报的优先：续上以后宿主可能换了会话；没有再用记录里的）。两边都没有不放，见本节开头；
    - 按屏幕修正后是 done / idle（release_status）；
    - 经 drover 给它发过话（记录里有 prompted_at，deliver 记的）：会话里有内容才续得上；
    - pane 的前台进程组认得出是这个宿主（host_group），认不出时原因里列出看到的进程。"""
    kind, pane = rec.get("kind"), str(rec.get("pane_id"))
    session = (agent.get("agent_session") or {}).get("value") or rec.get("session_id")
    if not session:
        raise DroverError(f"{name} 没有会话 ID（herdr 没报 agent_session，agent-start 也没记下），没有释放：放了只能按工作目录取"
                          f"最近一次会话续，会续到别的会话上。会话 ID 是 herdr 的状态 hook 报的：herdr integration status 里 "
                          f"{kind} 应该是 current，不是就跑 herdr integration install {kind}（或重跑 install.py），之后新起的 "
                          "agent 才有；codex 要跑完第一轮才报")
    status = release_status(name, agent, kind)
    if status not in ("done", "idle"):
        raise DroverError(refusal(name, status), status=status)
    if not rec.get("prompted_at"):
        raise DroverError(f"还没经 drover 给 {name} 发过话（prompt / brief --send），没有释放：没对过话的会话按 ID 续不上"
                          "（claude 实测报 No conversation found），放了它的 pane 里就起不回来了")
    info = pane_processes(pane)
    if info is None:
        raise DroverError(f"herdr 说 {name} 在 pane {pane}，又说这个 pane 不存在，没有释放")
    pgid = host_group(info, kind)
    if pgid is None:
        raise DroverError(f"pane {pane} 的前台进程组里认不出 {kind}，没有释放（不给认不出的进程发信号）。看到的进程："
                          f"{seen_processes(info)}", foreground_processes=info.get("foreground_processes"))
    return session, status, pgid


def stop_worker(name: str, rec: dict, agent: dict, session: str, pgid: int, reason: str) -> dict:
    """退掉进程、记成 released，返回里写用了哪个信号、放掉多少内存、要注意的。记录先写再发信号（见本节开头）；没退掉
    （stop_group 抛错）把记录改回原样再抛。进程一退 herdr 就清掉报过的续命令，记录里的 resume_reported_session 跟着删掉
    （续上以后重报，见 report_resume 上面的说明）。"""
    rss = group_rss_kb(pgid)
    update_agent_record(rec, state="released", released_at=time.time(), release_reason=reason, session_id=session,
                        cwd=agent.get("cwd") or rec.get("cwd"), freed_kb=rss, resumed_at=None,
                        **{RESUME_REPORT_KEY: None})
    try:
        sig = stop_group(pgid)
    except DroverError:
        update_agent_record(rec)
        raise
    deadline = time.time() + RELEASE_NAME_SECONDS
    while not agent_missing(name) and time.time() < deadline:
        time.sleep(0.2)
    warnings = [w for w, bad in (("这个 pane 是 herdr 报的 focused（用户可能正在看它）", agent.get("focused")),
                                 ("进程已经退了，herdr 还没清掉这个名字：过一会儿再给它发话", not agent_missing(name)))
                if bad]
    return {"signal": sig, "freed_mb": round(rss / 1024) if rss is not None else None,
            **({"warnings": warnings} if warnings else {})}


def release_one(name: str, rec: dict, reason: str, dry_run: bool) -> dict:
    """释放一个 worker（调用方拿着它的锁）：核对（worker_agent、release_checks）都过了才发信号。不放时返回 ok: false 和
    原因（不抛：闲置扫描接着看下一个）；已经释放了的再放一次是 ok（already_released），什么都不做。"""
    out = {"name": name, "slug": rec.get("slug"), "kind": rec.get("kind"), "pane_id": rec.get("pane_id"),
           "record": rec["path"], "resume": RESUME_HOW}
    try:
        agent = worker_agent(name, rec)
        if agent is None:
            return {**out, "ok": True, "already_released": True, "session_id": rec.get("session_id")}
        session, status, pgid = release_checks(name, rec, agent)
        out.update(ok=True, status=status, session_id=session, reason=reason)
        if dry_run:
            return {**out, "dry_run": True, "planned": [f"记进 {rec['path']}（state: released）",
                                                       f"kill -TERM -{pgid}（{RELEASE_TERM_SECONDS} 秒后还在就 SIGKILL）"]}
        return {**out, **stop_worker(name, rec, agent, session, pgid, reason)}
    except DroverError as exc:
        return {**{k: v for k, v in out.items() if k != "resume"}, "ok": False, "error": exc.message, **exc.extra}


def release_locked(name: str, slug: Optional[str], reason: str, dry_run: bool, wait: float) -> Optional[dict]:
    """拿这个 agent 的锁再放（release_one）；等了 wait 秒锁还没放开（正在给它发话或续上）返回 None。记录拿到锁以后才读：
    等锁的时候它可能被续上、换了会话。没有 agent-start 记录的不放。"""
    with agent_lock(name, wait) as got:
        if got is False:
            return None
        rec = find_agent_record(name, slug)
        if rec is None:
            return {"ok": False, "name": name,
                    "error": f"{name} 没有 agent-start 记录（{home_path(agent_record_path(slug or '*', name))}），没有释放："
                             "只放 drover agent-start 起的 worker；编排者、子编排者、复审、主会话、自己开的 agent 和这版之前"
                             "起的 worker 都不放"}
        return release_one(name, rec, reason, dry_run)


def resume_worker(rec: dict) -> tuple:
    """在原 pane 按记录里的参数和会话 ID 把释放了的 worker 起回来（start_agent：查名字占用、处理启动弹窗、等到 idle、claude
    等到会话开始），起来了再把续命令报给 herdr（report_resume：释放时 herdr 已经清掉了）。返回 (改过的记录, 发话返回里要带的说明)。
    原 pane 不在了、pane 的情况查不到（herdr 调用失败，pane_processes 抛的）、pane 里在跑别的程序、起不来都抛 DroverError，写清下一步。"""
    name, kind, pane, slug, session = (rec.get(k) for k in ("name", "kind", "pane_id", "slug", "session_id"))
    manual = (f"drover agent-start --name {name} --slug {slug} --kind {kind} --pane <pane> --resume"
              "（按记下的会话 ID 续），续上后再发一次")
    if not session:  # 释放时一定记了（release_checks）；没有只能是记录被改过
        raise DroverError(f"{name} 的记录里没有会话 ID（{rec['path']}），没法按 ID 续：到它的 pane（{pane}）里手动起", record=rec["path"])
    info = pane_processes(str(pane))
    if info is None:
        raise DroverError(f"{name} 释放时在 pane {pane}，这个 pane 已经不在了：在它的 worktree（{rec.get('cwd')}）里新开一个 pane，"
                          f"用 {manual}", record=rec["path"])
    if not at_shell(info):
        raise DroverError(f"pane {pane} 里现在在跑别的程序（{seen_processes(info)}），没有续上：等它结束或换一个 pane，"
                          f"用 {manual}", record=rec["path"])
    if kind == "codex":
        HEAVY_DIR.mkdir(parents=True, exist_ok=True)
    base = worker_args(kind, slug, rec.get("model"), rec.get("effort"), rec.get("add_dirs") or [])
    started = start_agent(name, kind, pane, resume_args(kind, base, session), False)
    reported: dict = {}
    if started.get("status") != "gone":  # 起来了（卡在启动弹窗上、ok 是 false 的也算）：记录回到 running，同 agent-start
        reported = report_resume(pane, kind, base, started.get("session_id"))
        rec = update_agent_record(rec, state="running", resumed_at=time.time(),
                                  session_id=started.get("session_id") or session,
                                  **{RESUME_REPORT_KEY: reported.get("session_id")})
    if not started.get("ok"):
        raise DroverError(f"在 pane {pane} 续 {name} 没续好（{started.get('status')}，start 里有屏幕 / 报错）：它还在、卡在弹窗上的，"
                          f"处理完弹窗再发一次；起来又退出了的（gone）看 start.pane_output 里宿主的报错，用 {manual}；"
                          "宿主说这个会话续不了的，去掉 --resume 起一个新会话（之前的上下文没有了，任务书要重发）",
                          start=started, record=rec["path"])
    return rec, {"resumed": True, "resume_command": started["command"],
                 "startup_dialogs_handled": started.get("startup_dialogs_handled"), "herdr_resume": reported}


def agent_missing(name: str) -> bool:
    """herdr 明确说没有这个名字（agent_not_found）；超时、连不上、别的错误都不算（不能当成已经退出去续）。"""
    try:
        ok, res = herdr(["agent", "get", name], timeout=30)
    except DroverError:
        return False
    return not ok and res.get("code") == "agent_not_found"


RESUME_SUBMIT_WAIT_MS = 10000  # 补了回车以后最多等它开工这么久


def submit_leftover(name: str, kind: str, sent: dict) -> dict:
    """刚续上就发话、herdr 报 agent_prompt_stalled 时补一次回车，返回新的发送结果（没补、补了没用都把原来的还回去）。
    实测（机器忙时三次续上里有一次，等到会话开始以后也还有）：话已经打进输入框了，回车却被当成换行、没有提交，agent 一直
    idle；这时再按一次回车就提交了（探针实测：输入框里留着话时 send-keys enter → working）。输入框是空的话回车什么都不做。
    屏幕上有确认框、接口错误、后台命令（screen_override 不为空）时不按：回车可能落在别的东西上。"""
    status = sent.get("status")
    if (sent.get("outcome") != "agent_prompt_stalled" or status not in ("idle", "done")
            or screen_override(status, screen_or_empty(name), kind)):
        return sent
    herdr(["agent", "send-keys", name, "enter"], timeout=30)
    herdr(["agent", "wait", name, "--until", "working", "--until", "blocked", "--timeout", str(RESUME_SUBMIT_WAIT_MS)],
          timeout=RESUME_SUBMIT_WAIT_MS / 1000 + 30)
    if agent_status(name) != "working":
        return sent
    return {"ok": True, "outcome": "started", "status": "working", "submitted_with": "extra_enter"}


def deliver(name: str, text: str, timeout_ms: int) -> dict:
    """prompt、brief --send 发话：拿这个 agent 的锁；它被释放了（herdr 里没有、最新的 worker 记录是 released）就先在原 pane
    续上（resume_worker），再 send_prompt。锁拿到发完：发话和释放不会交错（见本节开头）。续不上返回 ok: false、
    outcome resume_failed（error 写下一步），不发。刚续上发的话没提交（agent_prompt_stalled）时补一次回车（submit_leftover）。
    发出去了在 worker 记录里记 prompted_at：没对过话的会话续不上，释放只放发过话的（release_checks）。"""
    with agent_lock(name, AGENT_LOCK_WAIT) as got:
        if got is False:
            return {"ok": False, "outcome": "locked", "error": f"{name} 正在被释放或续上，等了 {AGENT_LOCK_WAIT} 秒锁还没放开",
                    "hint": "稍后再发一次"}
        rec = find_agent_record(name)
        resumed: dict = {}
        if rec and rec.get("state") == "released" and agent_missing(name):
            try:
                rec, resumed = resume_worker(rec)
            except DroverError as exc:
                return {"ok": False, "outcome": "resume_failed", "status": "released", "error": exc.message,
                        "hint": exc.message, **exc.extra}
        sent = send_prompt(name, text, timeout_ms)
        if resumed:
            sent = submit_leftover(name, rec.get("kind"), sent)
        if rec and sent["ok"]:
            update_agent_record(rec, prompted_at=time.time())
        return {**sent, **resumed}


def cmd_release(a: argparse.Namespace) -> dict:
    """drover release --name：手动释放一个 worker（不看 focused，focused 时返回里提示）。--idle 是闲置扫描（release_idle）。"""
    if a.idle:
        return release_idle(a.dry_run, list_agents())
    check_agent_name(a.name)
    if a.slug:
        check_slug(a.slug)
    res = release_locked(a.name, a.slug, "manual", a.dry_run, RELEASE_LOCK_WAIT)
    if res is None:
        raise DroverError(f"正在给 {a.name} 发话或续上（等了 {RELEASE_LOCK_WAIT} 秒锁还没放开），稍后再试")
    return res


# 后台维护（drover upkeep）：drover 起的 agent 每分钟核对两件事——
# - 续命令同步（sync_resume_reports，见 report_resume 上面的说明）：herdr 现在的会话和上次报的不一样（或还没报过）就报；
# - 闲置自动释放（release_idle）：agent-start 起的 worker 连续空闲（herdr 报 done / idle、按屏幕修正后还是）满 N 分钟、pane 不是
#   focused（用户可能正在看它；被 focus 了计时清零，离开后从头算）→ 释放；扫描一次只跑一个（IDLE_RELEASE_LOCK）。
# tick 挂在一直在跑的循环里（watch 普通的和 --main 每一轮、board 文本 / --json / --live、main-register）：主会话那边的循环不一定在跑
# （Codex 主会话两条消息之间什么都不跑、看板 tab 可能关了、主会话直接编排时没有 watch --main），普通 watch 正好在有 worker 的时候
# 在跑。tick 自己只读一个小文件，到点了在后台起 drover upkeep 就返回（同 auto_update_tick）。
# 续命令同步不看闲置释放开没开（worker_idle_release_minutes = 0、DROVER_IDLE_RELEASE=0 只关释放）；整个后台维护只有环境变量
# DROVER_UPKEEP=0 关得掉（自测用：每个跑 watch、看板、main-register 的用例都会触发 tick，不能真的在后台起进程）。
# 闲置释放默认 10 分钟的依据：Anthropic 的 prompt 缓存默认 5 分钟有效（https://platform.claude.com/docs/en/build-with-claude/prompt-caching
# "By default, the cache has a 5-minute lifetime"），过了以后留着进程不省 token，只省几秒启动。
IDLE_RELEASE_MINUTES = 10   # 默认 N；config 的 worker_idle_release_minutes 可改，0 关；环境变量 DROVER_IDLE_RELEASE=0 也关（自测用）
IDLE_RELEASE_FILE = STATE_HOME / "idle-release.json"  # 扫描记的候选：agents {名: {pane, seq, since}}、last_scan（拿着扫描锁写）
IDLE_RELEASE_LOCK = STATE_HOME / "locks" / "idle-release.lock"
UPKEEP_TICK_SECONDS = 60    # tick 离上次起后台维护满这么久才再起
# tick 上次起后台维护的时间。不用这版之前的 locks/idle-release-tick.json：装着旧版 drover 的 watch / 看板还在每分钟写它。
UPKEEP_TICK_FILE = STATE_HOME / "locks" / "upkeep-tick.json"
UPKEEP_LOG = STATE_HOME / "upkeep.log"  # 后台维护的输出（每次一个 JSON：resume_sync、idle_release；超过 BACKGROUND_LOG_MAX 清空重写）
# 后台进程跑的命令：这份 drover 自己。自测换成假的。
UPKEEP_ARGV = [sys.executable, str(PKG_ROOT / "bin" / "drover"), "upkeep"]


def idle_release_minutes() -> float:
    """闲置多少分钟自动释放，0 = 关：环境变量 DROVER_IDLE_RELEASE=0（false / off 也认）优先，再是 config 的
    worker_idle_release_minutes，没配是 IDLE_RELEASE_MINUTES。"""
    if os.environ.get("DROVER_IDLE_RELEASE", "").strip().lower() in AUTO_UPDATE_OFF:
        return 0.0
    value = as_float(CONFIG.get("worker_idle_release_minutes"))
    return float(IDLE_RELEASE_MINUTES) if value is None else max(value, 0.0)


def upkeep_tick() -> str:
    """离上次满 UPKEEP_TICK_SECONDS 秒就在后台起 drover upkeep，自己立刻返回（不等它）。返回 off（DROVER_UPKEEP=0）/ not_due /
    started / error，不抛异常：调用方是 watch、看板、hook，任何失败都不能影响它们。两个调用方同时到点时可能各起一个：闲置扫描后起的
    拿不到扫描锁就跳过；续命令同步按 agent 拿锁、拿到后重读记录，同一个会话不会报两次。"""
    if os.environ.get("DROVER_UPKEEP", "").strip().lower() in AUTO_UPDATE_OFF:
        return "off"
    now = time.time()
    try:
        last = as_float(read_json_dict(UPKEEP_TICK_FILE).get("at"))
        if last is not None and 0 <= now - last < UPKEEP_TICK_SECONDS:
            return "not_due"
        UPKEEP_TICK_FILE.parent.mkdir(parents=True, exist_ok=True)
        write_json_atomic(UPKEEP_TICK_FILE, {"at": now})
        spawn_background(UPKEEP_ARGV, UPKEEP_LOG, "drover-upkeep")
        return "started"
    except (OSError, ValueError, subprocess.SubprocessError):
        return "error"


def cmd_upkeep(a: argparse.Namespace) -> dict:
    """drover upkeep（后台维护，tick 到点了在后台起它；手动跑也行）：一次 herdr agent list，先批 herdr 拉回的 claude 停着的信任框
    （approve_trust_dialogs），再同步续命令（sync_resume_reports），最后在闲置释放开着时扫一遍（release_idle）。"""
    agents = list_agents()
    if agents is None:
        return {"ok": False, "at": clock(time.time()), "error": "herdr agent list 读不到"}
    launches = drover_launches(agents)
    return {"ok": True, "at": clock(time.time()), "trust_dialogs": approve_trust_dialogs(launches),
            "resume_sync": sync_resume_reports(launches), "idle_release": release_idle(False, agents)}


# 认"herdr 里这个 agent 还是记录里那一次起的"：这几个字段都没变（worker 记录有 started_at，orch.json 有 started）。
LAUNCH_KEYS = ("name", "pane_id", "kind", "started_at", "started")


def launch_target(kind: str, pane: str, rec: Optional[dict], orch: Optional[dict]) -> Optional[dict]:
    """herdr 里 pane 这个 kind 的 agent 是 drover 起的哪一份：worker 记录 rec（worker_records 的一项）或编排者 orch.json（orch：
    latest_orch_metas 的一项），pane 和宿主要对得上。返回 {path（记 resume_reported_session 的文件）, launch（读到的内容）,
    args（起它用的参数：worker 按记录重放 worker_args，编排者按 orch.json 和当前 config 重建 orch_agent_args）}，都对不上是 None。"""
    if rec and (rec.get("pane_id"), rec.get("kind")) == (pane, kind):
        return {"path": Path(rec["path"]), "launch": rec,
                "args": worker_args(kind, rec.get("slug"), rec.get("model"), rec.get("effort"), rec.get("add_dirs") or [])}
    meta = (orch or {}).get("meta") or {}
    if (meta.get("pane_id"), meta.get("kind")) == (pane, kind):
        return {"path": orch["dir"] / "orch.json", "launch": meta,
                "args": orch_agent_args(kind, meta.get("slug") or orch["dir"].name, meta.get("model"), meta.get("effort"))}
    return None


def drover_launches(agents: list) -> list:
    """herdr 里活着、drover 起的 agent（launch_target 对得上名字、pane、宿主）：每项是 launch_target 的结果加上 name、kind、pane、
    status（herdr 报的状态）、session（herdr 现在的会话 ID，没有是 None）。worker 记录、orch.json 一轮只读一次。"""
    workers, orchs = worker_records(), latest_orch_metas()
    out = []
    for ag in agents:
        name, kind, pane = ag.get("name"), ag.get("agent"), ag.get("pane_id")
        target = launch_target(kind, pane, workers.get(name), orchs.get(name)) if pane and kind in HOST_KINDS else None
        if target:
            out.append({**target, "name": name, "kind": kind, "pane": pane, "status": ag.get("agent_status"),
                        "session": (ag.get("agent_session") or {}).get("value")})
    return out


def resume_report_targets(launches: list) -> list:
    """要（重）报续命令的（drover_launches 里的）：herdr 报了会话 ID、和记下的 resume_reported_session 不一样的。"""
    return [t for t in launches if t["session"] and t["launch"].get(RESUME_REPORT_KEY) != t["session"]]


def current_launch(t: dict) -> Optional[dict]:
    """t（resume_report_targets 的一项）的文件现在的内容：还是 t 读到的那一份（LAUNCH_KEYS 都没变）、也还没记着 t 的会话时返回它，
    否则 None（被 agent-start --resume / 换编排者整份重写了，或者别的后台维护刚报过）。"""
    cur = read_json_dict(t["path"])
    same = all(cur.get(k) == t["launch"].get(k) for k in LAUNCH_KEYS)
    return cur if same and cur.get(RESUME_REPORT_KEY) != t["session"] else None


def sync_one(t: dict) -> Optional[dict]:
    """（拿着 t 这个 agent 的锁）报 t 的续命令（report_resume），报上了把会话 ID 记进它的文件；不用报时（current_launch 是 None）
    返回 None。写回前再核对一次：报的那几十毫秒里文件也可能被整份重写，旧内容不能写回去盖掉新的。"""
    if current_launch(t) is None:
        return None
    res = report_resume(t["pane"], t["kind"], t["args"], t["session"])
    cur = current_launch(t)
    if res["reported"] and cur is not None:
        write_json_atomic(t["path"], {**cur, RESUME_REPORT_KEY: t["session"]})
    return res


def locked_each(targets: list, act: Callable[[dict], Any]) -> tuple:
    """后台维护对每个 agent 动手前拿它的锁（agent_lock，不等）：正在发话、释放、续上、agent-start 的这一轮跳过，下一轮再看。
    返回 ([(t, act(t) 的结果)], 锁被拿着的名字)。"""
    done, busy = [], []
    for t in targets:
        with agent_lock(t["name"], 0) as got:
            if got:
                done.append((t, act(t)))
            else:
                busy.append(t["name"])
    return done, busy


def sync_resume_reports(launches: list) -> dict:
    """后台维护的续命令同步（见 report_resume 上面的说明）：resume_report_targets 逐个报（sync_one，拿着这个 agent 的锁）。
    返回 reported（name、session_id、argv）、failed（name、reason：herdr 报错、续命令不合格……）、busy（锁被拿着的名字）。"""
    done, busy = locked_each(resume_report_targets(launches), sync_one)
    return {"reported": [{"name": t["name"], "session_id": t["session"], "argv": res["argv"]}
                         for t, res in done if res and res["reported"]],
            "failed": [{"name": t["name"], "reason": res["reason"]} for t, res in done if res and not res["reported"]],
            "busy": busy}


# herdr 按续命令拉回的 claude 先停在 "Adding a new directory" 信任框上（问 --add-dir 加的目录；这个框的信任只管一个进程，续同一个
# 会话也要重新批，实测），光标默认在 "No, exit"。drover 起、续的时候 start_agent 自动批；herdr 拉回的由后台维护顺带批
# （approve_trust_dialogs，每轮先做这一步）。只认：drover 起的 claude（drover_launches 对得上名字、pane、宿主）、herdr 报 blocked、
# 屏幕是这个框（TRUST_ADD_DIR_RE）、框里问的目录是 drover 起它时 --add-dir 加的（launch_target 重建的参数里的：worker 是
# ~/.drover/<slug> 和记录里的 add_dirs，编排者是 ~/.drover）。对不上的一律不碰。照 start_agent 用 select_affirmative 把光标移到
# 肯定项再回车，绝不发 esc（这个框里 esc 就是退出）；连着弹的（每个 --add-dir 一个）逐个批，目录对不上的那个停下不碰。拿这个
# agent 的锁（和发话、释放、agent-start 互斥，不和 start_agent 抢着按键），批了往 stderr 写一行（后台跑时进 upkeep.log）。
TRUST_DIR_RE = re.compile(r"Adding a new directory:[ \t]*\n([\s\S]*?)\n[ \t]*\n[ \t]*This\s+session")
TRUST_SETTLE_SECONDS = 1.5  # 批完一个框等这么久再看是不是还有下一个
TRUST_MAX_DIALOGS = 4       # 一轮最多连着批几个


def trust_dialog_dir(screen: str) -> Optional[str]:
    """屏幕上 "Adding a new directory" 信任框问的目录（窄 pane 里折了行的拼回去）；不是这个框（TRUST_ADD_DIR_RE）是 None。"""
    found = TRUST_DIR_RE.findall(screen) if TRUST_ADD_DIR_RE.search(screen) else []
    return "".join(line.strip() for line in found[-1].splitlines()) if found else None


def real_path(path: str) -> str:
    """比目录用的写法：展开 ~、解开符号链接（/tmp 和 /private/tmp 是同一个）。"""
    return str(Path(path).expanduser().resolve())


def approve_trust(t: dict) -> list:
    """（拿着 t 这个 agent 的锁）t 停在 drover 给它加的目录的信任框上就批（select_affirmative），连着弹的逐个批；返回批了的目录。
    屏幕不是这个框、目录不是 drover 加的、找不到肯定项时停下，不按别的键；herdr 调用失败（读屏、按键超时）也停下，下一轮再看。"""
    allowed = {real_path(v) for k, v in zip(t["args"], t["args"][1:]) if k == "--add-dir"}
    approved: list = []
    with contextlib.suppress(DroverError):
        for _ in range(TRUST_MAX_DIALOGS):
            shown = trust_dialog_dir(agent_screen(t["name"]))
            if not shown or real_path(shown) not in allowed or not select_affirmative(t["name"]):
                break
            approved.append(shown)
            time.sleep(TRUST_SETTLE_SECONDS)
    return approved


def approve_trust_dialogs(launches: list) -> dict:
    """后台维护的第一步（见上面的说明）：drover 起的 claude 里 herdr 报 blocked 的，停在 drover 加的目录的信任框上就批
    （approve_trust，拿着这个 agent 的锁）。返回 approved（name、pane、dirs：批了的目录）、busy（锁被拿着、这一轮跳过的名字）。"""
    blocked = [t for t in launches if (t["kind"], t["status"]) == ("claude", "blocked")]
    done, busy = locked_each(blocked, approve_trust)
    approved = [{"name": t["name"], "pane": t["pane"], "dirs": dirs} for t, dirs in done if dirs]
    for a in approved:
        print(f"{clock(time.time())} upkeep：批了 {a['name']}（pane {a['pane']}）的 \"Adding a new directory\" 信任框："
              f"{'、'.join(a['dirs'])}", file=sys.stderr, flush=True)
    return {"approved": approved, "busy": busy}


def idle_candidates(agents: list, records: dict, old: dict, now: float) -> dict:
    """这一轮空闲着的候选 → {pane, seq, since}：有 worker 记录、herdr 里还在记录的 pane、宿主相同，herdr 报 done / idle，pane
    不是 focused。pane 和 herdr 的状态序号都和上一轮记的一样就接着算（since 不动），否则从现在起算；不在结果里的（干活了、
    被 focus 了、退出了）下次从头算。记录里的 state 不看：写着 released、herdr 里同一个 pane 却有这个 agent（有人手动续了）
    照样算。会话 ID、按屏幕修正（后台命令、确认框）、进程组留到满 N 分钟、真要放时再看（release_checks）。"""
    out = {}
    for ag in agents:
        name = ag.get("name")
        rec = records.get(name)
        if (not rec or (ag.get("pane_id"), ag.get("agent")) != (rec.get("pane_id"), rec.get("kind"))
                or ag.get("agent_status") not in ("done", "idle") or ag.get("focused")):
            continue
        prev = old.get(name) if isinstance(old.get(name), dict) else {}
        same = (prev.get("pane"), prev.get("seq")) == (ag.get("pane_id"), ag.get("state_change_seq"))
        since = as_float(prev.get("since")) if same else None
        out[name] = {"pane": ag.get("pane_id"), "seq": ag.get("state_change_seq"), "since": now if since is None else since}
    return out


def release_due(names: list, dry_run: bool) -> tuple:
    """把空闲满了的逐个放掉，返回 (放掉的, 没放的和原因)。拿不到锁的（正在给它发话）跳过，两边都不进。"""
    released, refused = [], []
    for name in names:
        res = release_locked(name, None, "idle", dry_run, 0)
        if res is not None:
            (released if res.get("ok") else refused).append(res)
    return released, refused


def release_idle(dry_run: bool, agents: Optional[list]) -> dict:
    """release --idle、后台维护（cmd_upkeep）：按 agents（调用方取的 herdr agent list，取不到是 None）扫一遍，空闲满 N 分钟的放掉。
    返回 released、refused（满了 N 分钟却没放的和原因：没有会话 ID、挂着后台命令、进程组认不出……）、idle_minutes（这一轮每个
    候选已经空闲多久）。--dry-run 只报会放谁、为什么不放，不发信号、不记候选（也不拿扫描锁）。"""
    minutes = idle_release_minutes()
    base = {"ok": True, "at": clock(time.time()), "minutes": minutes}
    if not minutes:
        return {**base, "off": True}
    with contextlib.nullcontext(True) if dry_run else flock_file(IDLE_RELEASE_LOCK, 0) as got:
        if not got:
            return {**base, "skipped": "另一个闲置扫描正在跑" if got is False else "状态目录写不了"}
        if agents is None:
            return {**base, "ok": False, "error": "herdr agent list 读不到"}
        now = time.time()
        old = read_json_dict(IDLE_RELEASE_FILE).get("agents")
        idle = idle_candidates(agents, worker_records(), old if isinstance(old, dict) else {}, now)
        released, refused = release_due(sorted(n for n, seen in idle.items() if now - seen["since"] >= minutes * 60),
                                        dry_run)
        if not dry_run:
            write_json_atomic(IDLE_RELEASE_FILE, {"agents": idle, "last_scan": now})
    return {**base, "released": released, "refused": refused,
            "idle_minutes": {n: round((now - s["since"]) / 60, 1) for n, s in idle.items()}}


# ---------------------------------------------------------------- orch-start

# 编排者（orchestrator）都放在这个 workspace 里，一个任务一个 tab。不叫 drover：drover 是主会话本身，编排者是它派生出来的。
# 工作目录用主工作台（配置的 workspace），这样编排者拿到的权限规则、MCP 配置和主会话一样，不会因为换了目录而频繁弹审批。
