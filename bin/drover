def orch_workspace(dry_run: bool) -> tuple[Optional[str], Optional[str], list]:
    """找到或新建编排者的 workspace（label orch）。返回 (workspace_id, 新建时的根 pane, 计划执行的命令)。"""
    ok, res = herdr(["workspace", "list"], timeout=30)
    if not ok:
        raise DroverError("herdr workspace list 失败", error=res)
    for ws in res.get("workspaces", []):
        if ws.get("label") == ORCH_WORKSPACE_LABEL:
            return ws.get("workspace_id"), None, []
    cmd = ["workspace", "create", "--cwd", str(ORCH_CWD), "--label", ORCH_WORKSPACE_LABEL, "--no-focus"]
    if dry_run:
        return None, None, ["herdr " + shlex.join(cmd)]
    ok, res = herdr(cmd)
    if not ok:
        raise DroverError("herdr workspace create 失败", error=res)
    ws_id = (res.get("workspace") or {}).get("workspace_id")
    root_pane = (res.get("root_pane") or {}).get("pane_id")
    tab_id = (res.get("tab") or {}).get("tab_id")
    if not ws_id or not root_pane:
        raise DroverError("herdr workspace create 返回里缺 workspace_id 或 root_pane", result=res)
    return ws_id, root_pane, [tab_id] if tab_id else []


def orch_kinds(explicit: Optional[str], parent: Optional[str]) -> tuple[str, str, str]:
    """orch-start 的宿主，返回 (编排者的 kind, kind_source, default_kind)。编排者：--kind，没给就跟调用方（主会话；
    起子编排者时是上层编排者）。default_kind 是这个任务里没指定宿主时 worker 用的，即主会话的宿主：顶层 = 调用方
    （不受 --kind 影响），子编排者 = 上层 orch.json 的 default_kind（上层没有这个字段时用调用方）；调用方认不出时取 --kind。"""
    inherited = read_json_dict(STATE_HOME / parent / "orch.json").get("default_kind") if parent else None
    caller = None if explicit and inherited else caller_kind()
    kind = explicit or caller
    if kind is None:
        raise DroverError(f"{NO_CALLER_KIND}：加 --kind claude|codex 指定编排者跑在哪个宿主里",
                          caller_pane=os.environ.get("HERDR_PANE_ID"))
    return kind, "explicit" if explicit else "caller", inherited or caller or kind


def orch_agent_args(kind: str, slug: str, model: Optional[str], effort: Optional[str]) -> list:
    """编排者（子编排者同）交给宿主的参数（不含续会话的）。orch-start 起它、后台维护给 herdr 报续命令（launch_target）共用，后者按
    orch.json 记的 kind / slug / model / effort 重建。model / effort 是 orch.json 记的、补默认值之前的值（task_model 的结果，
    没指定是 null；它也是同宿主 worker 继承的任务默认，不能存补完的），默认值按调用时的 config 补（model_defaults）。所以编排者
    起来以后改了 config 的 claude_model / claude_effort / codex_effort，报给 herdr 的续命令用新值，herdr 重启后它按新默认回来。"""
    if kind == "claude":
        return [*claude_model_args(model, effort), "--permission-mode", "acceptEdits",
                "--name", f"orch-{slug}", "--add-dir", str(STATE_HOME)]
    # 模型没指定就不传，用 ~/.codex/config.toml 的默认；effort 和 codex worker 一样（codex_model_args）。
    return [*CODEX_ORCH_ARGS, *codex_model_args(model, effort)]


def orch_start_lock(slug: str) -> Path:
    """orch-start 起这个任务的编排者时拿的锁：从写 orch.json 到 start_agent 返回（start_orch_agent）。
    用 flock：orch-start 被杀了自动放开，不会留下一份永远"正在起"的记录。"""
    return STATE_HOME / "locks" / f"orch-start-{slug}.lock"


def file_snapshot(path: Path) -> Optional[tuple]:
    """path 现在的 (内容, 访问时间 ns, 修改时间 ns)，给 restore_file 用；没有这个文件是 None。"""
    try:
        st = path.stat()
        return path.read_bytes(), st.st_atime_ns, st.st_mtime_ns
    except OSError:
        return None


def restore_file(path: Path, snapshot: Optional[tuple]) -> None:
    """把 path 恢复成 file_snapshot 那时的样子：那时没有就删掉；有就把内容一字不差写回去（原子写），修改时间也还原——
    同名的 orch.json 按修改时间取最新（orch_records），不还原的话，没起来的这次会把别的任务后来复用的名字抢回来。"""
    if snapshot is None:
        path.unlink(missing_ok=True)
        return
    data, atime, mtime = snapshot
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_bytes(data)
    os.utime(tmp, ns=(atime, mtime))
    os.replace(tmp, path)


def retired_names(previous: dict, name: str) -> list:
    """这个任务换下来的编排者名（orch.json 的 retired_names）。previous 是换之前的 orch.json（没有是 {}），name 是这次起的编排者：
    前任的名字接在它记着的更早的名字后面（X → Y → Z 累积），去掉和 name 相同的（同名再起不记；换回用过的名字时它是现任）。
    换下的名字仍归这个任务（orch_records）：换编排者时新的起好才关旧 tab（routing.md），旧编排者这段时间还活着，它的名字不能
    落回更早的同名任务。"""
    names = [*(previous.get("retired_names") or []), previous.get("name")]
    return list(dict.fromkeys(n for n in names if n and n != name))


def start_orch_agent(meta_file: Path, agent_args: list, record: dict) -> dict:
    """写下编排者的记录 record（orch.json 的内容）、起它（start_agent），返回 start_agent 的结果加 herdr_resume（report_resume）。
    记录在起 agent 之前写：名字可以被后来的任务复用，herdr 里叫这个名字的活 agent 算这个名字最新的那份记录的（orch_records）。
    起好才写的话，新 agent 出现在 herdr 里到写下记录的那几秒（处理启动弹窗、等会话开始）它被算给同名的旧任务：11-23 新任务的
    orch-oncall 刚起，watch --main 就报了两周前同名旧任务的 rollup:完成。反过来，记录写了、agent 还没出现的那一小段会被看成
    编排者退出了（watch --main 报 gone，主会话去起替换的），所以从写记录到起好拿着 orch_start_lock：这一段 orch_records 不列它。
    没起来就恢复原样（restore_file）：start_agent 抛错（herdr 报错、名字被活着的 agent 占着），或者起来又退出了（status 是
    gone）——留着记录的话 watch --main 会报 gone，可这次的失败调用方已经从返回里看到了。被打断（Ctrl-C）不恢复：agent 可能已经
    起来了，记录留着它才算这个任务的。卡在不认识的启动界面上、ok 是 false 的也留着（同 agent-start）：它活着，处理完照常用。
    起好把报给 herdr 的会话 ID 补进记录：claude 起好时就有；codex 发出第一句话才有，这时不报，后台维护补报。"""
    with flock_file(orch_start_lock(record["slug"]), None):
        before = file_snapshot(meta_file)
        write_json_atomic(meta_file, record)
        try:
            result = start_agent(record["name"], record["kind"], record["pane_id"], agent_args, False)
        except Exception:
            restore_file(meta_file, before)
            raise
        result["herdr_resume"] = report_resume(record["pane_id"], record["kind"], agent_args, result.get("session_id"))
        if result.get("status") == "gone":
            restore_file(meta_file, before)
        else:
            write_json_atomic(meta_file, {**record, RESUME_REPORT_KEY: result["herdr_resume"].get("session_id")})
    return result


def timeline_orch_start(slug_dir: Path, name: str, kind: str, parent: Optional[str], resume: bool) -> None:
    """orch-start 记时间线：派发（start）；resume（--args 第一个词是 resume）时是换编排者（replace；routing.md"需要换编排者"、
    意外退出都这样起），老任务没有派发那条就按 request.md / rollup.md 的修改时间补一条估计的。"""
    with timeline_session(slug_dir) as (events, new):
        if resume:
            if last_event(events, "start") is None:
                new.append(timeline_event("start", request_time(slug_dir) or time.time(), "orch-start", estimated=True))
            new.append(timeline_event("replace", time.time(), "orch-start", name=name, kind=kind))
        else:
            new.append(timeline_event("start", time.time(), "orch-start", name=name, kind=kind, parent=parent))


def cmd_orch_start(a: argparse.Namespace) -> dict:
    if ORCH_CWD is None:  # 编排者的工作目录就是主工作台，没配置就起不了
        raise DroverError(NO_WORKSPACE_ERROR, config_file=str(CONFIG_FILE))
    check_slug(a.slug)
    check_agent_name(a.name)
    slug_dir = STATE_HOME / a.slug
    request = Path(a.request_file).expanduser()
    if not request.is_file() or not request.read_text().strip():
        raise DroverError(f"请求文件不存在或为空：{request}。先用 Write 写好用户原话和主会话附的上下文。")
    rollup = slug_dir / "rollup.md"
    parent = getattr(a, "parent", None)
    if parent:
        check_slug(parent)
        if not (STATE_HOME / parent / "dispatch.md").is_file():
            raise DroverError(f"上层任务 {parent} 没有状态文件 {STATE_HOME / parent / 'dispatch.md'}：--parent 写上层编排者的 slug")
        if not a.slug.startswith(parent + "-"):
            raise DroverError(f"子编排者的 slug 约定为 <上层 slug>-<仓库>，现在是 {a.slug}（上层 {parent}）")
    kind, kind_source, default_kind = orch_kinds(a.kind, parent)
    model, effort = task_model(kind, a.model, a.effort, a.slug, parent)
    host = ORCH_HOSTS[kind]
    if not host["entry"].is_file():
        raise DroverError(f"{kind} 编排者要用 {host['entry_label']}，但 {host['entry']} 不存在："
                          f"先跑 drover 的 install.py --host {kind}")
    if parent:
        skill_args = f"--orch {a.slug} --parent {parent} {a.args or ''}".strip()
        template = ORCH_SUB_KICKOFF
    else:
        skill_args = f"--orch {a.slug} {a.args or ''}".strip()
        template = ORCH_KICKOFF
    kickoff = template.format(slug=a.slug, parent=parent, request=request, rollup=rollup, workspace=ORCH_CWD,
                              routing=ROUTING_FILE,
                              load_skill=host["load_skill"].format(skill_args=skill_args),
                              ask_tool=host["ask_tool"], host_notes=host["host_notes"](),
                              model_note=orch_model_note(a.slug, kind, model, effort))
    agent_args = orch_agent_args(kind, a.slug, model, effort)

    ws_id, root_pane, created_tab = orch_workspace(a.dry_run)
    kinds = {"kind": kind, "kind_source": kind_source, "default_kind": default_kind}
    if a.dry_run:
        tab_step = (f"herdr tab rename <新 workspace 自带的 tab> {a.slug}" if created_tab else
                    f"herdr tab create --workspace {ws_id} --cwd {ORCH_CWD} --label {a.slug} --no-focus")
        return {"ok": True, "dry_run": True, "workspace_id": ws_id, **kinds, "kickoff": kickoff,
                "planned": [*created_tab, tab_step,
                            f"herdr agent start {a.name} --kind {kind} --pane <该 tab 的 pane> -- {shlex.join(agent_args)}",
                            prompt_plan(a.name, "<开场 prompt>")]}

    if root_pane:
        # 新建的 workspace 自带一个 tab，直接给第一个编排者用，改成任务的标签。
        pane_id = root_pane
        if created_tab:
            herdr(["tab", "rename", created_tab[0], a.slug], timeout=30)
        tab_id = created_tab[0] if created_tab else None
    else:
        ok, res = herdr(["tab", "create", "--workspace", ws_id, "--cwd", str(ORCH_CWD), "--label", a.slug,
                         "--no-focus"])
        if not ok:
            raise DroverError("herdr tab create 失败", error=res)
        pane_id = (res.get("root_pane") or {}).get("pane_id")
        tab_id = (res.get("tab") or {}).get("tab_id")
        if not pane_id:
            raise DroverError("herdr tab create 返回里缺 root_pane.pane_id", result=res)

    slug_dir.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%m-%d %H:%M")
    # orch-status 和 watch 靠它把编排者名、宿主和任务对上（resume 换人时覆盖成新的）；
    # default_kind 给 agent-start / brief（没写 --kind 的 worker 用主会话的宿主）和子编排者的 orch-start 用；
    # model / effort 是任务默认（没指定是 null），同宿主的 agent-start、review、子编排者和换上的编排者不传时继承（task_model）；
    # resume_reported_session 是报给 herdr 的续命令用的会话 ID（没报是 null，起好由 start_orch_agent 补上），后台维护拿它和
    # herdr 现在的会话比、会改它，所以整份原子写（write_json_atomic），后台不会读到半截；
    # retired_names 是这个任务换下来的编排者名（retired_names）。
    meta_file = slug_dir / "orch.json"
    result = start_orch_agent(meta_file, agent_args, {
        "slug": a.slug, "name": a.name, "kind": kind, "default_kind": default_kind, "parent": parent,
        "model": model, "effort": effort,
        "workspace_id": ws_id, "tab_id": tab_id, "pane_id": pane_id, "started": stamp,
        "retired_names": retired_names(read_json_dict(meta_file), a.name), RESUME_REPORT_KEY: None})
    result.update({"workspace_id": ws_id, "tab_id": tab_id, "rollup_file": str(rollup), **kinds})
    if result.get("status") == "gone":  # 起来又退出了：记录已经恢复原样（start_orch_agent），不往上层登记、不记时间线
        return result
    if parent:
        # 关系记两边：子任务目录里的 parent.json（resume、history 用），上层状态文件里追加一行（上层追踪用）。
        (slug_dir / "parent.json").write_text(json.dumps(
            {"parent": parent, "name": a.name, "tab_id": tab_id, "pane_id": pane_id, "started": stamp},
            ensure_ascii=False, indent=2))
        with locked_append(STATE_HOME / parent / "dispatch.md") as (text, chunks):
            chunks.append(("" if not text or text.endswith("\n") else "\n")
                          + f"- {stamp} 子编排者 {a.name}（任务 {a.slug}，tab {tab_id}，pane {pane_id}），"
                            f"rollup：{rollup}\n")
        result["parent"] = parent
    timeline_orch_start(slug_dir, a.name, kind, parent, (a.args or "").split()[:1] == ["resume"])
    if SLUG_RISKY_WORDS.search(a.slug):
        result["warning"] = ("slug 里有 import / include：编排者用 jq 读 <slug>/ 下的结果文件会被判成加载模块、弹强制审批。"
                             "下次换个词；这次编排者读验收结果用 drover accept-summary")
    if not result.get("ok"):
        return result
    sent = send_prompt(a.name, kickoff, PROMPT_TIMEOUT_MS)
    result["kickoff_sent"] = sent
    result["ok"] = sent["ok"]
    if not sent["ok"]:
        result["error"] = f"编排者已启动，但开场 prompt 的发送结果是 {sent['outcome']}：{sent.get('hint')}"
    return result


# "更新："是编排者手写的时间，现在只是展示、可以不写（模型手写的时间和真实时间可能差几十分钟）；带"更新："行的旧文件照样读，
# rollup_updated 原样返回。看板每个任务按这几行显示："标题："≤12 字中文（派发时主会话写在 request.md 里，编排者照抄），
# "摘要："≤20 字的当前状态（在等谁、等什么 / 正在做什么），"要你做："≤15 字（没有写"无"），"收尾："可以 / 先别，<原因>
# （见 rollup_wrapup），"提醒："可选，一句话。
ROLLUP_FIELD_RE = re.compile(r"^(状态|更新|上层|标题|摘要|要你做|收尾|提醒)[：:]\s*(.*?)\s*$", re.M)
# 主会话要处理的 rollup 状态，按前缀归类（真实 rollup 里有"完成（已收尾）"）。watch 的 rollup 事件、orch-status 的
# needs_attention、watch --main、board 共用（以前 orch-status 是全等匹配、watch 是前缀匹配，不一致）。
ROLLUP_ATTENTION = ("等你决定", "完成", "受阻", "需要换编排者")
# 主会话这边的记录，都在 ~/.drover/<slug>/ 下："转达过没有"以前只在主会话的上下文里，
# /clear、重挂 watch 之后就分不清；记到磁盘上，watch --main、board、orch-status 都按它判断。
MAIN_SEEN_FILE = "main-seen.json"  # 主会话用 drover rollup 读过的那一份：digest、status、规范化后的行、读的时间
ANSWERED_FILE = "answered.json"  # drover prompt 给编排者发过答复：at、当时 rollup 的 digest
MAIN_WATCH_FILE = "main-watch.json"  # watch --main 报过什么、什么时候报的（去重、到时间再报），重挂不丢
# watch --main 每一轮写的心跳（pid、at）。它报出一件事就退出，靠主会话处理完再重挂；那一轮卡在选项框上、被打断、没重挂时，
# 以前没有任何东西发现（真实时间线：一个"等你决定"380 分钟后才被读到）。常驻的看板看到"主会话在处理"不空、心跳停了
# MAIN_WATCH_STALE_MINUTES，就给主会话送一句"接上"（board_nudge）。
MAIN_WATCH_LIVE_FILE = STATE_HOME / "main-watch-live.json"
MAIN_WATCH_STALE_MINUTES = 5
# 编排者现在的状态（按屏幕修正后）从什么时候开始：herdr 不给状态开始的时间（agent get
# 只有 state_change_seq、revision），只能 drover 自己记。watch --main、board 每一轮都记，看板的"卡在确认框 N 分钟"按它算。
AGENT_STATE_FILE = "agent-state.json"
# 时间线：统计数据（总耗时、等你的次数和时长、卡在确认框多久……以后 drover stats 用），一个任务一个
# <slug>/TIMELINE_FILE，一行一个 JSON，只追加不改。drover 自己发起的事在那条命令里当场记：orch-start（派发 / 换编排者）、
# prompt（转答复、收尾请求）、看板点收尾、wrapup --draft（收尾汇总）、rollup 读到新内容。只能看到的由观察者（watch --main 每一轮、
# 看板每次读屏）补：显示状态变了、编排者每换一段状态、停了没更新。读-比-追加都拿 flock(TIMELINE_FILE)（只追加、不替换，可以直接
# 锁它），两个观察者同时跑也只记一次。没人观察的时段记在全局的 OBSERVE_GAPS_FILE，统计时知道那段数据不全。
TIMELINE_FILE = "timeline.jsonl"
WRAPUP_CLICKED_FILE = "wrapup-clicked.json"  # 看板上点过收尾：at、送的那句话；"收尾中"按它算
OBSERVE_FILE = STATE_HOME / "observe.json"  # 观察者最后一次看的时间（last）
OBSERVE_GAPS_FILE = STATE_HOME / "observe-gaps.jsonl"  # 没人观察的时段，一行 {from, to}
OBSERVE_LOCK = STATE_HOME / "locks" / "observe.lock"
OBSERVE_GAP_SECONDS = 60  # 观察者重新开始时距离上次超过这么久，记一条观察中断（watch --main 5 秒、看板 15 秒一轮）


def rollup_lines(text: str) -> list:
    """规范化后的行：每行去掉首尾空白，删掉空行。rollup 改没改、和上次读的差在哪，都按它比。"""
    return [line.strip() for line in text.splitlines() if line.strip()]


def lines_digest(lines: list) -> str:
    return hashlib.sha1("\n".join(lines).encode(errors="replace")).hexdigest()


def read_rollup(path: Path) -> Optional[dict]:
    """读 rollup.md：text、开头的字段 fields、status（"状态："去掉空白）、规范化后的 lines 和 digest、mtime（秒）；
    没有文件返回 None。
    改没改按 digest（规范化内容）判断，不按修改时间：编排者原样重写、只动了空白空行时，
    以前 watch 会再报一次"等你决定 / 完成"。修改时间只用来展示（rollup_mtime）。"""
    try:
        text = path.read_text()
        mtime = path.stat().st_mtime
    except OSError:
        return None
    fields = {k: v for k, v in ROLLUP_FIELD_RE.findall(text[:600])}
    lines = rollup_lines(text)
    return {"text": text, "fields": fields, "status": re.sub(r"\s+", "", fields.get("状态") or ""),
            "lines": lines, "digest": lines_digest(lines), "mtime": mtime}


def clock(t: float, fmt: str = "%m-%d %H:%M:%S") -> str:
    return time.strftime(fmt, time.localtime(t))


def rollup_header(roll: Optional[dict]) -> dict:
    """rollup.md 开头的 状态 / 更新 / 上层 三个字段、摘要（见 rollup_summary）、文件修改时间；没有文件返回 {}。"""
    if roll is None:
        return {}
    fields = roll["fields"]
    return {"rollup_status": fields.get("状态"), "rollup_updated": fields.get("更新"), "rollup_parent": fields.get("上层"),
            "rollup_summary": rollup_summary(roll) or None, "rollup_mtime": clock(roll["mtime"])}


HEADING_RE = re.compile(r"^#{1,6}\s+(.*)$")


def rollup_section(lines: list, title: str) -> list:
    """规范化后的行里，标题以 title 开头的那一节（"## 需要你决定"）的内容，到下一个标题为止。"""
    out, inside = [], False
    for line in lines:
        m = HEADING_RE.match(line)
        if m:
            inside = m.group(1).startswith(title)
        elif inside:
            out.append(line)
    return out


def rollup_summary(roll: dict) -> str:
    """看板上的一句话摘要：rollup 的"摘要："；旧 rollup 没有这一行时按状态取——等你决定取"## 需要你决定"下第一行，
    进行中（和别的状态）取"## 当前进度"下最后一行，完成 / 受阻取"## 结论"下第一个不以"目标："开头的行；去掉开头的"- "。"""
    text = roll["fields"].get("摘要") or ""
    if not text:
        status, lines = roll["status"], roll["lines"]
        if status.startswith("等你决定"):
            picked = rollup_section(lines, "需要你决定")[:1]
        elif status.startswith(("完成", "受阻")):
            picked = [x for x in rollup_section(lines, "结论") if not x.startswith("目标：")][:1]
        else:
            picked = rollup_section(lines, "当前进度")[-1:]
        text = picked[0] if picked else ""
    return re.sub(r"^-\s+", "", text)


# 旧版看板让编排者在 rollup 写"## 交付"一节（一样交付一行
# "- <可以看|处理中|等你|提醒>：<项目> — <状态>"），看板按它分组。现在看板是一行一个任务的表格，不再读它，
# 格式里删掉了；还在用的旧 rollup 照样解析，只放进 --json 的 deliverables（没有这一节是空列表）。
DELIVERABLE_KINDS = {"可以看": "look", "处理中": "doing", "等你": "user", "提醒": "note"}
DELIVERABLE_RE = re.compile(r"^[-*]\s*(可以看|处理中|等你|提醒)\s*[：:]\s*(.*)$")
DELIVERABLE_SPLIT_RE = re.compile(r"\s+—{1,2}\s+")
# "要你做什么"在 rollup 没写"要你做："时（旧 rollup）：等你决定 / 受阻取"需要你决定"里的"答法："（dispatch.md 的格式要求最后给
# 一行答法）那一句，没有就按状态写一句用户要做的动作（以前退回逻辑把"等了 27 小时"放进了这一列）。
BOARD_ASK_FALLBACK = (("等你决定", "看转达，回你的决定"), ("受阻", "看转达，定下一步"))
ANSWER_RE = re.compile(r"^(?:[-*]\s*)?答法\s*[：:]\s*(.*)$")


def first_sentence(text: str) -> str:
    """到第一个"。"或"；"为止（不含）。"""
    return re.split(r"[。；]", text, maxsplit=1)[0].strip()


def rollup_ask(roll: dict) -> str:
    """等你决定 / 受阻的旧 rollup（没有"要你做："）的"要你做什么"："## 需要你决定"里"答法："那一行冒号后面的第一句；没有这一行
    按状态写一句通用的动作（BOARD_ASK_FALLBACK）。"""
    for line in rollup_section(roll["lines"], "需要你决定"):
        m = ANSWER_RE.match(line)
        if m and first_sentence(m.group(1)):
            return first_sentence(m.group(1))
    return next(text for prefix, text in BOARD_ASK_FALLBACK if roll["status"].startswith(prefix))


def rollup_deliverables(roll: Optional[dict]) -> list:
    """旧 rollup 的"## 交付"一节（--json 的 deliverables）：[{"kind": look|doing|user|note, "item", "status"}]，开头不是那四种的行
    不认，"提醒："整句放 status；没有这一节、没有 rollup 是 []。"""
    out = []
    for line in rollup_section(roll["lines"], "交付") if roll else []:
        m = DELIVERABLE_RE.match(line)
        if not m:
            continue
        kind, text = DELIVERABLE_KINDS[m.group(1)], m.group(2).strip()
        item, status = ("", text) if kind == "note" else (DELIVERABLE_SPLIT_RE.split(text, 1) + [""])[:2]
        out.append({"kind": kind, "item": item.strip(), "status": status.strip()})
    return out


def rollup_wrapup(roll: Optional[dict]) -> tuple[bool, Optional[str], bool]:
    """(能不能收尾, 不能的原因, 编排者写没写)。按 rollup 的"收尾："：以"可以"开头能；别的（"先别，<原因>"）不能，原因取"先别"
    后面那段。没写这一行时，状态是完成就算能，别的状态不能（原因"还没完成"）。编排者最清楚能不能收（比如有没推的改动），
    一键收尾靠它挡住不该收的；收尾本身没推送过的分支也不删、先问（flow/wrapup.md）。"""
    value = (roll["fields"].get("收尾") or "").strip() if roll else ""
    if value:
        return (True, None, True) if value.startswith("可以") else (False, re.sub(r"^先别[，,：:\s]*", "", value) or value, True)
    return (True, None, False) if roll and roll["status"].startswith("完成") else (False, "还没完成", False)


def task_wrapup(roll: Optional[dict], unread: bool) -> tuple[bool, Optional[str]]:
    """看板的收尾格、一键收尾名单（wrapup_ready）用的 (能不能收尾, 不能的原因)：编排者在 rollup 里说可以（rollup_wrapup），而且
    主会话读过这一版。还没审、没转达的结论不能被一句"全部收尾"收掉（会删掉用户还没看到结论的任务的 worktree），原因写
    WRAPUP_UNREAD_REASON；编排者自己写了先别的照它的原因。"""
    can, hold, _ = rollup_wrapup(roll)
    return (False, WRAPUP_UNREAD_REASON) if can and unread else (can, hold)


def rollup_flags(slug_dir: Path, roll: Optional[dict]) -> tuple[bool, Optional[float]]:
    """(unread, answered_at)。unread：状态要主会话处理，内容又和主会话用 drover rollup 读过的（main-seen.json）不同；
    answered_at：drover prompt 给编排者发过答复（answered.json）、rollup 从那时起内容没变（answered.json 记的 digest 就是现在的，
    和"未读"一样按规范化内容比：编排者收到答复后原样重写一遍再停下，按修改时间比就成了"等你决定"、没人再转）时是转答复的时间，
    否则 None。"""
    if roll is None:
        return False, None
    seen = read_json_dict(slug_dir / MAIN_SEEN_FILE)
    answered = read_json_dict(slug_dir / ANSWERED_FILE)
    unread = roll["status"].startswith(ROLLUP_ATTENTION) and roll["digest"] != seen.get("digest")
    return unread, as_float(answered.get("at")) if answered.get("rollup_digest") == roll["digest"] else None


def closed_after_done(d: Path, roll: Optional[dict], agent_status: str) -> bool:
    """收尾完关掉的历史任务（用户状态目录里几十个都是这样）：编排者已经退出、rollup 是完成、主会话读过这一版。watch --main 不盯，
    看板不显示，orch-status 的 needs_attention 不算。没读过的不算：编排者写完结论 tab 就被关了、herdr 或电脑重启了，结论还没转。
    没有时间线（TIMELINE_FILE，orch-start 派发时就写）的是装上已读记录之前的老任务，算读过：本机 51 个已退出、没读过的完成任务
    都没有时间线，有时间线的完成任务都读过，不这样升级后它们会一起翻出来。"""
    if agent_status != "gone" or roll is None or not roll["status"].startswith("完成"):
        return False
    return not rollup_flags(d, roll)[0] or not (d / TIMELINE_FILE).exists()


def write_json_atomic(path: Path, obj: dict) -> None:
    """先写同目录的临时文件再改名：watch --main、board、主会话同时读写时不会读到半截。"""
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(obj, ensure_ascii=False, indent=2))
    os.replace(tmp, path)


# ---------------------------------------------------------------- 时间线（TIMELINE_FILE 上面的说明）

def timeline_read(d: Path) -> list:
    """<d>/timeline.jsonl 的全部事件，按文件里的顺序；没有文件是 []，坏行跳过。"""
    return read_jsonl(d / TIMELINE_FILE)


def timeline_event(event: str, at: float, source: str, **fields: Any) -> dict:
    """时间线的一条：at 是事情发生的时间，logged 是写下的时间（观察者按 rollup 修改时间补记的，两者可以差很久）；source 是谁记的
    （命令名，或者观察者 watch-main / board）。"""
    return {"at": round(at, 3), "logged": round(time.time(), 3), "event": event, "source": source, **fields}


@contextlib.contextmanager
def timeline_session(d: Path):
    """拿着 flock(timeline.jsonl) 读-比-追加（locked_append）：yield (已有的事件, 要追加的列表)，退出时把列表里的追加上去
    （agent-state.json 是 os.replace 换的，锁不住，不走这里）。写不了（目录只读）不影响调用方。"""
    new: list = []
    with locked_append(d / TIMELINE_FILE, best_effort=True) as (text, chunks):
        yield jsonl_rows(text), new
        chunks.extend(json.dumps(e, ensure_ascii=False) + "\n" for e in new)


def timeline_note(d: Path, event: str, source: str, **fields: Any) -> None:
    """命令当场记一条现在发生的事。"""
    with timeline_session(d) as (_, new):
        new.append(timeline_event(event, time.time(), source, **fields))


def last_event(events: list, kind: str) -> Optional[dict]:
    return next((e for e in reversed(events) if e.get("event") == kind), None)


def request_time(d: Path) -> Optional[float]:
    """没有时间线的老任务估派发时间：request.md（主会话派发时写）和 rollup.md 修改时间里早的那个（编排者写 rollup 一定在
    派发之后，request.md 后来被改过时不会估到 rollup 后面去），都没有就是 orch.json 的。"""
    found = []
    for name in ("request.md", "rollup.md"):
        with contextlib.suppress(OSError):
            found.append((d / name).stat().st_mtime)
    if not found:
        with contextlib.suppress(OSError):
            found.append((d / "orch.json").stat().st_mtime)
    return min(found) if found else None


# 看板的显示状态（分组、"状态持续"都按它）：rollup 的状态，加上一个 drover 自己知道的"已转答复"——等你决定 / 受阻时
# drover prompt 转过答复、rollup 还没更新（rollup_flags 的 answered_at）。没有 rollup 的算进行中。
def display_state(roll: Optional[dict], answered_at: Optional[float]) -> str:
    status = roll["status"] if roll else ""
    if status.startswith(("等你决定", "受阻")):
        return "已转答复" if answered_at is not None else "等你决定" if status.startswith("等你决定") else "受阻"
    return next((s for s in ("完成", "需要换编排者") if status.startswith(s)), "进行中")


def timeline_state(d: Path, events: list, roll: Optional[dict], answered_at: Optional[float],
                   source: str) -> tuple[dict, list]:
    """按时间线和现在的文件算：({state, since, start_at}, 观察者要补记的事件)。
    state 是显示状态；和时间线最后一条 state 一样时 since 取那条的 at，不一样（变了还没人记下）时取这次变化的时间：已转答复是
    转答复的时间，有 rollup 是它的修改时间（编排者直接写文件，不经 drover 命令；晚看到也准），都没有是派发时间。
    没有派发那条（start）的（这套记录装上之前派发的老任务）按 request_time 补一条，第一次补的 state 也标 estimated：之前改过
    几次状态不知道，只知道最后一次。start_at 是最近一次派发（换编排者是 replace，不算派发）。"""
    new = []
    start = last_event(events, "start")
    if start is None:
        start = timeline_event("start", request_time(d) or time.time(), source, estimated=True)
        new.append(start)
    start_at = as_float(start.get("at"))
    state = display_state(roll, answered_at)
    last = last_event(events, "state")
    since = as_float(last.get("at")) if last and last.get("state") == state else None
    if since is None:
        since = answered_at if state == "已转答复" else roll["mtime"] if roll else start_at
        mark = {"estimated": True} if last is None and start.get("estimated") else {}
        new.append(timeline_event("state", since, source, state=state, status=roll["status"] if roll else None, **mark))
    return {"state": state, "since": since, "start_at": start_at}, new


# 停了没更新：编排者停着（自己不会再动），显示状态却是进行中或已转答复。watch --main 报 stalled、看板写"停了 N 分钟没更新"、
# 时间线记 stalled 都按 stall_since 这一个判定（以前两套：watch --main 只认 done / idle 加 rollup 写着进行中，没写 rollup 就停了、
# 状态写成别的词、herdr 报 unknown、挂着后台命令的，时间线记了 stalled、watch 却一直不报）。
STALL_SHOWN = ("done", "idle", "unknown")
# 状态栏挂着后台命令（waiting-background）的编排者在等它叫醒自己。Monitor 最长 30 分钟、到期必叫醒（dispatch.md 追踪那条的
# timeout_ms 1800000），叫醒就是新的一段；同一段挂过这么久，等的就是不会自己结束的命令（验收时起的 dev server 之类），从这时起算停着。
BACKGROUND_WAIT_MAX_SECONDS = 30 * 60


def stall_since(d: Path, info: dict) -> Optional[float]:
    """停了没更新从什么时候算起（见 STALL_SHOWN 上面的说明）；不算停着返回 None。info 是 timeline_state 的结果（显示状态和它
    从什么时候开始）。编排者现在的状态看 agent-state.json（note_agent_state，watch --main 和看板谁先看到谁记）：done / idle /
    unknown 从这一段开始算，waiting-background 从这一段开始 BACKGROUND_WAIT_MAX_SECONDS 之后算；和显示状态开始的时间取晚的那个。"""
    agent = read_json_dict(d / AGENT_STATE_FILE)
    since, shown = as_float(agent.get("since")), str(agent.get("shown") or "")
    if info["state"] not in ("进行中", "已转答复") or since is None:
        return None
    if shown.startswith("waiting-background"):
        since += BACKGROUND_WAIT_MAX_SECONDS
    elif shown not in STALL_SHOWN:
        return None
    # 取到毫秒，同时间线里记的：显示状态刚变时 info 的 since 是原值，之后读的是时间线记的那条（取过毫秒），不取的话起点前后对不上、
    # watch --main 会把同一段停顿当成新的一段再报
    return round(max(since, info["since"] or since), 3)


def timeline_stalled(d: Path, events: list, info: dict, now: float, source: str) -> Optional[dict]:
    """停了没更新（stall_since）满 MAIN_IDLE_MINUTES 记一条（at 是看到的时间，since 是起点），按起点去重。"""
    start = stall_since(d, info)
    if (start is None or now - start < MAIN_IDLE_MINUTES * 60
            or any(e.get("event") == "stalled" and e.get("since") == start for e in events)):
        return None
    return timeline_event("stalled", now, source, since=start)


def timeline_observe(task: dict, now: float, source: str) -> tuple[Optional[dict], dict]:
    """观察者（watch --main 每一轮、看板每次读屏）对一个任务补记：显示状态的变化（timeline_state）、停了没更新。在时间线锁里
    重新读 rollup 和 answered.json，不用调用方在锁外读的那份：两边一前一后读到新旧两版时，后拿到锁的会把旧状态再记一遍。
    返回 (这次读到的 rollup, timeline_state 的结果)。"""
    d = task["dir"]
    with timeline_session(d) as (events, new):
        roll = read_rollup(d / "rollup.md")
        info, pending = timeline_state(d, events, roll, rollup_flags(d, roll)[1], source)
        stalled = timeline_stalled(d, events + pending, info, now, source)
        new += pending + ([stalled] if stalled else [])
    return roll, info


def timeline_view(d: Path, roll: Optional[dict]) -> dict:
    """不记、只算（board --line / --pending：不读屏、不写文件）：结果和观察者这时会记下的一致。"""
    return timeline_state(d, timeline_read(d), roll, rollup_flags(d, roll)[1], "board")[0]


def note_observed(now: float) -> None:
    """观察者每一轮记一下最后一次看的时间（全局 OBSERVE_FILE）；离上次超过 OBSERVE_GAP_SECONDS 时往 OBSERVE_GAPS_FILE 追加
    {from, to}：这段时间没人看，时间线里的确认框、接口错误记不到，状态中间改过几次的只剩最后一次。两个观察者拿同一把锁。"""
    with contextlib.suppress(OSError), flock_file(OBSERVE_LOCK, None):
        last = as_float(read_json_dict(OBSERVE_FILE).get("last"))
        if last is not None and now - last > OBSERVE_GAP_SECONDS:
            with open(OBSERVE_GAPS_FILE, "a") as fh:
                fh.write(json.dumps({"from": round(last, 3), "to": round(now, 3)}) + "\n")
        if last is None or now > last:
            write_json_atomic(OBSERVE_FILE, {"last": round(now, 3)})

def cmd_orch_status(a: argparse.Namespace) -> dict:
    """列出编排者：herdr 里的状态 + rollup 的状态行。给主会话一条命令看全部（Codex 没有 Monitor，每轮开头查一次）。
    herdr 报 working / done / idle 的编排者读一次屏幕，按 watch 的规则（screen_override）修正：和 herdr 的原值不同时写进
    screen_status（agent_status 保留 herdr 的原值，needs_attention 仍按原值判断）。卡在确认框上的编排者（herdr 报 blocked，
    或者屏幕修正成 blocked：后台子 agent 的确认框会被 herdr 报成 working）列进顶层 blocked（slug、name），没有就不出这个键。
    读屏失败按原值；codex 编排者 working 时不读（screen_override 只在 Claude Code 上认 working 时的弹框）。
    每行带 rollup_summary、unread、answered_after_rollup（见 rollup_flags）；needs_attention 只算
    未读的（主会话用 drover rollup 读过就不算），以前只看状态，--all 会列出几十个早就转达过的"完成"。
    编排者名被后来的任务复用时，活着的同名 agent 只算最新那份 orch.json 的，更早的同名任务是 gone（orch_records；以前只按名字
    对，新任务的编排者活着，同名的旧任务就一直显示 working）；orch-start 正在起的那一份不列。"""
    ok, res = herdr(["agent", "list"], timeout=30)
    if not ok:
        raise DroverError("herdr agent list 失败", error=res)
    alive = {x.get("name"): x for x in res.get("agents", []) if x.get("name")}
    rows, seen, attention = [], set(), []
    for rec in orch_records():
        meta, d = rec["meta"], rec["dir"]
        name = meta.get("name")
        seen.add(name)
        # 同名的几份 orch.json（名字被后来的任务复用）里，活着的 agent 只算最新那份的，更早的是已经退出的（orch_records）
        agent = alive.get(name) if rec["latest"] else None
        if meta.get("parent") and not a.with_sub:
            continue
        if agent is None and not a.all:
            continue
        status = agent.get("agent_status") if agent else "gone"
        roll = read_rollup(d / "rollup.md")
        unread, answered_at = rollup_flags(d, roll)
        row = {"slug": meta.get("slug") or d.name, "name": name, "kind": meta.get("kind"),
               "parent": meta.get("parent"), "agent_status": status, **rollup_header(roll),
               "unread": unread, "answered_after_rollup": answered_at is not None}
        fixed = corrected_status(name, status, (agent or {}).get("agent") or meta.get("kind"))
        if fixed:
            row["screen_status"] = fixed
        rows.append(row)
        # unread 已经按前缀要求状态要处理；收尾完关掉的（编排者已退出、完成、主会话读过这一版）不算。
        if unread and status in ("done", "idle", "gone") and not closed_after_done(d, roll, status):
            attention.append(row["slug"])
    # 活着、名字是 orch- 开头、却没有对应 orch.json 的（不是 orch-start 起的，或 orch.json 被删了）：照样列出来，
    # slug 要自己对（tab 标签就是 slug）。
    unmatched = [{"name": n, "agent_status": x.get("agent_status"), "tab_id": x.get("tab_id")}
                 for n, x in alive.items() if n.startswith("orch-") and n not in seen]
    result = {"ok": True, "orchestrators": rows}
    if unmatched:
        result["without_orch_json"] = unmatched
    blocked = [{"slug": r["slug"], "name": r["name"]} for r in rows
               if "blocked" in (r["agent_status"], r.get("screen_status"))]
    if blocked:
        result["blocked"] = blocked
    result["needs_attention"] = attention
    return result


# ---------------------------------------------------------------- main-register

# 主会话在 herdr 里的 agent 名（和 herdr-oncall 插件的约定）：插件按这个名字认主会话，只给主会话推确认框和 done，
# 不引用的飞书消息也送进它。herdr 的名字跟着 pane 里当前的 agent 走，退出重开、/clear 都会被清掉（实测），
# 所以 install.py 在 Claude Code 的 SessionStart hook 里每次都跑 main-register --hook，路由规则"会话刚开始"那一步兜底。
# Codex 不装 hook：codex 的 SessionStart 第一条消息时才跑（和路由规则同一时刻），新 hook 还要用户手动信任，
# 信任之前所有 codex 会话（含 drover 起的编排者、worker）启动都会卡在"Hooks need review"上。
MAIN_AGENT_NAME = "drover"
# --hook 等 herdr 换上这次 session 的上限和间隔（秒）。SessionStart 刚跑时，手动起的会话 herdr 里还没有（agent_not_found）；
# /clear 时 herdr 里还是旧 session、旧名字，0.5～2 秒后才换成新 session 并清掉名字（探针实测）。所以先等
# agent_session 对上 hook 输入的 session_id 再判断，不然会把马上要被清掉的旧名字当成"已经登记过"。
# 环境变量 DROVER_MAIN_REGISTER_WAIT 给自测缩短用。
MAIN_REGISTER_WAIT = float(os.environ.get("DROVER_MAIN_REGISTER_WAIT") or 8)
MAIN_REGISTER_POLL = 0.5
MAIN_REGISTER_HERDR_TIMEOUT = 5


def hook_input() -> dict:
    """hook 从 stdin 收到的 JSON（session_id、cwd、source…）；stdin 是终端、读不出或不是 JSON 对象时是 {}。"""
    try:
        if sys.stdin is None or sys.stdin.isatty():
            return {}
        data = json.loads(sys.stdin.read() or "{}")
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def pane_agent(pane: str) -> Optional[dict]:
    """herdr 里这个 pane 当前的 agent（agent get 的 result.agent）；pane 里没有 agent 时 None。名字只有这里和 agent list 有，
    pane get / pane current 都不带 name。"""
    ok, res = herdr(["agent", "get", pane], timeout=MAIN_REGISTER_HERDR_TIMEOUT)
    agent = res.get("agent") if ok else None
    return agent if isinstance(agent, dict) else None


def wait_pane_agent(pane: str, session_id: Optional[str]) -> tuple[Optional[dict], bool]:
    """等 herdr 里这个 pane 的 agent_session 变成 session_id（没给 session_id 时只查一次）。返回 (agent, 是否对上)。
    到了上限还没对上，就按当时的样子返回：没装 herdr 的状态 hook 时 herdr 根本拿不到 session，只能这样判断。"""
    deadline = time.time() + (MAIN_REGISTER_WAIT if session_id else 0)
    while True:
        agent = pane_agent(pane)
        if not session_id:
            return agent, False
        if agent and (agent.get("agent_session") or {}).get("value") == session_id:
            return agent, True
        if time.time() >= deadline:
            return agent, False
        time.sleep(MAIN_REGISTER_POLL)


def workspace_label(workspace_id: str) -> Optional[str]:
    ok, res = herdr(["workspace", "list"], timeout=MAIN_REGISTER_HERDR_TIMEOUT)
    if not ok:
        raise DroverError("herdr workspace list 失败", error=res)
    for ws in res.get("workspaces", []):
        if ws.get("workspace_id") == workspace_id:
            return ws.get("label")
    return None


def check_not_orch(workspace_id: Optional[str]) -> None:
    """编排者的工作目录也是主工作台，名字被清掉后（比如 /clear）它也像一个"没名字的主会话"：在 orch workspace 里一律不登记。"""
    if workspace_id and workspace_label(workspace_id) == ORCH_WORKSPACE_LABEL:
        raise DroverError(f"这个 pane 在编排者的 {ORCH_WORKSPACE_LABEL} workspace 里（{workspace_id}），不是主会话，不登记",
                          reason="orch_workspace", workspace_id=workspace_id)


def in_workspace(path: Optional[str]) -> bool:
    """path 就是主工作台（软链进来的也算）：主会话的工作目录。main-register --hook、看板补登记（board_reregister）都按它认主会话。"""
    return bool(path) and TRUSTED_ROOT is not None and os.path.realpath(path) == os.path.realpath(str(TRUSTED_ROOT))


def main_register(hook: bool, info: dict) -> dict:
    """把当前 pane 的 agent 改名为 drover。拒绝时抛 DroverError（reason 说明是哪种情况）。
    --hook 额外要求工作目录就是主工作台，并且先等 herdr 换上 hook 输入里的那个 session。"""
    pane = os.environ.get("HERDR_PANE_ID")
    if os.environ.get("HERDR_ENV") != "1" or not pane:
        raise DroverError("不在 Herdr 的 pane 里（HERDR_ENV 不是 1 或没有 HERDR_PANE_ID）：主会话要在 Herdr 里打开才能登记",
                          reason="not_in_herdr")
    if hook:
        # 本机每个 Claude Code 会话（worker、编排者、别处开的）都会跑这个 hook：先做不调 herdr 的检查，绝大多数到这里就结束。
        if TRUSTED_ROOT is None:
            raise DroverError(NO_WORKSPACE_ERROR, reason="no_workspace")
        cwd = str(info.get("cwd") or os.getcwd())
        if not in_workspace(cwd):
            raise DroverError(f"工作目录 {cwd} 不是主工作台 {TRUSTED_ROOT}，不是主会话", reason="not_workspace")
    env_ws = os.environ.get("HERDR_WORKSPACE_ID")
    check_not_orch(env_ws)
    # 认出是主会话之后：记下"载入时"的规则、触发自动更新检查（main_session_seen）。hook 里越早越好：下面等 herdr 换 session
    # 最多 MAIN_REGISTER_WAIT 秒，这段时间里别处触发的自动更新要是改了 AGENTS.md，记下的就成了会话没载入过的新版本。
    # herdr 给每个 pane 都注入 HERDR_WORKSPACE_ID；没有时要等拿到 agent、按它的 workspace 排除编排者之后才记。
    early = hook and bool(env_ws)
    if early:
        main_session_seen(True)
    session_id = info.get("session_id") if hook and isinstance(info.get("session_id"), str) else None
    agent, matched = wait_pane_agent(pane, session_id)
    if agent is None:
        raise DroverError(f"herdr 里 pane {pane} 现在没有 agent（herdr 还没认出这个会话）：等会话起来后再跑一次",
                          reason="no_agent", pane_id=pane)
    if not env_ws:
        check_not_orch(agent.get("workspace_id"))
    # 不带 --hook 的：Codex 主会话没有 hook，第一条消息时的这一次就是它载入 AGENTS.md 之后最早的时机，要记规则、记 session；
    # Claude Code 主会话的这一次只是兜底登记（hook 已经在会话开始时记过），再记会把"载入时"盖成之后的版本、session_id 盖成 null。
    # main-session.json 例外：记的不是这个 pane 时（hook 没登记上）照样补写，见 record_main_session。
    records = hook or agent.get("agent") == "codex"
    if not early:
        main_session_seen(records)
    base = {"pane_id": pane, "name": MAIN_AGENT_NAME, **({"session_matched": matched} if session_id else {})}
    current = agent.get("name")
    if current == MAIN_AGENT_NAME:
        record_main_session(pane, session_id, info, records)
        return {"ok": True, "action": "already", **base}
    if current:
        raise DroverError(f"这个 pane 的 agent 已经叫 {current}，不改名：main-register 只给还没有名字的主会话登记",
                          reason="named", current_name=current, pane_id=pane)
    ok, res = herdr(["agent", "list"], timeout=MAIN_REGISTER_HERDR_TIMEOUT)
    if not ok:
        raise DroverError("herdr agent list 失败", error=res)
    taken = [x.get("pane_id") for x in res.get("agents", [])
             if x.get("name") == MAIN_AGENT_NAME and x.get("pane_id") != pane]
    if taken:
        raise DroverError(f"已经有一个主会话登记成 {MAIN_AGENT_NAME} 了（pane {taken[0]}），这个会话不登记："
                          "飞书里不引用直接发的消息会送到那一个。要换成这个，先关掉那个会话再跑一次 main-register",
                          reason="conflict", conflict_pane=taken[0], pane_id=pane)
    ok, res = herdr(["agent", "rename", pane, MAIN_AGENT_NAME], timeout=MAIN_REGISTER_HERDR_TIMEOUT)
    if not ok:
        raise DroverError("herdr agent rename 失败", error=res, pane_id=pane)
    record_main_session(pane, session_id, info, records)
    return {"ok": True, "action": "renamed", **base}


def record_main_session(pane: str, session_id: Optional[str], info: dict, records: bool) -> None:
    """登记上了（改名成功，或者本来就叫 drover）：写 MAIN_SESSION_FILE。rules --hook 按 session_id 认主会话，watch --main
    按它变没变、source 是不是 clear / startup 认出 /clear 之后的新对话，drover rollup 按 pane_id 认主会话（main_caller）。
    Codex（不带 --hook）没有 session_id、source，写 null。写不了（沙箱）不影响登记。
    records 为 False（Claude Code 不带 --hook 的兜底登记）时只在记录不是这个 pane 时写，session_id、source 写 null：
    hook 没登记上（等 herdr 超时）时记录还停在上一个会话，换了 pane 时 drover rollup 就一直认不出主会话。旧的 session_id
    本来就不是这个会话的，写 null 不会让 rules --hook 误认（它要求 session_id 相等），也不会让 watch --main 误报重开
    （source 不是 clear / startup）。同一个 pane 时不动，hook 记的 session_id 留着。"""
    if not records and read_json_dict(MAIN_SESSION_FILE).get("pane_id") == pane:
        return
    source = info.get("source") if isinstance(info.get("source"), str) else None
    with contextlib.suppress(OSError):
        write_json_atomic(MAIN_SESSION_FILE, {"session_id": session_id, "pane_id": pane, "source": source,
                                              "at": time.time()})


def main_session_seen(record_rules: bool) -> None:
    """main-register 认出了主会话：record_rules 时先记下"载入时"的规则（main-rules.json），再触发自动更新检查。顺序不能反：
    自动更新会改 AGENTS.md。顺带触发后台维护（续命令同步、闲置 worker 的释放）。都不能让登记失败（两个 tick 自己不抛异常）。"""
    if record_rules:
        with contextlib.suppress(OSError):
            record_main_rules("main-register")
    auto_update_tick()
    upkeep_tick()


def cmd_main_register(a: argparse.Namespace) -> dict:
    return main_register(False, {})


def cmd_main_register_hook(a: argparse.Namespace) -> int:
    """SessionStart hook 用：不管成败退出码都是 0，stdout 什么都不写（Claude Code 会把 SessionStart hook 的 stdout
    塞进会话上下文），不打扰会话。为什么没登记上，手动跑一次不带 --hook 的 main-register 就能看到原因。"""
    try:
        main_register(True, hook_input())
    except BaseException:  # noqa: BLE001 —— hook 里任何失败（含 herdr 超时、找不到命令、Ctrl-C）都只能静默放过
        pass
    return 0


# ---------------------------------------------------------------- oncall（内置的 herdr-oncall 插件）

# 和 install.py 一致（tests/test_install.py 断言两边相同）：插件 id、带按角色通知的最低版本、drover 写给插件的 drover.env。
ONCALL_PLUGIN_ID = "com.codreamer.herdr.oncall"
ONCALL_MIN_VERSION = "0.7.0"
ONCALL_ENV_NAME = "drover.env"
ONCALL_ENV_TEXT = """\
# 由 drover 的 install.py 写入：重装时整份覆盖，卸载时删除。
# 要改某一项，写到同目录的 .env 里（.env 优先），不要改这个文件。
MAIN_AGENT_NAME=drover
SUPERVISOR_PREFIX=orch-
SUPERVISOR_ESCALATE_SEC=300
SUPERVISOR_ESCALATE_SEC_CODEX=120
SUPERVISED_ESCALATE_SEC=600
BARE_MESSAGE_TARGET=main
MAIN_DONE_PING=relay
MAIN_RELAY_MARKER=【转达】
CHAT_IMAGE_DIR=~/.drover/oncall-images
"""
# drover oncall <动作> → 插件 action id（contract.md 第 6 节）。status 不走 action：action invoke 立即返回、不带输出。
ONCALL_ACTIONS = {"pair": "pair-feishu", "unpair": "unpair-feishu", "test": "test", "on": "enable", "off": "disable"}
ONCALL_STATUS_SCRIPT = "src/actions/status.mjs"
ONCALL_LOG_HINT = f"herdr plugin log list --plugin {ONCALL_PLUGIN_ID} --limit 5"
# 透传插件的输出前，键名像密钥的字符串值一律换掉（插件约定只报有没有，这里再挡一道）。
SECRET_KEY_RE = re.compile(r"(?i)(token|secret|open_?id|chat_?id)")
# 插件的 pair-feishu 把配对链接打印成一行 "open: <url>"（插件 src/actions/pair-feishu.mjs）；已配对时打印的那行带 open_id，不给人看。
PAIR_LINK_RE = re.compile(r"^\s*open:\s*(\S+)", re.M)
SECRETISH_LINE_RE = re.compile(r"(?i)(open_?id|secret|token)")
# 插件说"已经配对过"的两种写法（英文那行带 app / open_id，中文那行带机器人 id）。
PAIRED_WORDS = ("already paired", "已经配对过飞书")
# 等插件日志里这次 action 跑完（已配对的机器先向飞书核对，真机 22 秒）、等飞书配对上时查 status 的间隔（秒）。
# 环境变量给自测缩短用。
ONCALL_LOG_WAIT = float(os.environ.get("DROVER_PAIR_LOG_WAIT") or 45)
ONCALL_PAIR_POLL = float(os.environ.get("DROVER_PAIR_POLL") or 3)


def version_tuple(value: Any) -> tuple:
    return tuple(int(x) for x in re.findall(r"\d+", str(value or ""))[:3]) or (0,)


def redact(obj: Any) -> Any:
    if isinstance(obj, dict):
        return {k: ("<redacted>" if isinstance(v, str) and SECRET_KEY_RE.search(str(k)) else redact(v))
                for k, v in obj.items()}
    if isinstance(obj, list):
        return [redact(v) for v in obj]
    return obj


def oncall_plugin() -> Optional[dict]:
    ok, res = herdr(["plugin", "list", "--json", "--plugin", ONCALL_PLUGIN_ID], timeout=30)
    if not ok:
        raise DroverError("herdr plugin list 失败（herdr 没在运行时，先在终端里运行 herdr）", error=res)
    return next((p for p in res.get("plugins", []) if p.get("plugin_id") == ONCALL_PLUGIN_ID), None)


def require_oncall_plugin() -> dict:
    plugin = oncall_plugin()
    if plugin is None:
        raise DroverError("没装飞书 oncall（herdr-oncall 插件，选装）：在 drover 的 clone 里重跑 python3 install.py --oncall，"
                          "它会从 GitHub 装好插件",
                          plugin_id=ONCALL_PLUGIN_ID)
    return plugin


def oncall_env_view() -> dict:
    """drover.env 在不在、内容是不是 drover 现在要写的。插件装着时 config-dir 目录本来就在（这条命令会建目录）。"""
    p = run(["herdr", "plugin", "config-dir", ONCALL_PLUGIN_ID], timeout=30)
    folder = p.stdout.strip() if p.returncode == 0 else ""
    if not folder:
        return {"path": None, "present": False, "error": tail(p.stderr or p.stdout, 300)}
    path = Path(folder) / ONCALL_ENV_NAME
    try:
        text = path.read_text()
    except OSError:
        return {"path": str(path), "present": False, "up_to_date": False}
    return {"path": str(path), "present": True, "up_to_date": text == ONCALL_ENV_TEXT}


def main_agent_view() -> dict:
    ok, res = herdr(["agent", "list"], timeout=30)
    if not ok:
        return {"registered": None, "error": res}
    found = next((x for x in res.get("agents", []) if x.get("name") == MAIN_AGENT_NAME), None)
    if not found:
        return {"registered": False}
    return {"registered": True, "pane_id": found.get("pane_id"), "agent": found.get("agent")}


def oncall_owner_hints(status: dict) -> list:
    """飞书 oncall 归属的不是这次调用所在的 herdr 时的一条提示，否则 []。插件 status 的 owner 是 Oncall 归属的 herdr server
    （只属于一个，按 socket 路径认）：socket_path 不空、current_session 是 false 才是归属在别处。还没有归属记录时 socket_path 是
    null（current_session 也是 false，不代表在别处）、旧版插件没有 owner，都不提示。running 是 false 时点明那个 herdr 没在运行
    （true、说不清的 null 不提）。来由：11-23 飞书送不进主会话那次，插件连的是另一个 herdr，status 只显示收信进程活着、hints 是空的。"""
    owner = status.get("owner") or {}
    if not owner.get("socket_path") or owner.get("current_session") is not False:
        return []
    stopped = "，它没在运行" if owner.get("running") is False else ""
    return [f"飞书 oncall 现在归属另一个 herdr（{owner['socket_path']}{stopped}）：这个 herdr 里的主会话收不到飞书消息和按钮，"
            f"要切过来就在这个 herdr 里跑 herdr plugin action invoke poll --plugin {ONCALL_PLUGIN_ID}"]


def oncall_hints(plugin: dict, view: dict, status: Optional[dict]) -> list:
    hints = []
    source = (plugin.get("source") or {}).get("kind")
    if not view["plugin"]["version_ok"]:
        hints.append(f"插件版本 {plugin.get('version')} 低于 {ONCALL_MIN_VERSION}，还没有按角色通知：" +
                     (f"本地链接的插件，到 {plugin.get('plugin_root')} 里 git pull" if source == "local"
                      else "重跑 python3 install.py 会更新它"))
    if plugin.get("enabled") is False:
        hints.append(f"插件在 herdr 里被禁用了：herdr plugin enable {ONCALL_PLUGIN_ID}")
    env = view["drover_env"]
    if not env.get("present"):
        hints.append("drover.env 不在：插件按单独使用时的规则通知（不分角色），重跑 python3 install.py 补上")
    elif not env.get("up_to_date"):
        hints.append("drover.env 和这版 drover 要写的不一样：重跑 python3 install.py 刷新")
    if view["main_agent"].get("registered") is False:
        hints.append("主会话还没登记（herdr 里没有叫 drover 的 agent）：在主会话里跑 ~/.drover/bin/drover main-register")
    if status:
        if status.get("enabled") is False:
            hints.append("插件自己的开关关着（不推送也不收飞书消息）：drover oncall on")
        feishu = (status.get("channels") or {}).get("feishu") or {}
        if feishu.get("paired") is False:
            hints.append("飞书还没配对：drover oncall pair（Mac 桌面会弹二维码；没弹就用飞书打开它给的链接）")
        elif feishu.get("replies_supported") is False:
            hints.append("Node 低于 22：能收到推送，但飞书里的回复送不回来，升级 Node 到 22+")
        hints += oncall_owner_hints(status)
    return hints


def run_status_script(plugin: dict) -> tuple[Optional[dict], Optional[str]]:
    """跑插件的 status 脚本（contract 第 5 节）。返回 (status JSON, 出错原因)；太旧没有脚本时原因里说怎么办。"""
    root = plugin.get("plugin_root") or ""
    source = (plugin.get("source") or {}).get("kind")
    if not root or not (Path(root) / ONCALL_STATUS_SCRIPT).is_file():
        how = (f"本地链接的插件，到 {root} 里 git pull" if source == "local" else "重跑 python3 install.py 会更新它")
        return None, (f"插件 {plugin.get('version')} 太旧，没有 status 脚本（{ONCALL_STATUS_SCRIPT}，"
                      f"{ONCALL_MIN_VERSION} 起才有）：{how}")
    p = run(["/bin/bash", str(Path(root) / "bin" / "run-node.sh"), ONCALL_STATUS_SCRIPT], cwd=root, timeout=30)
    lines = [line for line in (p.stdout or "").splitlines() if line.strip()]
    status = None
    if p.returncode == 0 and lines:
        with contextlib.suppress(ValueError):
            status = json.loads(lines[-1])
    if not isinstance(status, dict):
        return None, f"插件的 status 脚本没给出 JSON（退出码 {p.returncode}）：{tail(p.stderr, 300)}"
    return status, None


def feishu_paired(status: Optional[dict]) -> Optional[bool]:
    paired = (((status or {}).get("channels") or {}).get("feishu") or {}).get("paired")
    return paired if isinstance(paired, bool) else None


def oncall_status(plugin: dict) -> dict:
    root = plugin.get("plugin_root") or ""
    view = {
        "plugin": {"version": plugin.get("version"), "min_version": ONCALL_MIN_VERSION,
                   "version_ok": version_tuple(plugin.get("version")) >= version_tuple(ONCALL_MIN_VERSION),
                   "source": (plugin.get("source") or {}).get("kind"), "herdr_enabled": plugin.get("enabled"),
                   "plugin_root": root},
        "drover_env": oncall_env_view(),
        "main_agent": main_agent_view(),
    }
    status, error = run_status_script(plugin)
    if status is None:
        return {"ok": False, "drover": view, "hints": oncall_hints(plugin, view, None), "error": error}
    status = redact(status)
    # drover 只引导飞书：没配过的 Telegram 不报（用户自己配过的照报）。
    channels = status.get("channels")
    if isinstance(channels, dict) and isinstance(channels.get("telegram"), dict) \
            and channels["telegram"].get("paired") is not True:
        channels.pop("telegram")
    return {"ok": True, "plugin_status": status, "drover": view, "hints": oncall_hints(plugin, view, status)}


def is_action_log(entry: dict, action_id: str) -> bool:
    """herdr plugin log list 里这条是不是这个 action 跑出来的（不是它在后台起的等待进程）。"""
    if entry.get("action") == action_id or entry.get("action_id") == action_id:
        return True
    cmd = [str(c) for c in entry.get("command") or []]
    return any(c.endswith(f"src/actions/{action_id}.mjs") for c in cmd) and "wait" not in cmd


def action_finished(entry: dict) -> bool:
    """herdr 先记一条 status: running、没有 stdout / stderr / exit_code / finished_unix_ms 的条目，动作跑完才把输出写进去。"""
    return entry.get("status") not in (None, "running") or "finished_unix_ms" in entry or "exit_code" in entry


def action_log(action_id: str, since: float) -> tuple[Optional[dict], bool]:
    """等插件把这次 action 的输出记进 herdr 的插件日志（action invoke 立即返回，输出只在日志里），返回 (条目, 跑完没有)。
    要等条目跑完才有输出：已配对的机器先向飞书核对凭据、再给机器人发消息，真机实测 22 秒。最多等 ONCALL_LOG_WAIT 秒
    （默认 45）；stdout 里已经有 open: 就提前返回（herdr 现在不会中途给 stdout，写成兼容的）。since 是调用前的时间，
    早于它（再留 2 秒余量）的不算。等的时候往 stderr 打一句进度，stdout 只留最后的 JSON。"""
    since_ms = int(since * 1000) - 2000
    deadline = time.time() + ONCALL_LOG_WAIT
    latest, told = None, False
    while True:
        ok, res = herdr(["plugin", "log", "list", "--plugin", ONCALL_PLUGIN_ID, "--limit", "20"], timeout=30)
        hits = [x for x in (res.get("logs") or [] if ok else []) if isinstance(x, dict) and is_action_log(x, action_id)
                and (x.get("started_unix_ms") or 0) >= since_ms]
        if hits:
            latest = max(hits, key=lambda x: x.get("started_unix_ms") or 0)
            if action_finished(latest) or PAIR_LINK_RE.search(latest.get("stdout") or ""):
                return latest, action_finished(latest)
        if time.time() >= deadline:
            return latest, False
        if not told:
            print(f"等插件跑完 {action_id}（已配对的机器要先向飞书核对，可能要二三十秒；最多等 {int(ONCALL_LOG_WAIT)} 秒）……",
                  file=sys.stderr, flush=True)
            told = True
        time.sleep(0.5)


def safe_lines(*texts: str, limit: int = 3) -> list:
    """插件输出里能给人看的几行：去掉带 open_id / secret / token 的行（已配对时插件会打印 open_id）和链接行。"""
    lines = [line.strip() for text in texts for line in (text or "").splitlines()]
    return [line for line in lines if line and not SECRETISH_LINE_RE.search(line) and not PAIR_LINK_RE.match(line)][-limit:]


def invoke_action(action_id: str) -> tuple[list, dict]:
    cmd = ["plugin", "action", "invoke", action_id, "--plugin", ONCALL_PLUGIN_ID]
    ok, res = herdr(cmd, timeout=60)
    if not ok:
        raise DroverError(f"herdr {shlex.join(cmd)} 失败", error=res)
    return cmd, res


def wait_feishu_paired(plugin: dict, seconds: float) -> tuple[Optional[bool], Optional[str]]:
    """每 ONCALL_PAIR_POLL 秒跑一次 status 脚本，等飞书配对上。返回 (配上没有, 出错原因)；等不了（插件太旧）时 (None, 原因)。"""
    deadline = time.time() + seconds
    while True:
        status, error = run_status_script(plugin)
        if status is None and error and "太旧" in error:
            return None, error
        if feishu_paired(status):
            return True, None
        if time.time() >= deadline:
            return False, error
        time.sleep(min(ONCALL_PAIR_POLL, max(0.1, deadline - time.time())))


def oncall_pair(plugin: dict, wait: Optional[float]) -> dict:
    """调插件的 pair-feishu，从插件日志读出配对链接（open: <url>）给人：Mac 桌面会弹二维码，没弹（没编译面板、
    不是 macOS）就用飞书打开链接。--wait 时接着等到飞书配上，再自动发一条测试消息。"""
    started = time.time()
    cmd, res = invoke_action("pair-feishu")
    log, finished = action_log("pair-feishu", started)
    out, err = (log or {}).get("stdout") or "", (log or {}).get("stderr") or ""
    already = any(word in out + err for word in PAIRED_WORDS)
    m = PAIR_LINK_RE.search(out)
    link = m.group(1) if m else None
    result = {"ok": True, "action": "pair", "plugin_action": "pair-feishu", "command": "herdr " + shlex.join(cmd),
              "link": link, "already_paired": already}
    if already:
        result["hint"] = "飞书已配对（这台电脑配过了，不会新建机器人）。要换账号先 drover oncall unpair 再 pair"
    elif link:
        result["hint"] = ("Mac 桌面会弹出二维码，用手机飞书扫一下；没弹的话，用手机飞书打开 link。"
                          "扫完确认后跑 drover oncall status 看 plugin_status.channels.feishu.paired，再 drover oncall test")
    elif log is None or not finished:
        result["still_running"] = True
        result["hint"] = (f"插件还在处理这次配对（{int(ONCALL_LOG_WAIT)} 秒内没跑完）：Mac 桌面可能会弹出二维码；稍后看 "
                          f"{ONCALL_LOG_HINT} 里 open: 后面的链接（用手机飞书打开），配没配上跑 drover oncall status 看")
    else:
        result["plugin_message"] = safe_lines(out, err)
        result["hint"] = f"插件没给出配对链接，原因见 plugin_message，或者看 {ONCALL_LOG_HINT}"
    if wait is None:
        return result
    if already:
        result["paired"] = True
        return result
    paired, error = wait_feishu_paired(plugin, wait)
    result["paired"] = paired
    if paired:
        test_cmd, _ = invoke_action("test")
        result["test"] = {"command": "herdr " + shlex.join(test_cmd)}
        result["hint"] = "飞书配对好了，发了一条测试消息，飞书里应该收到了"
        return result
    result["ok"] = False
    result["error"] = (f"等不了配对结果：{error}" if paired is None else
                       f"等了 {int(wait)} 秒，飞书还没配对上（扫码后要在飞书里点确认）：扫完再跑 drover oncall status 确认，"
                       "过期了就重跑 drover oncall pair")
    return result


def cmd_oncall(a: argparse.Namespace) -> dict:
    if a.wait is not None and a.action != "pair":
        raise DroverError("--wait 只给 pair 用：等飞书配对上再发测试消息")
    plugin = require_oncall_plugin()
    if a.action == "status":
        return oncall_status(plugin)
    action_id = ONCALL_ACTIONS[a.action]
    known = {x.get("id") for x in plugin.get("actions") or [] if isinstance(x, dict)}
    if known and action_id not in known:
        raise DroverError(f"插件 {plugin.get('version')} 里没有 {action_id} 这个动作：版本太旧，重跑 python3 install.py 更新",
                          plugin_actions=sorted(known))
    if a.action == "pair":
        return oncall_pair(plugin, a.wait)
    cmd, res = invoke_action(action_id)
    return {"ok": True, "action": a.action, "plugin_action": action_id, "command": "herdr " + shlex.join(cmd),
            "result": redact(res), "hint": f"动作已经交给插件执行（立即返回，不带输出），真实结果看：{ONCALL_LOG_HINT}"}


PROMPT_HINTS = {
    "timeout": "herdr 在等待时间内没报出 agent 的新状态（少见，正常 1 秒内就有）：交给 watch 追踪，"
               "长时间不变成 working 再 herdr agent read 看屏幕。",
    "agent_prompt_stalled": "agent 没有开始工作：先 herdr agent read 看屏幕（常见是弹窗或输入框残留），处理后重发一次。",
    "agent_blocked": "agent 停在审批或提问界面，prompt 没有发出去：先看屏幕，按第 7 节处理后再发。",
}
# 发 prompt 只等到 agent 开工（实测）：herdr 的 --wait 默认只把 idle / done / blocked 当结束，agent 正常开工就
# 一定等满 --timeout（实测 30.01 秒报 timeout）。加上 --until working，四种状态都写明（不依赖 herdr 怎么合并 --until
# 和默认集合）：空闲的 agent 0.4–0.6 秒返回 working，不会把发 prompt 之前的旧 done 当结果；正在干活的 0.3 秒返回 working；
# 卡在确认框上的照旧立刻报 agent_blocked。
PROMPT_UNTIL = ("working", "idle", "done", "blocked")
# 等待上限：正常 1 秒内就返回，只有 herdr 迟迟报不出新状态时才会等满。brief --send、prompt、orch-start、review 共用。
PROMPT_TIMEOUT_MS = 30000


def prompt_wait_args(timeout_ms: int) -> list:
    return ["--wait", *[x for s in PROMPT_UNTIL for x in ("--until", s)], "--timeout", str(timeout_ms)]


def prompt_plan(name: str, what: str, timeout_ms: int = PROMPT_TIMEOUT_MS) -> str:
    """--dry-run 的 planned 里那一行。"""
    return f"herdr agent prompt {name} {what} {shlex.join(prompt_wait_args(timeout_ms))}"


def send_prompt(name: str, text: str, timeout_ms: int) -> dict:
    """把 prompt 发给 agent，等到它开工（working）或停下（idle / done / blocked）就返回，最多等 timeout_ms。
    outcome：started（开工了）、settled（很快就停下了，看 status）、herdr 的错误码（timeout / agent_prompt_stalled /
    agent_blocked …，带 PROMPT_HINTS 的 hint）。timeout 也算 ok：交给 watch 追踪。"""
    ok, res = herdr(["agent", "prompt", name, text, *prompt_wait_args(timeout_ms)],
                    timeout=timeout_ms / 1000 + 60)
    if ok:
        status = find_key(res, "agent_status") or agent_status(name)
        return {"ok": True, "outcome": "started" if status == "working" else "settled", "status": status}
    code = res.get("code", "unknown")
    return {"ok": code == "timeout", "outcome": code, "message": res.get("message"),
            "status": agent_status(name), "hint": PROMPT_HINTS.get(code, "先 herdr agent read 看屏幕再决定。")}


def cmd_prompt(a: argparse.Namespace) -> dict:
    if a.text is not None:
        text, source = a.text, "--text"
    else:
        path = Path(a.file).expanduser()
        if not path.is_file():
            raise DroverError(f"prompt 文件不存在：{path}。先用 Write 写好 prompt 文件。")
        text, source = path.read_text(), str(path)
    if not text.strip():
        raise DroverError(f"prompt 是空的：{source}")
    if a.dry_run:
        return {"ok": True, "dry_run": True,
                "planned": [prompt_plan(a.name, f"<{source} 的内容，{len(text)} 字符>", a.timeout)]}
    warning = unread_warning(a.name)
    sent = deliver(a.name, text, a.timeout)
    if sent["ok"]:
        record_answered(a.name, text)
    return {**sent, **({"warning": warning} if warning else {})}


def unread_warning(name: str) -> Optional[str]:
    """发给顶层编排者之前算一次未读（rollup_flags）：rollup 在主会话上次读之后又改过时，返回给主会话的一句提醒（照发，不拦）。
    用户的"按建议来"针对的是主会话转达的那一版，编排者手里已经是新一版的问题，会把它当成对新版的同意（真实时间线里见过转答复
    24 秒后主会话才读到新版本）。子编排者不提醒：主会话不读它的 rollup，给它发话的是上层编排者。"""
    task = latest_orch_metas().get(name)
    if task is None or task["meta"].get("parent"):
        return None
    roll = read_rollup(task["dir"] / "rollup.md")
    if not rollup_flags(task["dir"], roll)[0]:
        return None
    slug = task["meta"].get("slug") or task["dir"].name
    return (f"rollup 在你上次读之后改过（现在是{roll['status']}）：先 drover rollup --slug {slug} 读新版本，确认刚转的答复"
            "对的是哪一版；对的是旧版的，告诉编排者那句答复不算，把新版转给用户")


PROMPT_HEAD_CHARS = 20  # 时间线里 answered 带 prompt 开头这么多字：统计时分得出是转答复还是"接着做"（answered.json 不分内容）


def record_answered(name: str, text: str) -> None:
    """发给的是编排者（name 对得上某个 orch.json，多条取最新的，同 orch_rollups）时，在它的任务目录写 answered.json：
    发送时间和当时 rollup 的 digest；时间线记 answered（带开头 PROMPT_HEAD_CHARS 个字），内容以"收尾"开头的再记一条
    wrapup-sent（收尾请求），三处用同一个发送时间（以前各取一次 time.time()，机器忙时差出几毫秒，test_timeline 偶尔对不上）。
    worker 对不上，不写。
    看板靠 answered.json 分开"等你决定、还没答"和"已转答复、等编排者更新"，后者不算等你。"""
    task = latest_orch_metas().get(name)
    if task is None:
        return
    roll = read_rollup(task["dir"] / "rollup.md")
    at = time.time()
    write_json_atomic(task["dir"] / ANSWERED_FILE, {"at": at, "rollup_digest": roll["digest"] if roll else None})
    with timeline_session(task["dir"]) as (_, new):
        new.append(timeline_event("answered", at, "prompt", name=name, head=text.strip()[:PROMPT_HEAD_CHARS]))
        if text.lstrip().startswith("收尾"):
            new.append(timeline_event("wrapup-sent", at, "prompt", name=name))


# ---------------------------------------------------------------- brief

BRIEF_HEAD = "你在 Herdr 的一个 git worktree 里独立完成一项任务，由编排者派发和追踪。"

# 任务书以用户的目标开头。
GOAL_SECTION = """## 目标
{goal}
（这是用户要做成的事，主会话开头就是这样复述给用户的。下面任务书里的范围和做法都为它服务；发现两者对不上，写进报告的 open_questions 并把 status 标为 NEED_INPUT，不要自己改方向。）"""

# 篇幅要求：实际见过摸底写到 33.7KB、生成 5 分钟，大半是逐条确认任务书写对的部分和贴代码。
# 编排者只靠"不符"和"决策"两部分决定下一步，所以这两部分写全、不限长，其余压到 100 行左右。
# 第 3 部分的证据标准：见过拿注释、调用方一侧当证据，没读链路上的别的仓库就断言它的行为，
# 和 dispatch.md 核心原则的"证据"同一个标准。外部平台读不到代码的查官方文档（见过探针只报现象、官方文档一查就有原因）。
SURVEY_SECTION = """## 第一步：先摸底，不要动手
下面是完整的任务书。现在只读代码，核实任务书里关于现状的描述，并按任务书的要求做盘点：不要改仓库里的任何文件、不要装依赖、不要运行会写仓库文件的命令。读完把摸底结果写到 {survey_path}，包含四部分：
1. 和代码不符的地方：任务书里关于现状的描述，哪些和代码实际不一样，写清证据（文件:行）；没有就写"无"。
2. 范围盘点：任务书要求盘点的内容；任务书没要求的话，列出预计要改的文件和函数。
3. 打算怎么做：修 bug 或改设计时先写根因链（应该怎样：从目标推，不从现有实现推 → 问题在哪一层产生、为什么，附证据 → 改在哪一层；证据写仓库 文件:行或实测，注释、命名、文档、调用方那一侧只算线索，链路经过、不在你 worktree 里的仓库写明没读，不推断它的行为；外部平台（厂商 API、云模型平台）读不到代码的，查它的官方文档（写链接和段落）），根因落在任务书"不做"的范围里也照写，不标"不在范围"；再写思路和预计改动规模，对照"完成证据"逐条说明打算怎么证明，做不到或不合理的直接指出。
4. 需要决策的问题：会影响范围、行为或产品方向的选择，列出选项和你的建议；没有就写"无"。
篇幅：只写结论和证据位置（文件:行），不贴代码和命令输出（超过 5 行的一律不贴，写位置）；任务书写对的部分一句"其余和任务书一致"带过，不逐条确认。第 1、4 部分写全、不限长；第 2、3 部分合计控制在 100 行左右。
写完在对话里只回复文件路径，然后停下。编排者处理完会回复"开始"并附上确认结果，收到之后再按任务书实施，最后按完成协议写报告（报告里不重述摸底内容）。"""

# 任务段固定小节：brief 检查必填小节在且不空，嵌进任务书时降成 ### 挂在"## 任务"下面。
TASK_SECTIONS_REQUIRED = ["背景", "要做的", "不做"]
TASK_SECTION_SURVEY = "摸底时要写清"
TASK_HEADING_RE = re.compile(r"^(#{2,3})[ \t]*(\S[^\n]*)$", re.M)
TASK_TEMPLATE = """### 背景
（为什么要做、现状和已知事实；你核实过的写明怎么核实的，没核实的放进"线索"）

### 要做的
（范围：改什么、做成什么样、关键语义；根因核实过的写出做法，没核实的写嫌疑、由摸底定；并写明哪些可以由 agent 自己定）

### 不做
（明确排除的：不改的模块和文件、不执行的操作（迁移、推送、写共享环境数据等））

### 线索（需核实）
（可选：history 查到的决定和坑、相关文件 / 接口位置；agent 动手前要核实）

### 摸底时要写清
（带 --survey 时必填：摸底产出要回答的问题。只点影响决策的问题，不要让 worker 逐条确认任务书写对的部分）"""


def check_task_sections(task: str, survey: bool) -> str:
    """任务段必须有"背景 / 要做的 / 不做"（带 --survey 时还要"摸底时要写清"），且每节不空；标题按前缀匹配。
    返回把 ## 小节降成 ### 之后的任务段。"""
    headings = list(TASK_HEADING_RE.finditer(task))
    bodies = {}
    for i, m in enumerate(headings):
        end = headings[i + 1].start() if i + 1 < len(headings) else len(task)
        bodies[m.group(2).strip()] = task[m.end():end].strip()

    def body_of(name: str) -> Optional[str]:
        return next((body for title, body in bodies.items() if title.startswith(name)), None)

    wanted = TASK_SECTIONS_REQUIRED + ([TASK_SECTION_SURVEY] if survey else [])
    missing = [name for name in wanted if body_of(name) is None]
    empty = [name for name in wanted if body_of(name) == ""]
    if missing or empty:
        problems = ([f"缺小节 {'、'.join(missing)}"] if missing else []) + ([f"小节是空的：{'、'.join(empty)}"] if empty else [])
        raise DroverError("任务段要按固定小节写（" + "；".join(problems) + "），模板见 template", template=TASK_TEMPLATE)
    return re.sub(r"^##(?=[ \t])", "###", task, flags=re.M)


APPROVAL_FRIENDLY_CLAUDE = (
    "- 审批友好写法（你跑在 acceptEdits 下，写文件自动放行、bash 命令要命中白名单前缀）：脚本一律先用 Write 写成文件再用单条命令执行，"
    "不要把 Python 用 heredoc 内联在 bash 里；不要 `echo … && …` 串联多条命令；git 用 `git -C <path>` 不要 `cd && git`；"
    "不用变量赋值前缀（`W=/path; grep … $W/…`），路径写全；"
    "避免 `$(...)` 命令替换和带引号的 `{}`——这些会触发无法加白名单的强制人工审批。"
    "派子 agent（Explore 等）时，把这几条写法（git 用 `git -C <path>`、不 `cd && git`、一条 Bash 只做一件事、不用 `$(...)`）"
    "写进子 agent 的 prompt：它看不到这里的规则，自己写的 `cd … && git …` 会弹强制审批，你在等它时没人批。"
    "测试需要的环境变量放进 conftest.py 或测试代码里，不要在命令前拼 `VAR=...`；任务书给的构建 / 测试命令自带 `VAR=值` 前缀的"
    f"（如 `JAVA_HOME=… mvn …`），套上 heavy 执行（`{DROVER_CMD} heavy -- JAVA_HOME=… mvn …`），不会弹框。"
)

# 编码规范的来源（brief 追加进 worker 任务书）：包默认的 flow/coding-rules.md（config 的 default_coding_rules 可关；
# 通用原则总带，MySQL、Java 两节按任务书涉及的 worktree 取舍，见 coding_rules_sections），
# 再是团队 profile / 个人覆盖目录的 coding-rules.md（claude、codex 都加，见 coding_rules_files），最后是用户全局 CLAUDE.md
# 的"编码规范"一节（只给 codex：claude 会自动加载 CLAUDE.md）。都没有就不加这一节。
def global_coding_rules() -> str:
    """从用户全局 CLAUDE.md 取"编码规范"一节原文，保证 codex 拿到的和 claude 自动加载的一致；没有文件或这一节时返回空串。"""
    try:
        text = (HOME / ".claude" / "CLAUDE.md").read_text()
    except OSError:
        return ""
    m = re.search(r"^## 编码规范[^\n]*\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    return m.group(1).strip() if m else ""


def brief_worktrees(a: argparse.Namespace) -> list:
    """主 worktree（--repo/--wt/--branch）加上 --wt-extra 仓库=路径，解析成 [{name, repo, wt, branch}]。"""
    specs = [(a.repo, a.wt, a.branch)]
    for spec in a.wt_extra:
        repo, sep, wt = spec.partition("=")
        if not sep or not repo.strip() or not wt.strip():
            raise DroverError(f"--wt-extra 格式是 仓库=worktree路径（仓库可以写名字或路径）：{spec!r}")
        specs.append((repo.strip(), wt.strip(), None))
    items = []
    for repo_arg, wt_arg, branch in specs:
        repo = resolve_repo(repo_arg)
        wt = Path(wt_arg).expanduser().resolve()
        if not wt.is_dir():
            raise DroverError(f"worktree 目录不存在：{wt}")
        common_repo, common_wt = git_common_dir(repo), git_common_dir(str(wt))
        if common_repo and common_wt and common_repo != common_wt:
            raise DroverError(f"{wt} 不是 {repo} 的 worktree（git common dir 不同），检查参数是否写反或写错")
        items.append({
            "name": Path(repo).name,
            "repo": repo,
            "wt": str(wt),
            "branch": branch or git_out(str(wt), "rev-parse", "--abbrev-ref", "HEAD"),
            # 基线 commit：worker 只跑和改动相关的测试时用（如 vitest run --changed <基线>）。
            "base": git_out(str(wt), "rev-parse", "--short=12", "HEAD"),
            # 源仓库有、worktree 里没有的规范文件（没提交的那种），prompt 里让 agent 去读源仓库的原文。
            "docs_in_source_only": [str(Path(repo) / name) for name, _ in untracked_repo_docs(repo)
                                    if not (wt / name).exists()],
        })
    return items


def brief_deps_section(worktrees: list, deps_files: list, warnings: list) -> str:
    by_wt: dict = {}
    for f in deps_files:
        path = Path(f).expanduser()
        try:
            data = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError) as exc:
            raise DroverError(f"读不了依赖存档 {path}：{exc}。先跑 deps --save {path}")
        if data.get("dry_run"):
            warnings.append(f"{path} 是 deps --dry-run 的结果，摘要里写的“已装好”并没有真正执行")
        by_wt[str(Path(data.get("worktree_path", "")).resolve())] = data
    kinds: set = set()
    blocks = []
    for w in worktrees:
        data = by_wt.get(w["wt"])
        if data is None:
            warnings.append(f"没有 {w['name']}（{w['wt']}）的依赖存档，prompt 里写了“未提供”")
            summary = "- （编排者没有提供这个 worktree 的依赖安装结果，用到时先自己检查）"
        else:
            summary = data.get("summary_for_prompt") or "- 未检测到需要安装的依赖。"
            kinds |= {item.get("kind") for item in data.get("items", [])}
        blocks.append(summary if len(worktrees) == 1 else f"{w['name']}：\n{summary}")
    js = bool(kinds & {"js", "nested"})
    py = "python" in kinds
    real_dirs = [d for d, flag in (("`node_modules`", js), ("`.venv`", py)) if flag]
    has_env = any(any(Path(w["wt"]).glob(".env*")) for w in worktrees)
    head = "编排者已在 worktree 内独立安装依赖"
    if real_dirs:
        head += f"（{' / '.join(real_dirs)} 是真实目录，不是源仓库的软链）"
    if has_env:
        head += "，.env 已从源仓库复制"
    lines = ["## 依赖", head + "。当前情况：", "\n".join(blocks)]
    hints = []
    if js:
        hints.append("JS 用仓库对应的包管理器；新增包后确认 lockfile 里新条目的下载地址和已有条目一致"
                     "（本机的 npm 镜像配置可能把镜像地址写进 lockfile）")
    if py:
        hints.append("Python 用 `./.venv/bin/python -m pip install …`")
    if hints:
        lines.append(f"依赖有变化就在 worktree 里装：{'；'.join(hints)}。"
                     f"绝不往源仓库的 {' / '.join(real_dirs)} 里装东西。")
    else:
        lines.append("依赖有变化就在 worktree 里装，绝不往源仓库里装东西。")
    return "\n".join(lines)


def build_brief(a: argparse.Namespace, worktrees: list, task: str, evidence: list, warnings: list) -> str:
    codex = a.kind == "codex"
    slug_dir = STATE_HOME / a.slug
    parts = [GOAL_SECTION.format(goal=a.goal.strip()), BRIEF_HEAD]
    if a.survey:
        parts.append(SURVEY_SECTION.format(survey_path=slug_dir / f"{a.name}.survey.md"))
    parts.append("## 任务\n" + task)
    parts.append("## 完成证据（逐条做到；报告的 verification 逐条对应，写出命令和实际结果）\n"
                 + "\n".join(evidence_lines(evidence)))

    wt_lines = ["## 工作目录（只在这些 worktree 内改动）"]
    for w in worktrees:
        wt_lines.append(f"- {w['name']}: {w['wt']}（分支 {w['branch']}，基线 {w['base']}；"
                        f"源仓库 {w['repo']} 仅供只读参考，禁止修改）")
    if any(is_under(w["wt"], HERDR_WORKTREES) for w in worktrees):
        wt_lines.append("- worktree 放在 herdr 管理目录 `~/.herdr/worktrees/` 是允许的位置，不要挪动。")
    parts.append("\n".join(wt_lines))
    parts.append(brief_deps_section(worktrees, a.deps_json, warnings))

    rules = ["## 约束"]
    if codex:
        rules.append("- 动手前先读各仓库根目录的 CLAUDE.md / AGENTS.md（codex 不会自动加载 CLAUDE.md），遵守其中的规范和现有代码风格。")
    else:
        rules.append("- 遵守各仓库的 CLAUDE.md 和现有规范。")
    source_only = [p for w in worktrees for p in w["docs_in_source_only"]]
    if source_only:
        rules.append("- 下面这些仓库规范文件没有提交进 git，worktree 里没有，动手前先读源仓库里的原文（只读，不要复制进 worktree）："
                     + "、".join(f"`{p}`" for p in source_only))
        ignored_missing = [f"{w['name']}/{name}" for w in worktrees for name, ign in untracked_repo_docs(w["repo"])
                           if ign and not (Path(w["wt"]) / name).exists()]
        if ignored_missing:
            warnings.append(f"worktree 里缺被忽略的规范文件 {'、'.join(ignored_missing)}（多半是旧版 wt 建的）："
                            "重跑一次 wt（同分支会复用）就会补复制；这次 prompt 已让 agent 读源仓库的原文")
    if a.commit_allowed:
        rules.append("- 可以在当前分支上 git commit（提交信息遵守仓库规范）；不要 git push / 切分支 / 改写已有提交 / 删 worktree。")
    else:
        rules.append("- 不要 git commit / git push / 切分支 / 删 worktree。")
    rules.append("- 不要 git fetch / pull / rebase / merge：基线由编排者统一管理，所有条目做完后由它在集成 worktree 里"
                 "统一同步上游、解冲突。")
    # 迁移在集成检查通过后、推送前由编排者按仓库规则统一执行（flow/integrate.md 第 4 步：定时间戳、试跑、核对账本）；
    # worker 并行、各自看不到别人的迁移，自己执行的会和它重复或乱序，写共享库还会影响别的条目和别人。
    rules.append("- 只写迁移文件和测试，不执行迁移，不对任何共享 / 生产数据库做写操作；迁移由编排者按仓库规则执行。")
    heavy = f"`{DROVER_CMD} heavy -- <命令>`"
    # 以前只让 build 和大批测试经 heavy，worker 自己跑的相关测试、lint 调度器看不见，全量测试照样
    # 被它们拖慢、超时。heavy 改成按实测占用调度以后，轻命令经 heavy 不用排队，所以一律经 heavy。
    rules.append(f"- 测试、lint、类型检查、构建一律经 {heavy} 执行（如 `{DROVER_CMD} heavy -- bunx vitest run src/a.test.ts`）："
                 "heavy 按本机实测的占用调度全机的构建 / 测试，轻的、跑得快的不用排队，重的（全量测试、build）等机器有空再跑，"
                 "排队时会打印这条要多少、在等谁。heavy 只执行构建 / 测试工具，不在它名单里的命令会被拒绝（退出码 2），这类直接执行。"
                 "测试只跑和这次改动相关的：直接相关的测试文件（或 `vitest run --changed <基线>`、pytest 指定文件），"
                 "加上类型检查和改动文件的 lint。不要跑全量测试：全量由编排者集成时统一跑一次。重命令可能要排几分钟，用后台方式执行。")
    if codex:
        rules.append(f"- 你跑在 workspace-write 沙箱里（-a on-request）：只在上面的 worktree 和 {slug_dir} 里写文件；"
                     "联网、写沙箱外路径会弹审批等编排者处理，能避免就避免（依赖已装好，不要重装）。")
    else:
        rules.append(APPROVAL_FRIENDLY_CLAUDE)
    # 根治，不打补丁（dispatch.md 核心原则的"根治三问"给 worker 的短版）。
    rules.append("- 改在问题产生的那一层，不在症状出现的地方加判断、特例、兜底或词表；能删就不加，能复用现有链路就不新建；"
                 "因此变得多余的旧代码（死分支、过渡兼容、重复判断）一起删。任务书指定的做法只治了症状的，在摸底或报告里指出来、"
                 "给出源头的改法（标 NEED_INPUT），不要照做。")
    # 事实判断的证据（同 dispatch.md 核心原则"证据"）：见过探针只报了"网关忽略"这个现象、没写原因，
    # 其实官方文档一查就有；也见过把 AI 自己对识别结果的逐项核对当结论转给用户。
    rules.append("- 报告、摸底、注释、文档里写的事实判断都要有证据（代码 文件:行、实测、外部平台的官方文档链接和段落）；"
                 "现象（不生效、不支持、报错）连原因一起写，查不到写\"原因未查明\"和已排除的可能；"
                 "经过网关、中转测到的现象定不了是哪一层。一两次查询（读源码、查官方文档、花费很小的探针）能核实的先核实，"
                 "不拿推断交差。识别类结果（OCR、识图、转写）你自己的核对只算初步，写明未经用户确认。")
    rules.append("- 做完必须自证：逐条完成上面\"完成证据\"里的检查，把命令和实际结果写进报告的 verification。"
                 "某一条做不到就写明原因，status 不能标 DONE。")
    # 证据产物的位置（dispatch.md 第 2 节"完成证据"的真实入口一档）：界面类改动以前没有放截图、录屏的地方，
    # 一条命令证明不了的检查也只能留在自述里。脚本留着，验收用 accept --verify 原样重跑。
    rules.append(f"- 证据产物放 `{slug_dir / 'evidence' / a.name}/`：改了界面或交互的，在跑起来的应用里走一遍改动的流程，"
                 "截图 / 录屏 / 接口响应存进去；一条命令证明不了的检查写成能重跑的脚本（退出码表示通过与否）也放这里。"
                 "报告列出路径，脚本写出能直接重跑的命令（绝对路径），验收会原样重跑。")
    rules.append("- 遇到需要决策的问题：能从任务上下文推断的自己定并记录假设；确实无法推断的写进报告 open_questions 并把 status 标为 NEED_INPUT，不要瞎猜关键需求。")
    parts.append("\n".join(rules))
    for source, body in playbook_coding_rules(warnings, [w["wt"] for w in worktrees]):
        parts.append(f"## 编码规范（{source}）\n" + body)
    if codex:
        user_rules = global_coding_rules()
        if user_rules:
            parts.append("## 编码规范（用户全局规则；codex 不会自动加载，必须遵守）\n" + user_rules)

    # 篇幅要求和"对话里只回复路径"：实际见过报告写到 18.7KB、生成约 3 分钟，还要在对话里再写一遍。
    # 编排者验收时自己重跑关键命令，verification 只要能对上命令和结果；报告文件找不到时让 worker 补写（第 6 节事件表）。
    # root_cause 附证据位置：编排者按位置核对根因，不靠 worker 的自述；还要写"为什么"，只说哪一层不算根因。
    repo_label = worktrees[0]["name"] if len(worktrees) == 1 else "<仓库名>"
    report = slug_dir / (a.name + '.md')
    parts.append("\n".join([
        "## 完成协议（必须执行）",
        f"把最终报告写到 {report}，格式：",
        "=== DISPATCH RESULT ===",
        "status: DONE | PARTIAL | FAILED | NEED_INPUT",
        "summary: <3-5 句>",
        "changed_files:",
        f"  - <相对路径>（{repo_label}）",
        "root_cause: <修 bug 或改设计时一句：问题产生在哪一层、为什么（附证据位置）、改在哪一层；新增的特例 / 兜底 / 回落逐个列出并说明为什么必要；"
        "其他任务写 n/a>",
        "verification: <按\"完成证据\"逐条写，每条一行：命令 → 结果汇总行（如 `Tests run: 218, Failures: 0`、`164 passed`）"
        "→ 流水号（经 heavy 跑完时 stderr 打的\"流水 #N\"，编排者按它核对你跑过什么）；"
        "修 bug 的写明回归测试改之前失败、改之后通过的两条流水号；不经 heavy 的（真实入口脚本、截图）写证据路径；做不到的写原因>",
        "assumptions: <自行决定的点>",
        "open_questions: <需要用户回答的问题，没有写 none>",
        "=== END ===",
        "篇幅：整份报告尽量 60 行以内；verification 不贴命令输出、不点名测试类、不重述摸底。",
        f"写完在对话里只回复一行：报告路径和 status（如 `{report} status: DONE`），不要把报告块再写一遍。",
    ]))
    return "\n\n".join(parts) + "\n"


def evidence_entry(value: str) -> tuple:
    return ("text", value)


def evidence_cmd_entry(value: str) -> tuple:
    return ("cmd", value)


def evidence_items(entries: list) -> list:
    """--evidence / --evidence-cmd 按命令行顺序收在同一个列表里（argparse 共用 dest，元素是 ("text" | "cmd", 值)）：命令挂在
    它前面最近的那条证据下，一条证据可以配几条命令。返回 [{n, text, commands}]。空白的证据照旧丢掉；配了命令的不能空白。"""
    items: list = []
    for kind, value in entries:
        value = value.strip()
        if kind == "text":
            items.append({"text": value, "commands": []})
            continue
        if not items:
            raise DroverError(f"--evidence-cmd {value!r} 要写在它所属的那条 --evidence 后面（命令挂在前面最近的一条证据下）")
        try:
            argv = shlex.split(value)
        except ValueError as exc:
            raise DroverError(f"--evidence-cmd 拆不开：{value!r}（{exc}）。验收按 shlex 拆、不经 shell，引号要配对")
        if not argv:
            raise DroverError("--evidence-cmd 是空的")
        items[-1]["commands"].append(value)
    if any(it["commands"] and not it["text"] for it in items):
        raise DroverError("配了 --evidence-cmd 的那条 --evidence 是空白的：写清用什么命令或操作、看到什么结果算通过")
    return [{"n": i, **it} for i, it in enumerate((it for it in items if it["text"]), 1)]


def evidence_lines(items: list, indent: str = "") -> list:
    """完成证据编号列出，带命令的下面一行列命令（任务书、状态文件的 brief 段共用）。"""
    lines = []
    for it in items:
        lines.append(f"{indent}{it['n']}. {it['text']}")
        if it["commands"]:
            lines.append(f"{indent}   验收会重跑：" + "、".join(f"`{c}`" for c in it["commands"]))
    return lines


def rotate_round(slug_dir: Path, name: str) -> list:
    """同一个 agent 再生成任务书（返工、换范围）：上一轮的任务书、报告、摸底挪成 <name>.prompt.rN.md、<name>.rN.md、
    <name>.survey.rN.md（N 取三样都没占用的最小轮次号），新一轮不盖掉它们，第二轮还没写报告时也不会把上一轮的报告当成这一轮的。
    返回挪到的路径。"""
    files = [(f"{name}.prompt", ".md"), (name, ".md"), (f"{name}.survey", ".md")]
    present = [(stem, ext) for stem, ext in files if (slug_dir / f"{stem}{ext}").exists()]
    if not present:
        return []
    n = 1
    while any((slug_dir / f"{stem}.r{n}{ext}").exists() for stem, ext in files):
        n += 1
    moved = []
    for stem, ext in present:
        dest = slug_dir / f"{stem}.r{n}{ext}"
        os.replace(slug_dir / f"{stem}{ext}", dest)
        moved.append(str(dest))
    return moved


def append_brief_record(a: argparse.Namespace, prompt_file: Path, evidence: list, evidence_file: Path,
                        moved: list) -> dict:
    """把完成证据和是否摸底追加到状态文件，6.1 验收逐条核对；重复生成时追加新段，以最后一段为准。拿锁追加（locked_append）。"""
    state = STATE_HOME / a.slug / "dispatch.md"
    stamp = time.strftime("%m-%d %H:%M")
    lines = [f"## brief：{a.name}（{stamp}，{a.kind}，摸底：{'是' if a.survey else '否'}）",
             f"- prompt：{prompt_file}",
             "- 完成证据（6.1 验收逐条核对）："]
    lines += evidence_lines(evidence, "  ")
    lines.append(f"- 证据清单：{evidence_file}（accept --slug {a.slug} --name {a.name} 自动重跑带命令的）")
    if moved:
        lines.append(f"- 上一轮的文件挪到：{'、'.join(moved)}")
    if a.survey:
        lines.append(f"- 摸底结论：待处理（读 {STATE_HOME / a.slug / (a.name + '.survey.md')} 后写明："
                     "我直接改掉的事实偏差、交给用户决定的问题和用户的答复）")
    with locked_append(state) as (text, chunks):
        created = not text
        if created:
            text = f"# dispatch: {a.slug}\n"
            chunks.append(text)
        sep = "" if text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
        chunks.append(sep + "\n".join(lines) + "\n")
    return {"state_file": str(state), "state_file_created": created}


def brief_kind(a: argparse.Namespace, warnings: list) -> tuple[str, str]:
    """任务书按哪个宿主写约束，返回 (kind, kind_source)：应等于收任务书的 agent（--name）的实际宿主。
    给了 --kind 照用（"explicit"），和 herdr 里活着的这个 agent 对不上时进 warnings；没给就取这个 agent 的宿主（"agent"）；
    herdr 里没有、这个任务有它的 worker 记录（被释放了）时用记录的（"record"）；
    agent 还没起时同 agent-start：orch.json 的 default_kind（"orch"），再调用方（"caller"）。"""
    actual = agent_kind(a.name)
    if a.kind:
        if actual and actual != a.kind:
            warnings.append(f"--kind {a.kind} 和 agent {a.name} 实际的宿主 {actual} 对不上：任务书照 --kind 写成 {a.kind} 的约束；"
                            f"要发给它的话去掉 --kind（或改成 --kind {actual}）重新生成")
        return a.kind, "explicit"
    if actual:
        return actual, "agent"
    released = find_agent_record(a.name, a.slug)  # 被释放了的 worker：herdr 里暂时没有，宿主看 agent-start 记下的
    if released and released.get("kind") in HOST_KINDS:
        return released["kind"], "record"
    kind, source = task_default_kind(a.slug)
    if kind is None:
        raise DroverError(f"herdr 里没有 agent {a.name}，{STATE_HOME / a.slug / 'orch.json'} 里没有 default_kind，"
                          f"又{NO_CALLER_KIND}：加 --kind claude|codex（和要收任务书的 agent 一致）",
                          caller_pane=os.environ.get("HERDR_PANE_ID"))
    return kind, source


def cmd_brief(a: argparse.Namespace) -> dict:
    check_slug(a.slug)
    check_agent_name(a.name)
    evidence = evidence_items(a.evidence)
    if not evidence:
        raise DroverError("完成证据必填：每条写\"用什么命令或操作、看到什么结果算通过\"。写不出来说明任务还没拆清楚，回第 2 节。")
    if not a.goal.strip():
        raise DroverError("目标必填：写状态文件开头的\"目标：\"那段（dispatch.md 第 1.1 节的复述，用户纠正过就用纠正后的）。")
    task_path = Path(a.task_file).expanduser()
    if not task_path.is_file():
        raise DroverError(f"任务文件不存在：{task_path}。先用 Write 写好只含\"任务\"一段的文件。")
    task = re.sub(r"\A\s*##\s*任务\s*\n", "", task_path.read_text()).strip()
    if not task:
        raise DroverError(f"任务文件是空的：{task_path}")
    task = check_task_sections(task, a.survey)
    warnings: list = []
    # build_brief、append_brief_record 都按 a.kind 写，换成解析后的值。
    a.kind, kind_source = brief_kind(a, warnings)
    worktrees = brief_worktrees(a)
    prompt = build_brief(a, worktrees, task, evidence, warnings)
    slug_dir = STATE_HOME / a.slug
    prompt_file = slug_dir / f"{a.name}.prompt.md"
    # 证据清单（机器读）：accept --slug --name 按它把带命令的证据当 verify 跑；命令在主 worktree（--wt）里跑。
    evidence_file = slug_dir / f"{a.name}.evidence.json"
    result = {"ok": True, "dry_run": a.dry_run, "kind": a.kind, "kind_source": kind_source, "survey": a.survey,
              "prompt_file": str(prompt_file), "chars": len(prompt), "worktrees": worktrees,
              "evidence": [it["text"] for it in evidence], "evidence_file": str(evidence_file), "warnings": warnings}
    if a.survey:
        result["survey_file"] = str(slug_dir / f"{a.name}.survey.md")
    if a.dry_run:
        result["prompt"] = prompt
        result["planned"] = [f"上一轮的任务书 / 报告 / 摸底（有的话）挪成 {a.name}.prompt.rN.md / {a.name}.rN.md / "
                             f"{a.name}.survey.rN.md", f"写 {prompt_file}", f"写 {evidence_file}",
                             f"追加完成证据到 {slug_dir / 'dispatch.md'}"]
        if a.send:
            result["planned"].append(prompt_plan(a.name, f"<{prompt_file}>"))
        return result
    slug_dir.mkdir(parents=True, exist_ok=True)
    moved = rotate_round(slug_dir, a.name)
    prompt_file.write_text(prompt)
    write_json_atomic(evidence_file, {"slug": a.slug, "agent": a.name, "worktree": worktrees[0]["wt"],
                                      "base": worktrees[0]["base"], "prompt_file": str(prompt_file),
                                      "written_at": time.strftime("%Y-%m-%d %H:%M:%S"), "items": evidence})
    result["previous_round"] = moved
    result.update(append_brief_record(a, prompt_file, evidence, evidence_file, moved))
    if a.send:
        sent = deliver(a.name, prompt, PROMPT_TIMEOUT_MS)
        result["sent"] = sent
        result["ok"] = sent["ok"]
        if not sent["ok"]:
            result["error"] = f"prompt 文件已写好，但发送结果是 {sent['outcome']}：{sent.get('hint')}"
    return result


# ---------------------------------------------------------------- watch

# Claude Code 状态栏里的后台命令计数，如 "⏵⏵ accept edits on · 1 shell · ← 1 agent"（实测）。
# 有后台命令时 herdr 会报 done / idle，但 agent 会在命令结束后自己接着干（全量测试放后台、drover heavy 排队）。
# Monitor 同理（"· 1 monitor"，编排者挂着 Monitor 等 worker 时被误报成过 done）：有事件就会被唤醒。
BACKGROUND_SHELL_RE = re.compile(
    r"·\s*(\d+)\s+(?:background\s+)?(?:shells?|bash(?:es)?|monitors?)\b(?:\s+still\s+running)?", re.I)
# 状态为 done / idle 且有后台命令时，多久重读一次屏幕（后台命令结束、agent 却没接着干时，改报 done）。
BACKGROUND_RECHECK_SECONDS = 30
# working 却没有输出（Codex 实测：worker 改完代码、测试通过后，停在 working 十几分钟不调工具也不写报告，
# working-no-diff 要 20 分钟才报）：屏幕输出的指纹。计时行（带 esc to interrupt）和轮换的 Tip 行不算，数字抹掉。
OUTPUT_VOLATILE_RE = re.compile(r"(?i)(esc to interrupt|^\s*⎿?\s*Tip:)")
DIGITS_RE = re.compile(r"\d+")
# 屏幕底部有这些标记说明正在跑命令：长测试没输出是正常的，不算没动静（这种情况交给 working-no-diff）。
RUNNING_CMD_RE = re.compile(r"(?im)(Running…|Running\.\.\.|Waiting for background terminal|^\s*[•◦]\s+Running\b)")


def output_fingerprint(name: str) -> tuple[Optional[str], bool]:
    """agent 最近输出的指纹和"是否正在跑命令"；读不到返回 (None, False)。"""
    p = run(["herdr", "agent", "read", name, "--source", "recent-unwrapped", "--lines", "80"], timeout=30)
    if p.returncode != 0:
        return None, False
    lines = p.stdout.splitlines()
    running = bool(RUNNING_CMD_RE.search("\n".join(lines[-15:])))
    stable = "\n".join(line for line in lines if not OUTPUT_VOLATILE_RE.search(line))
    return hashlib.sha1(DIGITS_RE.sub("#", stable).encode(errors="replace")).hexdigest(), running


def background_shells(name: str) -> int:
    """agent 屏幕底部状态栏里还在跑的后台命令数；读不到返回 0。"""
    m = BACKGROUND_SHELL_RE.search(agent_screen(name, 8))
    return int(m.group(1)) if m else 0


# 一轮因为接口错误中断（实际出过一次 API 503，编排者和三个 worker 同时停在 done，
# 空等了 6 个多小时没人发现）。Claude Code 打印 "⏺ API Error: 503 ..."（有时在工具调用下面："⎿  API Error: …"）；
# codex 是 "■ stream error / stream disconnected / unexpected status 502"。只认行首的错误行，而且它得是屏幕上最后一个输出块：
# 正文里提到 "API Error"（误报过两次：worker 报告里写了 "API_ERROR_RE 不认 API Error"，编排者的收尾总结里也写了）、
# 更早的块是错误但之后又有正常输出，都不算。
CLAUDE_API_ERROR_RE = re.compile(r"^\s*(?:[⏺⎿]\s*)?API Error\b")
CODEX_API_ERROR_RE = re.compile(r"(?i)^\s*■\s*(?:stream (?:error|disconnected)|unexpected status \d{3})")
# 输出块的开头：Claude Code 的 ⏺、codex 的 •，都在行首。从下往上先碰到它，说明错误行（如果有）不是最后一个块。
# codex 的输入框以 › / » 开头、一定在错误行下面，不能算块开头。
OUTPUT_BLOCK_RE = re.compile(r"^[⏺•]")

# Claude Code 的确认弹框（WebFetch 授权、Bash、Edit……）：最后一条纯横线以下，"Do you want to …?" 问句后面紧跟带光标 ❯ 的编号选项。
# WebFetch 授权弹框被 herdr 报成过 done：herdr 的检测清单只靠一条兜底规则认它（问句是 "Do you want to allow Claude to
# fetch this content?"，没有 Bash 弹框的 "proceed" 和 "Esc to cancel"），而那条规则在屏幕上任何位置有一行单独的 ❯ 时就不生效
# （编排者的工具输出里常有 worker 的空输入框），于是落到 ✳ 标题规则报 idle → done（用临时 agent 复现过）。
# 只按纯横线（整行都是 ─）切：带 --name 启动的会话（worker 的 worker-<slug>、编排者的 orch-<slug>）会把名字嵌进横线，
# "────… worker-x ─" 弹框时在弹框最底下，平时是输入框的上边框。按纯横线切，弹框时最后一条是弹框顶部，region 就是整个弹框；
# 平时最后一条是输入框的下边框，region 只剩状态栏，正文里引用的弹框文字都在它上面，不会误报。
# 要是把带名字的横线也算进来，弹框时 region 就是空的，认不出弹框。
HRULE_RE = re.compile(r"^\s*─{10,}\s*$")
DIALOG_QUESTION_RE = re.compile(r"^\s*(?:Do you want to|Would you like to)\b")
DIALOG_FIRST_OPTION_RE = re.compile(r"^\s*(?:❯\s*)?1\.\s")
DIALOG_CURSOR_RE = re.compile(r"^\s*❯\s*\d+\.\s")
# 弹框指纹里抹掉的时长（3s、1m 12s）和时钟；普通数字保留（连续两个确认常常只差数字，比如 sips -Z 512 和 sips -Z 1024）。
DURATION_RE = re.compile(r"(?:\d+(?:\.\d+)?(?:ms|s|m|h)\b\s*)+|\d{1,2}:\d{2}(?::\d{2})?")
# 判断弹框读多少行屏幕：完整的 Bash 确认框从顶部横线到底部有 16 行（实测），14 行读不全。
DIALOG_SCREEN_LINES = 40
# herdr 报 working 时隔多久看一次屏幕，找后台子 agent 的确认框（见 screen_override）。
# 来由：编排者派的后台 Explore 子 agent 弹出 Bash 确认，主 agent 停在 "✻ Waiting for 1 background agent to finish"，
# herdr 的检测清单里 background_agents_working（优先级 965）压过 bash_permission_prompt（850），报 working；watch 只在 done / idle
# 时读屏幕，就漏了，直到用户自己在 pane 里看到（用真实 agent 复现过，herdr agent explain 的 matched_rule 就是它）。
# 不每轮都读（working 的 agent 最多）：默认 5 秒一轮时每两轮读一次，弹框出现后最多约 10 秒（再加一轮的耗时）报出 blocked。
# 刚变成 working、上一轮判成 blocked（要看弹框消失没有、换没换）、--once 时不受这个限制，立刻读。
# 不复用 output_fingerprint 那次读屏：它只在 --quiet-minutes 开着时每 --output-interval（默认 30 秒）读一次，赶不上这个间隔；
# 而且它读的是 recent-unwrapped，permission_dialog 和它的样本（实测抓的）都是按 visible 校准的。
WORKING_DIALOG_CHECK_SECONDS = 10


def last_hrule(lines: list) -> Optional[int]:
    """最后一条纯横线的行号（带会话名的横线不算，见 HRULE_RE 上面的说明）；没有返回 None。"""
    for i in range(len(lines) - 1, -1, -1):
        if HRULE_RE.match(lines[i]):
            return i
    return None


def permission_dialog(screen: str) -> bool:
    """屏幕底部是不是 Claude Code 的确认弹框。弹框太高、顶部横线不在读到的范围里时看整屏（这时屏幕上也没有输入框）。"""
    lines = screen.splitlines()
    top = last_hrule(lines)
    region = lines if top is None else lines[top + 1:]
    for i, line in enumerate(region):
        if not DIALOG_QUESTION_RE.match(line):
            continue
        # 问句在窄屏上可能折成两行：之后最多隔两行就是第一个选项（"❯ 1. Yes"），光标在选项里的某一行
        for j in range(i + 1, min(i + 4, len(region))):
            if DIALOG_FIRST_OPTION_RE.match(region[j]):
                options = region[j:]
                end = next((k for k, text in enumerate(options) if not text.strip()), len(options))
                if any(DIALOG_CURSOR_RE.match(text) for text in options[:end]):
                    return True
                break
    return False


def dialog_fingerprint(screen: str) -> str:
    """blocked 时弹框内容的指纹。只取最后一条纯横线以下：弹框上方那行工具调用的 ⏺ 会闪（实测），不能算进去；
    没有纯横线就取最后 20 行、去掉 ⏺ / ⎿。Tip 行、计时行不算，时长和时钟抹掉，普通数字保留。"""
    lines = screen.splitlines()
    top = last_hrule(lines)
    region = ([text.replace("⏺", "").replace("⎿", "") for text in lines[-20:]] if top is None
              else lines[top + 1:])
    stable = "\n".join(DURATION_RE.sub("#", text).rstrip() for text in region if not OUTPUT_VOLATILE_RE.search(text))
    return hashlib.sha1(stable.encode(errors="replace")).hexdigest()


def api_error(screen: str) -> bool:
    """屏幕上最后一个输出块是不是接口错误（见 CLAUDE_API_ERROR_RE 上面的说明）。"""
    for line in reversed(screen.splitlines()):
        if CLAUDE_API_ERROR_RE.match(line) or CODEX_API_ERROR_RE.match(line):
            return True
        if OUTPUT_BLOCK_RE.match(line):
            return False
    return False


def screen_state(screen: str) -> str:
    """herdr 报 done / idle 时按屏幕改报：底部是确认弹框 → blocked（有弹框就必须有人处理，不管后台还有没有命令）；
    最后一个输出块是接口错误 → api-error（这一轮被打断了，自己不会再动；后台命令替它续不上：Monitor 要到期才叫醒它，留着的
    dev server 一直不退，以前先看后台命令、报 waiting-background 就没人管）；状态栏还有后台命令 → waiting-background(N)；否则空串。"""
    if permission_dialog(screen):
        return "blocked"
    if api_error(screen):
        return "api-error"
    m = BACKGROUND_SHELL_RE.search("\n".join(screen.splitlines()[-8:]))
    return f"waiting-background({m.group(1)})" if m else ""


def screen_override(status: str, screen: str, kind: Optional[str] = None) -> str:
    """按屏幕修正 herdr 报的状态，watch 和 orch-status 共用这一套规则；不用修正时返回空串。
    - done / idle：screen_state 的结果（确认弹框 → blocked、接口错误 → api-error、后台命令 → waiting-background(N)）；
    - working：屏幕底部是确认弹框 → blocked。主 agent 在等后台子 agent（"Waiting for N background agent(s) to finish"）时，
      子 agent 的确认框就在主 agent 屏幕的最底下，herdr 却报 working（见 WORKING_DIALOG_CHECK_SECONDS 上面的说明）。
      正文里引用的弹框文字（编排者 herdr agent read 出 worker 的屏幕）在自己的输入框上面，permission_dialog 不认。
      只看 Claude Code：codex（kind 为 codex）没有这种后台子 agent 弹框，它的屏幕上也没有纯横线，引用的弹框文字会被误认。"""
    if status in ("done", "idle"):
        return screen_state(screen)
    if status == "working" and kind != "codex" and permission_dialog(screen):
        return "blocked"
    return ""


def screen_or_empty(name: str) -> str:
    """读 agent 屏幕底部（判断弹框的行数）；herdr 报错、超时都返回空串，调用方按 herdr 的原值处理。"""
    try:
        return agent_screen(name, DIALOG_SCREEN_LINES)
    except DroverError:
        return ""


def done_state(name: str) -> str:
    """done / idle 时读 agent 屏幕底部，返回 screen_state 的结果。"""
    return screen_state(agent_screen(name, DIALOG_SCREEN_LINES))


# rollup 事件：主会话只能从 herdr 状态推断"该读 rollup 了"。编排者挂着 Monitor 时 watch 报 waiting-background，
# 它写了"等你决定""完成"主会话也收不到（漏过：编排者写完"完成"还挂着 2 个 monitor）。
# 所以对有 orch.json 的 agent（编排者、子编排者）同时盯它的 rollup.md：状态变了就报；状态没变、内容变了，
# 只在 ROLLUP_ATTENTION 这几种状态时报（"进行中"只是更新里程碑，不叫醒主会话）。
# 不看"更新："行：它是模型手写的，状态没变、又写了同一个推算时间时，新的"等你决定"会漏报。
# 内容变没变按规范化内容的 digest（read_rollup），不按修改时间：原样重写、只改空白空行不重报。
# 主会话专用的 --main：实测主会话两天里挂了 42 次 Monitor、收到 146 条通知，35 条是到期、
# 34 条是重挂时的启动快照（watch 的去重状态只在进程内存里，第一轮必定把当前值全打一遍）；working / waiting-background 对主会话
# 也没有对应的动作。--main 只报主会话要处理的事，去重记录写盘（MAIN_WATCH_FILE），重挂之后只报没报过的。
MAIN_IDLE_MINUTES = 10
# watch --main 报过的 rollup（仍未读）、弹框（还在）隔这么久再报一次：主会话收到通知的那一轮被接口错误打断、被用户的新消息岔开，
# 以前这件事在这个会话里就不会再有第二次提醒。
MAIN_REPEAT_MINUTES = 10
# 普通 watch 的 --until-event 第一轮（挂上、重挂时）看到这几种也算事件、输出完就退出：处理过就不会还在（批了弹框、续上了、换了人），
# 还在就是没处理过。Codex 编排者没有 Monitor，处理上一个事件期间别的 worker 卡在确认框上的，以前重挂后要白等到下一次变化或
# 1500 秒到期。done / idle 分不出处理过没有，不算（算进去的话每次重挂都立刻退出）。
WATCH_START_EVENTS = ("blocked", "api-error", "gone")
WATCH_DESCRIPTION = f"""\
轮询 agent 状态，启动时输出每个 agent 的当前状态，之后变化时输出一行 EVENT <名> <状态> @<时:分:秒>。
状态是 herdr 的 working / blocked / done / idle / unknown，agent 退出是 gone；watch 会按屏幕改报或补报：
  released                herdr 里没有这个名字，它是被释放的 worker（drover release 或闲置自动释放：进程退了，pane 还在）：
                          不用处理，drover prompt / brief --send 发给它会自动续上。只在启动时和 --once 显示，done / idle
                          变成 released 不输出、不算事件；续上以后照常报。释放时的 pane 被关了（原地续不了）报 gone
  blocked                 herdr 报 done / idle、但屏幕底部是确认弹框（如 WebFetch 授权）时也报 blocked。
                          herdr 报 working（主 agent 在等后台子 agent："Waiting for N background agent(s) to finish"）、
                          但屏幕底部是子 agent 的确认框时也报 blocked（只看 Claude Code，working 时每 {WORKING_DIALOG_CHECK_SECONDS} 秒
                          看一次屏幕；批完弹框消失后报回 working，卡在弹框上的时间不算进下面两种 working-no-xxx 的计时）。
                          同一状态 herdr 的序号变了（中间经历过别的状态）或弹框换了会重报，连续两个确认报两次；
                          一直有弹框、herdr 的原始状态却变了（如 blocked → working）也当作换了弹框重报一次；
                          done / idle 序号变了同样重报（working 不重报）
  waiting-background(N)   herdr 报 done / idle，但状态栏还有 N 个后台命令或 Monitor：会自己接着干，继续等
  api-error               herdr 报 done / idle，最后一个输出块是接口错误（Claude Code 行首的 API Error、codex 行首 ■ 的
                          stream error / unexpected status）：这一轮被打断了（状态栏同时挂着后台命令也报它）
  working-no-output(Nm)   working 但屏幕输出 N 分钟没变、也没在跑命令
  working-no-diff(Nm)     working 但 worktree N 分钟没有改动
有 orch.json 的 agent（编排者、子编排者）另外盯它的 rollup.md，单独输出一行 EVENT <名> rollup:<状态>：
状态变了就报；状态没变、内容变了（按规范化内容判断：每行去掉首尾空白、删掉空行；原样重写、只改空白空行不报，
不看"更新："行），只在 等你决定 / 完成 / 受阻 / 需要换编排者 时报（进行中不报）。
启动时和 --once 也输出当前的 rollup 状态。--until-event 不因启动时的输出退出，只有启动时就是 {' / '.join(WATCH_START_EVENTS)}
的例外（处理过就不会还在，还在就是没处理：重挂时已经卡在确认框上的不白等到下一次变化）；done / idle 分不出处理过没有，不算。

--main：主会话专用，只报主会话要处理的事。不写名字时每一轮自动找所有顶层编排者（orch.json 里没有 parent 的，
watch 起来之后新起的也算），写了名字只盯这些；子编排者不盯，收尾完关掉的（编排者已经退出、rollup 是完成、主会话读过这一版；
没有时间线的老任务算读过）不盯。每件事报一次，rollup 和弹框报过 {MAIN_REPEAT_MINUTES} 分钟还没处理（仍未读、弹框还在）再报一次：
  rollup:<状态>           状态以 等你决定 / 完成 / 受阻 / 需要换编排者 开头，内容和主会话用 drover rollup 读过的不同（未读），
                          也和上次报过的不同（编排者写完完成就退出了的照报）
  blocked                 同上（herdr 报 blocked，或按屏幕修正成 blocked）；同一个弹框只报一次，弹框换了再报
  api-error               同上，进入时报一次
  gone                    编排者不在 herdr 里了，rollup 却不是 完成 / 需要换编排者（意外退出）；同名的编排者换上来以后又退出，再报
  stalled(Nm)             停了没更新：显示状态是进行中（没写 rollup、状态写成别的词的也算）或已转答复（drover prompt 转过答复、
                          rollup 内容一直没变），编排者 done / idle / unknown，或者状态栏挂着后台命令已经超过 Monitor 的
                          {BACKGROUND_WAIT_MAX_SECONDS // 60} 分钟上限：停满 --idle-minutes 报一次（看板、时间线同一个判定），停的这一段变了重新计时
  herdr unreachable       herdr 连不上（--until-event 时退出码 1）
drover 自己的事，名字位置写 drover（EVENT drover <事件> @<时间>），同样每件只报一次、重挂不重报：
  updated(<旧>..<新>)[ rules]  自动更新装上了新版本（两边是版本号：正好在版本 tag 上是 tag，tag 之后 N 个提交是 vX.Y.Z+N，
                          历史上没有版本 tag 时是 7 位 sha；还没报过的几次
                          并成一次）；带 rules 的是 AGENTS.md 里的 drover 规则也变了，跑 drover rules 读入改动。
                          报过记在 ~/.drover/auto-update.json 的 announced
  update-blocked          自动更新被挡住（clone 有本地改动、分叉、没上游、上游还没有发布的版本……什么都没改）或失败：
                          同一个原因只报一次，原因看 drover board 的"drover 自动更新暂停"那一行
  update-unreachable(24h) 自动更新连续 24 小时连不上远端（离线、代理没开时很常见，所以只在满 24 小时时报一次）
  session-restarted       主会话重开了：~/.drover/main-session.json（main-register --hook 写）的 session_id 变了、
                          source 是 clear / startup（compact、resume 不算）。/clear 之前挂着的 watch 会活到 /clear 之后，
                          它报这一行（--until-event 时退出）就叫醒了新对话
同时跑着两个 watch --main 时，每一轮算事件、写去重记录拿同一把文件锁，同一件事只有一个进程报。
每一轮还会触发 drover 的自动更新检查（到时间才在后台查，不等它），写心跳 {MAIN_WATCH_LIVE_FILE}（pid、at）：看板看到
"主会话在处理"不空、心跳停了 {MAIN_WATCH_STALE_MINUTES} 分钟以上，就给主会话送一句"接上"（见 drover board --help）。
不报 working、waiting-background、rollup:进行中、done / idle 本身。报过什么、什么时候报的记在 ~/.drover/<slug>/{MAIN_WATCH_FILE}，
rollup 的已读看 {MAIN_SEEN_FILE}：重挂之后只报没报过的（和到了时间该再报的），没有新东西时启动不输出任何一行。
每一轮还把编排者现在的状态（按屏幕修正后）和它从什么时候开始记进 ~/.drover/<slug>/{AGENT_STATE_FILE}（看板也记，
"卡在确认框 N 分钟"按它算），把显示状态的变化、编排者每换一段状态、停了没更新补进时间线 ~/.drover/<slug>/{TIMELINE_FILE}
（看板也补，两边同时跑只记一次），离上一轮观察超过 {OBSERVE_GAP_SECONDS} 秒时在 {OBSERVE_GAPS_FILE} 记一条观察中断。
--main --until-event 时启动那一轮的输出也算事件：输出了就退出（退出码 0）。"""


def orch_meta_files() -> list:
    """STATE_HOME/*/orch.json 里读得出来的（内容是对象的）每一份，按任务目录排序：{"meta", "dir", "key", "names"}。key 排新旧用：
    （文件修改时间, started）；names 是这份记录占着的编排者名：现在的 name 加上换下来的 retired_names。"""
    found = []
    for meta_file in sorted(STATE_HOME.glob("*/orch.json")):
        try:
            meta = json.loads(meta_file.read_text())
            mtime = meta_file.stat().st_mtime
        except (OSError, ValueError):
            continue
        if isinstance(meta, dict):
            names = [n for n in (meta.get("name"), *(meta.get("retired_names") or [])) if n]
            found.append({"meta": meta, "dir": meta_file.parent, "key": (mtime, str(meta.get("started") or "")),
                          "names": names})
    return found


def orch_records() -> list:
    """每一份 orch.json（orch_meta_files），按任务目录排序：{"meta", "dir", "latest"}。
    latest：它是这个编排者名最新的一份——herdr 里叫这个名字的活 agent 是为它起的。名字可以被后来的任务复用，更早的同名记录的
    编排者就是已经不在了（gone）。最新按文件修改时间（started 没有年份，只在修改时间相同时排先后）。
    一份记录占着的名字是它现在的 name 加上换下来的 retired_names：换下的名字只参与"这个名字最新的记录是谁"，不拿去对活
    agent（latest 只看现在的 name），之后有更新的任务再用它就归那个任务。
    orch-start 正在起的那一份（拿着 orch_start_lock）不在结果里，但名字照样归它：这一段里这个名字在不在 herdr 里都说明不了
    什么，算给同名的旧记录、算成退出了都是错的（见 start_orch_agent）。
    认人只按名字、不按 pane / terminal：pane 挪进别的 workspace 后 herdr 给它新 pane ID（terminal 不变），herdr 重启后 pane ID
    不变、terminal_id 每次都换（herdr-resume-params 的实测）；两种情况都跟着 agent 走的只有名字。"""
    found = orch_meta_files()
    newest: dict = {}
    for rec in found:
        for name in rec["names"]:
            if name not in newest or rec["key"] > newest[name]["key"]:
                newest[name] = rec
    return [{"meta": r["meta"], "dir": r["dir"], "latest": newest.get(r["meta"].get("name")) is r}
            for r in found if not flock_held(orch_start_lock(r["dir"].name))]


def latest_orch_metas() -> dict:
    """编排者名 → 它最新的一份 orch.json：{"meta", "dir"}（orch_records 里 latest 的那些；名字被后来的任务复用时取最新的）。"""
    return {r["meta"]["name"]: {"meta": r["meta"], "dir": r["dir"]} for r in orch_records() if r["latest"]}


def orch_rollups(names) -> dict:
    """agent 名 → 它的任务目录里的 rollup.md（latest_orch_metas）。不是编排者（没有 orch.json）的 agent 不在结果里。"""
    metas = latest_orch_metas()
    return {n: metas[n]["dir"] / "rollup.md" for n in names if n in metas}


def rollup_event(name: str, path: Path, seen: dict, once: bool) -> bool:
    """按需输出一行 EVENT <名> rollup:<状态>，返回是否输出了。seen[name] 记上次的 (状态, digest)，第一次见到时照常输出当前值。
    rollup.md 不存在或读不出状态时不输出、不报错，也不覆盖上次的值（编排者可能正在重写这个文件）。"""
    roll = read_rollup(path)
    if roll is None or not roll["status"]:
        return False
    status = roll["status"]
    cur = (status, roll["digest"])
    old = seen.get(name)
    seen[name] = cur
    if not (once or old is None or cur[0] != old[0] or (cur[1] != old[1] and status.startswith(ROLLUP_ATTENTION))):
        return False
    print(f"EVENT {name} rollup:{status} @{time.strftime('%H:%M:%S')}", flush=True)
    return True


def worktree_fingerprint(path: str) -> Optional[str]:
    """worktree 的改动指纹：HEAD、git diff HEAD、未跟踪文件的名字 / 大小 / 修改时间。不在 git 仓库里（如编排者）返回 None；
    git 超时（满载时）返回空串：这一轮没取到，调用方隔 --diff-interval 再取。"""
    h = hashlib.sha1()
    try:
        top = git(path, "rev-parse", "--show-toplevel", timeout=30)
        if top.returncode != 0:
            return None
        root = top.stdout.strip()
        for args in (("rev-parse", "HEAD"), (*DIFF_NO_REFRESH, "diff", "HEAD"),
                     ("status", "--porcelain", "--untracked-files=all")):
            p = git(root, *args, timeout=60)
            h.update(p.stdout.encode(errors="replace"))
            if args[0] == "status":
                for line in p.stdout.splitlines():
                    if line.startswith("?? "):
                        with contextlib.suppress(OSError):
                            st = os.stat(os.path.join(root, line[3:]))
                            h.update(f"{line[3:]}:{st.st_size}:{st.st_mtime_ns}".encode())
    except DroverError:  # 超时（run 把 TimeoutExpired 转成了 DroverError）
        return ""
    return h.hexdigest()


def list_agents() -> Optional[list]:
    """herdr agent list 的 agents；herdr 连不上（退出码非 0、输出不是 JSON、找不到 herdr）时返回 None。watch、board 共用。"""
    try:
        p = subprocess.run(["herdr", "agent", "list"], capture_output=True, text=True)
    except OSError:
        return None
    if p.returncode != 0:
        return None
    try:
        return json.loads(p.stdout).get("result", {}).get("agents", [])
    except (json.JSONDecodeError, AttributeError):
        return None


def live_panes() -> Optional[set]:
    """herdr 里现有的全部 pane ID（herdr pane list 不带 --workspace，一次调用）；没拿到（超时、连不上、返回认不出）是 None。"""
    try:
        ok, res = herdr(["pane", "list"], timeout=30)
    except DroverError:
        return None
    panes = res.get("panes") if ok else None
    if not isinstance(panes, list):
        return None
    return {p["pane_id"] for p in panes if isinstance(p, dict) and p.get("pane_id")}


def absent_shown(names: list, by_name: dict, absent: dict, previous: dict) -> dict:
    """watch：herdr 里没有的名字这一轮显示什么，名 → released / gone。
    released：它最新的 worker 记录是 released、记录的 pane 还在（给它发话会在那里自动续上，不用编排者处理）；
    gone：别的（自己退出了、从来不是 agent-start 起的、pane 被关了原地续不了）。
    开销不随已释放的个数涨：记录只在名字刚从 herdr 里消失时查一次，记在 absent（名 → 释放时的 pane，不是释放的是 None）里，
    到它重新出现才清掉——记录先写成 released 再退进程（stop_worker），要变回 running 得先续上，续上名字就回来了；
    pane 还在不在，一轮只调一次 herdr pane list（没有已释放的就不调）。pane list 没拿到时不知道在不在：沿用上一轮显示的，
    第一轮按 released（报 gone 会叫醒编排者去重启，错报的代价大）。"""
    for name in names:
        if name in by_name:
            absent.pop(name, None)
        elif name not in absent:
            rec = find_agent_record(name) or {}
            absent[name] = rec.get("pane_id") if rec.get("state") == "released" else None
    missing = [n for n in names if n not in by_name]
    panes = live_panes() if any(absent[n] for n in missing) else set()
    out = {}
    for name in missing:
        pane = absent[name]
        if pane and panes is None:
            prev = previous.get(name, ("", ""))[1]
            out[name] = prev if prev in ("released", "gone") else "released"
        else:
            out[name] = "released" if pane and pane in panes else "gone"
    return out


def watch_reports(shown: str, prev_shown: str, again: bool, once: bool, first_round: bool) -> bool:
    """这一轮要不要输出这个 agent 的 EVENT 行：--once 都输出；显示的状态变了、或者同一状态要重报（again）时输出。
    变成 released 例外：它只是空闲时退了进程（活早干完了），没有要编排者处理的，不输出也不叫醒；启动那一轮照常显示当前状态。"""
    if once:
        return True
    if shown == "released" and not first_round:
        return False
    return prev_shown != shown or again


def cmd_watch(a: argparse.Namespace) -> int:
    for name in a.agents:
        check_agent_name(name)
    if a.main:
        return watch_main(a)
    previous: dict = {}  # name -> (herdr 报的状态, 输出的状态)
    absent: dict = {}  # herdr 里没有的名字 -> 它释放时的 pane（不是被释放的是 None），见 absent_shown
    # herdr 的 state_change_seq：server 全局递增，记在该 agent 最近一次状态变化上；读屏幕、标题变化都不会改它（实测）。
    seqs: dict = {}
    dialog_fps: dict = {}  # name -> 弹框指纹（输出的状态是 blocked 时才有）
    rollups: dict = {}  # name -> rollup 上次的 (状态, digest)
    last_screen_check: dict = {}
    # B6：working 时定期取 worktree 指纹，长时间没变化就提示（只是提示，跑长测试时也会这样）。
    progress: dict = {}  # name -> {"fp", "changed", "checked"}
    stall_seconds = a.stall_minutes * 60 if a.stall_minutes > 0 else 0
    quiet_seconds = a.quiet_minutes * 60 if a.quiet_minutes > 0 else 0
    # --until-event：先输出一遍当前状态，之后第一次有变化就退出（Codex 没有 Monitor，用阻塞等待代替）；第一轮就是
    # WATCH_START_EVENTS 的也退出。
    started = time.time()
    first_round = True
    while True:
        if a.timeout and not a.once and time.time() - started >= a.timeout:
            print(f"EVENT timeout @{time.strftime('%H:%M:%S')}", flush=True)
            return 0
        upkeep_tick()
        agents = list_agents()
        if agents is None:
            print(f"EVENT herdr unreachable @{time.strftime('%H:%M:%S')}", flush=True)
            if a.once or a.until_event:
                return 1
            time.sleep(10)
            continue
        by_name = {x.get("name"): x for x in agents if x.get("name")}
        now = time.time()
        changed = False
        # 每轮重新解析：watch 起来之后才写的 orch.json、resume 换人覆盖的 orch.json 都能跟上（几十个小文件，开销可以忽略）。
        rollup_files = orch_rollups(a.agents)
        gone_or_released = absent_shown(a.agents, by_name, absent, previous)
        for name in a.agents:
            agent = by_name.get(name)
            # herdr 里没有了：被释放的 worker（pane 还在、发话会自动续上）是 released，别的是 gone（退出了）。
            status = agent.get("agent_status", "unknown") if agent else gone_or_released[name]
            seq = agent.get("state_change_seq") if agent else None
            prev_status, prev_shown = previous.get(name, ("", ""))
            # 状态和上一轮一样、序号却变了：中间经历过别的状态，没被轮询到（worker 连着弹两个确认，编排者批完第一个，
            # 中间那下 working 没轮到，看到的是 blocked → blocked 就不报，三次各空等 10～24 分钟）。
            # blocked / done / idle 当作状态刚变重报一次；working 不因序号变化重报（免得噪音）。
            again = (status == prev_status and status in ("blocked", "done", "idle")
                     and seq is not None and seqs.get(name) not in (None, seq))
            seqs[name] = seq
            screen = None
            # herdr 报 working 也看屏幕：主 agent 在等后台子 agent 时，子 agent 的确认框被 herdr 报成 working（见 screen_override）。
            # 节流见 WORKING_DIALOG_CHECK_SECONDS：刚变成 working、上一轮判成 blocked、--once 时立刻读，否则隔这么久读一次。
            # codex 不读（没有这种弹框）。读屏失败沿用上一轮的判断（判成 blocked 的不因为一次读不到就报回 working）。
            working_dialog = False
            kind = agent.get("agent") if agent else None
            if (status == "working" and kind != "codex"
                    and (prev_status != status or prev_shown == "blocked" or a.once
                         or now - last_screen_check.get(name, 0) >= WORKING_DIALOG_CHECK_SECONDS)):
                last_screen_check[name] = now
                screen = screen_or_empty(name)
                working_dialog = (screen_override(status, screen, kind) == "blocked" if screen
                                  else prev_shown == "blocked")
            if working_dialog:
                # 卡在弹框上的这段时间不算进 working-no-output / working-no-diff：清掉计时，批完回到 working 后从头算
                # （等批准时屏幕和 worktree 本来就不会动，算进去的话一批完就会误报没动静）。
                shown = "blocked"
                progress.pop(name, None)
            elif status in ("done", "idle"):
                # herdr 报 done / idle 时看一眼屏幕：确认弹框改报 blocked；还有后台命令改报 waiting-background，
                # 免得编排者去读还不存在的报告；停在接口错误上改报 api-error。
                # 状态刚变（包括序号变了）时读，之后每 30 秒复查一次；改报成 blocked 的每轮都读（要看弹框换没换）。
                if (prev_status != status or again or prev_shown == "blocked" or a.once
                        or now - last_screen_check.get(name, 0) >= BACKGROUND_RECHECK_SECONDS):
                    last_screen_check[name] = now
                    screen = agent_screen(name, DIALOG_SCREEN_LINES)
                    shown = screen_override(status, screen) or status
                else:
                    shown = prev_shown
                if again and shown == prev_shown and shown.startswith("waiting-background"):
                    # 编排者挂着 Monitor 时，每处理一个 worker 事件都会 done → working → done；这个事件本来就只是"继续等"，不重报。
                    again = False
            elif status == "working" and (stall_seconds or quiet_seconds) and not a.once:
                info = progress.get(name)
                if info is None or prev_status != "working":
                    # 刚进入 working：从现在开始计时。指纹这时就超时（空串）的，之后的轮次补取，取到时才开始算没改动
                    cwd = agent.get("foreground_cwd") or agent.get("cwd") or ""
                    out_fp = output_fingerprint(name)[0] if quiet_seconds else None
                    info = progress[name] = {"cwd": cwd,
                                             "fp": worktree_fingerprint(cwd) if cwd and stall_seconds else None,
                                             "changed": now, "checked": now,
                                             "out_fp": out_fp, "out_changed": now, "out_checked": now}
                else:
                    if info["fp"] is not None and now - info["checked"] >= a.diff_interval:
                        info["checked"] = now
                        fp = worktree_fingerprint(info["cwd"])
                        # 空串是这一轮 git 超时没取到：不算有变化也不算没变化，隔 --diff-interval 再取
                        if fp != "" and fp != info["fp"]:
                            info.update(fp=fp, changed=now)
                    if quiet_seconds and now - info["out_checked"] >= a.output_interval:
                        info["out_checked"] = now
                        out_fp, running = output_fingerprint(name)
                        # 正在跑命令时不计没动静的时间（长测试交给 working-no-diff）
                        if out_fp != info["out_fp"] or running:
                            info.update(out_fp=out_fp, out_changed=now)
                quiet_for = now - info["out_changed"]
                idle_for = now - info["changed"]
                if quiet_seconds and info["out_fp"] is not None and quiet_for >= quiet_seconds:
                    # 屏幕输出 N 分钟没变、也没在跑命令：多半是卡在模型调用上，比 no-diff 早得多发现
                    bucket = int(quiet_for // quiet_seconds) * a.quiet_minutes
                    shown = f"working-no-output({bucket:g}m)"
                elif stall_seconds and info["fp"] and idle_for >= stall_seconds:
                    # 按阈值的整数倍报，限频：20 分钟报一次，40 分钟再报一次……
                    bucket = int(idle_for // stall_seconds) * a.stall_minutes
                    shown = f"working-no-diff({bucket:g}m)"
                else:
                    shown = status
            else:
                shown = status
            if shown == "blocked" and not a.once:
                # 兜底：herdr 自己也可能没看到中间那下 working（实测：一条回复里并行两个工具调用，批完第一个，
                # 第二个弹框立刻出来，herdr 一直是 blocked、序号也不变）。每轮取弹框指纹，弹框换了就重报。读屏失败时不动指纹。
                # herdr 报 working、屏幕上是后台子 agent 的弹框时同样适用（子 agent 连着弹，herdr 一直是 working）。
                if screen is None:
                    screen = agent_screen(name, DIALOG_SCREEN_LINES)
                if screen:
                    fp = dialog_fingerprint(screen)
                    if prev_shown == "blocked" and dialog_fps.get(name) not in (None, fp):
                        again = True
                    dialog_fps[name] = fp
                # 上一轮也是 blocked、herdr 的原始状态却变了：可能已经换了一个弹框（实测：子 agent 的第一个确认框 herdr 报 blocked，
                # 批完第二个紧接着弹出来，herdr 因为 "Waiting for N background agent" 那行改报 working，第二个没人报）。
                # 当作换了弹框重报一次：重报一个还没批的弹框无害（处理的一方总是先读屏再按键），漏报才有害。
                if prev_shown == "blocked" and status != prev_status:
                    again = True
            else:
                dialog_fps.pop(name, None)
            if watch_reports(shown, prev_shown, again, a.once, first_round):
                # 带上时间，方便事后分开算"agent 实际耗时"和"编排者自己的耗时"。
                print(f"EVENT {name} {shown} @{time.strftime('%H:%M:%S')}", flush=True)
                changed = changed or not first_round or shown in WATCH_START_EVENTS
            previous[name] = (status, shown)
            # rollup 事件单独一行，和 agent 状态那行互不影响（可以同时有 waiting-background(1) 和 rollup:完成）。
            if name in rollup_files and rollup_event(name, rollup_files[name], rollups, a.once):
                changed = changed or not first_round
        if a.once:
            return 0
        if a.until_event and changed:
            return 0
        first_round = False
        time.sleep(a.interval)


# ---------------------------------------------------------------- 主会话：watch --main、board、rollup 已读

def top_orch_tasks(names=()) -> list:
    """主会话盯的任务：顶层编排者（orch.json 里没有 parent；子编排者由上层追踪），每个编排者名取最新的一份 orch.json
    （latest_orch_metas）；names 给了只留这些名字。按 slug 排序：[{slug, name, kind, dir, tab_id}]（tab_id 是编排者所在的 tab，
    旧的 orch.json 没有是 None）。"""
    wanted = set(names)
    tasks = []
    for name, found in latest_orch_metas().items():
        meta = found["meta"]
        if meta.get("parent") or (wanted and name not in wanted):
            continue
        tasks.append({"slug": meta.get("slug") or found["dir"].name, "name": name, "kind": meta.get("kind"),
                      "dir": found["dir"], "tab_id": meta.get("tab_id")})
    return sorted(tasks, key=lambda t: t["slug"])


def main_shown(agent: dict, kind: Optional[str], cache: dict, now: float) -> tuple[str, Optional[str]]:
    """watch --main、board：编排者按屏幕修正后的状态（规则同 watch，screen_override）和这一轮读到的屏幕（没读是 None，读失败是
    空串）。读屏节流同 watch：herdr 的状态或序号变了、上次判成 blocked 时立刻读，否则 done / idle 每 BACKGROUND_RECHECK_SECONDS 秒、
    working 每 WORKING_DIALOG_CHECK_SECONDS 秒读一次，中间沿用上次的判断；读屏失败、状态没变时也沿用。codex working 不读。
    board 每次传空的 cache：每个编排者都读一次屏（herdr 报 blocked 的也读，算弹框指纹）。"""
    name, status, seq = agent["name"], agent.get("agent_status", "unknown"), agent.get("state_change_seq")
    prev = cache.get(name)
    same = prev is not None and (prev["status"], prev["seq"]) == (status, seq)
    if status == "blocked":
        screen, shown = screen_or_empty(name), "blocked"  # 每轮都读：要看弹框换没换
    elif status in ("done", "idle") or (status == "working" and kind != "codex"):
        every = WORKING_DIALOG_CHECK_SECONDS if status == "working" else BACKGROUND_RECHECK_SECONDS
        if same and prev["shown"] != "blocked" and now - prev["checked"] < every:
            return prev["shown"], None
        screen = screen_or_empty(name)
        shown = ((screen_override(status, screen, kind) or status) if screen
                 else prev["shown"] if same else status)
    else:
        screen, shown = None, status
    cache[name] = {"status": status, "seq": seq, "shown": shown, "checked": now}
    return shown, screen


def note_agent_state(task: dict, shown: str, seq: Any, screen: Optional[str], now: float, source: str) -> Optional[float]:
    """把编排者现在的状态记进 <slug>/AGENT_STATE_FILE：name、shown（按屏幕修正后的状态，退出了是 gone）、since（这一段
    第一次被看到的时间）、seq（herdr 的 state_change_seq），blocked 时加 dialog_fp（弹框指纹；读屏失败沿用记录里的）。
    和记录相比 编排者换了人、shown 变了、seq 变了（中间换过状态没轮询到，比如批完一个弹框又弹一个）、弹框指纹变了（herdr
    没看到中间那下 working，见 cmd_watch 的兜底）都算新的一段，since 记成 now；变了才写（原子写）。
    返回这一段的 since；这一段是这次才记下的返回 None——之前没在这个状态上看到过它，不知道已经持续多久，看板写"刚发现"。
    watch --main、board（文本、--json、--live）每一轮都调，谁先看到谁记。每换一段在时间线记一条 agent（shown、prev、seq，
    统计确认框、接口错误、意外退出的次数和时长，编排者自己干活的时长）：读-比-写都在时间线锁里，两边同时看只记一次。"""
    path = task["dir"] / AGENT_STATE_FILE
    with timeline_session(task["dir"]) as (_, new):
        old = read_json_dict(path)
        since = as_float(old.get("since"))
        fp = (dialog_fingerprint(screen) if screen else old.get("dialog_fp")) if shown == "blocked" else None
        same = (since is not None and (old.get("name"), old.get("shown"), old.get("seq")) == (task["name"], shown, seq)
                and old.get("dialog_fp") in (None, fp))
        record = {"name": task["name"], "shown": shown, "since": since if same else now, "seq": seq,
                  **({"dialog_fp": fp} if fp else {})}
        if record != old:
            write_json_atomic(path, record)
        if not same:
            new.append(timeline_event("agent", now, source, name=task["name"], shown=shown, prev=old.get("shown"), seq=seq,
                                      **({"dialog_fp": fp} if fp else {})))
    return since if same else None


def main_repeat_due(state: dict, key: str, at_key: str, value: str, now: float) -> bool:
    """watch --main 的去重加重报：value（rollup 的 digest、弹框指纹）和报过的（state[key]）不同，或者报过已满 MAIN_REPEAT_MINUTES
    还是它（仍未读、弹框还在），就该报，记下 value 和这次的时间（state[at_key]）。旧版本只记了 value、没记时间的从现在起算，
    不立刻重报。"""
    at = as_float(state.get(at_key))
    if state.get(key) == value and (at is None or now - at < MAIN_REPEAT_MINUTES * 60):
        if at is None:
            state[at_key] = now
        return False
    state[key], state[at_key] = value, now
    return True


def main_agent_events(task: dict, agent: Optional[dict], rstatus: str, state: dict, cache: dict,
                      now: float) -> tuple[str, Optional[str], list]:
    """watch --main 一轮里编排者本身的事件：(按屏幕修正后的状态，退出了是 gone；这一轮读到的屏幕；事件)，同时改 state
    （main-watch.json）。gone 只报意外退出：rollup 不是完成（做完退出是常态，没读的按 rollup 事件报）、也不是需要换编排者（编排者
    自己说要换人，按 rollup 事件报）；编排者活着时清掉 gone_reported，同名的编排者换上来以后又退出要再报。blocked 同一个弹框报一次、
    还在就隔 MAIN_REPEAT_MINUTES 再报，读屏失败沿用报过的指纹（没报过就报）；api-error 进入时报一次。"""
    if agent is None:
        if rstatus.startswith(("完成", "需要换编排者")) or state.get("gone_reported") == task["name"]:
            return "gone", None, []
        state["gone_reported"] = task["name"]
        return "gone", None, ["gone"]
    state.pop("gone_reported", None)
    shown, screen = main_shown(agent, agent.get("agent") or task["kind"], cache, now)
    events = []
    if shown == "blocked":
        fp = dialog_fingerprint(screen) if screen else (state.get("blocked_fp") or "unknown")
        if main_repeat_due(state, "blocked_fp", "blocked_at", fp, now):
            events.append("blocked")
    else:
        state.pop("blocked_fp", None)  # 弹框没了：之后再弹会再报
        state.pop("blocked_at", None)
    if shown != "api-error":
        state.pop("api_error", None)
    elif not state.get("api_error"):
        events.append("api-error")
        state["api_error"] = True
    return shown, screen, events


def main_watch_task(task: dict, agent: Optional[dict], cache: dict, idle_seconds: float, now: float) -> list:
    """watch --main 一轮里一个任务要报的事件（不带名字和时间），同时更新它的 main-watch.json（变了才写）。
    报过什么、什么时候报的跨重挂记在 main-watch.json：rollup digest 和弹框指纹（各带报出的时间，到时间再报，main_repeat_due）、
    api-error、退出的编排者名、停下的起点；rollup 已读看 main-seen.json（主会话用 drover rollup 读时写）。收尾完关掉的任务
    （closed_after_done）不盯。编排者现在的状态从什么时候开始另记在 agent-state.json（note_agent_state，看板也记）：它是"现在
    怎样"，main-watch.json 是"报过什么"，后者只有 watch --main 读写、整轮拿着 MAIN_WATCH_LOCK。
    时间线（统计用）也在这里补：note_agent_state 记编排者换的每一段，timeline_observe 记显示状态的变化和停了没更新。"""
    d = task["dir"]
    roll = read_rollup(d / "rollup.md")
    if closed_after_done(d, roll, agent.get("agent_status", "unknown") if agent else "gone"):
        return []
    path = d / MAIN_WATCH_FILE
    state = read_json_dict(path)
    before = dict(state)
    shown, screen, events = main_agent_events(task, agent, roll["status"] if roll else "", state, cache, now)
    note_agent_state(task, shown, agent.get("state_change_seq") if agent else None, screen, now, "watch-main")
    roll, info = timeline_observe(task, now, "watch-main")
    # 停了没更新（stall_since，看板、时间线同一个判定）：满 --idle-minutes 报一次，停的这一段（起点）变了再报。
    since = stall_since(d, info)
    if since is None:
        state.pop("stalled_since", None)
    elif now - since >= idle_seconds and state.get("stalled_since") != since:
        events.append(f"stalled({int((now - since) // 60)}m)")
        state["stalled_since"] = since
    if rollup_flags(d, roll)[0] and main_repeat_due(state, "rollup_emitted", "rollup_emitted_at", roll["digest"], now):
        events.append(f"rollup:{roll['status']}")
    if state != before:
        write_json_atomic(path, state)
    return events


def watch_main(a: argparse.Namespace) -> int:
    """watch --main（见 WATCH_DESCRIPTION 的 --main 一节）。和普通 watch 不同：不输出当前状态，只输出要处理、还没报过的事；
    --until-event 时启动那一轮的输出也算事件（这里输出的都是新的）。
    每一轮还做四件 drover 自己的事：写心跳（MAIN_WATCH_LIVE_FILE，看板靠它发现追踪断了）；触发自动更新检查（auto_update_tick）；
    报自动更新的结果（drover_main_events）；认出主会话重开（main-session.json 的 session_id 变了、source 是 clear / startup：
    /clear 之前挂着的后台 watch 会活到 /clear 之后，实测它退出时会叫醒新对话）。
    同时跑着两个 watch --main 时（/clear 之后新对话自己挂了一个、旧的还没退）："算事件 + 写去重记录"整轮拿 MAIN_WATCH_LOCK，
    同一件事只有一个进程报。"""
    idle_seconds = a.idle_minutes * 60
    cache: dict = {}
    started = time.time()
    session = read_json_dict(MAIN_SESSION_FILE).get("session_id")  # 启动时的主会话
    while True:
        if a.timeout and time.time() - started >= a.timeout:
            print(f"EVENT timeout @{time.strftime('%H:%M:%S')}", flush=True)
            return 0
        with contextlib.suppress(OSError):  # 写不了不管：看板只是少了个兜底
            write_json_atomic(MAIN_WATCH_LIVE_FILE, {"pid": os.getpid(), "at": time.time()})
        auto_update_tick()
        upkeep_tick()
        agents = list_agents()
        if agents is None:
            print(f"EVENT herdr unreachable @{time.strftime('%H:%M:%S')}", flush=True)
            if a.until_event:
                return 1
            time.sleep(10)
            continue
        by_name = {x.get("name"): x for x in agents if x.get("name")}
        now = time.time()
        note_observed(now)
        with flock_file(MAIN_WATCH_LOCK, None):
            session, restarted = session_restart_events(session)
            # 名字位置写 drover：是 drover 自己的事，不是哪个编排者的
            lines = [f"drover {event}" for event in restarted + drover_main_events(now)]
            # 每轮重新找编排者：watch 起来之后 orch-start 的新任务、resume 换上的编排者都能跟上，不用重挂。
            for task in top_orch_tasks(a.agents):
                lines += [f"{task['name']} {event}"
                          for event in main_watch_task(task, by_name.get(task["name"]), cache, idle_seconds, now)]
        for line in lines:
            print(f"EVENT {line} @{time.strftime('%H:%M:%S')}", flush=True)
        if a.until_event and lines:
            return 0
        time.sleep(a.interval)


def session_restart_events(known: Optional[str]) -> tuple[Optional[str], list]:
    """main-session.json 的 session_id 和 known（这个 watch 上次看到的）不同：新的 source 是 clear / startup 时报一次
    session-restarted（报过哪个 session 记在 MAIN_WATCH_DROVER_FILE，两个 watch 只有一个报）；compact、resume 不算重开
    （上下文还在），只跟上新的 session_id。返回 (现在的 session_id, 事件)。调用方持有 MAIN_WATCH_LOCK。"""
    cur = read_json_dict(MAIN_SESSION_FILE)
    sid = cur.get("session_id")
    if sid == known:
        return known, []
    if cur.get("source") not in ("clear", "startup"):
        return sid, []
    seen = read_json_dict(MAIN_WATCH_DROVER_FILE)
    if seen.get("session_restarted") == sid:
        return sid, []
    seen["session_restarted"] = sid
    write_json_atomic(MAIN_WATCH_DROVER_FILE, seen)
    return sid, ["session-restarted"]


