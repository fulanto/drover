#!/usr/bin/env python3
"""drover CLI：/drover 命令（Codex 里是 $drover 技能）的执行脚本。

把 flow/dispatch.md 里原来内联的 bash 片段收进一个脚本，主会话和编排者只需执行单条命令、读 JSON。
所有子命令（watch、heavy、playbook --text、update 不带 --json、rollup、rules、board 不带 --json / --pane 除外）都向 stdout 输出一个
JSON 对象，字段 ok 表示是否成功；失败时 error 字段说明原因和下一步该怎么做，进程退出码为 1。

子命令：
  preflight     检查是否在 Herdr 内、server 是否运行、常用工具是否可用
  wt            建或复用 worktree：新建前 fetch 源仓库主检出的上游，主检出干净且落后时快进，从远端最新起（--no-sync 不同步）；
                复制 settings.local.json 和 .env*（源仓库没跟踪的，或在 worktree 里被忽略的），返回 workspace/pane/路径/起点 commit
  deps          在 worktree 里独立安装依赖（不软链源仓库），返回给 agent prompt 用的中文摘要；--save 存成 JSON 给 brief 用
  agent-start   在 pane 里启动 claude/codex agent（--kind 不给时用主会话的宿主），自动处理新目录的信任弹窗；
                --split-from 在旁边新开 pane 再启动
  orch-start    为一个任务起编排者（orchestrator）：在 orch workspace 里新开 tab，启动 claude 或 codex（--kind，不给时跟调用方的宿主），
                发出编排者开场 prompt；orch.json 记下主会话的宿主（default_kind），任务里的 worker 默认用它
  orch-status   列出编排者的 herdr 状态和 rollup 状态行（主会话一条命令看全部；Codex 主会话每轮开头查一次）；
                按屏幕修正的状态放 screen_status，卡在确认框上的列进 blocked；needs_attention 只算主会话还没读过的 rollup
  brief         按模板生成任务 prompt（必填完成证据，写进状态文件）；--survey 先让 agent 摸底；--send 生成后立刻发出
  prompt        从文件（或 --text 短消息）读取 prompt 发给 agent（避免命令行里出现超长字符串）；发给编排者时记 answered.json
  watch         轮询 agent 状态，状态变化时输出一行带时间的 EVENT（给 Monitor 用）；同一状态 herdr 序号变了或弹框换了也重报，
                done 但屏幕上是确认弹框、working 但屏幕底部是后台子 agent 的确认框时报 blocked；编排者另外输出 rollup:<状态>；
                --until-event 在第一个变化时退出（给 Codex 阻塞等待用）；--main 是主会话专用的：自动找顶层编排者，
                只报要主会话处理的事，报过的记在磁盘上，重挂不重报
  rollup        读编排者的 rollup（--slug 或 --name 编排者名）：原样输出，开头一行说明和主会话上次读的比改了什么；
                主会话读完记为已读（main-seen.json），别人读不记，开头多一行说明
  board         任务看板：等你 / 现在可以看结果的 / 还在处理的 / 提醒，每样交付走到哪一步，每次现场生成；默认 Markdown，
                --plain（飞书）、--json、--line（状态栏）、--pending（【转达】的脚注）、--live（循环重画，看板 tab 里能点 [收尾]，
                装着的 drover 换了版本就重新执行自己）、--tab（开和主对话同级的看板 tab，里面是旧代码的看板就重启）、--pane（旧的下方分屏）
  accept        验收：git add -N、建图、detect-changes --brief、diff --stat、crapper 查改动函数的复杂度、--verify 重跑验证命令；
                --save 存成 JSON 给 review 用；--brief 只打印摘要；--integration 集成检查（不建图，dryer 查碰到改动的重复）
  review        复审一条命令：按模板生成 prompt、分屏启动只读 codex、立刻发出 prompt
  collect       复审结束后存档输出原文、取出 codex 自报耗时、关闭复审 pane
  review-start  （底层）只分屏并启动只读 codex，不发 prompt
  history       按仓库列出历史派发记录（结论、未决、踩坑），--grep 摘出相关行
  playbook      读团队 profile 和个人覆盖目录的规则（general.md、repos/<仓库名>.md），编排者分析任务时读；--text 只打印正文
  accept-summary 从 accept --save 的存档里重新打印摘要和失败输出（代替自己拼 jq）
  heavy         经调度执行构建 / 测试命令：按本机实测的占用决定马上跑还是排队（轻的同时跑、重的等机器有空）；
                输出原样透传，退出码同被执行的命令；--status 看全机调度状态
  integrate     编排者的集成 worktree（每个仓库一个，分支 task/<slug>）：fetch 后从最新上游建、依次 cherry-pick 各条目分支
  push          集成 worktree 推送前：fetch，上游有新提交就 rebase 并报告上游改了什么（这次不推）；没有就推送并 ls-remote 核对
  wrapup        收尾汇总的事实（只读）：各仓库推到哪条分支哪个提交、远端核对、改动文件分类、新增配置键引用、整体检查、
                待清理的 worktree；--draft 写 ~/.drover/<slug>/wrapup.md 骨架
  main-register 把当前 pane 的 agent 登记成主会话（herdr 里改名为 drover，飞书 oncall 按这个名字认主会话）；
                --hook 给 Claude Code 的 SessionStart hook 用（静默，退出码恒为 0）；登记上了写 main-session.json，
                顺带记下主会话载入时的规则（main-rules.json）、触发自动更新检查
  oncall        飞书 oncall（内置的 herdr-oncall 插件）：pair 发起配对并给出配对链接（--wait 等到配上再发测试消息），
                unpair / test / on / off 交给插件执行，status 看插件、飞书配对和主会话登记状态
  update        更新 drover 自己：fetch 并快进 clone（只快进）、按安装记录的模式和宿主重跑 install、--check，
                打印几行结果和下一步；--dry-run 只 fetch 看要拉什么，--json 输出 JSON；
                --auto 是后台的自动更新（主会话那边的 main-register、watch --main、board 到时间了起它，无人值守，
                结果写 auto-update.json）
  rules         主会话读 drover 规则的改动（不用 /clear）：AGENTS.md 里的 drover 区块和主会话载入时的比，只给差别；
                --full 给整个区块，--hook 给 Claude Code 的 UserPromptSubmit hook 用（只在主会话、规则变了时输出）

用 `drover <子命令> --help` 查看参数。
"""

from __future__ import annotations

import argparse
import base64
import contextlib
import ctypes
import ctypes.util
import difflib
import fcntl
import functools
import hashlib
import itertools
import json
import os
import re
import select
import shlex
import shutil
import signal
import statistics
import subprocess
import sys
import tempfile
import termios
import threading
import time
import tty
import unicodedata
from collections import Counter
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from typing import Any, Callable, Optional
from urllib.parse import urlsplit

HOME = Path.home()
# 状态目录放在 ~/.drover 而不是 ~/.claude：~/.claude 是 Claude Code 的配置目录，agent 往里写报告会被强制审批，规则放行不了。
# 环境变量 DROVER_STATE_DIR 可以换成别的目录（config.json、任务记录、heavy 调度状态、基线缓存都跟着走）：自测和调试用临时目录，不碰真实状态。
STATE_HOME = Path(os.environ.get("DROVER_STATE_DIR") or HOME / ".drover").expanduser()
# drover 包的根目录（bin/drover 的上一级）：软链安装时解析到包的源码目录（clone），复制安装时是 ~/.drover/pkg。
PKG_ROOT = Path(__file__).resolve().parent.parent
# 本机配置（install.py 写）：workspace 是主工作台目录（主会话和编排者的工作目录，也是可信仓库根目录），
# repo_dirs 是按名字找仓库的目录，按顺序找（没写时就是 workspace，和 install.py 一致）。
# 主工作台没有默认值：没有配置文件（没跑过 install.py）时不自动信任任何目录，按名字找仓库只看当前目录，
# 要用主工作台的子命令（orch-start）报错让先跑 install.py。
# profile 是团队 profile（写名字用包里的 profiles/<名>/，写路径用那个目录；null 表示只用包默认规则），
# playbook_dirs 是个人覆盖目录（布局和 profile 一样，排在团队 profile 之后读，后读的优先）。见 profiles/README.md。
CONFIG_FILE = STATE_HOME / "config.json"


def load_config() -> dict:
    cfg = {"workspace": None, "repo_dirs": None, "profile": None, "playbook_dirs": []}
    with contextlib.suppress(OSError, ValueError):
        cfg.update(json.loads(CONFIG_FILE.read_text()))
    return cfg


CONFIG = load_config()
# 仓库在这个目录下时，herdr 要求信任仓库可以自动补 --trust-repository；其他位置要先问用户。没配置主工作台时是 None。
TRUSTED_ROOT = Path(CONFIG["workspace"]).expanduser() if CONFIG.get("workspace") else None
REPO_DIRS = [Path(d).expanduser()
             for d in (CONFIG.get("repo_dirs") or ([CONFIG["workspace"]] if TRUSTED_ROOT else []))]
NO_WORKSPACE_ERROR = (f"没有配置主工作台（{CONFIG_FILE} 的 workspace），先跑 install.py：在 drover 的 clone 里执行 "
                      "./install.sh --workspace <主工作台目录>（你平时放各个仓库、开主会话的目录，不能是家目录）")
AGENT_NAME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,59}$")
# 状态目录下的固定目录（install.py 和本脚本建的，oncall-images 是飞书 oncall 插件按 drover.env 的 CHAT_IMAGE_DIR 存飞书图片的），
# 任务 slug 不能和它们重名。
RESERVED_SLUGS = ("pkg", "src", "bin", "backups", "baselines", "locks", "oncall-images", "tools")
HERDR_WORKTREES = HOME / ".herdr" / "worktrees"
# 安装后的 CLI 固定入口（install.py 的 BIN_LINK），写进任务书让 worker 执行的命令用它。写成字面的 ~ 路径：
# 权限规则 Bash(~/.drover/bin/drover:*) 按命令文本的字面前缀匹配，展开成 /Users/<名字>/... 就对不上，worker 每跑一次
# heavy 都弹确认框（实测一个 Java 任务弹了 8 次、等了 145 秒）。也不跟 DROVER_STATE_DIR 走：临时状态目录下没有 bin/drover。
DROVER_CMD = "~/.drover/bin/drover"
# claude / codex 在新目录启动时的信任弹窗。
TRUST_PROMPT_RE = re.compile(
    r"(?i)(do you trust|trust (the|this) (files|folder|directory|workspace|project)|trust the contents)"
)
# Claude Code 对 --add-dir 加进来、这个会话没用过的目录弹的信任框（实测，样本见 selftest_screens.TRUST_ADD_DIR）：
# 标题 "Adding a new directory:"，问句 "This session hasn't worked here before. Is this a directory you created or one you trust?"，
# 选项 "No, exit" / "Yes, add it"，光标默认在 No（2.1.327 的包里 cancelFirst、focus: "cancel"）。同一个组件另有
# "Moving to a new directory:"、"Now in a new directory:" 两种标题，启动时没见过，不认。
# 标题和问句都要有；单词之间用 \s+，窄 pane 里问句折行也认。
TRUST_ADD_DIR_RE = re.compile(r"Adding a new directory:[\s\S]*hasn't\s+worked\s+here\s+before")
# 启动时已知、可以安全自动处理的弹窗：(匹配文案, 动作, 记录名)。不在表里的弹窗一律交给编排者判断。
# - 信任弹窗不能直接按回车：Claude Code 的默认选项是"No, exit"，回车会直接退出。要把光标移到肯定项再确认。
# - codex 的升级提示按 esc 跳过：升级会全局 npm install -g，属于必须由用户决定的事。
STARTUP_DIALOGS = [
    (TRUST_ADD_DIR_RE, "select_yes", "trust_add_dir"),
    (TRUST_PROMPT_RE, "select_yes", "trust_folder"),
    (re.compile(r"(?i)update available"), "esc", "skip_update"),
]
# 选择菜单里光标所在行：Claude Code 用 ❯，codex 用 ›。
CURSOR_LINE_RE = re.compile(r"^\s*[❯›]\s*(?:\d+\.\s*)?(.+?)\s*$")
AFFIRMATIVE_RE = re.compile(r"(?i)\b(yes|trust|allow)\b")
NEGATIVE_START_RE = re.compile(r"(?i)^(no|don'?t|exit|quit|cancel)\b")
JS_LOCKFILES = [
    ("bun.lock", "bun"),
    ("bun.lockb", "bun"),
    ("pnpm-lock.yaml", "pnpm"),
    ("yarn.lock", "yarn"),
    ("package-lock.json", "npm"),
]
LOCKFILE_NAMES = {name for name, _ in JS_LOCKFILES} | {"uv.lock"}
SCAN_SKIP_DIRS = {
    "node_modules", ".git", ".venv", "venv", ".output", "dist", "build", "target",
    ".code-review-graph", ".next", ".nuxt", "__pycache__",
}
# 仓库规范文件：claude 自动加载 CLAUDE.md / CLAUDE.local.md，codex 读 AGENTS.md。
REPO_DOC_NAMES = ["CLAUDE.md", "CLAUDE.local.md", "AGENTS.md"]
# 仓库声明"新 worktree 还要带哪些被忽略的本地文件"：Claude Code 的约定（gitignore 语法），见 copy_local_files。
WORKTREE_INCLUDE = ".worktreeinclude"
# heavy 调度（替换了早先的"机器级排他锁，同一时间只跑一个"）：构建 / 测试命令按"机器还剩多少、
# 这条要多少"决定马上跑还是排队，剩余和需求都按本机实测。来由：排他锁让轻命令排在全量测试后面（验收存档 107 次排队共 2.6 小时，
# 0.5 秒的 compileall 等了 1014 秒）；实测（Apple M4，4 性能核 + 6 能效核）几条命令合计占用 ≤ 性能核数时同跑几乎不变慢、
# 总用时降 29～37%，超过后每条慢 1.8～2.9 倍、全量 vitest 超时（同样的活 CPU 时间涨 2 倍多，挤到了能效核上），内存是次要因素。
# 所以容量从性能核数起步、内存只当闸门。这条依据只来自这台 M4，
# 别人的机器和项目不一样：容量之后按真实命令的表现自动调（heavy_calibrate），config 可固定。
# 底线是"不能在 CPU 空闲的时候白白干等"：放行改成按实时 CPU（整机实测 + 各条命令进程树的实测），预留只补刚放行、
# 还没在实测里显出来的那几秒；没跑过的命令不再按独占，先按 HEAVY_UNKNOWN_CORES 核（见 heavy_plan）。
# 状态都在 HEAVY_DIR 下：
#   sched.lock    读改调度状态时拿的 flock（毫秒级）
#   run-*.json    一条命令一张票（命令、cwd、需求、排队 / 在跑、在跑的进程树实测 CPU）；属主进程一直对它持 flock，进程没了
#                 锁就没了，下一个拿 sched.lock 的进程试锁成功就删票（被杀、崩溃都能回收；不靠 pid：codex 沙箱里
#                 kill(外部 pid, 0) 得 EPERM，pid 还会复用）
#   history.json  按命令形状、按同一条命令分别记最近几次的实测（墙钟、CPU 时间、进程树内存峰值、退出码），同一条命令另记
#                 单独跑的基准；以及容量校准的状态
# accept --verify 和建图自动进调度，worker 用 `drover heavy -- <命令>`；codex worker 的沙箱由 agent-start 加 --add-dir 放行这个目录。
HEAVY_DIR = STATE_HOME / "locks" / "heavy"
HEAVY_SCHED_LOCK = HEAVY_DIR / "sched.lock"
HEAVY_HISTORY = HEAVY_DIR / "history.json"
HEAVY_HISTORY_RUNS = 5      # 每个命令形状、每条命令保留最近几次
HEAVY_HISTORY_KEYS = 400    # 命令形状、同一条命令各自的条数上限，超了按最近一次使用的时间删旧的
# 校准规则的版本：history.json 里别的版本的校准状态当成没有（heavy_doc），从硬件值重新校准。
# 2：基准从"同一命令形状的单独跑"改成"同一条命令的单独跑"——形状把不同的测试文件归成一类，版本 1 拿 A 文件的耗时
# 比 B 文件们的单独耗时（单独跑 3.1～35.8 秒的几个文件共用一个基准），把本机容量从 4 误降到 3。
HEAVY_CAL_VERSION = 2
HEAVY_POLL_SECONDS = 0.25   # 排队时多久看一次
HEAVY_SAMPLE_SECONDS = 1.0  # 进程树内存、CPU 多久采一次（ps 一次约 0.02 秒）
HEAVY_CPU_WINDOW = 2.0      # 整机、进程树的实测 CPU 取最近几秒的平均（排队时每 HEAVY_POLL_SECONDS 秒采一次整机）
HEAVY_CPU_MIN_SPAN = 0.5    # 两次采样至少隔这么久才算数（刚开始排队、--status 现采时最多多等这么久）
HEAVY_UNKNOWN_CORES = 1.0   # 没有历史的命令先按几核（一个进程最多占满一核；本机实测的单条测试命令多在 0.4～0.9 核），跑起来按实测
HEAVY_KILL_GRACE = 5        # 被中断时转发信号后等子进程自己退出的秒数，到了补 SIGKILL；capture_run 超时停子进程也用它
# config.json 可覆盖的阈值（docs/configuration.md）；容量 heavy_cpu_capacity 见 heavy_capacity。
HEAVY_SETTINGS = {
    "heavy_small_seconds": 10.0,   # 历史上最长也在这么多秒内跑完的小命令不排队、不计入占用
    "heavy_starve_seconds": 120.0,  # 排头等了这么久还没放行，后来的只放能在它开跑前跑完的（防饿死，见 heavy_plan）
    # 刚放行的命令在实测里显出来之前按预留算的秒数：整机实测取最近 HEAVY_CPU_WINDOW（2）秒的平均、进程树实测要两次 ps
    # 采样，再加上命令起进程、爬到稳定占用的时间。实测：6 套自测（run.py，10 个 worker 进程）经 heavy 跑，进程树实测
    # 放行后 2.4 秒第一次有值（0.87 核）、4.4 秒爬到稳定（1.85 核，之后在 1.3～2.0 之间）
    "heavy_grace_seconds": 5.0,
    "heavy_mem_psi": 10.0,         # Linux：/proc/pressure/memory 的 some avg10 到这个百分比算内存紧张
    # 容量校准（heavy_calibrate）：同时跑的命令比它单独跑慢到这个倍数算"明显变慢"、快于这个倍数算"几乎不变慢"，
    # 连续几个明显变慢就降一核、连续几个几乎不变慢（负载接近容量时）就加一核。heavy_calib_fast 也是单独跑基准的抖动界线
    # （heavy_baseline）
    "heavy_calib_slow": 1.5,
    "heavy_calib_fast": 1.2,
    "heavy_calib_down": 2.0,
    "heavy_calib_up": 3.0,
}
# 脚本运行器：第一个非选项参数是文件时，它就是程序本身（bun scripts/x.mjs、python3 run_tasks.py），进命令形状。
HEAVY_SCRIPT_RUNNER_RE = re.compile(r"^(python(3(\.\d+)?)?|node|bun)$")
HEAVY_EXT_RE = re.compile(r"\.[A-Za-z][A-Za-z0-9]{0,5}$")
HEX_REV_RE = re.compile(r"^[0-9a-f]{7,40}$")
# heavy 只排队跑构建 / 测试：白名单 Bash(~/.drover/bin/drover:*) 让 heavy 免确认，heavy 要是什么都执行，
# 就等于白名单放行了任意命令（git push、rm、bash -c …）。所以跳过开头的 env 和 VAR=值 之后，程序名（取 basename，
# ./mvnw、./.venv/bin/python 都认）必须在这张表里；python 带版本号（python3.12）也算。jest、vue-tsc 是在建议名单上
# 补的：和 vitest、tsc 同类。node 是后补的：文档的 CDP 检查（verify-*-cdp.mjs）一直用 heavy -- node 排队。
# 名单里的 python / node / npx / bun / make 本身能跑任意代码，这里挡的是把 heavy 当通用执行器。crapper、mutator 是 docs/quality-tools.md 写的
# 手动跑法（带覆盖率的 crapper 会跑全量测试，mutator 一跑就是每核一个 worker），要经调度。
HEAVY_TOOLS = frozenset({
    "mvn", "mvnw", "gradle", "gradlew",
    "bun", "bunx", "npm", "npx", "pnpm", "yarn", "vitest", "jest", "tsc", "vue-tsc", "eslint", "prettier",
    "python", "python3", "pytest", "uv", "node",
    "make", "go", "cargo",
    "crapper", "mutator",
})
HEAVY_PYTHON_RE = re.compile(r"^python3\.\d+$")
ENV_ASSIGN_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
# slug 进了结果文件路径；Claude Code 把带 import/include 的 jq 参数判成"加载模块"，弹出无法加白名单的强制审批。
SLUG_RISKY_WORDS = re.compile(r"(import|include)")
# 联网 git（git_net）失败时按原因行判断会不会自己好，会自己好的才重试。ssh / 本地传输初次连接失败时 git 总在最后补一句
# "Could not read from remote repository. Please make sure you have the correct access rights and the repository
# exists."（connect.c die_initial_contact），这句不是原因、不算数：仓库不存在 / 路径不是仓库（"does not appear to be a
# git repository"）、服务端说没有这个仓库、主机密钥不对，第一次就报。算偶发的（本机实测 ssh / http / 本地传输）：
# - ssh：连接被拒 / 超时 / 被重置 / 被关闭（"Connection to <主机> closed by remote host."）、网络不可达、握手被断；
# - 传输中途断开：early EOF、unexpected disconnect；
# - https（curl）：连不上、502 / 503 / 504、TLS 握手被断（SSL_ERROR_SYSCALL）、服务端不回包、包体只回一半；
# - 主机名解析：只认解析器自己说是临时的（EAI_AGAIN）。"没有这个名字"（EAI_NONAME，curl 的 Could not resolve host）
#   不重试：写错的主机名、只有内网 DNS 才解析得了的域名隔几秒也不会好；代价是 macOS 断网时也报 EAI_NONAME，这种不重试；
# - 公钥认证被拒：GitHub 经代理 TUN 时偶发（实测多次），隔几秒重试就好。和真没配公钥打的是同一行，分不出来，照样重试。
# git_net_once 用 C locale 跑 git，git 自己的话不会被翻译（ssh、curl 的话本来就不翻译）。
GIT_TRANSIENT_RE = re.compile(
    r"(?i)(permission denied \(publickey\)|connection (reset|closed|timed out|refused)|closed by remote host"
    r"|operation timed out|no route to host|network is unreachable|early eof|unexpected disconnect|kex_exchange"
    r"|broken pipe|temporary failure in name resolution|couldn't connect to server|returned error: 50[234]"
    r"|rpc failed; http 50[234]|ssl_error_syscall|empty reply from server|transfer closed with)")
GIT_NET_TRIES = 3
GIT_NET_TIMEOUT = 300  # 秒，每次。update --auto（无人值守）改成只试 1 次、AUTO_UPDATE_NET_TIMEOUT 秒，见 auto_update_unattended
# fetch 指定分支时远端没有这条分支：wt 在主检出没配上游、按 origin/<当前分支> 试 fetch 时，据此判断"没有上游"（不算失败）。
# 中文 locale 下 git 打的是"无法找到远程引用"，靠 git_net_once 的 C locale 才认得出。
REMOTE_REF_MISSING_RE = re.compile(r"(?i)couldn't find remote ref")
# 上游改动按类型归类，push 时据此提示要不要重新检查。
DEPS_FILE_RE = re.compile(
    r"(^|/)(package\.json|bun\.lockb?|pnpm-lock\.yaml|yarn\.lock|package-lock\.json|requirements[^/]*\.txt|pyproject\.toml"
    r"|uv\.lock|poetry\.lock|pom\.xml|build\.gradle(\.kts)?|go\.(mod|sum))$")
MIGRATION_FILE_RE = re.compile(r"(^|/)(migrations?|migrate|db/changelog)/")
DOC_FILE_RE = re.compile(r"(\.md$|^docs/)")
# vitest 输出解析：失败条目、超时、计数行；pytest 的结尾汇总行。
ANSI_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
VITEST_BANNER_RE = re.compile(r"^\s*RUN\s+v\d", re.M)
# FAIL 行（去掉 ANSI 后）：" FAIL  [project 标签] 文件 > describe > 用例"，整个文件失败是 "… 文件 [ 文件 ]"。配了 test.projects
# 且 project 有名字时文件前多一个标签（vitest 4 的 formatProjectName）：不带颜色是 "|ts| "，带颜色是背景色块 " ts "，
# 去掉 ANSI 后只剩 "ts "（在 vitest 4.1.7 上实测）。标签当可选前缀跳过、不进 key：开没开 projects，同一条用例的
# key 一样，和基线（旧配置、不带标签）对得上。前缀按最短的取，用例名里再出现测试文件名也不会被当成文件。
VITEST_FAIL_RE = re.compile(r"^\s*FAIL[ \t]+(?:.*?[ \t])??(\S+\.(?:test|spec)\.[cm]?[jt]sx?)(.*)$", re.M)
VITEST_TIMEOUT_RE = re.compile(r"(Test|Hook) timed out in \d+\s?ms")
VITEST_FAILED_TESTS_RE = re.compile(r"^\s*Tests\s+(\d+) failed", re.M)
TEST_COUNT_LINE_RE = re.compile(
    r"^\s*(?:(?:Test Files|Tests)\s+\d+ .+|=+ .*\b\d+ (?:passed|failed|errors?)\b.*=+)\s*$", re.M)
# 和基线比失败集合（accept --verify-baseline）：各工具的失败条目。
BASELINE_DIR = STATE_HOME / "baselines"
TSC_ERROR_RE = re.compile(r"^(?P<file>\S[^(\n]*)\(\d+,\d+\): error (?P<code>TS\d+)", re.M)
ESLINT_ENTRY_RE = re.compile(r"^\s+\d+:\d+\s+error\s+.*?\s{2,}(?P<rule>[@\w/.-]+)\s*$")
ESLINT_SUMMARY_RE = re.compile(r"^✖ \d+ problems?", re.M)
PYTEST_FAIL_RE = re.compile(r"^(?:FAILED|ERROR) (?P<id>\S+)", re.M)
# 基线只重跑失败所在的文件时，要去掉原命令里的位置参数（目录 / 文件）、保留选项。不带 "=" 的长选项默认当成后面跟一个值：
# 认错了只会把原来的目录留下（基线等于照整条跑，慢但结论对）；反过来把带值的选项当成开关，它的值会被当成位置参数去掉，命令就坏了。
# 所以这里只列常用的开关；短选项只有列出的几个带值（-q / -v / -x / -s 这类都是开关）。
PYTEST_BOOL_FLAGS = {
    "--lf", "--last-failed", "--ff", "--failed-first", "--nf", "--new-first", "--sw", "--stepwise", "--sw-skip",
    "--stepwise-skip", "--exitfirst", "--quiet", "--verbose", "--strict", "--strict-markers", "--strict-config",
    "--disable-warnings", "--disable-pytest-warnings", "--showlocals", "--runxfail", "--pdb", "--trace", "--co",
    "--collect-only", "--cache-clear", "--setup-show", "--full-trace", "--doctest-modules", "--cov-append",
    "--cov-branch", "--noconftest", "--continue-on-collection-errors", "--forked",
}
PYTEST_VALUE_SHORT = {"-k", "-m", "-p", "-c", "-o", "-W", "-n", "-r"}
ESLINT_BOOL_FLAGS = {
    "--fix", "--fix-dry-run", "--cache", "--quiet", "--color", "--debug", "--report-unused-disable-directives",
    "--exit-on-fatal-error", "--error-on-unmatched-pattern", "--pass-on-no-patterns", "--stats",
}
ESLINT_VALUE_SHORT = {"-c", "-f", "-o"}
# 包脚本（bun run test、npm test）：vitest 的文件过滤可以追加在后面；eslint 的脚本一般写死了目录（eslint .），追加了也缩不小范围。
PACKAGE_RUNNERS = {"bun", "npm", "pnpm", "yarn"}
BASELINE_SUBSET_HINT = ("基线只单独跑了当前失败所在的文件：某条用例单独跑能过、整套跑才失败（执行顺序、共享状态）时会被误报成新增。"
                        "遇到时在当前 worktree 也单独跑这个文件：也能过、diff 又没碰它相关的代码，就不是这次引入的；单独跑仍失败才是真的新增")


class DroverError(Exception):
    """可预期的失败：带上下文信息，最终以 JSON 输出。"""

    def __init__(self, message: str, **extra: Any) -> None:
        super().__init__(message)
        self.message = message
        self.extra = extra


# ---------------------------------------------------------------- 基础工具

def emit(obj: dict) -> None:
    print(json.dumps(obj, ensure_ascii=False, indent=2), flush=True)


def tail(text: str, limit: int = 1500) -> str:
    text = (text or "").strip()
    return text if len(text) <= limit else "…" + text[-limit:]


def stop_tree(proc: subprocess.Popen) -> None:
    """停掉还在跑的 proc：先给它的进程树（git commit 的 hook、git fetch 的 ssh 都在里面）发 SIGTERM，等它自己退出最多
    HEAVY_KILL_GRACE 秒，还在再 SIGKILL 整棵树。等的时候又来信号（再按 Ctrl-C、heavy_on_signal）就不等了。
    git 收到 SIGTERM / SIGINT 会在信号处理里删掉自己拿着的 index.lock 再退出，SIGKILL 接不住：写 index 的 git（add -N、
    update-index、commit、cherry-pick、rebase）被强杀就留下 0 字节的锁（git 刚建出锁文件、还没装上信号处理的那一瞬间
    收到 SIGTERM 也会留，那是 git 自己的窗口）。"""
    if proc.poll() is not None:
        return
    signal_tree(proc.pid, signal.SIGTERM)
    try:
        proc.communicate(timeout=HEAVY_KILL_GRACE)  # 接着读管道：子进程不会因为写满管道卡住
        return
    except (subprocess.TimeoutExpired, HeavyInterrupted, KeyboardInterrupt):
        pass
    if proc.poll() is None:
        signal_tree(proc.pid, signal.SIGKILL)
    proc.wait()


def capture_run(cmd: list, *, cwd: Optional[str] = None, timeout: Optional[float] = None, input=None,
                env: Optional[dict] = None, text: bool = True) -> subprocess.CompletedProcess:
    """subprocess.run(capture_output=True) 的替身，只差在超时、被中断时怎么停：subprocess.run 直接 SIGKILL 子进程，这里交给
    stop_tree（先 SIGTERM，等 HEAVY_KILL_GRACE 秒再 SIGKILL）。子进程照旧留在 drover 的进程组里（不开新会话），终端的
    Ctrl-C 还是直接到它。超时照旧抛 TimeoutExpired（stdout 是到那时为止的输出），找不到命令照旧抛 FileNotFoundError。"""
    with subprocess.Popen(cmd, cwd=cwd, env=env, text=text, stdin=subprocess.PIPE if input is not None else None,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE) as proc:
        try:
            out, err = proc.communicate(input, timeout=timeout)
        except BaseException:
            stop_tree(proc)
            raise
        return subprocess.CompletedProcess(cmd, proc.returncode, out, err)


def run(cmd: list, *, cwd: Optional[str] = None, timeout: Optional[float] = None,
        input_text: Optional[str] = None, env: Optional[dict] = None) -> subprocess.CompletedProcess:
    """env 是在当前环境上额外设的变量（如临时 index 的 GIT_INDEX_FILE）。超时、被中断时先 SIGTERM 再 SIGKILL（capture_run）。"""
    try:
        return capture_run(cmd, cwd=cwd, timeout=timeout, input=input_text, env={**os.environ, **env} if env else None)
    except FileNotFoundError:
        raise DroverError(f"找不到命令 {cmd[0]}，请确认已安装并在 PATH 里")
    except subprocess.TimeoutExpired as exc:
        raise DroverError(f"命令超时（{timeout} 秒）：{shlex.join(cmd)}", output=tail(str(exc.stdout or "")))


# drover 起的 git 一律带上（git() / git_bytes() 合在调用方给的 env 后面）：只读的 git status 默认会顺手刷新 index 并写回，
# 写的时候拿 index.lock，持锁时被强杀就留下 0 字节的锁，之后的 git add / commit 都报 "index.lock: File exists"
# （一个大前端仓库里出现过两次）。git-status 文档 BACKGROUND REFRESH：后台跑的用 --no-optional-locks，git(1)：等价于
# GIT_OPTIONAL_LOCKS=0。真要写 index 的（add、commit、cherry-pick、merge、rebase、worktree add / remove）拿的是必需锁，不受影响。
GIT_NO_OPTIONAL_LOCKS = {"GIT_OPTIONAL_LOCKS": "0"}
# 比对工作区的 git diff 不看 GIT_OPTIONAL_LOCKS，照样刷新并改写 index（git 2.51 实测），要靠 diff.autoRefreshIndex=false。
# 关掉之后"内容没变、只改了时间"的文件会出现在 --name-only / --name-status 的输出里，所以不放进公共入口，只加在输出不受它
# 影响的调用上：完整 diff、--stat、--diff-filter=U（这类文件是 M，筛掉了）。
DIFF_NO_REFRESH = ("-c", "diff.autoRefreshIndex=false")


def git(repo: str, *args: str, timeout: float = 120, input_text: Optional[str] = None,
        env: Optional[dict] = None) -> subprocess.CompletedProcess:
    return run(["git", "-C", repo, *args], timeout=timeout, input_text=input_text,
               env={**(env or {}), **GIT_NO_OPTIONAL_LOCKS})


def c_locale_env() -> dict:
    """要按 git 的原话做判断的命令用这个环境跑（C locale）：中文 locale 下 git 会把这些话翻译掉。环境在调用时取：
    update --auto 运行中才改 os.environ（auto_update_unattended）。"""
    return {**os.environ, "LC_ALL": "C"}


def git_bytes(repo: str, *args: str, env: Optional[dict] = None, input_bytes: Optional[bytes] = None,
              timeout: float = 600) -> subprocess.CompletedProcess:
    """git 按字节读写（补丁里可能有不是 UTF-8 的文本，按文本解码会出错）。超时同 run（capture_run）。"""
    try:
        return capture_run(["git", "-C", repo, *args], input=input_bytes, timeout=timeout, text=False,
                           env={**os.environ, **(env or {}), **GIT_NO_OPTIONAL_LOCKS})
    except subprocess.TimeoutExpired:
        raise DroverError(f"命令超时（{timeout} 秒）：git -C {repo} {shlex.join(args)}")


def git_out(repo: str, *args: str) -> str:
    p = git(repo, *args)
    if p.returncode != 0:
        raise DroverError(f"git {' '.join(args)} 失败", repo=repo, stderr=tail(p.stderr))
    # 只去掉末尾换行：status --porcelain 的第一行开头是有意义的空格（" M"）。
    return p.stdout.rstrip()


def git_net(repo: str, *args: str) -> tuple[subprocess.CompletedProcess, int]:
    """fetch / push / ls-remote：失败原因是会自己好的（GIT_TRANSIENT_RE）才隔 5 秒重试，最多 GIT_NET_TRIES 次；
    仓库不存在这类永久错误第一次就返回。返回 (结果, 尝试次数)。"""
    p = git_net_once(repo, args)
    tries = 1
    while p.returncode != 0 and tries < GIT_NET_TRIES and GIT_TRANSIENT_RE.search(p.stderr or ""):
        time.sleep(5)
        p = git_net_once(repo, args)
        tries += 1
    return p, tries


def git_net_once(repo: str, args: tuple) -> subprocess.CompletedProcess:
    """联网的 git 跑一次，最多 GIT_NET_TIMEOUT 秒。超时（run 把它转成了 DroverError）当成这次联网失败（退出码 124），
    由调用方按失败处理、说各自的话：网络不通、远端连不上时 ssh 卡在建连接上，是"连不上"，不是别的错。
    调用方按 git 的原话判断（GIT_TRANSIENT_RE、REMOTE_REF_MISSING_RE），所以用 C locale 跑。"""
    try:
        return git(repo, *args, timeout=GIT_NET_TIMEOUT, env=c_locale_env())
    except DroverError as exc:
        return subprocess.CompletedProcess(["git", "-C", repo, *args], 124, "", exc.message)


def find_key(obj: Any, key: str) -> Any:
    """在嵌套的 JSON 里找第一个 key，herdr 不同命令的返回结构不完全一样。"""
    if isinstance(obj, dict):
        if key in obj:
            return obj[key]
        for value in obj.values():
            found = find_key(value, key)
            if found is not None:
                return found
    elif isinstance(obj, list):
        for value in obj:
            found = find_key(value, key)
            if found is not None:
                return found
    return None


def parse_herdr_error(text: str) -> Optional[dict]:
    for line in reversed((text or "").strip().splitlines()):
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(obj, dict) and isinstance(obj.get("error"), dict):
            return obj["error"]
    return None


def herdr(args: list, *, timeout: Optional[float] = 120) -> tuple[bool, dict]:
    """调用 herdr。成功返回 (True, result)，失败返回 (False, error)，error 至少有 code 和 message。"""
    p = run(["herdr", *args], timeout=timeout)
    if p.returncode == 0:
        try:
            body = json.loads(p.stdout)
        except json.JSONDecodeError:
            return True, {"raw": p.stdout.strip()}
        return True, body.get("result", body)
    err = parse_herdr_error(p.stderr) or parse_herdr_error(p.stdout)
    if not err:
        err = {"code": f"exit_{p.returncode}", "message": tail(p.stderr or p.stdout)}
    return False, err


def is_under(path: str, root: Path) -> bool:
    try:
        Path(path).resolve().relative_to(root.resolve())
        return True
    except ValueError:
        return False


def check_agent_name(name: str) -> None:
    if not AGENT_NAME_RE.match(name):
        raise DroverError(f"agent 名 {name!r} 不合法：必须匹配 [a-z][a-z0-9_-]{{0,31}}（小写字母开头，最长 32 个字符）")


def check_slug(slug: str) -> None:
    # slug 会拼进 ~/.drover/<slug>/ 路径，挡住 ../ 之类的值，也不能和状态目录下的固定目录重名。
    if not SLUG_RE.match(slug):
        raise DroverError(f"slug {slug!r} 不合法：只能用小写字母、数字和 -，以字母或数字开头")
    if slug in RESERVED_SLUGS:
        raise DroverError(f"slug {slug!r} 是保留名：{'、'.join(RESERVED_SLUGS)} 是状态目录 {STATE_HOME} 下的固定目录，"
                          "换一个任务 slug")


def save_json(path_str: str, obj: dict) -> str:
    path = Path(path_str).expanduser()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2))
    return str(path)


def resolve_repo(value: str) -> str:
    """仓库参数可以是路径（仓库内任意位置）或仓库名；仓库名按配置的 repo_dirs 顺序找（没配置时只看当前目录下）。"""
    candidates = [Path(value).expanduser()]
    if "/" not in value:
        candidates += [d / value for d in REPO_DIRS]
    for candidate in candidates:
        if candidate.exists():
            p = git(str(candidate), "rev-parse", "--show-toplevel")
            if p.returncode == 0:
                return p.stdout.strip()
    if not REPO_DIRS:
        raise DroverError(f"找不到仓库 {value}：不是仓库路径（相对路径按当前目录算）；{CONFIG_FILE} 里没有配置 "
                            "repo_dirs / workspace，按名字只在当前目录下找。写绝对路径，或者先跑 install.py 配好主工作台")
    raise DroverError(f"找不到仓库 {value}：既不是仓库路径，也不在 {', '.join(map(str, REPO_DIRS))} 下"
                        f"（目录在 {CONFIG_FILE} 的 repo_dirs 里配）")


def git_common_dir(path: str) -> Optional[Path]:
    """仓库的 .git 目录；在 worktree 里调用也返回源仓库的那个，用来判断 worktree 属于哪个仓库。"""
    p = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return Path(p.stdout.strip()).resolve() if p.returncode == 0 else None


# ---------------------------------------------------------------- 团队 profile 和 playbook

# 规则分三层：包默认（flow/dispatch.md、flow/coding-rules.md 和本脚本）→ 团队 profile（config 的 profile）→ 个人覆盖
# （config 的 playbook_dirs，按顺序）。后两层的目录布局相同，后读的优先：
#   general.md             对所有仓库适用、编排者读的规则（drover playbook 输出）
#   coding-rules.md        编码规范，brief 追加进 worker 任务书（claude、codex 都加：哪个宿主都不会自动加载它）
#   repos/<仓库目录名>.md   仓库专属 playbook（迁移步骤、worktree 位置、基线有失败的命令、给 worker 的约束），编排者读
# 包默认的编码规范（flow/coding-rules.md）排在各层 coding-rules.md 前面；config 的 default_coding_rules 为 false 时不加，
# 只关这一份，安全和流程规则（任务书模板的固定约束、dispatch.md）不跟着关。
# 包里的 profiles/README.md 说明三层关系和怎么写新的团队 profile；命令不读它。
PROFILES_DIR = PKG_ROOT / "profiles"
PLAYBOOK_GENERAL = "general.md"
PLAYBOOK_CODING_RULES = "coding-rules.md"
PLAYBOOK_REPOS_DIR = "repos"
DEFAULT_CODING_RULES = PKG_ROOT / "flow" / "coding-rules.md"
# playbook 里给维护者看的说明写成 HTML 注释，读出来时去掉，不进 playbook 输出和 worker 任务书。
HTML_COMMENT_RE = re.compile(r"<!--.*?-->[ \t]*\n?", re.S)
# coding-rules.md 的分节标记：独占一行的 <!-- drover:section 名字 --> 开始一节，到下一个标记或文件末尾。第一个标记之前的
# 部分总带；有标记的节只在这次涉及的仓库用得上时带（coding_rules_sections 认得的名字：mysql、java）。
CODING_RULES_SECTION_RE = re.compile(r"^<!-- drover:section (\S+) -->[ \t]*\n?", re.M)
# 认 Java 仓库：根目录有这几个构建文件之一（deps 判断要不要装 Java 依赖也按它）。
JAVA_BUILD_FILES = ("pom.xml", "build.gradle", "build.gradle.kts")
# 认 MySQL 仓库时看的依赖清单（仓库里任意一层被 git 跟踪的）。lockfile 不看：传递依赖里的 mysql 不算这个仓库在用。
DEPS_MANIFEST_RE = re.compile(r"(^|/)(pom\.xml|build\.gradle(\.kts)?|package\.json|requirements[^/]*\.txt|pyproject\.toml)$")
MYSQL_DEP_RE = re.compile(r"mysql|mariadb", re.I)


def config_dir(value: str) -> Path:
    """config 里写的目录：~ 展开；相对路径按 config.json 所在的目录算。"""
    path = Path(value).expanduser()
    return path if path.is_absolute() else CONFIG_FILE.parent / path


def available_profiles() -> list:
    return sorted(p.name for p in PROFILES_DIR.iterdir() if p.is_dir()) if PROFILES_DIR.is_dir() else []


def profile_info() -> dict:
    """解析 config 的 profile：写名字 → <包根>/profiles/<名>/；带 / 或以 ~ 开头 → 那个目录（团队自己维护的 profile 仓库）。
    没配置时 name、dir 都是 None（只有包默认规则）。配置了但目录不存在时带 error：这时迁移规则会悄悄丢掉，调用方不能静默。"""
    raw = CONFIG.get("profile")
    if not raw or not str(raw).strip():
        return {"configured": None, "name": None, "dir": None, "exists": None}
    raw = str(raw).strip()
    by_path = "/" in raw or raw.startswith("~")
    path = config_dir(raw) if by_path else PROFILES_DIR / raw
    info = {"configured": raw, "name": path.name if by_path else raw, "dir": str(path), "exists": path.is_dir()}
    if not info["exists"]:
        info["error"] = (f"{CONFIG_FILE} 的 profile 是 {raw!r}，但目录 {path} 不存在：团队规则（迁移流程、推送前确认、"
                         "编码规范）会读不到。修法：profile 写包里有的名字（"
                         + ("、".join(available_profiles()) or f"{PROFILES_DIR} 下没有")
                         + "）或团队 profile 目录的路径（在 drover 包目录里跑 `python3 install.py --profile <名字|目录>`，"
                         "或直接编辑 config.json）；不用团队 profile 就去掉这个键（`python3 install.py --profile none`）。")
    return info


def personal_dirs() -> list:
    """config 的 playbook_dirs（个人覆盖目录），按顺序：[{configured, dir, exists}]。写成单个字符串也认。"""
    dirs = CONFIG.get("playbook_dirs") or []
    if isinstance(dirs, str):
        dirs = [dirs]
    out = []
    for raw in dirs:
        path = config_dir(str(raw))
        out.append({"configured": str(raw), "dir": str(path), "exists": path.is_dir()})
    return out


def playbook_layers() -> tuple[list, list]:
    """按读的顺序列出存在的层：[{layer, name, dir}]，团队 profile 在前，playbook_dirs 依次在后（后读的优先）。
    返回 (层, 提示)：个人覆盖目录不存在只进提示；团队 profile 目录不存在由调用方看 profile_info() 的 error。"""
    layers, notes = [], []
    prof = profile_info()
    if prof["dir"] and prof["exists"]:
        layers.append({"layer": "profile", "name": prof["name"], "dir": Path(prof["dir"])})
    for d in personal_dirs():
        if d["exists"]:
            layers.append({"layer": "personal", "name": d["configured"], "dir": Path(d["dir"])})
        else:
            notes.append(f"{CONFIG_FILE} 的 playbook_dirs 里 {d['configured']} 不存在（{d['dir']}），跳过")
    return layers, notes


def layer_label(layer: dict) -> str:
    return f"团队 profile：{layer['name']}" if layer["layer"] == "profile" else f"个人覆盖：{layer['name']}"


def read_playbook_file(path: Path) -> str:
    return HTML_COMMENT_RE.sub("", path.read_text()).strip()


def default_coding_rules_enabled() -> bool:
    """config 的 default_coding_rules：没写或 true 时加包默认的编码规范，false 时不加。"""
    return CONFIG.get("default_coding_rules") is not False


def coding_rules_files(layers: list) -> list:
    """生效的编码规范文件，按追加的顺序（后面的优先）：[(小节标题里的来源, 路径)]。包默认（flow/coding-rules.md）在最前，
    default_coding_rules 关掉时不算；团队 profile、个人覆盖依次在后，没有 coding-rules.md 的层跳过。"""
    out = []
    if default_coding_rules_enabled() and DEFAULT_CODING_RULES.is_file():
        out.append(("drover 默认；必须遵守，仓库规范冲突时按仓库的", DEFAULT_CODING_RULES))
    out += [(f"{layer_label(l)}；必须遵守", l["dir"] / PLAYBOOK_CODING_RULES) for l in layers
            if (l["dir"] / PLAYBOOK_CODING_RULES).is_file()]
    return out


def uses_mysql(wt: Path) -> bool:
    """仓库用 MySQL：有被 git 跟踪的 .sql 文件，或依赖清单（DEPS_MANIFEST_RE）里出现 mysql / mariadb 字样。
    只有 ORM（SQLAlchemy、Hibernate、Prisma…）、没有这两个字样的不算：ORM 可能连的是别的数据库。"""
    for rel in git_out(str(wt), "ls-files", "-z").split("\0"):
        if rel.lower().endswith(".sql"):
            return True
        manifest = wt / rel
        # 跟踪着、工作区里删了的清单读不到，跳过
        if DEPS_MANIFEST_RE.search(rel) and manifest.is_file() and MYSQL_DEP_RE.search(manifest.read_text(errors="replace")):
            return True
    return False


def coding_rules_sections(paths: list) -> set:
    """编码规范里有分节标记的几节，这次带哪几节：paths（brief 是任务书涉及的各 worktree，playbook 是各 --repo）任一满足就带。
    java：根目录有 JAVA_BUILD_FILES 之一；mysql：uses_mysql。判断错了只是多带或少带一节，验收按整份核对（dispatch.md 第 6.1 节）。"""
    sections = set()
    if any((Path(p) / name).is_file() for p in paths for name in JAVA_BUILD_FILES):
        sections.add("java")
    if any(uses_mysql(Path(p)) for p in paths):
        sections.add("mysql")
    return sections


def read_coding_rules(path: Path, sections: set) -> tuple[list, str]:
    """读一份 coding-rules.md：第一个分节标记之前的部分（记作 general）总带，标记开始的节只带名字在 sections 里的；
    去掉 HTML 注释（标记本身也是注释）。返回 (带了的节名，按文件里的顺序, 正文)。没有标记的文件整份就是 general。"""
    parts = CODING_RULES_SECTION_RE.split(path.read_text())
    names, chunks = ["general"], [parts[0]]
    for name, body in zip(parts[1::2], parts[2::2]):
        if name in sections:
            names.append(name)
            chunks.append(body)
    return names, HTML_COMMENT_RE.sub("", "".join(chunks)).strip()


def playbook_coding_rules(warnings: list, paths: list) -> list:
    """各层编码规范的正文：[(来源, 正文)]，顺序同 coding_rules_files；有分节标记的节按 paths（任务书涉及的 worktree）
    取舍（coding_rules_sections）。团队 profile 目录不存在时记 warning，不中断 brief。"""
    prof = profile_info()
    if prof.get("error"):
        warnings.append("团队编码规范没有追加进 prompt：" + prof["error"])
    layers, notes = playbook_layers()
    warnings.extend(notes)
    sections = coding_rules_sections(paths)
    out = []
    for source, path in coding_rules_files(layers):
        _, body = read_coding_rules(path, sections)
        if body:
            out.append((source, body))
    return out


def cmd_playbook(a: argparse.Namespace) -> dict:
    prof = profile_info()
    if prof.get("error"):
        raise DroverError(prof["error"], profile=prof)
    repos: list = []
    for value in a.repo:
        root = resolve_repo(value)
        name = history_repo_name(root)  # worktree 路径按它所属的源仓库算
        if name not in [r["name"] for r in repos]:
            repos.append({"arg": value, "name": name, "path": root, "has_playbook": False})
    layers, notes = playbook_layers()
    files, chunks = [], []
    for layer in layers:
        targets = [("general", None, layer["dir"] / PLAYBOOK_GENERAL)]
        targets += [("repo", r, layer["dir"] / PLAYBOOK_REPOS_DIR / f"{r['name']}.md") for r in repos]
        for kind, repo, path in targets:
            if not path.is_file():
                continue
            if repo is not None:
                repo["has_playbook"] = True
            files.append({"path": str(path), "layer": layer["layer"], "layer_name": layer["name"], "kind": kind,
                          "repo": repo["name"] if repo else None})
            body = read_playbook_file(path)
            if body:
                scope = "所有仓库" if repo is None else f"仓库 {repo['name']}"
                chunks.append(f"=== 来源：{path}（{layer_label(layer)}；{scope}）===\n\n{body}\n")
    available = []
    for layer in layers:
        repo_dir = layer["dir"] / PLAYBOOK_REPOS_DIR
        names = sorted(p.stem for p in repo_dir.glob("*.md")) if repo_dir.is_dir() else []
        available.append({"layer": layer["layer"], "name": layer["name"], "repos": names})
    rules_on = default_coding_rules_enabled()
    result = {
        "ok": True,
        "profile": prof,
        "playbook_dirs": personal_dirs(),
        "repos": repos,
        "files": files,
        "text": "\n".join(chunks),
        # 编码规范不在 text 里（brief 自动追加给 worker）；验收 DDL 这类改动时按这些文件核对。包默认的那份开着时排第一，
        # default_coding_rules 标明它是哪个、开没开（coding_rules 仍是路径列表，旧的读法照样用）；sections 是按这几个 --repo
        # 算、brief 会带它的哪几节（general 总带；mysql、java 见 coding_rules_sections），关着时为空。
        "coding_rules": [str(path) for _, path in coding_rules_files(layers)],
        "default_coding_rules": {
            "enabled": rules_on,
            "path": str(DEFAULT_CODING_RULES),
            "sections": (read_coding_rules(DEFAULT_CODING_RULES, coding_rules_sections([r["path"] for r in repos]))[0]
                         if rules_on else []),
        },
        "available_repos": available,
    }
    if notes:
        result["warnings"] = notes
    if not chunks:
        result["note"] = ("没有配置团队 profile 和个人覆盖目录（config.json 的 profile / playbook_dirs），只有包默认规则（flow/dispatch.md）。"
                          if not layers else
                          "各层都没有 general.md，也没有这些仓库的 repos/<仓库名>.md：按包默认规则（flow/dispatch.md）做。"
                          "有 playbook 的仓库见 available_repos。")
    return result


def cmd_playbook_text(a: argparse.Namespace) -> int:
    """playbook --text：只打印拼好的正文（给人看、前后对比用）；没有内容时把 note 打到 stderr。"""
    result = cmd_playbook(a)
    sys.stdout.write(result["text"])
    for line in result.get("warnings", []) + ([result["note"]] if result.get("note") else []):
        print(line, file=sys.stderr)
    return 0


# ---------------------------------------------------------------- preflight

def config_info() -> dict:
    """本机配置的情况（preflight 报出来）：有没有 config.json、主工作台和按名字找仓库的目录。
    没配置主工作台时带 warning（只是提示，不让 preflight 失败：orch-start 会单独报错）。"""
    info = {"file": str(CONFIG_FILE), "exists": CONFIG_FILE.is_file(),
            "workspace": str(TRUSTED_ROOT) if TRUSTED_ROOT else None, "repo_dirs": [str(d) for d in REPO_DIRS]}
    if TRUSTED_ROOT is None:
        info["warning"] = (NO_WORKSPACE_ERROR + "。在这之前 orch-start 起不了编排者，wt 遇到要信任仓库时不会自动加 "
                           "--trust-repository，按名字找仓库只看当前目录。")
    return info


def cmd_preflight(a: argparse.Namespace) -> dict:
    if os.environ.get("HERDR_ENV") != "1":
        raise DroverError("不在 Herdr 中（HERDR_ENV 不是 1），无法派发。请在 Herdr 管理的 pane 里运行。")
    if not shutil.which("herdr"):
        raise DroverError("找不到 herdr 命令")
    p = run(["herdr", "status"], timeout=30)
    m = re.search(r"^server:\s*\n\s+status:\s*(\S+)", p.stdout, re.M)
    server_status = m.group(1) if m else "unknown"
    if server_status != "running":
        raise DroverError("herdr server 没在运行", server_status=server_status, output=tail(p.stdout))
    tools = ["git", "jq", "uv", "bun", "pnpm", "npm", "yarn", "code-review-graph", "claude", "codex"]
    return {
        "ok": True,
        "server": server_status,
        "caller": {
            "workspace": os.environ.get("HERDR_WORKSPACE_ID"),
            "tab": os.environ.get("HERDR_TAB_ID"),
            "pane": os.environ.get("HERDR_PANE_ID"),
        },
        "tools": {t: bool(shutil.which(t)) for t in tools},
        # 本机配置：没有 config.json / 没配置主工作台时带 warning（不影响 ok），按提示先跑 install.py。
        "config": config_info(),
        # 团队 profile 的解析结果：配置了但目录不存在时带 error（playbook 会报 ok: false），先修好再派发。
        "profile": profile_info(),
        "playbook_dirs": personal_dirs(),
    }


# ---------------------------------------------------------------- wt

def branch_exists(repo: str, branch: str) -> bool:
    return git(repo, "show-ref", "--verify", "--quiet", f"refs/heads/{branch}").returncode == 0


def repo_primary_workspaces(repo: str) -> set:
    """源仓库主检出对应的 workspace（不含 worktree 的 workspace）。

    实测：源仓库的 workspace 关着时，herdr worktree create 会自动把它重新打开（worktree workspace 要挂在它下面）。
    建 worktree 前后各取一次，差集就是这次被自动打开的，任务收尾时可以关掉。
    """
    ok, res = herdr(["workspace", "list"], timeout=30)
    if not ok:
        return set()
    target = Path(repo).resolve()
    found = set()
    for ws in res.get("workspaces", []):
        info = ws.get("worktree") or {}
        if info.get("is_linked_worktree") is False and info.get("checkout_path"):
            if Path(info["checkout_path"]).resolve() == target:
                found.add(ws.get("workspace_id"))
    return found


def untracked_repo_docs(repo: str) -> list:
    """源仓库根目录里存在、但没被 git 跟踪的规范文件，返回 [(文件名, 是否被 .gitignore 忽略)]。

    很多仓库把 CLAUDE.md / AGENTS.md 写进了 .gitignore，worktree 里就没有，
    派出去的 agent 读不到仓库规范；实际见到的仓库都只在根目录放这些文件，所以只看根目录。
    """
    found = []
    for name in REPO_DOC_NAMES:
        if (Path(repo) / name).is_file() and git(repo, "ls-files", "--error-unmatch", name).returncode != 0:
            found.append((name, git(repo, "check-ignore", "-q", name).returncode == 0))
    return found


def is_tracked(repo: str, rel: str) -> bool:
    return git(repo, "ls-files", "--error-unmatch", "--", rel).returncode == 0


def local_file_candidates(repo: str) -> list:
    """本地运行需要、要从源仓库复制的文件：.claude/settings.local.json 和根目录的 .env*，返回 [(相对路径, 源仓库是否跟踪)]。"""
    found = []
    if (Path(repo) / ".claude" / "settings.local.json").is_file():
        found.append(".claude/settings.local.json")
    found += [f.name for f in sorted(Path(repo).glob(".env*")) if f.is_file()]
    return [(rel, is_tracked(repo, rel)) for rel in found]


def ignored_paths(repo: str, rels: list) -> set:
    """rels 里按 repo 自己的规则（.gitignore、.git/info/exclude、core.excludesFile）被忽略的那些；跟踪着的不算。"""
    if not rels:
        return set()
    p = git(repo, "check-ignore", "-z", "--stdin", input_text="\0".join(rels) + "\0")
    if p.returncode not in (0, 1):  # 0：有被忽略的，1：一个都没有
        raise DroverError("git check-ignore 失败", repo=repo, stderr=tail(p.stderr))
    return {rel for rel in p.stdout.split("\0") if rel}


def worktree_include_files(repo: str, handled: set) -> tuple[list, list]:
    """源仓库根目录 .worktreeinclude 匹配到、在源仓库被忽略的未跟踪文件，返回 (要复制的, 源路径是符号链接的)，相对路径、排好序。
    没有这个文件返回两个空表；handled 里的（.env*、规范文件，各有自己的规则）不算在内。

    沿用 Claude Code 的约定（claude --worktree 认同一个文件）：gitignore 语法，匹配某条模式且被 gitignore 的才复制，跟踪的不复制。
    匹配全交给 git：ls-files --others --ignored --exclude-from 只按这份模式列未跟踪文件（注释、! 取反、/ 锚定、**、
    目录模式展开成其中的文件都是 git 自己的语义），再用 check-ignore 留下按仓库自己的规则被忽略的。ls-files 要走一遍
    未跟踪目录（node_modules、target 也走，只读目录项）：实测 1.3G 的 node_modules 不到 1 秒；没有这个文件的仓库不走。
    """
    include = Path(repo) / WORKTREE_INCLUDE
    if not include.is_file():
        return [], []
    p = git(repo, "ls-files", "-z", "--others", "--ignored", f"--exclude-from={include}")
    if p.returncode != 0:
        raise DroverError(f"按 {include} 列文件失败", repo=repo, stderr=tail(p.stderr))
    matched = [rel for rel in p.stdout.split("\0") if rel and rel not in handled]
    ignored = sorted(ignored_paths(repo, matched))
    symlinks = [rel for rel in ignored if (Path(repo) / rel).is_symlink()]
    return [rel for rel in ignored if rel not in symlinks], symlinks


def copy_local_files(repo: str, wt: str, dry_run: bool) -> tuple[list, list, list]:
    """复制源仓库里本地运行需要的文件。只复制，不覆盖 worktree 里已有的。

    .claude/settings.local.json 和 .env*：源仓库没跟踪的照复制；源仓库跟踪着的不复制（基线分支上有它就随 checkout
    带过来了，没有就说明那条分支本来就没有，复制过去会成为未跟踪文件，挡住要新增它的 cherry-pick），
    除非它在 worktree 里被 .gitignore 忽略（以 worktree 自己的规则为准：基线分支已把 .env 移出 git 并忽略，
    主检出所在的分支还跟踪着，worker 仍要这份本地配置）。

    规范文件只复制在 worktree 里同样被忽略的：不会出现在 git status / diff 里，也不会被 agent 顺手提交进仓库。
    没提交也没被忽略的复制过去会变成未跟踪文件，改由 brief 让 agent 去读源仓库的原文。

    仓库声明的额外文件：源仓库根目录 .worktreeinclude 匹配到、在源仓库被忽略的未跟踪文件（worktree_include_files）。
    来由：一个 Java 服务的本地启动配置 src/main/resources/config/*.yml 和本地测试页 tools/
    都被忽略，新 worktree 里没有，起不了服务、打不开测试页。.worktreeinclude 自己多半也只在本机忽略（.git/info/exclude，
    各 worktree 共用），worktree 里读不到，所以从源仓库读。规则同规范文件：只复制在 worktree 里同样被忽略的，
    不被忽略的（分支的 .gitignore 不同）不复制；源路径是符号链接的不复制；和 .env*、规范文件重复的只按上面的规则走一次。

    返回 (已复制, 没复制的规范文件, .worktreeinclude 匹配了但没复制的 [{path, reason}])。
    """
    copied, skipped = [], []
    candidates, docs = local_file_candidates(repo), untracked_repo_docs(repo)
    for rel, tracked in candidates:
        target = Path(wt) / rel
        if target.exists():
            continue
        if tracked and not (Path(wt).is_dir() and git(wt, "check-ignore", "-q", "--", rel).returncode == 0):
            continue
        if not dry_run:
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(Path(repo) / rel, target)
        copied.append(rel)
    for name, ignored in docs:
        target = Path(wt) / name
        if target.exists():
            continue
        if Path(wt).is_dir():
            # 以 worktree 自己的 .gitignore 为准（分支不同，规则可能不同）。
            ignored = git(wt, "check-ignore", "-q", name).returncode == 0
        if not ignored:
            skipped.append(name)
            continue
        if not dry_run:
            shutil.copy2(Path(repo) / name, target)
        copied.append(name)
    include, symlinks = worktree_include_files(repo, {rel for rel, _ in candidates} | {name for name, _ in docs})
    include_skipped = [{"path": rel, "reason": "源仓库里是符号链接，不复制"} for rel in symlinks]
    missing = [rel for rel in include if not (Path(wt) / rel).exists()]
    # worktree 不在了（复用时 herdr 记录里还有、目录已删）只可能是 --dry-run：按源仓库的忽略规则预估。
    ignored_in_wt = ignored_paths(wt, missing) if Path(wt).is_dir() else set(missing)
    for rel in missing:
        if rel not in ignored_in_wt:
            include_skipped.append({"path": rel, "reason": "在 worktree 里没被 .gitignore 忽略，复制过去会出现在 git status 里"})
            continue
        if not dry_run:
            target = Path(wt) / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(Path(repo) / rel, target)
        copied.append(rel)
    return copied, skipped, include_skipped


def new_worktree_copy_note(repo: str) -> str:
    """wt --dry-run 新建时的 would_copy：worktree 还没建，按源仓库这边说明会复制什么、各自的条件；
    有 .worktreeinclude 时把匹配到的文件逐个列出，用户和编排者能直接核对会带哪些。"""
    candidates, docs = local_file_candidates(repo), untracked_repo_docs(repo)
    parts = ["、".join(f"{rel}（源仓库跟踪着，在新 worktree 里被 .gitignore 忽略才复制）" if tracked else rel
                       for rel, tracked in candidates)] if candidates else []
    parts.append("以及被 .gitignore 忽略的 " + " / ".join(REPO_DOC_NAMES))
    if (Path(repo) / WORKTREE_INCLUDE).is_file():
        include, _ = worktree_include_files(repo, {rel for rel, _ in candidates} | {name for name, _ in docs})
        parts.append(f"以及 {WORKTREE_INCLUDE} 匹配到的（在新 worktree 里同样被忽略才复制）：" + "、".join(include)
                     if include else f"{WORKTREE_INCLUDE} 没匹配到要复制的文件")
    return "（新 worktree 建好后复制：" + "；".join(parts) + "）"


# wt 新建前同步源仓库主检出（几次发布后主目录停在旧提交，之后从它建的 worktree 都从旧代码起步）。
# fetch 主检出的上游，主检出干净且落后时快进（只快进，不硬覆盖），起点保证是远端最新。复用已有 worktree 时不做。

def repo_sync_lock_path(repo: str) -> Path:
    real = os.path.realpath(repo)
    return STATE_HOME / "locks" / f"wt-sync-{Path(real).name}-{hashlib.sha1(real.encode()).hexdigest()[:10]}.lock"


@contextlib.contextmanager
def repo_sync_lock(repo: str):
    """同一仓库的 fetch + 主检出快进加锁（flock，按仓库路径区分，进程退出自动释放）：几个编排者同时对同一个仓库跑
    wt / integrate 时，避免 index.lock / ref lock 冲突。不进 heavy 调度：那是全机构建 / 测试排队用的，fetch 不该排在全量测试后面。
    同一进程里不能嵌套拿（flock 按打开的文件算，第二次会等自己）。拿不到锁文件（沙箱不能写）时不加锁照常执行。
    yield 等锁的秒数（没加锁时 None）。"""
    path = repo_sync_lock_path(repo)
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        fh = open(path, "a+")
    except OSError:
        yield None
        return
    started = time.time()
    try:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield round(time.time() - started, 1)
    finally:
        with contextlib.suppress(OSError):
            fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()


def current_branch(repo: str) -> Optional[str]:
    """主检出所在的分支；detached HEAD 返回 None。"""
    p = git(repo, "symbolic-ref", "--quiet", "--short", "HEAD")
    return p.stdout.strip() if p.returncode == 0 and p.stdout.strip() else None


def is_ancestor(repo: str, older: str, newer: str) -> bool:
    return git(repo, "merge-base", "--is-ancestor", older, newer).returncode == 0


def commit_count(repo: str, rev_range: str) -> int:
    return int(git_out(repo, "rev-list", "--count", rev_range) or 0)


def remote_branch_of(ref: Optional[str], remotes: list) -> Optional[tuple]:
    """<远端名>/<分支>（远端名在 git remote 里）→ (远端名, 分支)；本地分支名、sha 等返回 None。"""
    for remote in sorted(remotes, key=len, reverse=True):
        if ref and ref.startswith(remote + "/") and len(ref) > len(remote) + 1:
            return remote, ref[len(remote) + 1:]
    return None


def source_upstream(repo: str, branch: Optional[str], remotes: list) -> dict:
    """主检出当前分支的上游：{ref（如 origin/master；None 表示没有上游）, remote, branch, configured, reason}。
    配了上游（@{u}）用配的；没配就用 origin/<当前分支>（configured=False：远端有没有这条分支，fetch 时才知道）。"""
    if not branch:
        return {"ref": None, "reason": "主目录是 detached HEAD"}
    remote = git(repo, "config", f"branch.{branch}.remote").stdout.strip()
    merge = git(repo, "config", f"branch.{branch}.merge").stdout.strip()
    if remote and merge:
        merge_branch = merge[len("refs/heads/"):] if merge.startswith("refs/heads/") else merge
        if remote == ".":
            return {"ref": None, "reason": f"{branch} 的上游是本地分支 {merge_branch}"}
        if remote not in remotes:
            return {"ref": None, "reason": f"{branch} 的上游远端 {remote} 不在 git remote 里"}
        p = git(repo, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
        ref = p.stdout.strip() if p.returncode == 0 and p.stdout.strip() else f"{remote}/{merge_branch}"
        return {"ref": ref, "remote": remote, "branch": merge_branch, "configured": True}
    if "origin" not in remotes:
        return {"ref": None, "reason": f"{branch} 没配上游，仓库也没有远端 origin"}
    return {"ref": f"origin/{branch}", "remote": "origin", "branch": branch, "configured": False}


def remote_default_branch(repo: str, remote: str) -> Optional[str]:
    """本地记录的 <远端>/HEAD 指向的分支名（如 main）。只读本地的 refs/remotes/<远端>/HEAD，不联网；解析不出返回 None。"""
    p = git(repo, "symbolic-ref", "--quiet", "--short", f"refs/remotes/{remote}/HEAD")
    ref = p.stdout.strip() if p.returncode == 0 else ""
    return ref[len(remote) + 1:] if ref.startswith(remote + "/") and len(ref) > len(remote) + 1 else None


def default_branch_note(repo: str, branch: Optional[str], up: dict, remotes: list) -> tuple:
    """主检出不在远端默认分支上时给一句提示（主目录停在别的分支上用户自己不一定知道），不切分支、不改起点。
    按上游分支名比，没上游按本地分支名；远端用上游的远端，没上游用 origin。返回 (远端默认分支如 origin/main 或 None, 提示或 None)。"""
    remote = up.get("remote") or ("origin" if "origin" in remotes else None)
    default = remote_default_branch(repo, remote) if branch and remote else None
    if not default:
        return None, None
    if (up.get("branch") or branch) == default:
        return f"{remote}/{default}", None
    return f"{remote}/{default}", (f"主目录在 {branch} 上，不是 {remote} 的默认分支 {default}；worktree 跟着主目录的分支走，"
                                   f"要从别的分支起请传 --base {remote}/<分支>")


def fast_forward_source(repo: str, upstream: str, up_sha: str, sync: dict, merge: bool = True) -> None:
    """主检出相对上游的位置；在分支上、没有已跟踪改动、没有进行中的操作、落后时 merge --ff-only。结果写进 sync。
    merge=False（update --dry-run）只判断，能快进时记 status=behind，不执行 merge。"""
    head = sync["before"]
    if head == up_sha:
        sync.update(status="up_to_date", reason=f"主目录已是 {upstream} 最新")
        return
    if is_ancestor(repo, up_sha, head):
        n = commit_count(repo, f"{up_sha}..{head}")
        sync.update(status="ahead", ahead=n, reason=f"主目录领先 {upstream} {n} 个提交（没推送）")
        return
    behind = commit_count(repo, f"{head}..{up_sha}")
    sync["behind"] = behind
    if not is_ancestor(repo, head, up_sha):
        ahead = commit_count(repo, f"{up_sha}..{head}")
        sync.update(status="diverged", ahead=ahead,
                    reason=f"主目录和 {upstream} 分叉了（本地多 {ahead} 个提交，落后 {behind} 个）")
        return
    dirty = git_out(repo, "status", "--porcelain", "--untracked-files=no").splitlines()
    if dirty:
        sync.update(status="dirty", dirty_files=[line[3:] for line in dirty[:20]],
                    reason=f"主目录落后 {upstream} {behind} 个提交，但有 {len(dirty)} 个已跟踪文件的改动，没快进")
        return
    op = in_progress_op(repo)
    if op:
        sync.update(status="in_progress", reason=f"主目录落后 {upstream} {behind} 个提交，但有进行中的 {op}，没快进")
        return
    if not merge:
        sync.update(status="behind", reason=f"主目录落后 {upstream} {behind} 个提交，可以快进（没执行）")
        return
    try:
        p = git(repo, "merge", "--ff-only", upstream, timeout=300)
    except DroverError as exc:  # 超时：多半是仓库的 post-merge hook 跑太久。不阻断，按快进失败记，HEAD 以实际为准
        p = subprocess.CompletedProcess([], 1, "", exc.message)
    if p.returncode != 0:
        err = p.stderr or p.stdout
        sync.update(status="ff_failed", ff_stderr=tail(err, 600), after=git_out(repo, "rev-parse", "HEAD"),
                    reason=f"主目录落后 {upstream} {behind} 个提交，git merge --ff-only 失败：{tail(err, 200)}")
        return
    sync.update(status="fast_forwarded", after=git_out(repo, "rev-parse", "HEAD"),
                reason=f"主目录从 {head[:12]} 快进到 {upstream}（{behind} 个提交）")


def wt_fetch_error(command: str, tries: int, stderr: str) -> str:
    """wt / integrate 的 fetch 失败文案（update 用 update_fetch_error）。"""
    return (f"{command} 失败（试了 {tries} 次），没有建 worktree：{tail(stderr, 300)}。"
            "网络 / 认证问题处理好后重跑；确认要用本地已有的代码建，加 --no-sync 重跑")


def fetch_ref(repo: str, sync: dict, prefetched: dict, fail, ref: str, remote: str, remote_branch: str,
              missing_ok: bool = False, extra: tuple = ()) -> bool:
    """fetch 一条远端分支（extra 是同一次 fetch 里顺带的 refspec，update 的 release 通道用它带上版本 tag），结果记进
    sync["fetch"]。prefetched 里的不再 fetch；missing_ok 时远端没有这条分支返回 False；
    其他失败抛 DroverError，文案由 fail(命令, 尝试次数, stderr) 给（wt 和 update 要说各自的话）。"""
    if ref in prefetched:
        sync["fetch"].append({"ref": ref, "ok": True, "tries": prefetched[ref], "note": "调用方已 fetch，不重复"})
        return True
    p, tries = git_net(repo, "fetch", remote, remote_branch, *extra)
    command = shlex.join(["git", "fetch", remote, remote_branch, *extra])
    entry = {"ref": ref, "command": command, "ok": p.returncode == 0, "tries": tries}
    sync["fetch"].append(entry)
    if p.returncode == 0:
        return True
    if missing_ok and REMOTE_REF_MISSING_RE.search(p.stderr or ""):
        entry["note"] = "远端没有这条分支"
        return False
    entry["stderr"] = tail(p.stderr, 600)
    raise DroverError(fail(command, tries, p.stderr), repo=repo, source_sync=sync)


def fetch_upstream(repo: str, explicit: Optional[str], prefetched: dict, fail, extra: tuple = ()) -> tuple:
    """fetch 主检出当前分支的上游（和显式 --base 的远端分支，同一条只 fetch 一次，prefetched 里的不再 fetch；extra 跟着上游
    那次 fetch 顺带），定出上游。返回 (sync, up, remotes, branch)：有上游时 sync 里有 upstream / upstream_sha、status 还是 None
    （位置由调用方判断：fetch_source 和上游比，update 按通道定目标）；没有上游时 status 是 detached / upstream_gone /
    no_upstream。fetch 失败的文案由 fail 给（见 fetch_ref）。调用方持有 repo_sync_lock。"""
    remotes = git_out(repo, "remote").split()
    branch = current_branch(repo)
    up = source_upstream(repo, branch, remotes)
    head = git_out(repo, "rev-parse", "HEAD")
    sync: dict = {"branch": branch, "upstream": up["ref"], "before": head, "after": head, "status": None,
                  "reason": None, "fetch": []}
    upstream, gone = up["ref"], False
    if upstream:
        # 远端没有这条分支不算错：没配上游时是本地分支；配了上游的多半是合并后被删了（不少仓库的
        # 主检出停在旧的 feature / bugfix 分支上）。integrate 显式传了 --base，不能因此失败。
        if not fetch_ref(repo, sync, prefetched, fail, upstream, up["remote"], up["branch"], missing_ok=True,
                         extra=extra):
            gone = up["configured"]
            up["reason"] = (f"{branch} 的上游 {upstream} 在远端已经没有了" if gone else
                            f"{branch} 没配上游，远端 origin 也没有这条分支")
            upstream = None
        elif not rev_commit(repo, upstream):
            upstream, up["reason"] = None, (f"fetch 了 {up['remote']} {up['branch']}，但本地没有远端跟踪分支 {upstream}"
                                            "（远端的 fetch 规则没包含它）")
    sync["upstream"] = upstream
    target = remote_branch_of(explicit, remotes)
    if target and explicit != upstream:
        fetch_ref(repo, sync, prefetched, fail, explicit, *target)

    if upstream:
        sync["upstream_sha"] = git_out(repo, "rev-parse", upstream)
    else:
        sync.update(status="detached" if not branch else "upstream_gone" if gone else "no_upstream",
                    reason=up["reason"])
    return sync, up, remotes, branch


def fetch_source(repo: str, explicit: Optional[str], prefetched: dict, fail) -> tuple:
    """fetch_upstream，再按 fast_forward_source 判断主检出相对上游的位置，落后就快进。返回 (sync, up, remotes, branch)。
    sync_source（wt / integrate）用；update 用 fetch_upstream 再按更新通道自己定目标（update_sync）。调用方持有 repo_sync_lock。"""
    sync, up, remotes, branch = fetch_upstream(repo, explicit, prefetched, fail)
    if sync["upstream"]:
        fast_forward_source(repo, sync["upstream"], sync["upstream_sha"], sync)
    return sync, up, remotes, branch


def sync_source(repo: str, base: Optional[str], prefetched: dict) -> tuple:
    """fetch 主检出的上游（和显式 --base 的远端分支，同一条只 fetch 一次，prefetched 里的不再 fetch），快进主检出，定起点。
    返回 (source_sync, base_ref, warnings)。fetch 失败（网络、认证等）抛 DroverError（不建 worktree）；
    没有上游（detached、上游是本地分支、没有远端、远端没有这条分支，或配了上游但远端已经删了）不算错。
    调用方持有 repo_sync_lock。"""
    explicit = base if base and base != "HEAD" else None
    sync, up, remotes, branch = fetch_source(repo, explicit, prefetched, wt_fetch_error)
    upstream = sync["upstream"]
    sync["remote_default"], default_note = default_branch_note(repo, branch, up, remotes)

    warnings = []
    reason = sync["reason"]
    if explicit:
        base_ref = explicit
        if sync["status"] in ("dirty", "in_progress", "diverged", "ff_failed"):
            warnings.append(f"主目录没更新：{reason}（worktree 的起点是 --base {explicit}，不受影响）")
    elif not upstream:
        base_ref = "HEAD"
        warnings.append(f"没法判断上游（{reason}），worktree 从主目录当前 HEAD 起")
    elif is_ancestor(repo, sync["upstream_sha"], sync["after"]):
        base_ref = "HEAD"  # 快进成功、本来就是最新、本地领先
        if sync["status"] == "ahead":
            warnings.append(f"worktree 带着主目录 {sync['ahead']} 个没推送的提交（{branch} 领先 {upstream}）")
    else:
        base_ref = upstream  # 有改动没快进、分叉、快进失败：从远端最新起
        warnings.append(f"主目录没更新：{reason}；worktree 从 {upstream} 起，不含主目录的本地提交 / 改动")
    if default_note and not explicit:
        warnings.append(default_note)
    return sync, base_ref, warnings


def plan_source_sync(repo: str, base: Optional[str], prefetched: dict) -> tuple:
    """--dry-run：不 fetch、不快进，报主检出现状和会执行的 git 命令。
    返回 (source_sync, 计划的命令, 按本地记录预测的起点, warnings（只有"不在远端默认分支上"这种不用联网就知道的）)。"""
    explicit = base if base and base != "HEAD" else None
    remotes = git_out(repo, "remote").split()
    branch = current_branch(repo)
    up = source_upstream(repo, branch, remotes)
    head = git_out(repo, "rev-parse", "HEAD")
    upstream = up["ref"]
    up_sha = rev_commit(repo, upstream)
    dirty = git_out(repo, "status", "--porcelain", "--untracked-files=no").splitlines()
    op = in_progress_op(repo)
    remote_default, default_note = default_branch_note(repo, branch, up, remotes)
    sync = {"status": "dry_run", "branch": branch, "upstream": upstream, "upstream_configured": up.get("configured"),
            "head": head, "upstream_sha_local": up_sha, "dirty": bool(dirty),
            "dirty_files": [line[3:] for line in dirty[:20]], "in_progress": op, "remote_default": remote_default}
    planned = []

    def plan_fetch(ref: str, remote: str, remote_branch: str, note: str) -> None:
        planned.append(f"（调用方已 fetch {ref}，不重复）" if ref in prefetched else
                       f"git -C {repo} fetch {remote} {remote_branch}（{note}）")

    if upstream:
        plan_fetch(upstream, up["remote"], up["branch"],
                   "主检出的上游；偶发认证 / 网络错误自动重试；远端已经没有这条分支就当作没有上游，"
                   "其他失败报错、不建 worktree" if up["configured"] else
                   f"{branch} 没配上游，按 origin/{branch} 试；远端没有这条分支就当作没有上游")
    else:
        sync["reason"] = up["reason"]
    target = remote_branch_of(explicit, remotes)
    if target and explicit != upstream:
        plan_fetch(explicit, *target, "--base 是远端分支，先 fetch 再用；失败就报错、不建 worktree")
    if upstream:
        planned.append(f"git -C {repo} merge --ff-only {upstream}（fetch 后主检出在分支上、没有已跟踪改动、"
                       "没有进行中的 merge / rebase / cherry-pick、落后上游时才执行；其余情况不动主目录）")
    if explicit:
        base_ref = explicit
    elif not upstream or not up_sha:
        base_ref = "HEAD"
    elif is_ancestor(repo, up_sha, head) or (is_ancestor(repo, head, up_sha) and not dirty and not op):
        base_ref = "HEAD"
    else:
        base_ref = upstream
    return sync, planned, base_ref, [default_note] if default_note and not explicit else []


# ---------------------------------------------------------------- 推送记录、新一轮的起点
# 每次推送都记下分支和提交，不管走没走 integrate（patch 模式也记）。推送过什么是任务级的事实，和集成 worktree 怎么建、
# 建了几次无关，所以记在 <slug>/pushes.jsonl（一行一次推送，只追加），不挂在 integrate 状态上：那份一个仓库一份，
# 重建或换目标分支时整个换掉（以前推两条分支要手工改名归档）。读它的：wt / integrate 定新一轮的起点并核实、cleanup 核实
# 内容已在推过的远端分支里、wrapup 列提交。旧任务的推送记在 integrate-*.json 的 pushes 里，task_pushes 一起读。
# 记录里除了 remote 名还记推送时的地址 remote_url：remote 名只是本地别名，仓库换了托管地址以后 origin 指的是另一个仓库，
# 拿推到旧地址的记录去核实新地址会误报漏推（push_moved）。
PUSHES_FILE = "pushes.jsonl"
CARRY_FILE = "carry.jsonl"  # wt --carry 带上上一轮提交的记录：理由、起点、带上的提交


def read_jsonl(path: Path) -> list:
    """一行一个 JSON 对象的文件；没有文件是 []，坏行跳过。"""
    try:
        text = path.read_text()
    except OSError:
        return []
    out = []
    for line in text.splitlines():
        with contextlib.suppress(ValueError):
            obj = json.loads(line)
            if isinstance(obj, dict):
                out.append(obj)
    return out


def append_jsonl(path: Path, obj: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as fh:
        fh.write(json.dumps(obj, ensure_ascii=False) + "\n")


def task_slugs() -> list:
    """状态目录下的全部任务 slug（task_owner 按它判断分支归哪个任务）。"""
    return [p.name for p in STATE_HOME.iterdir() if p.is_dir() and p.name not in RESERVED_SLUGS] \
        if STATE_HOME.is_dir() else []


def task_dir(slug: str) -> Path:
    """--slug 给的任务目录：slug 合法、目录已经在（编排者开工时建好）；写错了报错，不悄悄记进一个新目录。"""
    check_slug(slug)
    d = STATE_HOME / slug
    if not d.is_dir():
        raise DroverError(f"没有任务目录 {d}：--slug 写错了，或者这个任务不是 drover 派发的")
    return d


def state_pushes(state: dict, source: str) -> list:
    """integrate 状态文件里的 pushes（旧代码记在这里）换成推送记录的格式：仓库、目标分支、集成分支、worktree 取那份文件的。"""
    upstream = state.get("upstream") or ""
    remote, _, target = upstream.partition("/")
    return [{**p, "repo": state.get("repo"), "remote": remote, "target": target, "upstream": upstream,
             "branch": state.get("branch"), "worktree_path": state.get("worktree_path"), "source": source}
            for p in state.get("pushes") or [] if isinstance(p, dict)]


def task_pushes(slug: str) -> list:
    """这个任务的全部推送记录，从旧到新：旧 integrate-*.json（含改名归档的）里的按时间排在前，pushes.jsonl 的按文件顺序
    在后（新代码只写 pushes.jsonl）。同一仓库、同一目标分支、推上去的同一个提交只算一次：归档时复制的、integrate 重建时
    转进 pushes.jsonl 的都会重复。每条带上 record_file：这条是从哪个文件读的（要用户改记录时给出它；转进 pushes.jsonl
    的记录还带着原来的 source，但它在 pushes.jsonl 里）。"""
    legacy: list = []
    for f in sorted((STATE_HOME / slug).glob("integrate-*.json")):
        with contextlib.suppress(OSError, ValueError):
            state = json.loads(f.read_text())
            if isinstance(state, dict):
                legacy += [{**p, "record_file": str(f)} for p in state_pushes(state, f.name)]
    legacy.sort(key=lambda p: str(p.get("at") or ""))
    jsonl = STATE_HOME / slug / PUSHES_FILE
    seen, out = set(), []
    for p in legacy + [{**p, "record_file": str(jsonl)} for p in read_jsonl(jsonl)]:
        key = (os.path.realpath(p.get("repo") or "/nonexistent"), p.get("upstream"),
               p.get("remote_sha") or p.get("range"))
        if key not in seen:
            seen.add(key)
            out.append(p)
    return out


def repo_pushes(pushes: list, repo: str) -> list:
    real = os.path.realpath(repo)
    return [p for p in pushes if os.path.realpath(p.get("repo") or "/nonexistent") == real]


def push_target(p: dict) -> tuple:
    """(远端, 目标分支)。"""
    return p.get("remote") or "", p.get("target") or ""


def push_end(repo: str, p: dict) -> Optional[str]:
    """推上去的提交（完整 sha）；旧记录 remote_sha 是空的时取 range 的后一半。本地没有这个对象返回 None。"""
    return rev_commit(repo, p.get("remote_sha") or (p.get("range") or "").partition("..")[2])


def push_start(repo: str, p: dict) -> Optional[str]:
    """推送前的远端头；旧记录没有 from，取 range 的前一半。"""
    return rev_commit(repo, p.get("from") or (p.get("range") or "").partition("..")[0])


def pushed_branches(pushes: list) -> list:
    """推过的目标分支，按最后一次推送从旧到新：[{ref, last_at, last_sha}]。"""
    last: dict = {}
    for p in pushes:
        last.pop(push_target(p), None)
        last[push_target(p)] = p
    return [{"ref": p.get("upstream") or "/".join(k), "last_at": p.get("at"),
             "last_sha": (p.get("remote_sha") or (p.get("range") or "").partition("..")[2])[:12]}
            for k, p in last.items()]


@functools.lru_cache(maxsize=None)
def remote_push_url(repo: str, remote: str) -> Optional[str]:
    """remote 现在的推送地址（git remote get-url --push，git 已展开 insteadOf / pushInsteadOf）；不是 remote 名（比如传的是
    地址）、这个 remote 已经不在了返回 None。一条命令里不会变，同一个仓库的同一个 remote 只查一次。"""
    p = git(repo, "remote", "get-url", "--push", remote)
    return (p.stdout.strip() or None) if p.returncode == 0 else None


def remote_url_key(url: str) -> str:
    """比较地址用：同一个仓库的几种写法比的是主机 + 路径（git@example.com:o/r.git、ssh://git@example.com/o/r、
    https://example.com/o/r 算同一个）。scheme://[user@]host[:port]/path（ssh、https、git…）和 scp 写法 [user@]host:path
    （git 的规则：第一个 / 之前有 : 才算）都换成 host/path：去掉协议、用户名、端口，主机转小写，路径大小写不动；
    file:///abs/path 是 /abs/path，本地路径照原样；最后去掉首尾空白、末尾的 / 和 .git。别的不归一（不查 DNS、不认托管
    平台的大小写或改名重定向）：对不上的只是不拿那些推送核实、给出提示，不会挡人。"""
    s = url.strip()
    if "://" in s:
        parts = urlsplit(s)
        s = parts.path if parts.scheme == "file" else f"{parts.hostname or ''}{parts.path}"
    elif ":" in s.partition("/")[0]:
        host, _, path = s.partition(":")
        s = f"{host.rpartition('@')[2].lower()}/{path.lstrip('/')}"
    return s.rstrip("/").removesuffix(".git")


def push_moved(repo: str, p: dict) -> Optional[dict]:
    """这次推送是不是推到了别处：记录里有推送时的地址 remote_url，而现在这个仓库里同名 remote 的推送地址和它不同（仓库换了
    托管地址，origin 指的是另一个仓库了），或者这个 remote 已经不在了。是就返回 {remote, remote_url, remote_url_now}（不在了
    是 None），不是返回 None。没有 remote_url 的旧记录（这个版本之前写的）当作推到现在这个远端，照旧核实。
    wt / integrate 定新一轮的起点（split_by_remote）和 wrapup 核对远端都按它认。"""
    old = p.get("remote_url")
    if not old:
        return None
    remote = push_target(p)[0]
    now = remote_push_url(repo, remote)
    if now and remote_url_key(now) == remote_url_key(old):
        return None
    return {"remote": remote, "remote_url": old, "remote_url_now": now}


def split_by_remote(repo: str, pushes: list) -> tuple[list, list]:
    """(推到现在这个远端的推送记录, 推到别处的 [{at, upstream, remote, remote_url, remote_url_now}])，见 push_moved。"""
    here, away = [], []
    for p in pushes:
        moved = push_moved(repo, p)
        if moved:
            away.append({"at": p.get("at"), "upstream": p.get("upstream"), **moved})
        else:
            here.append(p)
    return here, away


def remote_now_text(remote: str, url: Optional[str]) -> str:
    return f"现在 {remote} 是 {url}" if url else f"现在没有 {remote} 这个远端"


def moved_text(away: list) -> str:
    """"推到的是 <旧地址>，现在 <remote> 是 <新地址>"；几组不同的用"；"连起来。"""
    return "；".join(dict.fromkeys(f"推到的是 {m['remote_url']}，{remote_now_text(m['remote'], m['remote_url_now'])}"
                                  for m in away))


# 新一轮的起点：起点 = 这一轮要推的那条远端分支（fetch 到最新），不是主检出所在的分支；没说推哪条的
# 按上一轮推的那条起。建之前核实上一轮推到远端的提交在起点里，不过就拒绝建、列出缺的提交，交用户定：--carry 带上这些
# 提交在新分支上起，或者 --base 指回上一轮的分支接着改。没有推送记录（第一轮）起点照旧。推到别处的推送（remote 换过
# 地址，见 push_moved）不拿来定起点、不拿来核实：那些提交本来就不在新远端里，--carry 会把那边的提交带到现在的仓库。
ROUND_REUSED = {"status": "skipped", "reason": "复用已有 worktree：没有新起点，不核实"}

def round_default_base(repo: str, pushes: list) -> Optional[str]:
    """wt 没传 --base 时的起点：这个任务在这个仓库推过的那条远端分支。没有推送记录返回 None（第一轮，起点照旧）；
    推过两条以上（一轮推两条，或者中途换过分支）不猜：命令不知道哪条是这一轮主要的，报错要求显式 --base。"""
    if not pushes:
        return None
    branches = pushed_branches(pushes)
    if len(branches) > 1:
        raise DroverError(
            "这个任务在这个仓库推过 " + "、".join(f"{b['ref']}（最后一次 {b['last_at']} 推到 {b['last_sha'][:9]}）"
                                       for b in branches)
            + "，没传 --base 不知道这一轮从哪条起，没有建 worktree：按用户这一轮要推的分支加 --base <远端>/<分支> 重跑"
            "（一轮推两条的从主要那条起，另一条集成时各自核实）", repo=repo, pushed_branches=branches)
    return branches[0]["ref"]


def cherry_plus(repo: str, upstream: str, end: str, begin: str) -> Optional[list]:
    """begin..end 里在 upstream 那边没有的提交（git cherry 的 "+"，从旧到新）；upstream 已经包含的（祖先，不列出）和补丁内容
    相同的（"-"）都不算。git cherry 失败返回 None。"""
    c = git(repo, "cherry", upstream, end, begin)
    if c.returncode != 0:
        return None
    return [line.split()[1] for line in c.stdout.splitlines() if line.startswith("+ ")]


def push_short(repo: str, p: dict, start_sha: str, also: tuple) -> tuple[list, Optional[str]]:
    """一次推送推上去的提交里起点 start_sha 没有的（git cherry 的 "+"；also 里已有的不算，见 round_check）：(缺的 sha, None)；
    核实不了返回 ([], 原因)。"""
    end, begin = push_end(repo, p), push_start(repo, p)
    if not end or not begin:
        return [], "推送记录里的提交本地找不到"
    plus = cherry_plus(repo, start_sha, end, begin)
    if plus is None:
        return [], "git cherry 失败"
    for rev in also:
        other = cherry_plus(repo, rev, end, begin) if plus else []
        if other is not None:
            plus = [s for s in plus if s in other]
    return plus, None


def round_check(repo: str, pushes: list, start: str, remotes: list, also: tuple = ()) -> dict:
    """起点 start 含不含这个任务上一轮推到远端的提交（pushes 只含推到现在这个远端的，见 split_by_remote）。参照：start 是
    <远端>/<T> 且推过 T 的按 T 自己的推送（同一条分支）；否则（换了分支）按最近一次推送的那条分支。参照里最后一次推上去的
    提交是 start 的祖先 → 过；否则逐次推送用 git cherry 按补丁内容比（挑到别的分支上的也算），剩下的就是缺的。合并提交
    git cherry 不比，合并带进来的普通提交照比。
    also 是 integrate 接着要摘进来的条目分支（--from）：缺的提交已在其中的（commit 模式一轮推两条分支时，第二条集成的
    就是同一批条目提交；条目 worktree 用 --carry 带上过的）不算缺，integrate 会把它们摘进来。
    返回 {status: no_records / ok / missing, …}；推送记录里的提交本地找不到时列进 unknown，也算 missing（核实不了）。
    缺提交、核实不了的推送里没记远端地址的（旧版本写的）列进 no_remote_url：分不清推的是不是现在这个远端，拒绝时多说一段。"""
    if not pushes:
        return {"status": "no_records", "note": "这个任务在这个仓库还没有推送记录（第一轮），起点照旧"}
    rb = remote_branch_of(start, remotes)
    same = [p for p in pushes if rb and push_target(p) == rb]
    ref = same or [p for p in pushes if push_target(p) == push_target(pushes[-1])]
    against = ref[-1].get("upstream") or "/".join(push_target(ref[-1]))
    start_sha = rev_commit(repo, start)
    out: dict = {"start": start, "start_sha": start_sha, "against": against, "same_branch": bool(same),
                 "last_push": {k: ref[-1].get(k) for k in ("at", "remote_sha", "range")}}
    if not start_sha:
        return {**out, "status": "missing", "missing": [], "unknown": [f"起点 {start} 本地解析不到提交"]}
    last = push_end(repo, ref[-1])
    if last and is_ancestor(repo, last, start_sha):
        return {**out, "status": "ok", "how": "ancestor"}
    missing, unknown, no_url, seen = [], [], [], set()
    for p in ref:
        plus, why = push_short(repo, p, start_sha, also)
        if why:
            unknown.append(f"{p.get('at')} 推到 {p.get('upstream')} 的 {p.get('range') or p.get('remote_sha')}：{why}")
        for sha in plus:
            if sha not in seen:
                seen.add(sha)
                missing.append({"sha": sha, "short": sha[:9], "subject": git_out(repo, "log", "-1", "--format=%s", sha),
                                "pushed_to": p.get("upstream"), "pushed_at": p.get("at")})
        if (plus or why) and not p.get("remote_url"):
            remote = push_target(p)[0]
            no_url.append({"at": p.get("at"), "upstream": p.get("upstream"), "range": p.get("range"), "remote": remote,
                           "remote_url_now": remote_push_url(repo, remote), "file": p.get("record_file")})
    if also:
        out["covered_by"] = list(also)
    if not missing and not unknown:
        return {**out, "status": "ok", "how": "patch"}
    return {**out, "status": "missing", "how": "patch", "missing": missing, "unknown": unknown, "no_remote_url": no_url}


def round_other_remote(check: dict, away: list) -> tuple[dict, list]:
    """推到别处的推送（split_by_remote）不拿来核实，列在 round_check 的 other_remote 里。这个仓库的推送全都推到了别处时
    （round_check 是 no_records）status 是 other_remote：起点按第一轮的规则定。返回 (round_check, 要进 warnings 的话)。"""
    if not away:
        return check, []
    if check["status"] == "no_records":
        note = f"上一轮{moved_text(away)}：不拿这些推送核实起点，起点按第一轮的规则定"
        return {**check, "status": "other_remote", "note": note, "other_remote": away}, [note]
    return {**check, "other_remote": away}, \
        [f"另有 {len(away)} 次推送{moved_text(away)}：不拿它们核实起点，只核实推到现在这个地址的"]


def no_url_note(check: dict) -> str:
    """缺的提交来自没记远端地址的旧记录（round_check 的 no_remote_url）时，拒绝的报错末尾加的一段：remote 换过地址的话这些
    提交本来就不在新远端里，--carry 会把那边的提交带到现在的仓库；给记录补上当时的地址，就按推到别处处理、不拿它们核实。"""
    legacy = check.get("no_remote_url") or []
    if not legacy:
        return ""
    where = "；".join(f"{p['at']} 推到 {p['upstream']}（记在 {p['file']}）" for p in legacy)
    remotes = "、".join(dict.fromkeys(p["remote"] for p in legacy))
    now = "；".join(dict.fromkeys(remote_now_text(p["remote"], p["remote_url_now"]) for p in legacy))
    return (f"。另外，这几次推送是旧版本记的、没记远端地址：{where}。如果 {remotes} 之后换过地址（{now}）、上一轮推的是另一个"
            "仓库，这些提交本来就不在新远端里，不要 --carry（会把那边的提交带到现在的仓库）：在记录所在的文件里给这几条记录补上 "
            "\"remote_url\": \"<当时的地址>\" 再重跑，就不拿它们核实了")


def round_refusal(check: dict, base_flag: str, synced: bool, carry: Optional[str]) -> DroverError:
    """核实不过时的报错，写成编排者能直接搬给用户的中文：缺哪几个提交（短 sha + 标题、什么时候推到哪条分支）、两种做法；
    缺的来自没记远端地址的旧记录时再加一段怎么补（no_url_note，结构化的在 no_remote_url）。
    base_flag 是"在旧分支上接着改"的写法（wt 是 --base <远端>/<分支>，integrate 是 --target <分支>）。"""
    start, against = check["start"], check["against"]
    sha = f"（{check['start_sha'][:9]}）" if check.get("start_sha") else ""
    text = f"起点 {start}{sha} 不含这个任务上一轮推到 {against} 的提交，没有建 worktree"
    if not synced:
        text += "（--no-sync：按本地记录判断，没 fetch）"
    missing = check.get("missing") or []
    if missing:
        text += f"。缺 {len(missing)} 个：" + "；".join(f"{m['short']} {m['subject']}（{m['pushed_at']} 推到 {m['pushed_to']}）"
                                                    for m in missing)
    choices = [{"do": "base", "text": f"在上一轮的分支 {against} 上接着改：重跑改成 {base_flag}"}]
    if check.get("unknown"):
        text += "。核实不了：" + "；".join(check["unknown"])
        if carry:
            text += "（--carry 带不上本地找不到的提交）"
    else:
        choices.insert(0, {"do": "carry", "text": f"带上这些提交在 {start} 上起：重跑加 --carry \"<理由>\"，新 worktree 建好后"
                                                  "先把它们按顺序 cherry-pick 进来（理由记进任务目录的 carry.jsonl）"})
    marks = "①②"
    text += "。做法交用户定：" + "；".join(f"{marks[i]}{c['text']}" for i, c in enumerate(choices)) + no_url_note(check)
    return DroverError(text, round_check=check, missing=missing, choices=choices,
                       no_remote_url=check.get("no_remote_url", []))


def carry_commits(wt: str, slug: str, repo: str, branch: str, check: dict, reason: str) -> list:
    """--carry：在新 worktree 里按从旧到新 cherry-pick 起点缺的上一轮提交，记进 <slug>/carry.jsonl。一条 cherry-pick 命令：
    git 自己按顺序摘，冲突时停在那个提交上，解完 --continue 接着摘剩下的。返回带上的提交 [{sha, subject, new_sha}]。
    带上的提交在 worktree 里是提交、BASE_SHA（head_sha）在它们之后：commit 模式条目分支里有它们，integrate 核实时按 --from
    算作已覆盖，摘条目提交时一起摘进集成分支；patch 模式补丁只含 worker 的改动，集成 worktree 用 wt --carry 建、先带上再
    叠补丁。漏了的都会被核实挡住（集成 worktree 的起点不含、--from 里也没有）。"""
    missing = check["missing"]
    record = {"at": time.strftime("%m-%d %H:%M:%S"), "ts": round(time.time(), 3), "repo": repo, "branch": branch,
              "worktree_path": wt, "start": check["start"], "start_sha": check["start_sha"],
              "against": check["against"], "reason": reason,
              "commits": [{k: m[k] for k in ("sha", "subject", "pushed_to", "pushed_at")} for m in missing]}
    cp = git(wt, "cherry-pick", *[m["sha"] for m in missing], timeout=600)
    record["status"] = "picked" if cp.returncode == 0 else "stopped"
    append_jsonl(STATE_HOME / slug / CARRY_FILE, record)
    if cp.returncode != 0:
        raise DroverError(
            f"带上上一轮的提交时 cherry-pick 停下了（worktree 已建在 {wt}）：解完冲突 → git -C {wt} add <文件> → "
            f"git -C {wt} -c core.editor=true cherry-pick --continue（会接着摘剩下的）；摘完后的 HEAD 就是这个 worktree 的 "
            "BASE_SHA", worktree_path=wt, conflicts=conflicted_files(wt), stderr=tail(cp.stderr or cp.stdout, 800),
            carry_file=str(STATE_HOME / slug / CARRY_FILE))
    picked = git_out(wt, "rev-list", "--reverse", f"{check['start_sha']}..HEAD").splitlines()
    return [{"sha": m["sha"], "subject": m["subject"], "new_sha": new} for m, new in zip(missing, picked)]


def herdr_trusted(cmd: list, repo: str) -> tuple[bool, dict, bool]:
    """跑一条 herdr worktree 命令；herdr 要求信任仓库时，只对主工作台（config 的 workspace）下的仓库自动加
    --trust-repository 重试一次，其他位置报错（先问用户确认可信）。返回 (成功, 结果或错误, 是否加了信任)。wt、cleanup 共用。"""
    ok, res = herdr(cmd)
    if ok or "trust" not in f"{res.get('code', '')} {res.get('message', '')}".lower():
        return ok, res, False
    if TRUSTED_ROOT is None:
        raise DroverError(
            f"herdr 要求信任仓库 {repo}；没有配置主工作台（{CONFIG_FILE} 的 workspace），不自动信任任何目录。"
            "先问用户确认可信，再手动加 --trust-repository。", error=res)
    if not is_under(repo, TRUSTED_ROOT):
        raise DroverError(
            f"herdr 要求信任仓库，但 {repo} 不在 {TRUSTED_ROOT} 下。先问用户确认可信，再手动加 --trust-repository。",
            error=res)
    ok, res = herdr(cmd + ["--trust-repository"])
    return ok, res, ok


def cmd_wt(a: argparse.Namespace) -> dict:
    repo = git_out(a.repo, "rev-parse", "--show-toplevel")
    branch = a.branch
    base = getattr(a, "base", None)
    no_sync = getattr(a, "no_sync", False)
    # integrate 调用时传：调用前已经 fetch 过的远端分支 {ref: 尝试次数}，这里不重复 fetch。
    prefetched = getattr(a, "prefetched", None) or {}
    ok, listing = herdr(["worktree", "list", "--cwd", repo])
    if not ok:
        raise DroverError("herdr worktree list 失败", error=listing)
    existing = [w for w in listing.get("worktrees", []) if w.get("branch") == branch]

    # 新一轮的起点（见 round_check 上面的说明）：任务来自 --slug，或分支 task/<slug>… 的归属。
    carry = getattr(a, "carry", None)
    via_integrate = getattr(a, "via_integrate", False)
    slug = getattr(a, "slug", None)
    if slug and not via_integrate:  # integrate 已核过 slug，任务目录由它在写状态时建
        task_dir(slug)
    elif not slug:
        slug = task_owner(branch, task_slugs())
    # 推到别处的（remote 换过地址，见 push_moved）不拿来定起点、不拿来核实，列在 round_check 的 other_remote 里
    pushes, away = split_by_remote(repo, repo_pushes(task_pushes(slug), repo) if slug else [])
    remotes = git_out(repo, "remote").split()
    base_from = None
    if not existing and base is None and pushes:
        base, base_from = round_default_base(repo, pushes), "这个任务上一轮推的分支"
    also = tuple(getattr(a, "round_also", None) or ())  # integrate 接着要摘的条目分支，见 round_check

    def check_round(start: str, synced: bool) -> dict:
        """核实起点，推到别处的推送进 warnings；不过就抛错（带了 --carry、缺的提交都找得到时放行，建好后 carry_commits
        带上）。--dry-run 按本地记录预测（would_refuse），不报错：实际执行时 fetch 后再核实。"""
        check, notes = round_other_remote(round_check(repo, pushes, start, remotes, also), away)
        warnings.extend(notes)
        refuse = check["status"] == "missing" and (not carry or bool(check.get("unknown")))
        if a.dry_run:
            return {**check, "would_refuse": refuse, "note": "按本地记录预测（没 fetch）；实际执行 fetch 后再核实"} \
                if check["status"] == "missing" else check
        if refuse:
            against = check["against"]
            raise round_refusal(check, f"--target {against.partition('/')[2]}" if via_integrate else f"--base {against}",
                                synced, carry)
        return check

    renamed_from = None
    reused = bool(existing)
    if not reused:
        candidate, n = branch, 2
        while branch_exists(repo, candidate):
            candidate = f"{branch}-{n}"
            n += 1
        if candidate != branch:
            renamed_from, branch = branch, candidate
    path_args = ["--path", a.path] if a.path else []

    def create_cmd(start: str) -> list:
        return ["worktree", "create", "--cwd", repo, "--branch", branch, "--base", start, "--label", a.label,
                "--no-focus", *path_args]

    open_cmd = ["worktree", "open", "--cwd", repo, "--branch", branch, "--label", a.label, "--no-focus", *path_args]
    warnings: list = []
    if reused:
        cmd, base_ref = open_cmd, None
        sync = {"status": "reused", "reason": "复用已有 worktree：不 fetch、不动主目录"}
    elif no_sync:
        base_ref = base or "HEAD"
        cmd = create_cmd(base_ref)
        head = git_out(repo, "rev-parse", "HEAD")
        src_branch = current_branch(repo)
        remote_default, default_note = default_branch_note(repo, src_branch,
                                                           source_upstream(repo, src_branch, remotes), remotes)
        sync = {"status": "not_synced", "reason": "--no-sync：没 fetch、没动主目录", "branch": src_branch,
                "before": head, "after": head, "remote_default": remote_default}
        warnings.append(f"没同步上游（--no-sync）：worktree 从 {base_ref} 起，不一定是远端最新")
        if default_note and base_ref == "HEAD":
            warnings.append(default_note)

    if a.dry_run:
        planned = []
        if not reused and not no_sync:
            sync, planned, base_ref, warnings = plan_source_sync(repo, base, prefetched)
            cmd = create_cmd(base_ref)
        planned.append("herdr " + shlex.join(cmd))
        check = check_round(base_ref, False) if not reused else ROUND_REUSED
        return {
            "ok": True, "dry_run": True, "repo": repo, "branch": branch,
            "branch_renamed_from": renamed_from, "reused": reused,
            "existing_worktree_path": existing[0].get("path") if existing else None,
            "source_sync": sync,
            "base_ref": base_ref,
            "base_ref_note": None if reused or no_sync else
            "按本地记录的上游预测；实际起点 fetch 后再定：上游是主检出 HEAD 的祖先（快进成功、本来就是最新、本地领先）用 HEAD，"
            "否则用上游；显式 --base 照用",
            "base_from": base_from, "task": slug, "round_check": check,
            # 不用联网就知道的提示（主目录不在远端默认分支上、--no-sync）；主目录没更新之类要 fetch 后才知道
            "warnings": warnings,
            "planned": planned,
            "would_copy": copy_local_files(repo, existing[0]["path"], True)[0] if existing else
            new_worktree_copy_note(repo),
            "untracked_repo_docs": [{"name": n, "ignored": i} for n, i in untracked_repo_docs(repo)],
        }

    if not reused and not no_sync:
        with repo_sync_lock(repo) as waited:
            sync, base_ref, warnings = sync_source(repo, base, prefetched)
        if waited:
            sync["lock_waited_seconds"] = waited
        cmd = create_cmd(base_ref)
    check = check_round(base_ref, not no_sync) if not reused else dict(ROUND_REUSED)
    if carry and check["status"] != "missing":
        warnings.append(f"--carry 没用上：{check.get('note') or '起点已经包含上一轮推的提交'}"
                        if check["status"] != "skipped" else "--carry 没用上：复用已有 worktree，没有新起点")

    primary_before = repo_primary_workspaces(repo)
    ok, res, trusted = herdr_trusted(cmd, repo)
    if not ok:
        raise DroverError("herdr worktree 命令失败", command="herdr " + shlex.join(cmd), error=res, source_sync=sync)

    ws_id = (res.get("workspace") or {}).get("workspace_id") or find_key(res, "workspace_id")
    wt_path = (res.get("worktree") or {}).get("path")
    if not ws_id or not wt_path:
        raise DroverError("herdr 返回里缺 workspace.workspace_id 或 worktree.path", result=res)

    ok, panes = herdr(["pane", "list", "--workspace", ws_id])
    pane_id = panes["panes"][0]["pane_id"] if ok and panes.get("panes") else None
    carried = []
    if check["status"] == "missing":
        # 先带上再复制本地文件：复制过去的未跟踪文件会挡住要新增它的 cherry-pick（见 copy_local_files）
        try:
            carried = carry_commits(wt_path, slug, repo, branch, check, carry)
        except DroverError as exc:
            exc.extra.update(workspace_id=ws_id, pane_id=pane_id, round_check=check)
            raise
    opened = sorted(repo_primary_workspaces(repo) - primary_before)
    copied, docs_not_copied, include_skipped = copy_local_files(repo, wt_path, False)

    result = {
        "ok": True,
        "repo": repo,
        "branch": branch,
        "branch_renamed_from": renamed_from,
        "reused": reused,
        "trusted_repository_added": trusted,
        "workspace_id": ws_id,
        "worktree_path": wt_path,
        "pane_id": pane_id,
        "source_workspace_opened": opened[0] if opened else None,
        "head_sha": git_out(wt_path, "rev-parse", "HEAD"),
        # 新建时实际用的起点写法（HEAD、origin/<分支> 或显式 --base）；复用时为 None。
        "base_ref": base_ref,
        # 主检出同步：status 见 sync_source / fast_forward_source（fast_forwarded、up_to_date、ahead、dirty、in_progress、
        # diverged、ff_failed、detached、no_upstream、upstream_gone、not_synced、reused），reason 是中文说明，
        # fetch 列出每次 fetch 和尝试次数，remote_default 是本地记录的远端默认分支（如 origin/main）。
        "source_sync": sync,
        # 编排者要在汇报里提一句的事：主目录没更新、worktree 带着没推送的提交、没法判断上游（含上游在远端已删）、
        # 主目录不在远端默认分支上、--no-sync、上一轮的推送推到了别处（remote 换过地址）。
        "warnings": warnings,
        "copied": copied,
        # 新一轮的起点：task 是推送记录按哪个任务取的（没有就是 null）；base_from 非空表示起点是按推送记录定的；
        # round_check 的 status：no_records（第一轮，起点照旧）、ok（含上一轮推的提交，how 是 ancestor / patch）、
        # missing（带了 --carry，carried 是带上的提交）、skipped（复用）、other_remote（推送全推到了别处：remote 换过地址，
        # 起点照第一轮的规则定）；other_remote 列出推到别处的推送（有的推到这里时也在，只核实推到这里的）。
        "task": slug, "base_from": base_from, "round_check": check,
        **({"carried": carried} if carried else {}),
        "note": ("复用了已有 worktree：BASE_SHA 用状态文件里原来记录的，没有记录才用 head_sha 并在汇报里说明。"
                 if reused else "新建 worktree：head_sha 就是 BASE_SHA。" + (
                     "（--carry 带上的上一轮提交已在它之前）" if carried else "")),
    }
    if SLUG_RISKY_WORDS.search(a.label):
        result["warning"] = ("label / slug 里有 import 或 include：结果文件路径会带上它，用 jq 读时会被判成加载模块、弹强制审批；"
                             "读验收结果用 drover accept-summary")
    if docs_not_copied:
        result["docs_not_copied"] = docs_not_copied
        result["docs_note"] = ("这些规范文件在源仓库里既没提交也没被忽略，复制过去会出现在 worktree 的 git status 里，所以没复制；"
                               "brief 会让 agent 去读源仓库里的原文。")
    if include_skipped:
        # .worktreeinclude 匹配到、源仓库里被忽略，但没复制的文件和原因（worktree 里没被忽略、源路径是符号链接）。
        result["worktreeinclude_skipped"] = include_skipped
    return result


# ---------------------------------------------------------------- deps

def venv_python_version(venv: Path) -> Optional[str]:
    cfg = venv / "pyvenv.cfg"
    if cfg.is_file():
        for line in cfg.read_text(errors="replace").splitlines():
            key, _, value = line.partition("=")
            if key.strip() in ("version", "version_info"):
                m = re.match(r"\s*(\d+\.\d+\.\d+)", value)
                if m:
                    return m.group(1)
    py = venv / "bin" / "python"
    if py.exists():
        p = run([str(py), "-c", "import sys; print('%d.%d.%d' % sys.version_info[:3])"], timeout=30)
        if p.returncode == 0:
            return p.stdout.strip()
    return None


def nested_lockfiles(wt: Path, max_depth: int = 3) -> dict:
    """按子目录归组列出 lockfile：{子目录: [lockfile 名, ...]}，不含 worktree 根目录。"""
    found: dict = {}
    root_depth = len(wt.parts)
    for dirpath, dirnames, filenames in os.walk(wt):
        depth = len(Path(dirpath).parts) - root_depth
        dirnames[:] = [d for d in dirnames if d not in SCAN_SKIP_DIRS and depth < max_depth]
        if depth == 0:
            continue
        locks = sorted(name for name in filenames if name in LOCKFILE_NAMES)
        if locks:
            found[str(Path(dirpath).relative_to(wt))] = locks
    return dict(sorted(found.items()))


class DepsPlan:
    """记录每一项依赖的处理结果，同时生成给 agent 看的中文摘要。"""

    def __init__(self, dry_run: bool) -> None:
        self.dry_run = dry_run
        self.items: list = []

    def step(self, cmd: list, timeout: float = 1800) -> tuple[bool, str, float]:
        if self.dry_run:
            return True, "dry-run", 0.0
        started = time.time()
        p = run(cmd, timeout=timeout)
        return p.returncode == 0, tail(p.stderr or p.stdout, 600), round(time.time() - started, 1)

    def add(self, kind: str, action: str, summary: str, **extra: Any) -> None:
        self.items.append({"kind": kind, "action": action, "summary": summary, **extra})


def deps_js(plan: DepsPlan, wt: Path) -> None:
    if not (wt / "package.json").is_file():
        return
    lock = next(((name, tool) for name, tool in JS_LOCKFILES if (wt / name).is_file()), None)
    if lock is None:
        plan.add("js", "not_installed", "有 package.json 但没有 lockfile，未安装 JS 依赖；需要时请在 worktree 内自行安装。")
        return
    lockname, tool = lock
    if (wt / "node_modules").exists():
        plan.add("js", "skipped", f"worktree 里已有 node_modules，未重装（lockfile：{lockname}）。", tool=tool)
        return
    if not shutil.which(tool):
        plan.add("js", "failed", f"仓库用 {lockname}，但本机找不到 {tool}，未安装 JS 依赖；需要时请自行安装。", tool=tool)
        return
    cmd = {
        "bun": ["bun", "install", "--cwd", str(wt), "--frozen-lockfile"],
        "pnpm": ["pnpm", "install", "--dir", str(wt), "--frozen-lockfile"],
        "yarn": ["yarn", "--cwd", str(wt), "install", "--frozen-lockfile"],
        "npm": ["npm", "ci", "--prefix", str(wt)],
    }[tool]
    ok, out, secs = plan.step(cmd)
    if ok:
        plan.add("js", "installed",
                 f"JS 依赖已按 {lockname} 装好（{tool}，worktree 内独立的 node_modules，不是源仓库的软链）。",
                 command=shlex.join(cmd), seconds=secs)
    else:
        plan.add("js", "failed",
                 f"JS 依赖按 {lockname} 严格安装失败（lockfile 可能和 package.json 不一致），node_modules 可能不完整；"
                 f"需要时请在 worktree 内自行安装。错误尾部：{out[-200:]}",
                 command=shlex.join(cmd), error=out, seconds=secs)


def deps_python(plan: DepsPlan, repo: Path, wt: Path) -> None:
    wt_venv = wt / ".venv"
    src_venv = repo / ".venv"
    has_py_project = any((wt / f).is_file() for f in ("requirements.txt", "pyproject.toml", "uv.lock"))
    if not has_py_project and not src_venv.exists():
        return
    if wt_venv.exists():
        plan.add("python", "skipped", "worktree 里已有 .venv，未重建。")
        return
    if not shutil.which("uv"):
        plan.add("python", "failed", "找不到 uv，未建 Python 环境；需要时请自行创建 ./.venv。")
        return

    if (wt / "uv.lock").is_file():
        cmd = ["uv", "sync", "--frozen", "--project", str(wt)]
        ok, out, secs = plan.step(cmd)
        if ok:
            plan.add("python", "installed", "Python 环境已按 uv.lock 同步到 ./.venv（uv sync --frozen）。",
                     command=shlex.join(cmd), seconds=secs)
        else:
            plan.add("python", "failed", f"uv sync --frozen 失败，./.venv 可能不完整；需要时请自行处理。错误尾部：{out[-200:]}",
                     command=shlex.join(cmd), error=out, seconds=secs)
        return

    src_py = src_venv / "bin" / "python"
    if not src_py.exists():
        plan.add("python", "not_installed", "源仓库没有 .venv，worktree 里没有建 Python 环境；需要时请自行创建 ./.venv。")
        return

    version = venv_python_version(src_venv)
    if not version:
        plan.add("python", "failed", "读不出源仓库 .venv 的 Python 版本，未建 Python 环境。")
        return
    started = time.time()
    commands = []
    wt_py = wt_venv / "bin" / "python"

    cmd = ["uv", "venv", "--seed", "--python", version, str(wt_venv)]
    commands.append(shlex.join(cmd))
    ok, out, _ = plan.step(cmd, timeout=600)
    if not ok:
        plan.add("python", "failed", f"uv venv 创建失败（Python {version}）。错误尾部：{out[-200:]}", error=out)
        return

    editable: list = []
    if plan.dry_run:
        commands.append(f"uv pip freeze --python {src_py} → 去掉 -e 行写入 .venv/base-freeze.txt → uv pip install -r")
    else:
        p = run(["uv", "pip", "freeze", "--python", str(src_py)], timeout=300)
        if p.returncode != 0:
            plan.add("python", "failed", "读取源仓库 venv 的包列表失败。", error=tail(p.stderr))
            return
        pinned = []
        for line in p.stdout.splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            (editable if line.startswith("-e ") else pinned).append(line)
        freeze = wt_venv / "base-freeze.txt"
        freeze.write_text("\n".join(pinned) + "\n")
        cmd = ["uv", "pip", "install", "--python", str(wt_py), "-r", str(freeze)]
        commands.append(shlex.join(cmd))
        ok, out, _ = plan.step(cmd)
        if not ok:
            plan.add("python", "failed", f"按源仓库 venv 的包列表安装失败。错误尾部：{out[-200:]}", error=out,
                     commands=commands)
            return

    req = wt / "requirements.txt"
    if req.is_file():
        cmd = ["uv", "pip", "install", "--python", str(wt_py), "-r", str(req)]
        commands.append(shlex.join(cmd))
        ok, out, _ = plan.step(cmd)
        if not ok:
            plan.add("python", "failed", f"按 worktree 的 requirements.txt 补装失败。错误尾部：{out[-200:]}", error=out,
                     commands=commands)
            return

    reinstalled = []
    for line in editable:
        target = line[3:].strip()
        target_path = target[len("file://"):] if target.startswith("file://") else target
        if target_path and is_under(target_path, repo):
            # 源 venv 里以可编辑方式装的本仓库，换成 worktree 里的同一路径，避免 import 到源仓库的代码。
            target_path = str(wt / Path(target_path).resolve().relative_to(repo.resolve()))
        cmd = ["uv", "pip", "install", "--python", str(wt_py), "-e", target_path]
        commands.append(shlex.join(cmd))
        ok, out, _ = plan.step(cmd)
        reinstalled.append({"source": target, "installed_as": target_path, "ok": ok})

    summary = f"Python 环境已建好：./.venv（Python {version}）复刻了源仓库 venv 的包"
    if req.is_file():
        summary += "，并按 requirements.txt 补装"
    if reinstalled:
        summary += f"；{len(reinstalled)} 个可编辑安装已改指向 worktree"
    plan.add("python", "installed", summary + "。",
             commands=commands, editable=reinstalled, seconds=round(time.time() - started, 1))


def cmd_deps(a: argparse.Namespace) -> dict:
    repo = Path(git_out(a.repo, "rev-parse", "--show-toplevel"))
    wt = Path(a.wt).resolve()
    if not wt.is_dir():
        raise DroverError(f"worktree 目录不存在：{wt}")
    plan = DepsPlan(a.dry_run)
    deps_js(plan, wt)
    deps_python(plan, repo, wt)
    if any((wt / f).is_file() for f in JAVA_BUILD_FILES):
        plan.add("java", "skipped", "Java 依赖走全局缓存（~/.m2 / ~/.gradle），无需安装。")
    for subdir, locks in nested_lockfiles(wt).items():
        plan.add("nested", "not_installed",
                 f"子项目 {subdir}（{'、'.join(locks)}）的依赖没有安装；改到这个子项目时请在 worktree 内自行安装。",
                 path=subdir)
    if not plan.items:
        plan.add("none", "skipped", "未检测到需要安装的依赖。")
    lines = [item["summary"] for item in plan.items]
    result = {
        "ok": True,
        "dry_run": a.dry_run,
        "worktree_path": str(wt),
        "items": plan.items,
        "has_failure": any(i["action"] == "failed" for i in plan.items),
        "summary_for_prompt": "\n".join(f"- {line}" for line in lines),
    }
    if a.save:
        # brief 从这里取依赖摘要和类型，编排者不必再抄一遍。dry-run 也存（带 dry_run 标记，brief 会提示）。
        result["saved_to"] = save_json(a.save, result)
    return result


# ---------------------------------------------------------------- agent

def agent_status(name: str) -> Optional[str]:
    ok, res = herdr(["agent", "get", name], timeout=30)
    return find_key(res, "agent_status") if ok else None


def agent_screen(name: str, lines: int = 40) -> str:
    p = run(["herdr", "agent", "read", name, "--source", "visible", "--lines", str(lines)], timeout=30)
    return p.stdout if p.returncode == 0 else ""


def pane_output(pane: str, lines: int = 30) -> str:
    p = run(["herdr", "pane", "read", pane, "--source", "recent", "--lines", str(lines)], timeout=30)
    return p.stdout if p.returncode == 0 else ""


def cursor_option(screen: str) -> Optional[str]:
    current = None
    for line in screen.splitlines():
        m = CURSOR_LINE_RE.match(line)
        if m:
            current = m.group(1)
    return current


def select_affirmative(name: str) -> bool:
    """把选择菜单的光标移到肯定项（Yes / trust / allow）再回车。找不到肯定项就什么都不确认。"""
    for _ in range(5):
        option = cursor_option(agent_screen(name))
        if option is None:
            return False
        if AFFIRMATIVE_RE.search(option) and not NEGATIVE_START_RE.match(option):
            herdr(["agent", "send-keys", name, "enter"], timeout=30)
            return True
        herdr(["agent", "send-keys", name, "down"], timeout=30)
        time.sleep(0.5)
    return False


# codex 0.157 起交互模式默认连共享后台 server，本机配置下会直接报错退出，必须加 --no-daemon。
CODEX_BASE_ARGS = ["--no-daemon", "--no-alt-screen"]
# 编排者、worker、复审的模型和 effort：config.json 的 claude_model / claude_effort / codex_effort 可改（没有 1M 上下文
# 档位的账号起不来 opus[1m]），没配就用下面的默认值；命令行的 --effort 优先于 config。codex 的模型不传，
# 用 ~/.codex/config.toml 的默认。
CLAUDE_DEFAULT_MODEL = "opus[1m]"
CLAUDE_DEFAULT_EFFORT = "xhigh"
# codex 默认 effort 和 claude 对齐成 xhigh：不传时会继承 ~/.codex/config.toml 的 ultra
# （"Maximum reasoning with automatic task delegation"），实测 worker 改两个文件花了 19 分钟。
CODEX_DEFAULT_EFFORT = "xhigh"


def claude_model_args(effort: Optional[str]) -> list:
    return ["--model", CONFIG.get("claude_model") or CLAUDE_DEFAULT_MODEL,
            "--effort", effort or CONFIG.get("claude_effort") or CLAUDE_DEFAULT_EFFORT]


def codex_effort_args(effort: Optional[str]) -> list:
    return ["-c", f"model_reasoning_effort={effort or CONFIG.get('codex_effort') or CODEX_DEFAULT_EFFORT}"]
# agent start 刚返回时 herdr 可能还把一个马上要退出的进程看成 idle，等几秒再确认一次。
STARTUP_SETTLE_SECONDS = 4
# 新 pane 的 shell 还没就绪时（agent_pane_busy）的重试次数和间隔。
PANE_READY_RETRIES = 5
PANE_READY_WAIT_SECONDS = 2


def start_agent(name: str, kind: str, pane: str, agent_args: list, dry_run: bool) -> dict:
    check_agent_name(name)
    cmd = ["agent", "start", name, "--kind", kind, "--pane", pane, "--timeout", "120000", "--", *agent_args]
    if dry_run:
        return {"ok": True, "dry_run": True, "planned": ["herdr " + shlex.join(cmd)]}

    ok, listing = herdr(["agent", "list"], timeout=30)
    if ok and any(x.get("name") == name for x in listing.get("agents", [])):
        raise DroverError(f"agent 名 {name} 已被占用，换一个名字")

    # 刚分屏 / 新建 tab 的 pane，shell 可能还没初始化完，herdr 会报 agent_pane_busy（复审起不来过）。
    # 这种情况等一下再试；其它错误照旧直接失败。
    for attempt in range(PANE_READY_RETRIES + 1):
        ok, res = herdr(cmd, timeout=150)
        if ok or res.get("code") != "agent_pane_busy" or attempt == PANE_READY_RETRIES:
            break
        time.sleep(PANE_READY_WAIT_SECONDS)
    if not ok and res.get("code") != "agent_not_ready":
        raise DroverError("herdr agent start 失败", command="herdr " + shlex.join(cmd), error=res)

    handled: list = []
    status: Optional[str] = None
    for _ in range(6):
        time.sleep(STARTUP_SETTLE_SECONDS if not handled else 1)
        status = agent_status(name)
        if status is None:
            return {"ok": False, "name": name, "pane_id": pane, "status": "gone",
                    "startup_dialogs_handled": handled,
                    "pane_output": tail(pane_output(pane), 3000),
                    "command": "herdr " + shlex.join(cmd),
                    "error": "agent 启动后又退出了，看 pane_output 里的报错；修正参数后可在同一个 pane 重新 agent-start"}
        if status in ("idle", "done"):
            break
        if status != "blocked":
            # working / unknown：启动期的瞬时状态（比如接受信任后加载配置），等它稳定再看。
            herdr(["agent", "wait", name, "--timeout", "60000"], timeout=90)
            continue
        screen = agent_screen(name)
        match = next(((key, label) for pattern, key, label in STARTUP_DIALOGS if pattern.search(screen)), None)
        if match is None:
            return {"ok": False, "name": name, "pane_id": pane, "status": status,
                    "startup_dialogs_handled": handled, "screen": tail(screen, 3000),
                    "error": "agent 卡在不认识的界面上，按 dispatch.md 第 7 节决策表处理"}
        action, label = match
        if action == "select_yes":
            if not select_affirmative(name):
                return {"ok": False, "name": name, "pane_id": pane, "status": status,
                        "startup_dialogs_handled": handled, "screen": tail(agent_screen(name), 3000),
                        "error": "识别到信任弹窗，但没找到可选的肯定项，没有按任何确认键；看 screen 手动处理"}
        else:
            herdr(["agent", "send-keys", name, action], timeout=30)
        herdr(["agent", "wait", name, "--timeout", "60000"], timeout=90)
        handled.append(label)
    else:
        return {"ok": False, "name": name, "pane_id": pane, "status": status,
                "startup_dialogs_handled": handled, "screen": tail(agent_screen(name), 3000),
                "error": "启动后状态一直没稳定到 idle（连续处理弹窗或等待后仍不就绪），看 screen 后按第 7 节决策表处理"}
    return {"ok": status in ("idle", "done"), "name": name, "kind": kind, "pane_id": pane, "status": status,
            "startup_dialogs_handled": handled,
            "command": "herdr " + shlex.join(cmd)}


def split_pane(pane: str, wt: str) -> str:
    """在 pane 右侧分屏，新 pane 的工作目录是 wt；返回新 pane 的 ID。"""
    ok, res = herdr(["pane", "split", pane, "--direction", "right", "--cwd", wt, "--no-focus"])
    if not ok:
        raise DroverError("herdr pane split 失败", error=res)
    pane_id = (res.get("pane") or {}).get("pane_id")
    if not pane_id:
        raise DroverError("herdr pane split 返回里缺 pane.pane_id", result=res)
    return pane_id


# 没写 --kind 时宿主跟主会话走（主会话是 Codex 时，派出的编排者和 worker 仍是 Claude Code）。
# 认调用方用 herdr：HERDR_PANE_ID 那个 pane 里 agent 的类型（agent get 的 agent 字段，和 agent start --kind 同一套取值）。
# 不看 CLAUDECODE / CODEX_* 环境变量：子进程会继承祖先的，实测从 Claude Code 里起的 codex 两种都有，认不出最近一层。
HOST_KINDS = ("claude", "codex")
NO_CALLER_KIND = "认不出调用方的宿主（不在 Herdr 的 pane 里，或这个 pane 里没有 claude / codex agent）"


def agent_kind(target: str) -> Optional[str]:
    """herdr 里这个 agent（pane ID 或 agent 名）的宿主；查不到、类型不是 claude / codex 时 None。"""
    kind = (pane_agent(target) or {}).get("agent")
    return kind if kind in HOST_KINDS else None


def caller_kind() -> Optional[str]:
    """调用这条命令的 agent 的宿主：主会话跑 orch-start、编排者跑 agent-start 时就是它们自己。"""
    pane = os.environ.get("HERDR_PANE_ID")
    return agent_kind(pane) if pane else None


def task_default_kind(slug: str) -> tuple[Optional[str], str]:
    """任务里没指定宿主时 worker 用哪个，返回 (kind, 来由)：orch.json 的 default_kind（orch-start 记的主会话宿主）是 "orch"；
    没有 orch.json（主会话直接编排）或没有这个字段时是调用方的宿主，"caller"（认不出时 kind 为 None）。"""
    kind = read_json_dict(STATE_HOME / slug / "orch.json").get("default_kind")
    return (kind, "orch") if kind else (caller_kind(), "caller")


def cmd_agent_start(a: argparse.Namespace) -> dict:
    if bool(a.pane) == bool(a.split_from):
        raise DroverError("--pane 和 --split-from 必须且只能给一个")
    if a.split_from and not a.wt:
        raise DroverError("--split-from 要配合 --wt（新 pane 的工作目录）")
    check_slug(a.slug)
    slug_dir = STATE_HOME / a.slug
    kind, kind_source = (a.kind, "explicit") if a.kind else task_default_kind(a.slug)
    if kind is None:
        raise DroverError(f"{slug_dir / 'orch.json'} 里没有 default_kind，又{NO_CALLER_KIND}：加 --kind claude|codex",
                          caller_pane=os.environ.get("HERDR_PANE_ID"))
    if not a.dry_run:
        slug_dir.mkdir(parents=True, exist_ok=True)
    add_dirs = [str(slug_dir), *a.add_dir]
    if kind == "codex":
        # codex worker 跑在 workspace-write 沙箱里，写不了 heavy 的调度目录就不排队直接跑、调度器也看不见它的负载。
        # --add-dir 让目录可写：`codex --help` 写明 "Additional directories that should be writable alongside the
        # primary workspace"，用 codex exec 实测过加进去的目录能建文件、别的目录被拒。
        # claude worker 默认不在沙箱里，不加（加了还会多弹一次 "Adding a new directory" 信任框）。
        add_dirs.append(str(HEAVY_DIR))
        if not a.dry_run:
            HEAVY_DIR.mkdir(parents=True, exist_ok=True)
    if kind == "claude":
        args = [*claude_model_args(a.effort), "--permission-mode", "acceptEdits", "--name", f"worker-{a.slug}"]
        for d in add_dirs:
            args += ["--add-dir", d]
    else:
        args = ["-a", "on-request", "-s", "workspace-write", *CODEX_BASE_ARGS]
        for d in add_dirs:
            args += ["--add-dir", d]
        args += codex_effort_args(a.effort)
    if a.resume:
        # agent 意外退出后在同一个 pane 接着上次的会话：claude 加 --continue，codex 用 resume --last（选项照旧）。
        args = ["resume", "--last", *args] if kind == "codex" else [*args, "--continue"]
    if a.split_from:
        # 同一个 worktree 换 agent（换 kind、缩小范围重开）：在旧 agent 旁边新开 pane，旧 pane 由编排者确认报告存档后关闭。
        check_agent_name(a.name)
        if a.dry_run:
            planned = start_agent(a.name, kind, "<新 pane>", args, True)["planned"]
            result = {"ok": True, "dry_run": True,
                      "planned": [f"herdr pane split {a.split_from} --direction right --cwd {a.wt} --no-focus", *planned]}
        else:
            pane = split_pane(a.split_from, str(Path(a.wt).expanduser().resolve()))
            result = start_agent(a.name, kind, pane, args, False)
            result["split_from"] = a.split_from
            result["pane_id"] = pane
    else:
        result = start_agent(a.name, kind, a.pane, args, a.dry_run)
    result.update(kind=kind, kind_source=kind_source)
    return result


# ---------------------------------------------------------------- orch-start

# 编排者（orchestrator）都放在这个 workspace 里，一个任务一个 tab。不叫 drover：drover 是主会话本身，编排者是它派生出来的。
# 工作目录用主工作台（配置的 workspace），这样编排者拿到的权限规则、MCP 配置和主会话一样，不会因为换了目录而频繁弹审批。
# 没配置主工作台时下面三个是 None，orch-start 一开始就报错。
ORCH_WORKSPACE_LABEL = "orch"
ORCH_CWD = TRUSTED_ROOT
# 流程文档：在包里（flow/dispatch.md），Claude Code 的 /drover 命令软链到它；Codex 的 drover 技能只是一层壳，
# 让 codex 去读同一份（主体只写一次）。
DISPATCH_DOC = PKG_ROOT / "flow" / "dispatch.md"
CLAUDE_DROVER_COMMAND = HOME / ".claude" / "commands" / "drover.md"
CODEX_HOME = Path(os.environ.get("CODEX_HOME") or HOME / ".codex")
CODEX_DROVER_SKILL = CODEX_HOME / "skills" / "drover" / "SKILL.md"
# Codex 不会自动加载的两份东西：用户全局规则（~/.claude/CLAUDE.md）和 Claude Code 给主工作台记的记忆索引。
# 没用 Claude Code 的用户没有这两个文件，开场 prompt 里就不提。
GLOBAL_CLAUDE_MD = HOME / ".claude" / "CLAUDE.md"
ORCH_MEMORY_INDEX = (HOME / ".claude" / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(ORCH_CWD))
                     / "memory" / "MEMORY.md") if ORCH_CWD else None
ROUTING_FILE = ORCH_CWD / "AGENTS.md" if ORCH_CWD else None
# codex 编排者用 danger-full-access：workspace-write 沙箱挡住 AF_UNIX socket，连不上 herdr（用 codex sandbox -P :workspace
# 实测 herdr agent list 报 Operation not permitted，加 --allow-unix-socket 才通）；编排者还要写 ~/.drover 和 ~/.herdr、git 联网、装依赖。
# 这和本机 ~/.codex/config.toml 的默认 sandbox_mode 一致。-a on-request 保留 codex 自己觉得危险时停下来问的机会。
CODEX_ORCH_ARGS = ["-s", "danger-full-access", "-a", "on-request", *CODEX_BASE_ARGS]

ORCH_KICKOFF = """你是任务 {slug} 的「编排者」（orchestrator），由主会话（{workspace} 的工作台会话）派来负责这一个任务。

1. 先读 {request}：用户的原话、主会话附的上下文和已经定下的决定。
2. {load_skill}
   参数里有 resume 时，是接手之前的编排者：先读 ~/.drover/{slug}/dispatch.md 和 rollup.md 恢复进度，按 dispatch.md「子模式」的 resume 接着做，不要从头分析。
3. request.md 里的「目标」是主会话在第一条回复里给用户的复述（用户纠正过就是纠正后的），直接用它当这个任务的目标，不用再复述；每份 worker 任务书（brief --goal）和最终汇报都以它开头。读完代码发现用户要的改动行不通、或者目标本身理解错了，把证据写进 {rollup}，状态标「等你决定」后停下，不要自己改方向。request.md 里没有「目标」时，按 dispatch.md 第 1.1 节自己写一段，放进 rollup 的「当前进度」，照常往下走。
4. 之后按 dispatch.md 的「编排者模式」一节运行：所有要用户确认或决定的事，以及阶段结论和最终汇报，都写进 {rollup}，写完就停下（结束这一轮），等主会话转达用户的答复。不要用向用户提问的工具（{ask_tool}），用户不看这个窗口。用户直接在这个窗口跟你说话时，可以直接回答。
{host_notes}
{routing}（CLAUDE.md 引用的就是它）的路由规则是给主会话用的，你忽略它。"""

# 子编排者：上层编排者给某个仓库起的编排者（跨仓任务里某个仓库工作量大时），往上只交 rollup，由上层转达。
ORCH_SUB_KICKOFF = """你是任务 {slug} 的「子编排者」，由上层编排者（任务 {parent}，状态文件 ~/.drover/{parent}/dispatch.md）派来负责其中一个仓库的那部分。

1. 先读 {request}：上层写的范围、目标、跨仓约定和已经定下的决定。
2. {load_skill}
   参数里有 resume 时，是接手之前的子编排者：先读 ~/.drover/{slug}/dispatch.md 和 rollup.md 恢复进度，按 dispatch.md「子模式」的 resume 接着做，不要从头分析。
3. request.md 里的「目标」是上层给你的目标（开头是用户的目标），直接用它，不用再复述；每份 worker 任务书（brief --goal）和最终汇报都以它开头。发现行不通或者和其他仓库的约定对不上，把证据写进 {rollup}，状态标「等你决定」后停下。
4. 之后按 dispatch.md「编排者模式」里「子编排者」一节运行：要决定的事、阶段结论都写进 {rollup}，写完就停下，等上层编排者转达答复（上层读你的 rollup，用户和主会话不直接看）。整体检查通过后在 rollup 写「可以推送」并停下，等上层说「推送」再执行迁移和推送。不要用向用户提问的工具（{ask_tool}）。
{host_notes}
{routing}（CLAUDE.md 引用的就是它）的路由规则是给主会话用的，你忽略它。"""


def codex_host_notes() -> str:
    """codex 编排者开场 prompt 的附加段。全局规则和记忆索引只在本机有这两个文件时才提（没用 Claude Code 的用户没有）。"""
    preload = []
    if GLOBAL_CLAUDE_MD.is_file():
        preload.append(f"{GLOBAL_CLAUDE_MD}（用户全局规则，里面的编码规范、git 规则同样适用）")
    if ORCH_MEMORY_INDEX and ORCH_MEMORY_INDEX.is_file():
        preload.append(f"{ORCH_MEMORY_INDEX}（主工作台的记忆索引，和任务相关的条目再读原文）")
    lines = ["", "5. 你跑在 Codex 里，宿主相关的做法按 dispatch.md 末尾「附录 B：Codex」："]
    if preload:
        lines.append("   - Codex 不会自动加载这些，开始前先读：" + "；".join(preload) + "。")
    lines += [
        "   - 追踪 agent 用 `~/.drover/bin/drover watch --until-event --timeout 1500 <agent名>...`，"
        "它在第一个状态变化时退出；没退出就用 write_stdin 空轮询（yield_time_ms 300000）一直等到它退出，处理完事件再挂下一轮。"
        "这个窗口没人看，长时间阻塞等待是预期的，不受「阻塞不要超过 60 秒」那条的限制。",
        "   - 文档里的 Write / Read / Edit 指读写文件，用你自己的工具做；Monitor、run_in_background 换成上面的阻塞等待。",
        "",
    ]
    return "\n".join(lines)


# 开场 prompt 里和宿主有关的几处：怎么加载 drover 流程、提问工具叫什么、Codex 要额外知道的事；
# 加上 orch-start 起编排者之前要确认装好的入口（Claude Code 的 /drover 命令、Codex 的 drover 技能）。
ORCH_HOSTS = {
    "claude": {
        "load_skill": "然后用 Skill 工具调用 drover，参数是：{skill_args}",
        "ask_tool": "AskUserQuestion",
        "host_notes": lambda: "",
        "entry": CLAUDE_DROVER_COMMAND,
        "entry_label": "/drover 命令",
    },
    "codex": {
        "load_skill": ("然后使用 drover 技能（$drover，文件 " + str(CODEX_DROVER_SKILL) + "），它会让你完整读 "
                       + str(DISPATCH_DOC) + " 并照做；流程里的 $ARGUMENTS 就是：{skill_args}"),
        "ask_tool": "request_user_input / request_user_input_async",
        "host_notes": codex_host_notes,
        "entry": CODEX_DROVER_SKILL,
        "entry_label": "drover 技能",
    },
}


def orch_workspace(dry_run: bool) -> tuple[Optional[str], Optional[str], list]:
    """找到或新建编排者的 workspace（label orch）。返回 (workspace_id, 新建时的根 pane, 计划执行的命令)。"""
    ok, res = herdr(["workspace", "list"], timeout=30)
    if not ok:
        raise DroverError("herdr workspace list 失败", error=res)
    for ws in res.get("workspaces", []):
        if ws.get("label") == ORCH_WORKSPACE_LABEL:
            return ws.get("workspace_id"), None, []
    cmd = ["workspace", "create", "--cwd", str(ORCH_CWD), "--label", ORCH_WORKSPACE_LABEL, "--no-focus"]
    if dry_run:
        return None, None, ["herdr " + shlex.join(cmd)]
    ok, res = herdr(cmd)
    if not ok:
        raise DroverError("herdr workspace create 失败", error=res)
    ws_id = (res.get("workspace") or {}).get("workspace_id")
    root_pane = (res.get("root_pane") or {}).get("pane_id")
    tab_id = (res.get("tab") or {}).get("tab_id")
    if not ws_id or not root_pane:
        raise DroverError("herdr workspace create 返回里缺 workspace_id 或 root_pane", result=res)
    return ws_id, root_pane, [tab_id] if tab_id else []


def orch_kinds(explicit: Optional[str], parent: Optional[str]) -> tuple[str, str, str]:
    """orch-start 的宿主，返回 (编排者的 kind, kind_source, default_kind)。编排者：--kind，没给就跟调用方（主会话；
    起子编排者时是上层编排者）。default_kind 是这个任务里没指定宿主时 worker 用的，即主会话的宿主：顶层 = 调用方
    （不受 --kind 影响），子编排者 = 上层 orch.json 的 default_kind（上层没有这个字段时用调用方）；调用方认不出时取 --kind。"""
    inherited = read_json_dict(STATE_HOME / parent / "orch.json").get("default_kind") if parent else None
    caller = None if explicit and inherited else caller_kind()
    kind = explicit or caller
    if kind is None:
        raise DroverError(f"{NO_CALLER_KIND}：加 --kind claude|codex 指定编排者跑在哪个宿主里",
                          caller_pane=os.environ.get("HERDR_PANE_ID"))
    return kind, "explicit" if explicit else "caller", inherited or caller or kind


def cmd_orch_start(a: argparse.Namespace) -> dict:
    if ORCH_CWD is None:  # 编排者的工作目录就是主工作台，没配置就起不了
        raise DroverError(NO_WORKSPACE_ERROR, config_file=str(CONFIG_FILE))
    check_slug(a.slug)
    check_agent_name(a.name)
    slug_dir = STATE_HOME / a.slug
    request = Path(a.request_file).expanduser()
    if not request.is_file() or not request.read_text().strip():
        raise DroverError(f"请求文件不存在或为空：{request}。先用 Write 写好用户原话和主会话附的上下文。")
    rollup = slug_dir / "rollup.md"
    parent = getattr(a, "parent", None)
    if parent:
        check_slug(parent)
        if not (STATE_HOME / parent / "dispatch.md").is_file():
            raise DroverError(f"上层任务 {parent} 没有状态文件 {STATE_HOME / parent / 'dispatch.md'}：--parent 写上层编排者的 slug")
        if not a.slug.startswith(parent + "-"):
            raise DroverError(f"子编排者的 slug 约定为 <上层 slug>-<仓库>，现在是 {a.slug}（上层 {parent}）")
    kind, kind_source, default_kind = orch_kinds(a.kind, parent)
    host = ORCH_HOSTS[kind]
    if not host["entry"].is_file():
        raise DroverError(f"{kind} 编排者要用 {host['entry_label']}，但 {host['entry']} 不存在："
                          f"先跑 drover 的 install.py --host {kind}")
    if parent:
        skill_args = f"--orch {a.slug} --parent {parent} {a.args or ''}".strip()
        template = ORCH_SUB_KICKOFF
    else:
        skill_args = f"--orch {a.slug} {a.args or ''}".strip()
        template = ORCH_KICKOFF
    kickoff = template.format(slug=a.slug, parent=parent, request=request, rollup=rollup, workspace=ORCH_CWD,
                              routing=ROUTING_FILE,
                              load_skill=host["load_skill"].format(skill_args=skill_args),
                              ask_tool=host["ask_tool"], host_notes=host["host_notes"]())
    if kind == "claude":
        agent_args = [*claude_model_args(a.effort), "--permission-mode", "acceptEdits",
                      "--name", f"orch-{a.slug}", "--add-dir", str(STATE_HOME)]
    else:
        # 模型不传就用 ~/.codex/config.toml 的默认；effort 和 codex worker 一样（codex_effort_args）。
        agent_args = [*CODEX_ORCH_ARGS, *codex_effort_args(a.effort)]

    ws_id, root_pane, created_tab = orch_workspace(a.dry_run)
    kinds = {"kind": kind, "kind_source": kind_source, "default_kind": default_kind}
    if a.dry_run:
        tab_step = (f"herdr tab rename <新 workspace 自带的 tab> {a.slug}" if created_tab else
                    f"herdr tab create --workspace {ws_id} --cwd {ORCH_CWD} --label {a.slug} --no-focus")
        return {"ok": True, "dry_run": True, "workspace_id": ws_id, **kinds, "kickoff": kickoff,
                "planned": [*created_tab, tab_step,
                            f"herdr agent start {a.name} --kind {kind} --pane <该 tab 的 pane> -- {shlex.join(agent_args)}",
                            prompt_plan(a.name, "<开场 prompt>")]}

    if root_pane:
        # 新建的 workspace 自带一个 tab，直接给第一个编排者用，改成任务的标签。
        pane_id = root_pane
        if created_tab:
            herdr(["tab", "rename", created_tab[0], a.slug], timeout=30)
        tab_id = created_tab[0] if created_tab else None
    else:
        ok, res = herdr(["tab", "create", "--workspace", ws_id, "--cwd", str(ORCH_CWD), "--label", a.slug,
                         "--no-focus"])
        if not ok:
            raise DroverError("herdr tab create 失败", error=res)
        pane_id = (res.get("root_pane") or {}).get("pane_id")
        tab_id = (res.get("tab") or {}).get("tab_id")
        if not pane_id:
            raise DroverError("herdr tab create 返回里缺 root_pane.pane_id", result=res)

    slug_dir.mkdir(parents=True, exist_ok=True)
    result = start_agent(a.name, kind, pane_id, agent_args, False)
    result.update({"workspace_id": ws_id, "tab_id": tab_id, "rollup_file": str(rollup), **kinds})
    stamp = time.strftime("%m-%d %H:%M")
    # orch-status 和 watch 靠它把编排者名、宿主和任务对上（resume 换人时覆盖成新的）；
    # default_kind 给 agent-start / brief（没写 --kind 的 worker 用主会话的宿主）和子编排者的 orch-start 用。
    (slug_dir / "orch.json").write_text(json.dumps(
        {"slug": a.slug, "name": a.name, "kind": kind, "default_kind": default_kind, "parent": parent,
         "workspace_id": ws_id, "tab_id": tab_id, "pane_id": pane_id, "started": stamp}, ensure_ascii=False, indent=2))
    if parent:
        # 关系记两边：子任务目录里的 parent.json（resume、history 用），上层状态文件里追加一行（上层追踪用）。
        (slug_dir / "parent.json").write_text(json.dumps(
            {"parent": parent, "name": a.name, "tab_id": tab_id, "pane_id": pane_id, "started": stamp},
            ensure_ascii=False, indent=2))
        parent_state = STATE_HOME / parent / "dispatch.md"
        text = parent_state.read_text()
        parent_state.write_text(text + ("" if text.endswith("\n") else "\n")
                                + f"- {stamp} 子编排者 {a.name}（任务 {a.slug}，tab {tab_id}，pane {pane_id}），"
                                  f"rollup：{rollup}\n")
        result["parent"] = parent
    # 时间线：派发（start）；--args 第一个词是 resume 时是换编排者（routing.md"需要换编排者"、意外退出都这样起），老任务没有派发
    # 那条就按 request.md / rollup.md 的修改时间补一条估计的。
    with timeline_session(slug_dir) as (events, new):
        if (a.args or "").split()[:1] == ["resume"]:
            if last_event(events, "start") is None:
                new.append(timeline_event("start", request_time(slug_dir) or time.time(), "orch-start", estimated=True))
            new.append(timeline_event("replace", time.time(), "orch-start", name=a.name, kind=kind))
        else:
            new.append(timeline_event("start", time.time(), "orch-start", name=a.name, kind=kind, parent=parent))
    if SLUG_RISKY_WORDS.search(a.slug):
        result["warning"] = ("slug 里有 import / include：编排者用 jq 读 <slug>/ 下的结果文件会被判成加载模块、弹强制审批。"
                             "下次换个词；这次编排者读验收结果用 drover accept-summary")
    if not result.get("ok"):
        return result
    sent = send_prompt(a.name, kickoff, PROMPT_TIMEOUT_MS)
    result["kickoff_sent"] = sent
    result["ok"] = sent["ok"]
    if not sent["ok"]:
        result["error"] = f"编排者已启动，但开场 prompt 的发送结果是 {sent['outcome']}：{sent.get('hint')}"
    return result


# "更新："是编排者手写的时间，现在只是展示、可以不写（模型手写的时间和真实时间可能差几十分钟）；带"更新："行的旧文件照样读，
# rollup_updated 原样返回。看板每个任务按这几行显示："标题："≤12 字中文（派发时主会话写在 request.md 里，编排者照抄），
# "摘要："≤20 字的当前状态（在等谁、等什么 / 正在做什么），"要你做："≤15 字（没有写"无"），"收尾："可以 / 先别，<原因>
# （见 rollup_wrapup），"提醒："可选，一句话。
ROLLUP_FIELD_RE = re.compile(r"^(状态|更新|上层|标题|摘要|要你做|收尾|提醒)[：:]\s*(.*?)\s*$", re.M)
# 主会话要处理的 rollup 状态，按前缀归类（真实 rollup 里有"完成（已收尾）"）。watch 的 rollup 事件、orch-status 的
# needs_attention、watch --main、board 共用（以前 orch-status 是全等匹配、watch 是前缀匹配，不一致）。
ROLLUP_ATTENTION = ("等你决定", "完成", "受阻", "需要换编排者")
# 主会话这边的记录，都在 ~/.drover/<slug>/ 下："转达过没有"以前只在主会话的上下文里，
# /clear、重挂 watch 之后就分不清；记到磁盘上，watch --main、board、orch-status 都按它判断。
MAIN_SEEN_FILE = "main-seen.json"  # 主会话用 drover rollup 读过的那一份：digest、status、规范化后的行、读的时间
ANSWERED_FILE = "answered.json"  # drover prompt 给编排者发过答复：at、当时 rollup 的 digest
MAIN_WATCH_FILE = "main-watch.json"  # watch --main 报过什么（去重），重挂不丢
# 编排者现在的状态（按屏幕修正后）从什么时候开始：herdr 不给状态开始的时间（agent get
# 只有 state_change_seq、revision），只能 drover 自己记。watch --main、board 每一轮都记，看板的"卡在确认框 N 分钟"按它算。
AGENT_STATE_FILE = "agent-state.json"
# 时间线：统计数据（总耗时、等你的次数和时长、卡在确认框多久……以后 drover stats 用），一个任务一个
# <slug>/TIMELINE_FILE，一行一个 JSON，只追加不改。drover 自己发起的事在那条命令里当场记：orch-start（派发 / 换编排者）、
# prompt（转答复、收尾请求）、看板点收尾、wrapup --draft（收尾汇总）、rollup 读到新内容。只能看到的由观察者（watch --main 每一轮、
# 看板每次读屏）补：显示状态变了、编排者每换一段状态、停了没更新。读-比-追加都拿 flock(TIMELINE_FILE)（只追加、不替换，可以直接
# 锁它），两个观察者同时跑也只记一次。没人观察的时段记在全局的 OBSERVE_GAPS_FILE，统计时知道那段数据不全。
TIMELINE_FILE = "timeline.jsonl"
WRAPUP_CLICKED_FILE = "wrapup-clicked.json"  # 看板上点过收尾：at、送的那句话；"收尾中"按它算
OBSERVE_FILE = STATE_HOME / "observe.json"  # 观察者最后一次看的时间（last）
OBSERVE_GAPS_FILE = STATE_HOME / "observe-gaps.jsonl"  # 没人观察的时段，一行 {from, to}
OBSERVE_LOCK = STATE_HOME / "locks" / "observe.lock"
OBSERVE_GAP_SECONDS = 60  # 观察者重新开始时距离上次超过这么久，记一条观察中断（watch --main 5 秒、看板 15 秒一轮）


def rollup_lines(text: str) -> list:
    """规范化后的行：每行去掉首尾空白，删掉空行。rollup 改没改、和上次读的差在哪，都按它比。"""
    return [line.strip() for line in text.splitlines() if line.strip()]


def lines_digest(lines: list) -> str:
    return hashlib.sha1("\n".join(lines).encode(errors="replace")).hexdigest()


def read_rollup(path: Path) -> Optional[dict]:
    """读 rollup.md：text、开头的字段 fields、status（"状态："去掉空白）、规范化后的 lines 和 digest、mtime（秒）；
    没有文件返回 None。
    改没改按 digest（规范化内容）判断，不按修改时间：编排者原样重写、只动了空白空行时，
    以前 watch 会再报一次"等你决定 / 完成"。修改时间只用来展示（rollup_mtime）和比"转过答复之后 rollup 更新没有"。"""
    try:
        text = path.read_text()
        mtime = path.stat().st_mtime
    except OSError:
        return None
    fields = {k: v for k, v in ROLLUP_FIELD_RE.findall(text[:600])}
    lines = rollup_lines(text)
    return {"text": text, "fields": fields, "status": re.sub(r"\s+", "", fields.get("状态") or ""),
            "lines": lines, "digest": lines_digest(lines), "mtime": mtime}


def clock(t: float, fmt: str = "%m-%d %H:%M:%S") -> str:
    return time.strftime(fmt, time.localtime(t))


def rollup_header(roll: Optional[dict]) -> dict:
    """rollup.md 开头的 状态 / 更新 / 上层 三个字段、摘要（见 rollup_summary）、文件修改时间；没有文件返回 {}。"""
    if roll is None:
        return {}
    fields = roll["fields"]
    return {"rollup_status": fields.get("状态"), "rollup_updated": fields.get("更新"), "rollup_parent": fields.get("上层"),
            "rollup_summary": rollup_summary(roll) or None, "rollup_mtime": clock(roll["mtime"])}


HEADING_RE = re.compile(r"^#{1,6}\s+(.*)$")


def rollup_section(lines: list, title: str) -> list:
    """规范化后的行里，标题以 title 开头的那一节（"## 需要你决定"）的内容，到下一个标题为止。"""
    out, inside = [], False
    for line in lines:
        m = HEADING_RE.match(line)
        if m:
            inside = m.group(1).startswith(title)
        elif inside:
            out.append(line)
    return out


def rollup_summary(roll: dict) -> str:
    """看板上的一句话摘要：rollup 的"摘要："；旧 rollup 没有这一行时按状态取——等你决定取"## 需要你决定"下第一行，
    进行中（和别的状态）取"## 当前进度"下最后一行，完成 / 受阻取"## 结论"下第一个不以"目标："开头的行；去掉开头的"- "。"""
    text = roll["fields"].get("摘要") or ""
    if not text:
        status, lines = roll["status"], roll["lines"]
        if status.startswith("等你决定"):
            picked = rollup_section(lines, "需要你决定")[:1]
        elif status.startswith(("完成", "受阻")):
            picked = [x for x in rollup_section(lines, "结论") if not x.startswith("目标：")][:1]
        else:
            picked = rollup_section(lines, "当前进度")[-1:]
        text = picked[0] if picked else ""
    return re.sub(r"^-\s+", "", text)


# 旧版看板让编排者在 rollup 写"## 交付"一节（一样交付一行
# "- <可以看|处理中|等你|提醒>：<项目> — <状态>"），看板按它分组。现在看板是一行一个任务的表格，不再读它，
# 格式里删掉了；还在用的旧 rollup 照样解析，只放进 --json 的 deliverables（没有这一节是空列表）。
DELIVERABLE_KINDS = {"可以看": "look", "处理中": "doing", "等你": "user", "提醒": "note"}
DELIVERABLE_RE = re.compile(r"^[-*]\s*(可以看|处理中|等你|提醒)\s*[：:]\s*(.*)$")
DELIVERABLE_SPLIT_RE = re.compile(r"\s+—{1,2}\s+")
# "要你做什么"在 rollup 没写"要你做："时（旧 rollup）：等你决定 / 受阻取"需要你决定"里的"答法："（dispatch.md 的格式要求最后给
# 一行答法）那一句，没有就按状态写一句用户要做的动作（以前退回逻辑把"等了 27 小时"放进了这一列）。
BOARD_ASK_FALLBACK = (("等你决定", "看转达，回你的决定"), ("受阻", "看转达，定下一步"))
ANSWER_RE = re.compile(r"^(?:[-*]\s*)?答法\s*[：:]\s*(.*)$")


def first_sentence(text: str) -> str:
    """到第一个"。"或"；"为止（不含）。"""
    return re.split(r"[。；]", text, maxsplit=1)[0].strip()


def rollup_ask(roll: dict) -> str:
    """等你决定 / 受阻的旧 rollup（没有"要你做："）的"要你做什么"："## 需要你决定"里"答法："那一行冒号后面的第一句；没有这一行
    按状态写一句通用的动作（BOARD_ASK_FALLBACK）。"""
    for line in rollup_section(roll["lines"], "需要你决定"):
        m = ANSWER_RE.match(line)
        if m and first_sentence(m.group(1)):
            return first_sentence(m.group(1))
    return next(text for prefix, text in BOARD_ASK_FALLBACK if roll["status"].startswith(prefix))


def rollup_deliverables(roll: Optional[dict]) -> list:
    """旧 rollup 的"## 交付"一节（--json 的 deliverables）：[{"kind": look|doing|user|note, "item", "status"}]，开头不是那四种的行
    不认，"提醒："整句放 status；没有这一节、没有 rollup 是 []。"""
    out = []
    for line in rollup_section(roll["lines"], "交付") if roll else []:
        m = DELIVERABLE_RE.match(line)
        if not m:
            continue
        kind, text = DELIVERABLE_KINDS[m.group(1)], m.group(2).strip()
        item, status = ("", text) if kind == "note" else (DELIVERABLE_SPLIT_RE.split(text, 1) + [""])[:2]
        out.append({"kind": kind, "item": item.strip(), "status": status.strip()})
    return out


def rollup_wrapup(roll: Optional[dict]) -> tuple[bool, Optional[str], bool]:
    """(能不能收尾, 不能的原因, 编排者写没写)。按 rollup 的"收尾："：以"可以"开头能；别的（"先别，<原因>"）不能，原因取"先别"
    后面那段。没写这一行时，状态是完成就算能，别的状态不能（原因"还没完成"）。编排者最清楚能不能收（比如有没推的改动），
    一键收尾靠它挡住不该收的；收尾本身没推送过的分支也不删、先问（dispatch.md 第 9 节）。"""
    value = (roll["fields"].get("收尾") or "").strip() if roll else ""
    if value:
        return (True, None, True) if value.startswith("可以") else (False, re.sub(r"^先别[，,：:\s]*", "", value) or value, True)
    return (True, None, False) if roll and roll["status"].startswith("完成") else (False, "还没完成", False)


def rollup_flags(slug_dir: Path, roll: Optional[dict]) -> tuple[bool, Optional[float]]:
    """(unread, answered_at)。unread：状态要主会话处理，内容又和主会话用 drover rollup 读过的（main-seen.json）不同；
    answered_at：drover prompt 给编排者发过答复（answered.json）、时间晚于 rollup 的修改时间时是那个时间（转过答复、
    rollup 还没更新），否则 None。"""
    if roll is None:
        return False, None
    seen = read_json_dict(slug_dir / MAIN_SEEN_FILE)
    answered_at = as_float(read_json_dict(slug_dir / ANSWERED_FILE).get("at"))
    unread = roll["status"].startswith(ROLLUP_ATTENTION) and roll["digest"] != seen.get("digest")
    return unread, answered_at if answered_at and answered_at > roll["mtime"] else None


def closed_after_done(agent_status: str, rollup_status: str) -> bool:
    """编排者已经退出、rollup 又是完成的：收尾完关掉了（用户状态目录里几十个历史任务都是这样）。watch --main 不盯，
    看板不显示，orch-status 的 needs_attention 不算。"""
    return agent_status == "gone" and rollup_status.startswith("完成")


def write_json_atomic(path: Path, obj: dict) -> None:
    """先写同目录的临时文件再改名：watch --main、board、主会话同时读写时不会读到半截。"""
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(obj, ensure_ascii=False, indent=2))
    os.replace(tmp, path)


# ---------------------------------------------------------------- 时间线（TIMELINE_FILE 上面的说明）

def timeline_read(d: Path) -> list:
    """<d>/timeline.jsonl 的全部事件，按文件里的顺序；没有文件是 []，坏行跳过。"""
    return read_jsonl(d / TIMELINE_FILE)


def timeline_event(event: str, at: float, source: str, **fields: Any) -> dict:
    """时间线的一条：at 是事情发生的时间，logged 是写下的时间（观察者按 rollup 修改时间补记的，两者可以差很久）；source 是谁记的
    （命令名，或者观察者 watch-main / board）。"""
    return {"at": round(at, 3), "logged": round(time.time(), 3), "event": event, "source": source, **fields}


@contextlib.contextmanager
def timeline_session(d: Path):
    """拿着 flock(timeline.jsonl) 读-比-追加：yield (已有的事件, 要追加的列表)，退出时把列表里的追加上去。文件只追加、不替换，
    所以直接锁它（agent-state.json 是 os.replace 换的，锁不住）。写不了（目录只读）不影响调用方。"""
    new: list = []
    with flock_file(d / TIMELINE_FILE, None):
        yield timeline_read(d), new
        if new:
            with contextlib.suppress(OSError), open(d / TIMELINE_FILE, "a") as fh:
                fh.write("".join(json.dumps(e, ensure_ascii=False) + "\n" for e in new))


def timeline_note(d: Path, event: str, source: str, **fields: Any) -> None:
    """命令当场记一条现在发生的事。"""
    with timeline_session(d) as (_, new):
        new.append(timeline_event(event, time.time(), source, **fields))


def last_event(events: list, kind: str) -> Optional[dict]:
    return next((e for e in reversed(events) if e.get("event") == kind), None)


def request_time(d: Path) -> Optional[float]:
    """没有时间线的老任务估派发时间：request.md（主会话派发时写）和 rollup.md 修改时间里早的那个（编排者写 rollup 一定在
    派发之后，request.md 后来被改过时不会估到 rollup 后面去），都没有就是 orch.json 的。"""
    found = []
    for name in ("request.md", "rollup.md"):
        with contextlib.suppress(OSError):
            found.append((d / name).stat().st_mtime)
    if not found:
        with contextlib.suppress(OSError):
            found.append((d / "orch.json").stat().st_mtime)
    return min(found) if found else None


# 看板的显示状态（分组、"状态持续"都按它）：rollup 的状态，加上一个 drover 自己知道的"已转答复"——等你决定 / 受阻时
# drover prompt 转过答复、rollup 还没更新（rollup_flags 的 answered_at）。没有 rollup 的算进行中。
def display_state(roll: Optional[dict], answered_at: Optional[float]) -> str:
    status = roll["status"] if roll else ""
    if status.startswith(("等你决定", "受阻")):
        return "已转答复" if answered_at is not None else "等你决定" if status.startswith("等你决定") else "受阻"
    return next((s for s in ("完成", "需要换编排者") if status.startswith(s)), "进行中")


def timeline_state(d: Path, events: list, roll: Optional[dict], answered_at: Optional[float],
                   source: str) -> tuple[dict, list]:
    """按时间线和现在的文件算：({state, since, start_at}, 观察者要补记的事件)。
    state 是显示状态；和时间线最后一条 state 一样时 since 取那条的 at，不一样（变了还没人记下）时取这次变化的时间：已转答复是
    转答复的时间，有 rollup 是它的修改时间（编排者直接写文件，不经 drover 命令；晚看到也准），都没有是派发时间。
    没有派发那条（start）的（这套记录装上之前派发的老任务）按 request_time 补一条，第一次补的 state 也标 estimated：之前改过
    几次状态不知道，只知道最后一次。start_at 是最近一次派发（换编排者是 replace，不算派发）。"""
    new = []
    start = last_event(events, "start")
    if start is None:
        start = timeline_event("start", request_time(d) or time.time(), source, estimated=True)
        new.append(start)
    start_at = as_float(start.get("at"))
    state = display_state(roll, answered_at)
    last = last_event(events, "state")
    since = as_float(last.get("at")) if last and last.get("state") == state else None
    if since is None:
        since = answered_at if state == "已转答复" else roll["mtime"] if roll else start_at
        mark = {"estimated": True} if last is None and start.get("estimated") else {}
        new.append(timeline_event("state", since, source, state=state, status=roll["status"] if roll else None, **mark))
    return {"state": state, "since": since, "start_at": start_at}, new


def timeline_stalled(d: Path, events: list, info: dict, now: float, source: str) -> Optional[dict]:
    """停了没更新（同 watch --main 报的 stalled，但按两个观察者共享的记录算，只开看板也记得到）：编排者现在是 done / idle
    （agent-state.json，note_agent_state 记的），显示状态是进行中或已转答复；起点取这两段开始的时间里晚的那个，满
    MAIN_IDLE_MINUTES 记一条（at 是看到的时间，since 是起点），按起点去重。"""
    agent = read_json_dict(d / AGENT_STATE_FILE)
    agent_since = as_float(agent.get("since"))
    if info["state"] not in ("进行中", "已转答复") or agent.get("shown") not in ("done", "idle") or agent_since is None:
        return None
    start = round(max(agent_since, info["since"] or agent_since), 3)
    if now - start < MAIN_IDLE_MINUTES * 60 or any(e.get("event") == "stalled" and e.get("since") == start for e in events):
        return None
    return timeline_event("stalled", now, source, since=start)


def timeline_observe(task: dict, now: float, source: str) -> tuple[Optional[dict], dict]:
    """观察者（watch --main 每一轮、看板每次读屏）对一个任务补记：显示状态的变化（timeline_state）、停了没更新。在时间线锁里
    重新读 rollup 和 answered.json，不用调用方在锁外读的那份：两边一前一后读到新旧两版时，后拿到锁的会把旧状态再记一遍。
    返回 (这次读到的 rollup, timeline_state 的结果)。"""
    d = task["dir"]
    with timeline_session(d) as (events, new):
        roll = read_rollup(d / "rollup.md")
        info, pending = timeline_state(d, events, roll, rollup_flags(d, roll)[1], source)
        stalled = timeline_stalled(d, events + pending, info, now, source)
        new += pending + ([stalled] if stalled else [])
    return roll, info


def timeline_view(d: Path, roll: Optional[dict]) -> dict:
    """不记、只算（board --line / --pending：不读屏、不写文件）：结果和观察者这时会记下的一致。"""
    return timeline_state(d, timeline_read(d), roll, rollup_flags(d, roll)[1], "board")[0]


def note_observed(now: float) -> None:
    """观察者每一轮记一下最后一次看的时间（全局 OBSERVE_FILE）；离上次超过 OBSERVE_GAP_SECONDS 时往 OBSERVE_GAPS_FILE 追加
    {from, to}：这段时间没人看，时间线里的确认框、接口错误记不到，状态中间改过几次的只剩最后一次。两个观察者拿同一把锁。"""
    with contextlib.suppress(OSError), flock_file(OBSERVE_LOCK, None):
        last = as_float(read_json_dict(OBSERVE_FILE).get("last"))
        if last is not None and now - last > OBSERVE_GAP_SECONDS:
            with open(OBSERVE_GAPS_FILE, "a") as fh:
                fh.write(json.dumps({"from": round(last, 3), "to": round(now, 3)}) + "\n")
        if last is None or now > last:
            write_json_atomic(OBSERVE_FILE, {"last": round(now, 3)})

def cmd_orch_status(a: argparse.Namespace) -> dict:
    """列出编排者：herdr 里的状态 + rollup 的状态行。给主会话一条命令看全部（Codex 没有 Monitor，每轮开头查一次）。
    herdr 报 working / done / idle 的编排者读一次屏幕，按 watch 的规则（screen_override）修正：和 herdr 的原值不同时写进
    screen_status（agent_status 保留 herdr 的原值，needs_attention 仍按原值判断）。卡在确认框上的编排者（herdr 报 blocked，
    或者屏幕修正成 blocked：后台子 agent 的确认框会被 herdr 报成 working）列进顶层 blocked（slug、name），没有就不出这个键。
    读屏失败按原值；codex 编排者 working 时不读（screen_override 只在 Claude Code 上认 working 时的弹框）。
    每行带 rollup_summary、unread、answered_after_rollup（见 rollup_flags）；needs_attention 只算
    未读的（主会话用 drover rollup 读过就不算），以前只看状态，--all 会列出几十个早就转达过的"完成"。"""
    ok, res = herdr(["agent", "list"], timeout=30)
    if not ok:
        raise DroverError("herdr agent list 失败", error=res)
    alive = {x.get("name"): x for x in res.get("agents", []) if x.get("name")}
    rows, seen = [], set()
    for meta_file in sorted(STATE_HOME.glob("*/orch.json")):
        try:
            meta = json.loads(meta_file.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        name = meta.get("name")
        seen.add(name)
        agent = alive.get(name)
        if meta.get("parent") and not a.with_sub:
            continue
        if agent is None and not a.all:
            continue
        status = agent.get("agent_status") if agent else "gone"
        roll = read_rollup(meta_file.parent / "rollup.md")
        unread, answered_at = rollup_flags(meta_file.parent, roll)
        row = {"slug": meta.get("slug") or meta_file.parent.name, "name": name, "kind": meta.get("kind"),
               "parent": meta.get("parent"), "agent_status": status, **rollup_header(roll),
               "unread": unread, "answered_after_rollup": answered_at is not None}
        fixed = corrected_status(name, status, (agent or {}).get("agent") or meta.get("kind"))
        if fixed:
            row["screen_status"] = fixed
        rows.append(row)
    # 活着、名字是 orch- 开头、却没有对应 orch.json 的（不是 orch-start 起的，或 orch.json 被删了）：照样列出来，
    # slug 要自己对（tab 标签就是 slug）。
    unmatched = [{"name": n, "agent_status": x.get("agent_status"), "tab_id": x.get("tab_id")}
                 for n, x in alive.items() if n.startswith("orch-") and n not in seen]
    result = {"ok": True, "orchestrators": rows}
    if unmatched:
        result["without_orch_json"] = unmatched
    blocked = [{"slug": r["slug"], "name": r["name"]} for r in rows
               if "blocked" in (r["agent_status"], r.get("screen_status"))]
    if blocked:
        result["blocked"] = blocked
    # unread 已经按前缀要求状态要处理；编排者已经退出、又是完成的（收尾完关掉了）不算。
    attention = [r["slug"] for r in rows if r["unread"] and r["agent_status"] in ("done", "idle", "gone")
                 and not closed_after_done(r["agent_status"], r.get("rollup_status") or "")]
    result["needs_attention"] = attention
    return result


# ---------------------------------------------------------------- main-register

# 主会话在 herdr 里的 agent 名（和 herdr-oncall 插件的约定）：插件按这个名字认主会话，只给主会话推确认框和 done，
# 不引用的飞书消息也送进它。herdr 的名字跟着 pane 里当前的 agent 走，退出重开、/clear 都会被清掉（实测），
# 所以 install.py 在 Claude Code 的 SessionStart hook 里每次都跑 main-register --hook，路由规则"会话刚开始"那一步兜底。
# Codex 不装 hook：codex 的 SessionStart 第一条消息时才跑（和路由规则同一时刻），新 hook 还要用户手动信任，
# 信任之前所有 codex 会话（含 drover 起的编排者、worker）启动都会卡在"Hooks need review"上。
MAIN_AGENT_NAME = "drover"
# --hook 等 herdr 换上这次 session 的上限和间隔（秒）。SessionStart 刚跑时，手动起的会话 herdr 里还没有（agent_not_found）；
# /clear 时 herdr 里还是旧 session、旧名字，0.5～2 秒后才换成新 session 并清掉名字（探针实测）。所以先等
# agent_session 对上 hook 输入的 session_id 再判断，不然会把马上要被清掉的旧名字当成"已经登记过"。
# 环境变量 DROVER_MAIN_REGISTER_WAIT 给自测缩短用。
MAIN_REGISTER_WAIT = float(os.environ.get("DROVER_MAIN_REGISTER_WAIT") or 8)
MAIN_REGISTER_POLL = 0.5
MAIN_REGISTER_HERDR_TIMEOUT = 5


def hook_input() -> dict:
    """hook 从 stdin 收到的 JSON（session_id、cwd、source…）；stdin 是终端、读不出或不是 JSON 对象时是 {}。"""
    try:
        if sys.stdin is None or sys.stdin.isatty():
            return {}
        data = json.loads(sys.stdin.read() or "{}")
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def pane_agent(pane: str) -> Optional[dict]:
    """herdr 里这个 pane 当前的 agent（agent get 的 result.agent）；pane 里没有 agent 时 None。名字只有这里和 agent list 有，
    pane get / pane current 都不带 name。"""
    ok, res = herdr(["agent", "get", pane], timeout=MAIN_REGISTER_HERDR_TIMEOUT)
    agent = res.get("agent") if ok else None
    return agent if isinstance(agent, dict) else None


def wait_pane_agent(pane: str, session_id: Optional[str]) -> tuple[Optional[dict], bool]:
    """等 herdr 里这个 pane 的 agent_session 变成 session_id（没给 session_id 时只查一次）。返回 (agent, 是否对上)。
    到了上限还没对上，就按当时的样子返回：没装 herdr 的状态 hook 时 herdr 根本拿不到 session，只能这样判断。"""
    deadline = time.time() + (MAIN_REGISTER_WAIT if session_id else 0)
    while True:
        agent = pane_agent(pane)
        if not session_id:
            return agent, False
        if agent and (agent.get("agent_session") or {}).get("value") == session_id:
            return agent, True
        if time.time() >= deadline:
            return agent, False
        time.sleep(MAIN_REGISTER_POLL)


def workspace_label(workspace_id: str) -> Optional[str]:
    ok, res = herdr(["workspace", "list"], timeout=MAIN_REGISTER_HERDR_TIMEOUT)
    if not ok:
        raise DroverError("herdr workspace list 失败", error=res)
    for ws in res.get("workspaces", []):
        if ws.get("workspace_id") == workspace_id:
            return ws.get("label")
    return None


def check_not_orch(workspace_id: Optional[str]) -> None:
    """编排者的工作目录也是主工作台，名字被清掉后（比如 /clear）它也像一个"没名字的主会话"：在 orch workspace 里一律不登记。"""
    if workspace_id and workspace_label(workspace_id) == ORCH_WORKSPACE_LABEL:
        raise DroverError(f"这个 pane 在编排者的 {ORCH_WORKSPACE_LABEL} workspace 里（{workspace_id}），不是主会话，不登记",
                          reason="orch_workspace", workspace_id=workspace_id)


def main_register(hook: bool, info: dict) -> dict:
    """把当前 pane 的 agent 改名为 drover。拒绝时抛 DroverError（reason 说明是哪种情况）。
    --hook 额外要求工作目录就是主工作台，并且先等 herdr 换上 hook 输入里的那个 session。"""
    pane = os.environ.get("HERDR_PANE_ID")
    if os.environ.get("HERDR_ENV") != "1" or not pane:
        raise DroverError("不在 Herdr 的 pane 里（HERDR_ENV 不是 1 或没有 HERDR_PANE_ID）：主会话要在 Herdr 里打开才能登记",
                          reason="not_in_herdr")
    if hook:
        # 本机每个 Claude Code 会话（worker、编排者、别处开的）都会跑这个 hook：先做不调 herdr 的检查，绝大多数到这里就结束。
        if TRUSTED_ROOT is None:
            raise DroverError(NO_WORKSPACE_ERROR, reason="no_workspace")
        cwd = str(info.get("cwd") or os.getcwd())
        if os.path.realpath(cwd) != os.path.realpath(str(TRUSTED_ROOT)):
            raise DroverError(f"工作目录 {cwd} 不是主工作台 {TRUSTED_ROOT}，不是主会话", reason="not_workspace")
    env_ws = os.environ.get("HERDR_WORKSPACE_ID")
    check_not_orch(env_ws)
    # 认出是主会话之后：记下"载入时"的规则、触发自动更新检查（main_session_seen）。hook 里越早越好：下面等 herdr 换 session
    # 最多 MAIN_REGISTER_WAIT 秒，这段时间里别处触发的自动更新要是改了 AGENTS.md，记下的就成了会话没载入过的新版本。
    # herdr 给每个 pane 都注入 HERDR_WORKSPACE_ID；没有时要等拿到 agent、按它的 workspace 排除编排者之后才记。
    early = hook and bool(env_ws)
    if early:
        main_session_seen(True)
    session_id = info.get("session_id") if hook and isinstance(info.get("session_id"), str) else None
    agent, matched = wait_pane_agent(pane, session_id)
    if agent is None:
        raise DroverError(f"herdr 里 pane {pane} 现在没有 agent（herdr 还没认出这个会话）：等会话起来后再跑一次",
                          reason="no_agent", pane_id=pane)
    if not env_ws:
        check_not_orch(agent.get("workspace_id"))
    # 不带 --hook 的：Codex 主会话没有 hook，第一条消息时的这一次就是它载入 AGENTS.md 之后最早的时机，要记规则、记 session；
    # Claude Code 主会话的这一次只是兜底登记（hook 已经在会话开始时记过），再记会把"载入时"盖成之后的版本、session_id 盖成 null。
    # main-session.json 例外：记的不是这个 pane 时（hook 没登记上）照样补写，见 record_main_session。
    records = hook or agent.get("agent") == "codex"
    if not early:
        main_session_seen(records)
    base = {"pane_id": pane, "name": MAIN_AGENT_NAME, **({"session_matched": matched} if session_id else {})}
    current = agent.get("name")
    if current == MAIN_AGENT_NAME:
        record_main_session(pane, session_id, info, records)
        return {"ok": True, "action": "already", **base}
    if current:
        raise DroverError(f"这个 pane 的 agent 已经叫 {current}，不改名：main-register 只给还没有名字的主会话登记",
                          reason="named", current_name=current, pane_id=pane)
    ok, res = herdr(["agent", "list"], timeout=MAIN_REGISTER_HERDR_TIMEOUT)
    if not ok:
        raise DroverError("herdr agent list 失败", error=res)
    taken = [x.get("pane_id") for x in res.get("agents", [])
             if x.get("name") == MAIN_AGENT_NAME and x.get("pane_id") != pane]
    if taken:
        raise DroverError(f"已经有一个主会话登记成 {MAIN_AGENT_NAME} 了（pane {taken[0]}），这个会话不登记："
                          "飞书里不引用直接发的消息会送到那一个。要换成这个，先关掉那个会话再跑一次 main-register",
                          reason="conflict", conflict_pane=taken[0], pane_id=pane)
    ok, res = herdr(["agent", "rename", pane, MAIN_AGENT_NAME], timeout=MAIN_REGISTER_HERDR_TIMEOUT)
    if not ok:
        raise DroverError("herdr agent rename 失败", error=res, pane_id=pane)
    record_main_session(pane, session_id, info, records)
    return {"ok": True, "action": "renamed", **base}


def record_main_session(pane: str, session_id: Optional[str], info: dict, records: bool) -> None:
    """登记上了（改名成功，或者本来就叫 drover）：写 MAIN_SESSION_FILE。rules --hook 按 session_id 认主会话，watch --main
    按它变没变、source 是不是 clear / startup 认出 /clear 之后的新对话，drover rollup 按 pane_id 认主会话（main_caller）。
    Codex（不带 --hook）没有 session_id、source，写 null。写不了（沙箱）不影响登记。
    records 为 False（Claude Code 不带 --hook 的兜底登记）时只在记录不是这个 pane 时写，session_id、source 写 null：
    hook 没登记上（等 herdr 超时）时记录还停在上一个会话，换了 pane 时 drover rollup 就一直认不出主会话。旧的 session_id
    本来就不是这个会话的，写 null 不会让 rules --hook 误认（它要求 session_id 相等），也不会让 watch --main 误报重开
    （source 不是 clear / startup）。同一个 pane 时不动，hook 记的 session_id 留着。"""
    if not records and read_json_dict(MAIN_SESSION_FILE).get("pane_id") == pane:
        return
    source = info.get("source") if isinstance(info.get("source"), str) else None
    with contextlib.suppress(OSError):
        write_json_atomic(MAIN_SESSION_FILE, {"session_id": session_id, "pane_id": pane, "source": source,
                                              "at": time.time()})


def main_session_seen(record_rules: bool) -> None:
    """main-register 认出了主会话：record_rules 时先记下"载入时"的规则（main-rules.json），再触发自动更新检查。顺序不能反：
    自动更新会改 AGENTS.md。两样都不能让登记失败（tick 自己不抛异常）。"""
    if record_rules:
        with contextlib.suppress(OSError):
            record_main_rules("main-register")
    auto_update_tick()


def cmd_main_register(a: argparse.Namespace) -> dict:
    return main_register(False, {})


def cmd_main_register_hook(a: argparse.Namespace) -> int:
    """SessionStart hook 用：不管成败退出码都是 0，stdout 什么都不写（Claude Code 会把 SessionStart hook 的 stdout
    塞进会话上下文），不打扰会话。为什么没登记上，手动跑一次不带 --hook 的 main-register 就能看到原因。"""
    try:
        main_register(True, hook_input())
    except BaseException:  # noqa: BLE001 —— hook 里任何失败（含 herdr 超时、找不到命令、Ctrl-C）都只能静默放过
        pass
    return 0


# ---------------------------------------------------------------- oncall（内置的 herdr-oncall 插件）

# 和 install.py 一致（tests/test_install.py 断言两边相同）：插件 id、带按角色通知的最低版本、drover 写给插件的 drover.env。
ONCALL_PLUGIN_ID = "com.codreamer.herdr.oncall"
ONCALL_MIN_VERSION = "0.7.0"
ONCALL_ENV_NAME = "drover.env"
ONCALL_ENV_TEXT = """\
# 由 drover 的 install.py 写入：重装时整份覆盖，卸载时删除。
# 要改某一项，写到同目录的 .env 里（.env 优先），不要改这个文件。
MAIN_AGENT_NAME=drover
SUPERVISOR_PREFIX=orch-
SUPERVISOR_ESCALATE_SEC=300
SUPERVISOR_ESCALATE_SEC_CODEX=120
SUPERVISED_ESCALATE_SEC=600
BARE_MESSAGE_TARGET=main
MAIN_DONE_PING=relay
MAIN_RELAY_MARKER=【转达】
CHAT_IMAGE_DIR=~/.drover/oncall-images
"""
# drover oncall <动作> → 插件 action id（contract.md 第 6 节）。status 不走 action：action invoke 立即返回、不带输出。
ONCALL_ACTIONS = {"pair": "pair-feishu", "unpair": "unpair-feishu", "test": "test", "on": "enable", "off": "disable"}
ONCALL_STATUS_SCRIPT = "src/actions/status.mjs"
ONCALL_LOG_HINT = f"herdr plugin log list --plugin {ONCALL_PLUGIN_ID} --limit 5"
# 透传插件的输出前，键名像密钥的字符串值一律换掉（插件约定只报有没有，这里再挡一道）。
SECRET_KEY_RE = re.compile(r"(?i)(token|secret|open_?id|chat_?id)")
# 插件的 pair-feishu 把配对链接打印成一行 "open: <url>"（插件 src/actions/pair-feishu.mjs）；已配对时打印的那行带 open_id，不给人看。
PAIR_LINK_RE = re.compile(r"^\s*open:\s*(\S+)", re.M)
SECRETISH_LINE_RE = re.compile(r"(?i)(open_?id|secret|token)")
# 插件说"已经配对过"的两种写法（英文那行带 app / open_id，中文那行带机器人 id）。
PAIRED_WORDS = ("already paired", "已经配对过飞书")
# 等插件日志里这次 action 跑完（已配对的机器先向飞书核对，真机 22 秒）、等飞书配对上时查 status 的间隔（秒）。
# 环境变量给自测缩短用。
ONCALL_LOG_WAIT = float(os.environ.get("DROVER_PAIR_LOG_WAIT") or 45)
ONCALL_PAIR_POLL = float(os.environ.get("DROVER_PAIR_POLL") or 3)


def version_tuple(value: Any) -> tuple:
    return tuple(int(x) for x in re.findall(r"\d+", str(value or ""))[:3]) or (0,)


def redact(obj: Any) -> Any:
    if isinstance(obj, dict):
        return {k: ("<redacted>" if isinstance(v, str) and SECRET_KEY_RE.search(str(k)) else redact(v))
                for k, v in obj.items()}
    if isinstance(obj, list):
        return [redact(v) for v in obj]
    return obj


def oncall_plugin() -> Optional[dict]:
    ok, res = herdr(["plugin", "list", "--json", "--plugin", ONCALL_PLUGIN_ID], timeout=30)
    if not ok:
        raise DroverError("herdr plugin list 失败（herdr 没在运行时，先在终端里运行 herdr）", error=res)
    return next((p for p in res.get("plugins", []) if p.get("plugin_id") == ONCALL_PLUGIN_ID), None)


def require_oncall_plugin() -> dict:
    plugin = oncall_plugin()
    if plugin is None:
        raise DroverError("没装飞书 oncall（herdr-oncall 插件，选装）：在 drover 的 clone 里重跑 python3 install.py --oncall，"
                          "它会从 GitHub 装好插件",
                          plugin_id=ONCALL_PLUGIN_ID)
    return plugin


def oncall_env_view() -> dict:
    """drover.env 在不在、内容是不是 drover 现在要写的。插件装着时 config-dir 目录本来就在（这条命令会建目录）。"""
    p = run(["herdr", "plugin", "config-dir", ONCALL_PLUGIN_ID], timeout=30)
    folder = p.stdout.strip() if p.returncode == 0 else ""
    if not folder:
        return {"path": None, "present": False, "error": tail(p.stderr or p.stdout, 300)}
    path = Path(folder) / ONCALL_ENV_NAME
    try:
        text = path.read_text()
    except OSError:
        return {"path": str(path), "present": False, "up_to_date": False}
    return {"path": str(path), "present": True, "up_to_date": text == ONCALL_ENV_TEXT}


def main_agent_view() -> dict:
    ok, res = herdr(["agent", "list"], timeout=30)
    if not ok:
        return {"registered": None, "error": res}
    found = next((x for x in res.get("agents", []) if x.get("name") == MAIN_AGENT_NAME), None)
    if not found:
        return {"registered": False}
    return {"registered": True, "pane_id": found.get("pane_id"), "agent": found.get("agent")}


def oncall_hints(plugin: dict, view: dict, status: Optional[dict]) -> list:
    hints = []
    source = (plugin.get("source") or {}).get("kind")
    if not view["plugin"]["version_ok"]:
        hints.append(f"插件版本 {plugin.get('version')} 低于 {ONCALL_MIN_VERSION}，还没有按角色通知：" +
                     (f"本地链接的插件，到 {plugin.get('plugin_root')} 里 git pull" if source == "local"
                      else "重跑 python3 install.py 会更新它"))
    if plugin.get("enabled") is False:
        hints.append(f"插件在 herdr 里被禁用了：herdr plugin enable {ONCALL_PLUGIN_ID}")
    env = view["drover_env"]
    if not env.get("present"):
        hints.append("drover.env 不在：插件按单独使用时的规则通知（不分角色），重跑 python3 install.py 补上")
    elif not env.get("up_to_date"):
        hints.append("drover.env 和这版 drover 要写的不一样：重跑 python3 install.py 刷新")
    if view["main_agent"].get("registered") is False:
        hints.append("主会话还没登记（herdr 里没有叫 drover 的 agent）：在主会话里跑 ~/.drover/bin/drover main-register")
    if status:
        if status.get("enabled") is False:
            hints.append("插件自己的开关关着（不推送也不收飞书消息）：drover oncall on")
        feishu = (status.get("channels") or {}).get("feishu") or {}
        if feishu.get("paired") is False:
            hints.append("飞书还没配对：drover oncall pair（Mac 桌面会弹二维码；没弹就用飞书打开它给的链接）")
        elif feishu.get("replies_supported") is False:
            hints.append("Node 低于 22：能收到推送，但飞书里的回复送不回来，升级 Node 到 22+")
    return hints


def run_status_script(plugin: dict) -> tuple[Optional[dict], Optional[str]]:
    """跑插件的 status 脚本（contract 第 5 节）。返回 (status JSON, 出错原因)；太旧没有脚本时原因里说怎么办。"""
    root = plugin.get("plugin_root") or ""
    source = (plugin.get("source") or {}).get("kind")
    if not root or not (Path(root) / ONCALL_STATUS_SCRIPT).is_file():
        how = (f"本地链接的插件，到 {root} 里 git pull" if source == "local" else "重跑 python3 install.py 会更新它")
        return None, (f"插件 {plugin.get('version')} 太旧，没有 status 脚本（{ONCALL_STATUS_SCRIPT}，"
                      f"{ONCALL_MIN_VERSION} 起才有）：{how}")
    p = run(["/bin/bash", str(Path(root) / "bin" / "run-node.sh"), ONCALL_STATUS_SCRIPT], cwd=root, timeout=30)
    lines = [line for line in (p.stdout or "").splitlines() if line.strip()]
    status = None
    if p.returncode == 0 and lines:
        with contextlib.suppress(ValueError):
            status = json.loads(lines[-1])
    if not isinstance(status, dict):
        return None, f"插件的 status 脚本没给出 JSON（退出码 {p.returncode}）：{tail(p.stderr, 300)}"
    return status, None


def feishu_paired(status: Optional[dict]) -> Optional[bool]:
    paired = (((status or {}).get("channels") or {}).get("feishu") or {}).get("paired")
    return paired if isinstance(paired, bool) else None


def oncall_status(plugin: dict) -> dict:
    root = plugin.get("plugin_root") or ""
    view = {
        "plugin": {"version": plugin.get("version"), "min_version": ONCALL_MIN_VERSION,
                   "version_ok": version_tuple(plugin.get("version")) >= version_tuple(ONCALL_MIN_VERSION),
                   "source": (plugin.get("source") or {}).get("kind"), "herdr_enabled": plugin.get("enabled"),
                   "plugin_root": root},
        "drover_env": oncall_env_view(),
        "main_agent": main_agent_view(),
    }
    status, error = run_status_script(plugin)
    if status is None:
        return {"ok": False, "drover": view, "hints": oncall_hints(plugin, view, None), "error": error}
    status = redact(status)
    # drover 只引导飞书：没配过的 Telegram 不报（用户自己配过的照报）。
    channels = status.get("channels")
    if isinstance(channels, dict) and isinstance(channels.get("telegram"), dict) \
            and channels["telegram"].get("paired") is not True:
        channels.pop("telegram")
    return {"ok": True, "plugin_status": status, "drover": view, "hints": oncall_hints(plugin, view, status)}


def is_action_log(entry: dict, action_id: str) -> bool:
    """herdr plugin log list 里这条是不是这个 action 跑出来的（不是它在后台起的等待进程）。"""
    if entry.get("action") == action_id or entry.get("action_id") == action_id:
        return True
    cmd = [str(c) for c in entry.get("command") or []]
    return any(c.endswith(f"src/actions/{action_id}.mjs") for c in cmd) and "wait" not in cmd


def action_finished(entry: dict) -> bool:
    """herdr 先记一条 status: running、没有 stdout / stderr / exit_code / finished_unix_ms 的条目，动作跑完才把输出写进去。"""
    return entry.get("status") not in (None, "running") or "finished_unix_ms" in entry or "exit_code" in entry


def action_log(action_id: str, since: float) -> tuple[Optional[dict], bool]:
    """等插件把这次 action 的输出记进 herdr 的插件日志（action invoke 立即返回，输出只在日志里），返回 (条目, 跑完没有)。
    要等条目跑完才有输出：已配对的机器先向飞书核对凭据、再给机器人发消息，真机实测 22 秒。最多等 ONCALL_LOG_WAIT 秒
    （默认 45）；stdout 里已经有 open: 就提前返回（herdr 现在不会中途给 stdout，写成兼容的）。since 是调用前的时间，
    早于它（再留 2 秒余量）的不算。等的时候往 stderr 打一句进度，stdout 只留最后的 JSON。"""
    since_ms = int(since * 1000) - 2000
    deadline = time.time() + ONCALL_LOG_WAIT
    latest, told = None, False
    while True:
        ok, res = herdr(["plugin", "log", "list", "--plugin", ONCALL_PLUGIN_ID, "--limit", "20"], timeout=30)
        hits = [x for x in (res.get("logs") or [] if ok else []) if isinstance(x, dict) and is_action_log(x, action_id)
                and (x.get("started_unix_ms") or 0) >= since_ms]
        if hits:
            latest = max(hits, key=lambda x: x.get("started_unix_ms") or 0)
            if action_finished(latest) or PAIR_LINK_RE.search(latest.get("stdout") or ""):
                return latest, action_finished(latest)
        if time.time() >= deadline:
            return latest, False
        if not told:
            print(f"等插件跑完 {action_id}（已配对的机器要先向飞书核对，可能要二三十秒；最多等 {int(ONCALL_LOG_WAIT)} 秒）……",
                  file=sys.stderr, flush=True)
            told = True
        time.sleep(0.5)


def safe_lines(*texts: str, limit: int = 3) -> list:
    """插件输出里能给人看的几行：去掉带 open_id / secret / token 的行（已配对时插件会打印 open_id）和链接行。"""
    lines = [line.strip() for text in texts for line in (text or "").splitlines()]
    return [line for line in lines if line and not SECRETISH_LINE_RE.search(line) and not PAIR_LINK_RE.match(line)][-limit:]


def invoke_action(action_id: str) -> tuple[list, dict]:
    cmd = ["plugin", "action", "invoke", action_id, "--plugin", ONCALL_PLUGIN_ID]
    ok, res = herdr(cmd, timeout=60)
    if not ok:
        raise DroverError(f"herdr {shlex.join(cmd)} 失败", error=res)
    return cmd, res


def wait_feishu_paired(plugin: dict, seconds: float) -> tuple[Optional[bool], Optional[str]]:
    """每 ONCALL_PAIR_POLL 秒跑一次 status 脚本，等飞书配对上。返回 (配上没有, 出错原因)；等不了（插件太旧）时 (None, 原因)。"""
    deadline = time.time() + seconds
    while True:
        status, error = run_status_script(plugin)
        if status is None and error and "太旧" in error:
            return None, error
        if feishu_paired(status):
            return True, None
        if time.time() >= deadline:
            return False, error
        time.sleep(min(ONCALL_PAIR_POLL, max(0.1, deadline - time.time())))


def oncall_pair(plugin: dict, wait: Optional[float]) -> dict:
    """调插件的 pair-feishu，从插件日志读出配对链接（open: <url>）给人：Mac 桌面会弹二维码，没弹（没编译面板、
    不是 macOS）就用飞书打开链接。--wait 时接着等到飞书配上，再自动发一条测试消息。"""
    started = time.time()
    cmd, res = invoke_action("pair-feishu")
    log, finished = action_log("pair-feishu", started)
    out, err = (log or {}).get("stdout") or "", (log or {}).get("stderr") or ""
    already = any(word in out + err for word in PAIRED_WORDS)
    m = PAIR_LINK_RE.search(out)
    link = m.group(1) if m else None
    result = {"ok": True, "action": "pair", "plugin_action": "pair-feishu", "command": "herdr " + shlex.join(cmd),
              "link": link, "already_paired": already}
    if already:
        result["hint"] = "飞书已配对（这台电脑配过了，不会新建机器人）。要换账号先 drover oncall unpair 再 pair"
    elif link:
        result["hint"] = ("Mac 桌面会弹出二维码，用手机飞书扫一下；没弹的话，用手机飞书打开 link。"
                          "扫完确认后跑 drover oncall status 看 plugin_status.channels.feishu.paired，再 drover oncall test")
    elif log is None or not finished:
        result["still_running"] = True
        result["hint"] = (f"插件还在处理这次配对（{int(ONCALL_LOG_WAIT)} 秒内没跑完）：Mac 桌面可能会弹出二维码；稍后看 "
                          f"{ONCALL_LOG_HINT} 里 open: 后面的链接（用手机飞书打开），配没配上跑 drover oncall status 看")
    else:
        result["plugin_message"] = safe_lines(out, err)
        result["hint"] = f"插件没给出配对链接，原因见 plugin_message，或者看 {ONCALL_LOG_HINT}"
    if wait is None:
        return result
    if already:
        result["paired"] = True
        return result
    paired, error = wait_feishu_paired(plugin, wait)
    result["paired"] = paired
    if paired:
        test_cmd, _ = invoke_action("test")
        result["test"] = {"command": "herdr " + shlex.join(test_cmd)}
        result["hint"] = "飞书配对好了，发了一条测试消息，飞书里应该收到了"
        return result
    result["ok"] = False
    result["error"] = (f"等不了配对结果：{error}" if paired is None else
                       f"等了 {int(wait)} 秒，飞书还没配对上（扫码后要在飞书里点确认）：扫完再跑 drover oncall status 确认，"
                       "过期了就重跑 drover oncall pair")
    return result


def cmd_oncall(a: argparse.Namespace) -> dict:
    if a.wait is not None and a.action != "pair":
        raise DroverError("--wait 只给 pair 用：等飞书配对上再发测试消息")
    plugin = require_oncall_plugin()
    if a.action == "status":
        return oncall_status(plugin)
    action_id = ONCALL_ACTIONS[a.action]
    known = {x.get("id") for x in plugin.get("actions") or [] if isinstance(x, dict)}
    if known and action_id not in known:
        raise DroverError(f"插件 {plugin.get('version')} 里没有 {action_id} 这个动作：版本太旧，重跑 python3 install.py 更新",
                          plugin_actions=sorted(known))
    if a.action == "pair":
        return oncall_pair(plugin, a.wait)
    cmd, res = invoke_action(action_id)
    return {"ok": True, "action": a.action, "plugin_action": action_id, "command": "herdr " + shlex.join(cmd),
            "result": redact(res), "hint": f"动作已经交给插件执行（立即返回，不带输出），真实结果看：{ONCALL_LOG_HINT}"}


PROMPT_HINTS = {
    "timeout": "herdr 在等待时间内没报出 agent 的新状态（少见，正常 1 秒内就有）：交给 watch 追踪，"
               "长时间不变成 working 再 herdr agent read 看屏幕。",
    "agent_prompt_stalled": "agent 没有开始工作：先 herdr agent read 看屏幕（常见是弹窗或输入框残留），处理后重发一次。",
    "agent_blocked": "agent 停在审批或提问界面，prompt 没有发出去：先看屏幕，按第 7 节处理后再发。",
}
# 发 prompt 只等到 agent 开工（实测）：herdr 的 --wait 默认只把 idle / done / blocked 当结束，agent 正常开工就
# 一定等满 --timeout（实测 30.01 秒报 timeout）。加上 --until working，四种状态都写明（不依赖 herdr 怎么合并 --until
# 和默认集合）：空闲的 agent 0.4–0.6 秒返回 working，不会把发 prompt 之前的旧 done 当结果；正在干活的 0.3 秒返回 working；
# 卡在确认框上的照旧立刻报 agent_blocked。
PROMPT_UNTIL = ("working", "idle", "done", "blocked")
# 等待上限：正常 1 秒内就返回，只有 herdr 迟迟报不出新状态时才会等满。brief --send、prompt、orch-start、review 共用。
PROMPT_TIMEOUT_MS = 30000


def prompt_wait_args(timeout_ms: int) -> list:
    return ["--wait", *[x for s in PROMPT_UNTIL for x in ("--until", s)], "--timeout", str(timeout_ms)]


def prompt_plan(name: str, what: str, timeout_ms: int = PROMPT_TIMEOUT_MS) -> str:
    """--dry-run 的 planned 里那一行。"""
    return f"herdr agent prompt {name} {what} {shlex.join(prompt_wait_args(timeout_ms))}"


def send_prompt(name: str, text: str, timeout_ms: int) -> dict:
    """把 prompt 发给 agent，等到它开工（working）或停下（idle / done / blocked）就返回，最多等 timeout_ms。
    outcome：started（开工了）、settled（很快就停下了，看 status）、herdr 的错误码（timeout / agent_prompt_stalled /
    agent_blocked …，带 PROMPT_HINTS 的 hint）。timeout 也算 ok：交给 watch 追踪。"""
    ok, res = herdr(["agent", "prompt", name, text, *prompt_wait_args(timeout_ms)],
                    timeout=timeout_ms / 1000 + 60)
    if ok:
        status = find_key(res, "agent_status") or agent_status(name)
        return {"ok": True, "outcome": "started" if status == "working" else "settled", "status": status}
    code = res.get("code", "unknown")
    return {"ok": code == "timeout", "outcome": code, "message": res.get("message"),
            "status": agent_status(name), "hint": PROMPT_HINTS.get(code, "先 herdr agent read 看屏幕再决定。")}


def cmd_prompt(a: argparse.Namespace) -> dict:
    if a.text is not None:
        text, source = a.text, "--text"
    else:
        path = Path(a.file).expanduser()
        if not path.is_file():
            raise DroverError(f"prompt 文件不存在：{path}。先用 Write 写好 prompt 文件。")
        text, source = path.read_text(), str(path)
    if not text.strip():
        raise DroverError(f"prompt 是空的：{source}")
    if a.dry_run:
        return {"ok": True, "dry_run": True,
                "planned": [prompt_plan(a.name, f"<{source} 的内容，{len(text)} 字符>", a.timeout)]}
    sent = send_prompt(a.name, text, a.timeout)
    if sent["ok"]:
        record_answered(a.name, text)
    return sent


PROMPT_HEAD_CHARS = 20  # 时间线里 answered 带 prompt 开头这么多字：统计时分得出是转答复还是"接着做"（answered.json 不分内容）


def record_answered(name: str, text: str) -> None:
    """发给的是编排者（name 对得上某个 orch.json，多条取最新的，同 orch_rollups）时，在它的任务目录写 answered.json：
    发送时间和当时 rollup 的 digest；时间线记 answered（带开头 PROMPT_HEAD_CHARS 个字），内容以"收尾"开头的再记一条
    wrapup-sent（收尾请求），三处用同一个发送时间（以前各取一次 time.time()，机器忙时差出几毫秒，test_timeline 偶尔对不上）。
    worker 对不上，不写。
    看板靠 answered.json 分开"等你决定、还没答"和"已转答复、等编排者更新"，后者不算等你。"""
    task = latest_orch_metas().get(name)
    if task is None:
        return
    roll = read_rollup(task["dir"] / "rollup.md")
    at = time.time()
    write_json_atomic(task["dir"] / ANSWERED_FILE, {"at": at, "rollup_digest": roll["digest"] if roll else None})
    with timeline_session(task["dir"]) as (_, new):
        new.append(timeline_event("answered", at, "prompt", name=name, head=text.strip()[:PROMPT_HEAD_CHARS]))
        if text.lstrip().startswith("收尾"):
            new.append(timeline_event("wrapup-sent", at, "prompt", name=name))


# ---------------------------------------------------------------- brief

BRIEF_HEAD = "你在 Herdr 的一个 git worktree 里独立完成一项任务，由编排者派发和追踪。"

# 任务书以用户的目标开头。
GOAL_SECTION = """## 目标
{goal}
（这是用户要做成的事，主会话开头就是这样复述给用户的。下面任务书里的范围和做法都为它服务；发现两者对不上，写进报告的 open_questions 并把 status 标为 NEED_INPUT，不要自己改方向。）"""

# 篇幅要求：实际见过摸底写到 33.7KB、生成 5 分钟，大半是逐条确认任务书写对的部分和贴代码。
# 编排者只靠"不符"和"决策"两部分决定下一步，所以这两部分写全、不限长，其余压到 100 行左右。
# 第 3 部分的证据标准：见过拿注释、调用方一侧当证据，没读链路上的别的仓库就断言它的行为，
# 和 dispatch.md 核心原则的"证据"同一个标准。外部平台读不到代码的查官方文档（见过探针只报现象、官方文档一查就有原因）。
SURVEY_SECTION = """## 第一步：先摸底，不要动手
下面是完整的任务书。现在只读代码，核实任务书里关于现状的描述，并按任务书的要求做盘点：不要改仓库里的任何文件、不要装依赖、不要运行会写仓库文件的命令。读完把摸底结果写到 {survey_path}，包含四部分：
1. 和代码不符的地方：任务书里关于现状的描述，哪些和代码实际不一样，写清证据（文件:行）；没有就写"无"。
2. 范围盘点：任务书要求盘点的内容；任务书没要求的话，列出预计要改的文件和函数。
3. 打算怎么做：修 bug 或改设计时先写根因链（应该怎样：从目标推，不从现有实现推 → 问题在哪一层产生、为什么，附证据 → 改在哪一层；证据写仓库 文件:行或实测，注释、命名、文档、调用方那一侧只算线索，链路经过、不在你 worktree 里的仓库写明没读，不推断它的行为；外部平台（厂商 API、云模型平台）读不到代码的，查它的官方文档（写链接和段落）），根因落在任务书"不做"的范围里也照写，不标"不在范围"；再写思路和预计改动规模，对照"完成证据"逐条说明打算怎么证明，做不到或不合理的直接指出。
4. 需要决策的问题：会影响范围、行为或产品方向的选择，列出选项和你的建议；没有就写"无"。
篇幅：只写结论和证据位置（文件:行），不贴代码和命令输出（超过 5 行的一律不贴，写位置）；任务书写对的部分一句"其余和任务书一致"带过，不逐条确认。第 1、4 部分写全、不限长；第 2、3 部分合计控制在 100 行左右。
写完在对话里只回复文件路径，然后停下。编排者处理完会回复"开始"并附上确认结果，收到之后再按任务书实施，最后按完成协议写报告（报告里不重述摸底内容）。"""

# 任务段固定小节：brief 检查必填小节在且不空，嵌进任务书时降成 ### 挂在"## 任务"下面。
TASK_SECTIONS_REQUIRED = ["背景", "要做的", "不做"]
TASK_SECTION_SURVEY = "摸底时要写清"
TASK_HEADING_RE = re.compile(r"^(#{2,3})[ \t]*(\S[^\n]*)$", re.M)
TASK_TEMPLATE = """### 背景
（为什么要做、现状和已知事实；你核实过的写明怎么核实的，没核实的放进"线索"）

### 要做的
（范围：改什么、做成什么样、关键语义；根因核实过的写出做法，没核实的写嫌疑、由摸底定；并写明哪些可以由 agent 自己定）

### 不做
（明确排除的：不改的模块和文件、不执行的操作（迁移、推送、写共享环境数据等））

### 线索（需核实）
（可选：history 查到的决定和坑、相关文件 / 接口位置；agent 动手前要核实）

### 摸底时要写清
（带 --survey 时必填：摸底产出要回答的问题。只点影响决策的问题，不要让 worker 逐条确认任务书写对的部分）"""


def check_task_sections(task: str, survey: bool) -> str:
    """任务段必须有"背景 / 要做的 / 不做"（带 --survey 时还要"摸底时要写清"），且每节不空；标题按前缀匹配。
    返回把 ## 小节降成 ### 之后的任务段。"""
    headings = list(TASK_HEADING_RE.finditer(task))
    bodies = {}
    for i, m in enumerate(headings):
        end = headings[i + 1].start() if i + 1 < len(headings) else len(task)
        bodies[m.group(2).strip()] = task[m.end():end].strip()

    def body_of(name: str) -> Optional[str]:
        return next((body for title, body in bodies.items() if title.startswith(name)), None)

    wanted = TASK_SECTIONS_REQUIRED + ([TASK_SECTION_SURVEY] if survey else [])
    missing = [name for name in wanted if body_of(name) is None]
    empty = [name for name in wanted if body_of(name) == ""]
    if missing or empty:
        problems = ([f"缺小节 {'、'.join(missing)}"] if missing else []) + ([f"小节是空的：{'、'.join(empty)}"] if empty else [])
        raise DroverError("任务段要按固定小节写（" + "；".join(problems) + "），模板见 template", template=TASK_TEMPLATE)
    return re.sub(r"^##(?=[ \t])", "###", task, flags=re.M)


APPROVAL_FRIENDLY_CLAUDE = (
    "- 审批友好写法（你跑在 acceptEdits 下，写文件自动放行、bash 命令要命中白名单前缀）：脚本一律先用 Write 写成文件再用单条命令执行，"
    "不要把 Python 用 heredoc 内联在 bash 里；不要 `echo … && …` 串联多条命令；git 用 `git -C <path>` 不要 `cd && git`；"
    "不用变量赋值前缀（`W=/path; grep … $W/…`），路径写全；"
    "避免 `$(...)` 命令替换和带引号的 `{}`——这些会触发无法加白名单的强制人工审批。"
    "派子 agent（Explore 等）时，把这几条写法（git 用 `git -C <path>`、不 `cd && git`、一条 Bash 只做一件事、不用 `$(...)`）"
    "写进子 agent 的 prompt：它看不到这里的规则，自己写的 `cd … && git …` 会弹强制审批，你在等它时没人批。"
    "测试需要的环境变量放进 conftest.py 或测试代码里，不要在命令前拼 `VAR=...`；任务书给的构建 / 测试命令自带 `VAR=值` 前缀的"
    f"（如 `JAVA_HOME=… mvn …`），套上 heavy 执行（`{DROVER_CMD} heavy -- JAVA_HOME=… mvn …`），不会弹框。"
)

# 编码规范的来源（brief 追加进 worker 任务书）：包默认的 flow/coding-rules.md（config 的 default_coding_rules 可关；
# 通用原则总带，MySQL、Java 两节按任务书涉及的 worktree 取舍，见 coding_rules_sections），
# 再是团队 profile / 个人覆盖目录的 coding-rules.md（claude、codex 都加，见 coding_rules_files），最后是用户全局 CLAUDE.md
# 的"编码规范"一节（只给 codex：claude 会自动加载 CLAUDE.md）。都没有就不加这一节。
def global_coding_rules() -> str:
    """从用户全局 CLAUDE.md 取"编码规范"一节原文，保证 codex 拿到的和 claude 自动加载的一致；没有文件或这一节时返回空串。"""
    try:
        text = (HOME / ".claude" / "CLAUDE.md").read_text()
    except OSError:
        return ""
    m = re.search(r"^## 编码规范[^\n]*\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    return m.group(1).strip() if m else ""


def brief_worktrees(a: argparse.Namespace) -> list:
    """主 worktree（--repo/--wt/--branch）加上 --wt-extra 仓库=路径，解析成 [{name, repo, wt, branch}]。"""
    specs = [(a.repo, a.wt, a.branch)]
    for spec in a.wt_extra:
        repo, sep, wt = spec.partition("=")
        if not sep or not repo.strip() or not wt.strip():
            raise DroverError(f"--wt-extra 格式是 仓库=worktree路径（仓库可以写名字或路径）：{spec!r}")
        specs.append((repo.strip(), wt.strip(), None))
    items = []
    for repo_arg, wt_arg, branch in specs:
        repo = resolve_repo(repo_arg)
        wt = Path(wt_arg).expanduser().resolve()
        if not wt.is_dir():
            raise DroverError(f"worktree 目录不存在：{wt}")
        common_repo, common_wt = git_common_dir(repo), git_common_dir(str(wt))
        if common_repo and common_wt and common_repo != common_wt:
            raise DroverError(f"{wt} 不是 {repo} 的 worktree（git common dir 不同），检查参数是否写反或写错")
        items.append({
            "name": Path(repo).name,
            "repo": repo,
            "wt": str(wt),
            "branch": branch or git_out(str(wt), "rev-parse", "--abbrev-ref", "HEAD"),
            # 基线 commit：worker 只跑和改动相关的测试时用（如 vitest run --changed <基线>）。
            "base": git_out(str(wt), "rev-parse", "--short=12", "HEAD"),
            # 源仓库有、worktree 里没有的规范文件（没提交的那种），prompt 里让 agent 去读源仓库的原文。
            "docs_in_source_only": [str(Path(repo) / name) for name, _ in untracked_repo_docs(repo)
                                    if not (wt / name).exists()],
        })
    return items


def brief_deps_section(worktrees: list, deps_files: list, warnings: list) -> str:
    by_wt: dict = {}
    for f in deps_files:
        path = Path(f).expanduser()
        try:
            data = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError) as exc:
            raise DroverError(f"读不了依赖存档 {path}：{exc}。先跑 deps --save {path}")
        if data.get("dry_run"):
            warnings.append(f"{path} 是 deps --dry-run 的结果，摘要里写的“已装好”并没有真正执行")
        by_wt[str(Path(data.get("worktree_path", "")).resolve())] = data
    kinds: set = set()
    blocks = []
    for w in worktrees:
        data = by_wt.get(w["wt"])
        if data is None:
            warnings.append(f"没有 {w['name']}（{w['wt']}）的依赖存档，prompt 里写了“未提供”")
            summary = "- （编排者没有提供这个 worktree 的依赖安装结果，用到时先自己检查）"
        else:
            summary = data.get("summary_for_prompt") or "- 未检测到需要安装的依赖。"
            kinds |= {item.get("kind") for item in data.get("items", [])}
        blocks.append(summary if len(worktrees) == 1 else f"{w['name']}：\n{summary}")
    js = bool(kinds & {"js", "nested"})
    py = "python" in kinds
    real_dirs = [d for d, flag in (("`node_modules`", js), ("`.venv`", py)) if flag]
    has_env = any(any(Path(w["wt"]).glob(".env*")) for w in worktrees)
    head = "编排者已在 worktree 内独立安装依赖"
    if real_dirs:
        head += f"（{' / '.join(real_dirs)} 是真实目录，不是源仓库的软链）"
    if has_env:
        head += "，.env 已从源仓库复制"
    lines = ["## 依赖", head + "。当前情况：", "\n".join(blocks)]
    hints = []
    if js:
        hints.append("JS 用仓库对应的包管理器；新增包后确认 lockfile 里新条目的下载地址和已有条目一致"
                     "（本机的 npm 镜像配置可能把镜像地址写进 lockfile）")
    if py:
        hints.append("Python 用 `./.venv/bin/python -m pip install …`")
    if hints:
        lines.append(f"依赖有变化就在 worktree 里装：{'；'.join(hints)}。"
                     f"绝不往源仓库的 {' / '.join(real_dirs)} 里装东西。")
    else:
        lines.append("依赖有变化就在 worktree 里装，绝不往源仓库里装东西。")
    return "\n".join(lines)


def build_brief(a: argparse.Namespace, worktrees: list, task: str, evidence: list, warnings: list) -> str:
    codex = a.kind == "codex"
    slug_dir = STATE_HOME / a.slug
    parts = [GOAL_SECTION.format(goal=a.goal.strip()), BRIEF_HEAD]
    if a.survey:
        parts.append(SURVEY_SECTION.format(survey_path=slug_dir / f"{a.name}.survey.md"))
    parts.append("## 任务\n" + task)
    parts.append("## 完成证据（逐条做到；报告的 verification 逐条对应，写出命令和实际结果）\n"
                 + "\n".join(f"{i}. {e}" for i, e in enumerate(evidence, 1)))

    wt_lines = ["## 工作目录（只在这些 worktree 内改动）"]
    for w in worktrees:
        wt_lines.append(f"- {w['name']}: {w['wt']}（分支 {w['branch']}，基线 {w['base']}；"
                        f"源仓库 {w['repo']} 仅供只读参考，禁止修改）")
    if any(is_under(w["wt"], HERDR_WORKTREES) for w in worktrees):
        wt_lines.append("- worktree 放在 herdr 管理目录 `~/.herdr/worktrees/` 是允许的位置，不要挪动。")
    parts.append("\n".join(wt_lines))
    parts.append(brief_deps_section(worktrees, a.deps_json, warnings))

    rules = ["## 约束"]
    if codex:
        rules.append("- 动手前先读各仓库根目录的 CLAUDE.md / AGENTS.md（codex 不会自动加载 CLAUDE.md），遵守其中的规范和现有代码风格。")
    else:
        rules.append("- 遵守各仓库的 CLAUDE.md 和现有规范。")
    source_only = [p for w in worktrees for p in w["docs_in_source_only"]]
    if source_only:
        rules.append("- 下面这些仓库规范文件没有提交进 git，worktree 里没有，动手前先读源仓库里的原文（只读，不要复制进 worktree）："
                     + "、".join(f"`{p}`" for p in source_only))
        ignored_missing = [f"{w['name']}/{name}" for w in worktrees for name, ign in untracked_repo_docs(w["repo"])
                           if ign and not (Path(w["wt"]) / name).exists()]
        if ignored_missing:
            warnings.append(f"worktree 里缺被忽略的规范文件 {'、'.join(ignored_missing)}（多半是旧版 wt 建的）："
                            "重跑一次 wt（同分支会复用）就会补复制；这次 prompt 已让 agent 读源仓库的原文")
    if a.commit_allowed:
        rules.append("- 可以在当前分支上 git commit（提交信息遵守仓库规范）；不要 git push / 切分支 / 改写已有提交 / 删 worktree。")
    else:
        rules.append("- 不要 git commit / git push / 切分支 / 删 worktree。")
    rules.append("- 不要 git fetch / pull / rebase / merge：基线由编排者统一管理，所有条目做完后由它在集成 worktree 里"
                 "统一同步上游、解冲突。")
    # 迁移在集成检查通过后、推送前由编排者按仓库规则统一执行（dispatch.md 第 9.1 节第 4 步：定时间戳、试跑、核对账本）；
    # worker 并行、各自看不到别人的迁移，自己执行的会和它重复或乱序，写共享库还会影响别的条目和别人。
    rules.append("- 只写迁移文件和测试，不执行迁移，不对任何共享 / 生产数据库做写操作；迁移由编排者按仓库规则执行。")
    heavy = f"`{DROVER_CMD} heavy -- <命令>`"
    # 以前只让 build 和大批测试经 heavy，worker 自己跑的相关测试、lint 调度器看不见，全量测试照样
    # 被它们拖慢、超时。heavy 改成按实测占用调度以后，轻命令经 heavy 不用排队，所以一律经 heavy。
    rules.append(f"- 测试、lint、类型检查、构建一律经 {heavy} 执行（如 `{DROVER_CMD} heavy -- bunx vitest run src/a.test.ts`）："
                 "heavy 按本机实测的占用调度全机的构建 / 测试，轻的、跑得快的不用排队，重的（全量测试、build）等机器有空再跑，"
                 "排队时会打印这条要多少、在等谁。heavy 只执行构建 / 测试工具，不在它名单里的命令会被拒绝（退出码 2），这类直接执行。"
                 "测试只跑和这次改动相关的：直接相关的测试文件（或 `vitest run --changed <基线>`、pytest 指定文件），"
                 "加上类型检查和改动文件的 lint。不要跑全量测试：全量由编排者集成时统一跑一次。重命令可能要排几分钟，用后台方式执行。")
    if codex:
        rules.append(f"- 你跑在 workspace-write 沙箱里（-a on-request）：只在上面的 worktree 和 {slug_dir} 里写文件；"
                     "联网、写沙箱外路径会弹审批等编排者处理，能避免就避免（依赖已装好，不要重装）。")
    else:
        rules.append(APPROVAL_FRIENDLY_CLAUDE)
    # 根治，不打补丁（dispatch.md 核心原则的"根治三问"给 worker 的短版）。
    rules.append("- 改在问题产生的那一层，不在症状出现的地方加判断、特例、兜底或词表；能删就不加，能复用现有链路就不新建；"
                 "因此变得多余的旧代码（死分支、过渡兼容、重复判断）一起删。任务书指定的做法只治了症状的，在摸底或报告里指出来、"
                 "给出源头的改法（标 NEED_INPUT），不要照做。")
    # 事实判断的证据（同 dispatch.md 核心原则"证据"）：见过探针只报了"网关忽略"这个现象、没写原因，
    # 其实官方文档一查就有；也见过把 AI 自己对识别结果的逐项核对当结论转给用户。
    rules.append("- 报告、摸底、注释、文档里写的事实判断都要有证据（代码 文件:行、实测、外部平台的官方文档链接和段落）；"
                 "现象（不生效、不支持、报错）连原因一起写，查不到写\"原因未查明\"和已排除的可能；"
                 "经过网关、中转测到的现象定不了是哪一层。一两次查询（读源码、查官方文档、花费很小的探针）能核实的先核实，"
                 "不拿推断交差。识别类结果（OCR、识图、转写）你自己的核对只算初步，写明未经用户确认。")
    rules.append("- 做完必须自证：逐条完成上面\"完成证据\"里的检查，把命令和实际结果写进报告的 verification。"
                 "某一条做不到就写明原因，status 不能标 DONE。")
    rules.append("- 遇到需要决策的问题：能从任务上下文推断的自己定并记录假设；确实无法推断的写进报告 open_questions 并把 status 标为 NEED_INPUT，不要瞎猜关键需求。")
    parts.append("\n".join(rules))
    for source, body in playbook_coding_rules(warnings, [w["wt"] for w in worktrees]):
        parts.append(f"## 编码规范（{source}）\n" + body)
    if codex:
        user_rules = global_coding_rules()
        if user_rules:
            parts.append("## 编码规范（用户全局规则；codex 不会自动加载，必须遵守）\n" + user_rules)

    # 篇幅要求和"对话里只回复路径"：实际见过报告写到 18.7KB、生成约 3 分钟，还要在对话里再写一遍。
    # 编排者验收时自己重跑关键命令，verification 只要能对上命令和结果；报告文件找不到时让 worker 补写（第 6 节事件表）。
    # root_cause 附证据位置：编排者按位置核对根因，不靠 worker 的自述；还要写"为什么"，只说哪一层不算根因。
    repo_label = worktrees[0]["name"] if len(worktrees) == 1 else "<仓库名>"
    report = slug_dir / (a.name + '.md')
    parts.append("\n".join([
        "## 完成协议（必须执行）",
        f"把最终报告写到 {report}，格式：",
        "=== DISPATCH RESULT ===",
        "status: DONE | PARTIAL | FAILED | NEED_INPUT",
        "summary: <3-5 句>",
        "changed_files:",
        f"  - <相对路径>（{repo_label}）",
        "root_cause: <修 bug 或改设计时一句：问题产生在哪一层、为什么（附证据位置）、改在哪一层；新增的特例 / 兜底 / 回落逐个列出并说明为什么必要；"
        "其他任务写 n/a>",
        "verification: <按\"完成证据\"逐条写，每条一行：命令加结果汇总行（如 `Tests run: 218, Failures: 0`、`164 passed`）；"
        "修 bug 的写明回归测试改之前失败、改之后通过（命令和结果）；做不到的写原因>",
        "assumptions: <自行决定的点>",
        "open_questions: <需要用户回答的问题，没有写 none>",
        "=== END ===",
        "篇幅：整份报告尽量 60 行以内；verification 不贴命令输出、不点名测试类、不重述摸底。",
        f"写完在对话里只回复一行：报告路径和 status（如 `{report} status: DONE`），不要把报告块再写一遍。",
    ]))
    return "\n\n".join(parts) + "\n"


def append_brief_record(a: argparse.Namespace, prompt_file: Path, evidence: list) -> dict:
    """把完成证据和是否摸底追加到状态文件，6.1 验收逐条核对；重复生成时追加新段，以最后一段为准。"""
    state = STATE_HOME / a.slug / "dispatch.md"
    existed = state.exists()
    stamp = time.strftime("%m-%d %H:%M")
    lines = [f"## brief：{a.name}（{stamp}，{a.kind}，摸底：{'是' if a.survey else '否'}）",
             f"- prompt：{prompt_file}",
             "- 完成证据（6.1 验收逐条核对）："]
    lines += [f"  {i}. {e}" for i, e in enumerate(evidence, 1)]
    if a.survey:
        lines.append(f"- 摸底结论：待处理（读 {STATE_HOME / a.slug / (a.name + '.survey.md')} 后写明："
                     "我直接改掉的事实偏差、交给用户决定的问题和用户的答复）")
    text = state.read_text() if existed else f"# dispatch: {a.slug}\n"
    sep = "" if text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
    state.write_text(text + sep + "\n".join(lines) + "\n")
    return {"state_file": str(state), "state_file_created": not existed}


def brief_kind(a: argparse.Namespace, warnings: list) -> tuple[str, str]:
    """任务书按哪个宿主写约束，返回 (kind, kind_source)：应等于收任务书的 agent（--name）的实际宿主。
    给了 --kind 照用（"explicit"），和 herdr 里活着的这个 agent 对不上时进 warnings；没给就取这个 agent 的宿主（"agent"）；
    agent 还没起时同 agent-start：orch.json 的 default_kind（"orch"），再调用方（"caller"）。"""
    actual = agent_kind(a.name)
    if a.kind:
        if actual and actual != a.kind:
            warnings.append(f"--kind {a.kind} 和 agent {a.name} 实际的宿主 {actual} 对不上：任务书照 --kind 写成 {a.kind} 的约束；"
                            f"要发给它的话去掉 --kind（或改成 --kind {actual}）重新生成")
        return a.kind, "explicit"
    if actual:
        return actual, "agent"
    kind, source = task_default_kind(a.slug)
    if kind is None:
        raise DroverError(f"herdr 里没有 agent {a.name}，{STATE_HOME / a.slug / 'orch.json'} 里没有 default_kind，"
                          f"又{NO_CALLER_KIND}：加 --kind claude|codex（和要收任务书的 agent 一致）",
                          caller_pane=os.environ.get("HERDR_PANE_ID"))
    return kind, source


def cmd_brief(a: argparse.Namespace) -> dict:
    check_slug(a.slug)
    check_agent_name(a.name)
    evidence = [e.strip() for e in a.evidence if e.strip()]
    if not evidence:
        raise DroverError("完成证据必填：每条写\"用什么命令或操作、看到什么结果算通过\"。写不出来说明任务还没拆清楚，回第 2 节。")
    if not a.goal.strip():
        raise DroverError("目标必填：写状态文件开头的\"目标：\"那段（dispatch.md 第 1.1 节的复述，用户纠正过就用纠正后的）。")
    task_path = Path(a.task_file).expanduser()
    if not task_path.is_file():
        raise DroverError(f"任务文件不存在：{task_path}。先用 Write 写好只含\"任务\"一段的文件。")
    task = re.sub(r"\A\s*##\s*任务\s*\n", "", task_path.read_text()).strip()
    if not task:
        raise DroverError(f"任务文件是空的：{task_path}")
    task = check_task_sections(task, a.survey)
    warnings: list = []
    # build_brief、append_brief_record 都按 a.kind 写，换成解析后的值。
    a.kind, kind_source = brief_kind(a, warnings)
    worktrees = brief_worktrees(a)
    prompt = build_brief(a, worktrees, task, evidence, warnings)
    prompt_file = STATE_HOME / a.slug / f"{a.name}.prompt.md"
    result = {"ok": True, "dry_run": a.dry_run, "kind": a.kind, "kind_source": kind_source, "survey": a.survey,
              "prompt_file": str(prompt_file), "chars": len(prompt),
              "worktrees": worktrees, "evidence": evidence, "warnings": warnings}
    if a.survey:
        result["survey_file"] = str(STATE_HOME / a.slug / f"{a.name}.survey.md")
    if a.dry_run:
        result["prompt"] = prompt
        result["planned"] = [f"写 {prompt_file}", f"追加完成证据到 {STATE_HOME / a.slug / 'dispatch.md'}"]
        if a.send:
            result["planned"].append(prompt_plan(a.name, f"<{prompt_file}>"))
        return result
    prompt_file.parent.mkdir(parents=True, exist_ok=True)
    prompt_file.write_text(prompt)
    result.update(append_brief_record(a, prompt_file, evidence))
    if a.send:
        sent = send_prompt(a.name, prompt, PROMPT_TIMEOUT_MS)
        result["sent"] = sent
        result["ok"] = sent["ok"]
        if not sent["ok"]:
            result["error"] = f"prompt 文件已写好，但发送结果是 {sent['outcome']}：{sent.get('hint')}"
    return result


# ---------------------------------------------------------------- watch

# Claude Code 状态栏里的后台命令计数，如 "⏵⏵ accept edits on · 1 shell · ← 1 agent"（实测）。
# 有后台命令时 herdr 会报 done / idle，但 agent 会在命令结束后自己接着干（全量测试放后台、drover heavy 排队）。
# Monitor 同理（"· 1 monitor"，编排者挂着 Monitor 等 worker 时被误报成过 done）：有事件就会被唤醒。
BACKGROUND_SHELL_RE = re.compile(
    r"·\s*(\d+)\s+(?:background\s+)?(?:shells?|bash(?:es)?|monitors?)\b(?:\s+still\s+running)?", re.I)
# 状态为 done / idle 且有后台命令时，多久重读一次屏幕（后台命令结束、agent 却没接着干时，改报 done）。
BACKGROUND_RECHECK_SECONDS = 30
# working 却没有输出（Codex 实测：worker 改完代码、测试通过后，停在 working 十几分钟不调工具也不写报告，
# working-no-diff 要 20 分钟才报）：屏幕输出的指纹。计时行（带 esc to interrupt）和轮换的 Tip 行不算，数字抹掉。
OUTPUT_VOLATILE_RE = re.compile(r"(?i)(esc to interrupt|^\s*⎿?\s*Tip:)")
DIGITS_RE = re.compile(r"\d+")
# 屏幕底部有这些标记说明正在跑命令：长测试没输出是正常的，不算没动静（这种情况交给 working-no-diff）。
RUNNING_CMD_RE = re.compile(r"(?im)(Running…|Running\.\.\.|Waiting for background terminal|^\s*[•◦]\s+Running\b)")


def output_fingerprint(name: str) -> tuple[Optional[str], bool]:
    """agent 最近输出的指纹和"是否正在跑命令"；读不到返回 (None, False)。"""
    p = run(["herdr", "agent", "read", name, "--source", "recent-unwrapped", "--lines", "80"], timeout=30)
    if p.returncode != 0:
        return None, False
    lines = p.stdout.splitlines()
    running = bool(RUNNING_CMD_RE.search("\n".join(lines[-15:])))
    stable = "\n".join(line for line in lines if not OUTPUT_VOLATILE_RE.search(line))
    return hashlib.sha1(DIGITS_RE.sub("#", stable).encode(errors="replace")).hexdigest(), running


def background_shells(name: str) -> int:
    """agent 屏幕底部状态栏里还在跑的后台命令数；读不到返回 0。"""
    m = BACKGROUND_SHELL_RE.search(agent_screen(name, 8))
    return int(m.group(1)) if m else 0


# 一轮因为接口错误中断（实际出过一次 API 503，编排者和三个 worker 同时停在 done，
# 空等了 6 个多小时没人发现）。Claude Code 打印 "⏺ API Error: 503 ..."（有时在工具调用下面："⎿  API Error: …"）；
# codex 是 "■ stream error / stream disconnected / unexpected status 502"。只认行首的错误行，而且它得是屏幕上最后一个输出块：
# 正文里提到 "API Error"（误报过两次：worker 报告里写了 "API_ERROR_RE 不认 API Error"，编排者的收尾总结里也写了）、
# 更早的块是错误但之后又有正常输出，都不算。
CLAUDE_API_ERROR_RE = re.compile(r"^\s*(?:[⏺⎿]\s*)?API Error\b")
CODEX_API_ERROR_RE = re.compile(r"(?i)^\s*■\s*(?:stream (?:error|disconnected)|unexpected status \d{3})")
# 输出块的开头：Claude Code 的 ⏺、codex 的 •，都在行首。从下往上先碰到它，说明错误行（如果有）不是最后一个块。
# codex 的输入框以 › / » 开头、一定在错误行下面，不能算块开头。
OUTPUT_BLOCK_RE = re.compile(r"^[⏺•]")

# Claude Code 的确认弹框（WebFetch 授权、Bash、Edit……）：最后一条纯横线以下，"Do you want to …?" 问句后面紧跟带光标 ❯ 的编号选项。
# WebFetch 授权弹框被 herdr 报成过 done：herdr 的检测清单只靠一条兜底规则认它（问句是 "Do you want to allow Claude to
# fetch this content?"，没有 Bash 弹框的 "proceed" 和 "Esc to cancel"），而那条规则在屏幕上任何位置有一行单独的 ❯ 时就不生效
# （编排者的工具输出里常有 worker 的空输入框），于是落到 ✳ 标题规则报 idle → done（用临时 agent 复现过）。
# 只按纯横线（整行都是 ─）切：带 --name 启动的会话（worker 的 worker-<slug>、编排者的 orch-<slug>）会把名字嵌进横线，
# "────… worker-x ─" 弹框时在弹框最底下，平时是输入框的上边框。按纯横线切，弹框时最后一条是弹框顶部，region 就是整个弹框；
# 平时最后一条是输入框的下边框，region 只剩状态栏，正文里引用的弹框文字都在它上面，不会误报。
# 要是把带名字的横线也算进来，弹框时 region 就是空的，认不出弹框。
HRULE_RE = re.compile(r"^\s*─{10,}\s*$")
DIALOG_QUESTION_RE = re.compile(r"^\s*(?:Do you want to|Would you like to)\b")
DIALOG_FIRST_OPTION_RE = re.compile(r"^\s*(?:❯\s*)?1\.\s")
DIALOG_CURSOR_RE = re.compile(r"^\s*❯\s*\d+\.\s")
# 弹框指纹里抹掉的时长（3s、1m 12s）和时钟；普通数字保留（连续两个确认常常只差数字，比如 sips -Z 512 和 sips -Z 1024）。
DURATION_RE = re.compile(r"(?:\d+(?:\.\d+)?(?:ms|s|m|h)\b\s*)+|\d{1,2}:\d{2}(?::\d{2})?")
# 判断弹框读多少行屏幕：完整的 Bash 确认框从顶部横线到底部有 16 行（实测），14 行读不全。
DIALOG_SCREEN_LINES = 40
# herdr 报 working 时隔多久看一次屏幕，找后台子 agent 的确认框（见 screen_override）。
# 来由：编排者派的后台 Explore 子 agent 弹出 Bash 确认，主 agent 停在 "✻ Waiting for 1 background agent to finish"，
# herdr 的检测清单里 background_agents_working（优先级 965）压过 bash_permission_prompt（850），报 working；watch 只在 done / idle
# 时读屏幕，就漏了，直到用户自己在 pane 里看到（用真实 agent 复现过，herdr agent explain 的 matched_rule 就是它）。
# 不每轮都读（working 的 agent 最多）：默认 5 秒一轮时每两轮读一次，弹框出现后最多约 10 秒（再加一轮的耗时）报出 blocked。
# 刚变成 working、上一轮判成 blocked（要看弹框消失没有、换没换）、--once 时不受这个限制，立刻读。
# 不复用 output_fingerprint 那次读屏：它只在 --quiet-minutes 开着时每 --output-interval（默认 30 秒）读一次，赶不上这个间隔；
# 而且它读的是 recent-unwrapped，permission_dialog 和它的样本（实测抓的）都是按 visible 校准的。
WORKING_DIALOG_CHECK_SECONDS = 10


def last_hrule(lines: list) -> Optional[int]:
    """最后一条纯横线的行号（带会话名的横线不算，见 HRULE_RE 上面的说明）；没有返回 None。"""
    for i in range(len(lines) - 1, -1, -1):
        if HRULE_RE.match(lines[i]):
            return i
    return None


def permission_dialog(screen: str) -> bool:
    """屏幕底部是不是 Claude Code 的确认弹框。弹框太高、顶部横线不在读到的范围里时看整屏（这时屏幕上也没有输入框）。"""
    lines = screen.splitlines()
    top = last_hrule(lines)
    region = lines if top is None else lines[top + 1:]
    for i, line in enumerate(region):
        if not DIALOG_QUESTION_RE.match(line):
            continue
        # 问句在窄屏上可能折成两行：之后最多隔两行就是第一个选项（"❯ 1. Yes"），光标在选项里的某一行
        for j in range(i + 1, min(i + 4, len(region))):
            if DIALOG_FIRST_OPTION_RE.match(region[j]):
                options = region[j:]
                end = next((k for k, text in enumerate(options) if not text.strip()), len(options))
                if any(DIALOG_CURSOR_RE.match(text) for text in options[:end]):
                    return True
                break
    return False


def dialog_fingerprint(screen: str) -> str:
    """blocked 时弹框内容的指纹。只取最后一条纯横线以下：弹框上方那行工具调用的 ⏺ 会闪（实测），不能算进去；
    没有纯横线就取最后 20 行、去掉 ⏺ / ⎿。Tip 行、计时行不算，时长和时钟抹掉，普通数字保留。"""
    lines = screen.splitlines()
    top = last_hrule(lines)
    region = ([text.replace("⏺", "").replace("⎿", "") for text in lines[-20:]] if top is None
              else lines[top + 1:])
    stable = "\n".join(DURATION_RE.sub("#", text).rstrip() for text in region if not OUTPUT_VOLATILE_RE.search(text))
    return hashlib.sha1(stable.encode(errors="replace")).hexdigest()


def api_error(screen: str) -> bool:
    """屏幕上最后一个输出块是不是接口错误（见 CLAUDE_API_ERROR_RE 上面的说明）。"""
    for line in reversed(screen.splitlines()):
        if CLAUDE_API_ERROR_RE.match(line) or CODEX_API_ERROR_RE.match(line):
            return True
        if OUTPUT_BLOCK_RE.match(line):
            return False
    return False


def screen_state(screen: str) -> str:
    """herdr 报 done / idle 时按屏幕改报：底部是确认弹框 → blocked（有弹框就必须有人处理，不管后台还有没有命令）；
    状态栏还有后台命令 → waiting-background(N)；最后一个输出块是接口错误 → api-error；否则空串。"""
    if permission_dialog(screen):
        return "blocked"
    m = BACKGROUND_SHELL_RE.search("\n".join(screen.splitlines()[-8:]))
    if m:
        return f"waiting-background({m.group(1)})"
    return "api-error" if api_error(screen) else ""


def screen_override(status: str, screen: str, kind: Optional[str] = None) -> str:
    """按屏幕修正 herdr 报的状态，watch 和 orch-status 共用这一套规则；不用修正时返回空串。
    - done / idle：screen_state 的结果（确认弹框 → blocked、后台命令 → waiting-background(N)、接口错误 → api-error）；
    - working：屏幕底部是确认弹框 → blocked。主 agent 在等后台子 agent（"Waiting for N background agent(s) to finish"）时，
      子 agent 的确认框就在主 agent 屏幕的最底下，herdr 却报 working（见 WORKING_DIALOG_CHECK_SECONDS 上面的说明）。
      正文里引用的弹框文字（编排者 herdr agent read 出 worker 的屏幕）在自己的输入框上面，permission_dialog 不认。
      只看 Claude Code：codex（kind 为 codex）没有这种后台子 agent 弹框，它的屏幕上也没有纯横线，引用的弹框文字会被误认。"""
    if status in ("done", "idle"):
        return screen_state(screen)
    if status == "working" and kind != "codex" and permission_dialog(screen):
        return "blocked"
    return ""


def screen_or_empty(name: str) -> str:
    """读 agent 屏幕底部（判断弹框的行数）；herdr 报错、超时都返回空串，调用方按 herdr 的原值处理。"""
    try:
        return agent_screen(name, DIALOG_SCREEN_LINES)
    except DroverError:
        return ""


def done_state(name: str) -> str:
    """done / idle 时读 agent 屏幕底部，返回 screen_state 的结果。"""
    return screen_state(agent_screen(name, DIALOG_SCREEN_LINES))


# rollup 事件：主会话只能从 herdr 状态推断"该读 rollup 了"。编排者挂着 Monitor 时 watch 报 waiting-background，
# 它写了"等你决定""完成"主会话也收不到（漏过：编排者写完"完成"还挂着 2 个 monitor）。
# 所以对有 orch.json 的 agent（编排者、子编排者）同时盯它的 rollup.md：状态变了就报；状态没变、内容变了，
# 只在 ROLLUP_ATTENTION 这几种状态时报（"进行中"只是更新里程碑，不叫醒主会话）。
# 不看"更新："行：它是模型手写的，状态没变、又写了同一个推算时间时，新的"等你决定"会漏报。
# 内容变没变按规范化内容的 digest（read_rollup），不按修改时间：原样重写、只改空白空行不重报。
# 主会话专用的 --main：实测主会话两天里挂了 42 次 Monitor、收到 146 条通知，35 条是到期、
# 34 条是重挂时的启动快照（watch 的去重状态只在进程内存里，第一轮必定把当前值全打一遍）；working / waiting-background 对主会话
# 也没有对应的动作。--main 只报主会话要处理的事，去重记录写盘（MAIN_WATCH_FILE），重挂之后只报没报过的。
MAIN_IDLE_MINUTES = 10
WATCH_DESCRIPTION = f"""\
轮询 agent 状态，启动时输出每个 agent 的当前状态，之后变化时输出一行 EVENT <名> <状态> @<时:分:秒>。
状态是 herdr 的 working / blocked / done / idle / unknown，agent 退出是 gone；watch 会按屏幕改报或补报：
  blocked                 herdr 报 done / idle、但屏幕底部是确认弹框（如 WebFetch 授权）时也报 blocked。
                          herdr 报 working（主 agent 在等后台子 agent："Waiting for N background agent(s) to finish"）、
                          但屏幕底部是子 agent 的确认框时也报 blocked（只看 Claude Code，working 时每 {WORKING_DIALOG_CHECK_SECONDS} 秒
                          看一次屏幕；批完弹框消失后报回 working，卡在弹框上的时间不算进下面两种 working-no-xxx 的计时）。
                          同一状态 herdr 的序号变了（中间经历过别的状态）或弹框换了会重报，连续两个确认报两次；
                          一直有弹框、herdr 的原始状态却变了（如 blocked → working）也当作换了弹框重报一次；
                          done / idle 序号变了同样重报（working 不重报）
  waiting-background(N)   herdr 报 done / idle，但状态栏还有 N 个后台命令或 Monitor：会自己接着干，继续等
  api-error               herdr 报 done / idle，最后一个输出块是接口错误（Claude Code 行首的 API Error、codex 行首 ■ 的
                          stream error / unexpected status）：这一轮被打断了
  working-no-output(Nm)   working 但屏幕输出 N 分钟没变、也没在跑命令
  working-no-diff(Nm)     working 但 worktree N 分钟没有改动
有 orch.json 的 agent（编排者、子编排者）另外盯它的 rollup.md，单独输出一行 EVENT <名> rollup:<状态>：
状态变了就报；状态没变、内容变了（按规范化内容判断：每行去掉首尾空白、删掉空行；原样重写、只改空白空行不报，
不看"更新："行），只在 等你决定 / 完成 / 受阻 / 需要换编排者 时报（进行中不报）。
启动时和 --once 也输出当前的 rollup 状态（--until-event 不因启动时的输出退出）。

--main：主会话专用，只报主会话要处理的事。不写名字时每一轮自动找所有顶层编排者（orch.json 里没有 parent 的，
watch 起来之后新起的也算），写了名字只盯这些；子编排者不盯，编排者已经退出、rollup 又是完成的不盯。每件事只报一次：
  rollup:<状态>           状态以 等你决定 / 完成 / 受阻 / 需要换编排者 开头，内容和主会话用 drover rollup 读过的不同（未读），
                          也和上次报过的不同
  blocked                 同上（herdr 报 blocked，或按屏幕修正成 blocked）；同一个弹框只报一次，弹框换了再报
  api-error               同上，进入时报一次
  gone                    编排者不在 herdr 里了，rollup 却不是 完成 / 需要换编排者（意外退出）
  stalled(Nm)             herdr 报 done / idle（屏幕上不是后台命令、弹框、接口错误），rollup 是进行中，或者转过答复
                          （drover prompt）之后 rollup 还没更新：停满 --idle-minutes 报一次，变回 working 后重新计时
  herdr unreachable       herdr 连不上（--until-event 时退出码 1）
drover 自己的事，名字位置写 drover（EVENT drover <事件> @<时间>），同样每件只报一次、重挂不重报：
  updated(<旧>..<新>)[ rules]  自动更新装上了新版本（两边是版本 tag，那个提交上没有 tag 时是 7 位 sha；还没报过的几次
                          并成一次）；带 rules 的是 AGENTS.md 里的 drover 规则也变了，跑 drover rules 读入改动。
                          报过记在 ~/.drover/auto-update.json 的 announced
  update-blocked          自动更新被挡住（clone 有本地改动、分叉、没上游、上游还没有发布的版本……什么都没改）或失败：
                          同一个原因只报一次，原因看 drover board 的"drover 自动更新暂停"那一行
  update-unreachable(24h) 自动更新连续 24 小时连不上远端（离线、代理没开时很常见，所以只在满 24 小时时报一次）
  session-restarted       主会话重开了：~/.drover/main-session.json（main-register --hook 写）的 session_id 变了、
                          source 是 clear / startup（compact、resume 不算）。/clear 之前挂着的 watch 会活到 /clear 之后，
                          它报这一行（--until-event 时退出）就叫醒了新对话
同时跑着两个 watch --main 时，每一轮算事件、写去重记录拿同一把文件锁，同一件事只有一个进程报。
每一轮还会触发 drover 的自动更新检查（到时间才在后台查，不等它）。
不报 working、waiting-background、rollup:进行中、done / idle 本身。报过什么记在 ~/.drover/<slug>/{MAIN_WATCH_FILE}，
rollup 的已读看 {MAIN_SEEN_FILE}：重挂之后只报没报过的，没有新东西时启动不输出任何一行。
每一轮还把编排者现在的状态（按屏幕修正后）和它从什么时候开始记进 ~/.drover/<slug>/{AGENT_STATE_FILE}（看板也记，
"卡在确认框 N 分钟"按它算），把显示状态的变化、编排者每换一段状态、停了没更新补进时间线 ~/.drover/<slug>/{TIMELINE_FILE}
（看板也补，两边同时跑只记一次），离上一轮观察超过 {OBSERVE_GAP_SECONDS} 秒时在 {OBSERVE_GAPS_FILE} 记一条观察中断。
--main --until-event 时启动那一轮的输出也算事件：输出了就退出（退出码 0）。"""


def latest_orch_metas() -> dict:
    """编排者名 → 它最新的一份 orch.json：{"meta", "dir"}。按 STATE_HOME/*/orch.json 的 name 找，多条（名字被后来的任务复用）
    取文件修改时间最新的（started 没有年份，只在修改时间相同时排先后）。"""
    best: dict = {}
    for meta_file in STATE_HOME.glob("*/orch.json"):
        try:
            meta = json.loads(meta_file.read_text())
            mtime = meta_file.stat().st_mtime
        except (OSError, ValueError):
            continue
        name = meta.get("name") if isinstance(meta, dict) else None
        if not name:
            continue
        key = (mtime, str(meta.get("started") or ""))
        if name not in best or key > best[name][0]:
            best[name] = (key, {"meta": meta, "dir": meta_file.parent})
    return {n: task for n, (_, task) in best.items()}


def orch_rollups(names) -> dict:
    """agent 名 → 它的任务目录里的 rollup.md（latest_orch_metas）。不是编排者（没有 orch.json）的 agent 不在结果里。"""
    metas = latest_orch_metas()
    return {n: metas[n]["dir"] / "rollup.md" for n in names if n in metas}


def rollup_event(name: str, path: Path, seen: dict, once: bool) -> bool:
    """按需输出一行 EVENT <名> rollup:<状态>，返回是否输出了。seen[name] 记上次的 (状态, digest)，第一次见到时照常输出当前值。
    rollup.md 不存在或读不出状态时不输出、不报错，也不覆盖上次的值（编排者可能正在重写这个文件）。"""
    roll = read_rollup(path)
    if roll is None or not roll["status"]:
        return False
    status = roll["status"]
    cur = (status, roll["digest"])
    old = seen.get(name)
    seen[name] = cur
    if not (once or old is None or cur[0] != old[0] or (cur[1] != old[1] and status.startswith(ROLLUP_ATTENTION))):
        return False
    print(f"EVENT {name} rollup:{status} @{time.strftime('%H:%M:%S')}", flush=True)
    return True


def worktree_fingerprint(path: str) -> Optional[str]:
    """worktree 的改动指纹：HEAD、git diff HEAD、未跟踪文件的名字 / 大小 / 修改时间。不在 git 仓库里（如编排者）返回 None；
    git 超时（满载时）返回空串：这一轮没取到，调用方隔 --diff-interval 再取。"""
    h = hashlib.sha1()
    try:
        top = git(path, "rev-parse", "--show-toplevel", timeout=30)
        if top.returncode != 0:
            return None
        root = top.stdout.strip()
        for args in (("rev-parse", "HEAD"), (*DIFF_NO_REFRESH, "diff", "HEAD"),
                     ("status", "--porcelain", "--untracked-files=all")):
            p = git(root, *args, timeout=60)
            h.update(p.stdout.encode(errors="replace"))
            if args[0] == "status":
                for line in p.stdout.splitlines():
                    if line.startswith("?? "):
                        with contextlib.suppress(OSError):
                            st = os.stat(os.path.join(root, line[3:]))
                            h.update(f"{line[3:]}:{st.st_size}:{st.st_mtime_ns}".encode())
    except DroverError:  # 超时（run 把 TimeoutExpired 转成了 DroverError）
        return ""
    return h.hexdigest()


def list_agents() -> Optional[list]:
    """herdr agent list 的 agents；herdr 连不上（退出码非 0、输出不是 JSON、找不到 herdr）时返回 None。watch、board 共用。"""
    try:
        p = subprocess.run(["herdr", "agent", "list"], capture_output=True, text=True)
    except OSError:
        return None
    if p.returncode != 0:
        return None
    try:
        return json.loads(p.stdout).get("result", {}).get("agents", [])
    except (json.JSONDecodeError, AttributeError):
        return None


def cmd_watch(a: argparse.Namespace) -> int:
    for name in a.agents:
        check_agent_name(name)
    if a.main:
        return watch_main(a)
    previous: dict = {}  # name -> (herdr 报的状态, 输出的状态)
    # herdr 的 state_change_seq：server 全局递增，记在该 agent 最近一次状态变化上；读屏幕、标题变化都不会改它（实测）。
    seqs: dict = {}
    dialog_fps: dict = {}  # name -> 弹框指纹（输出的状态是 blocked 时才有）
    rollups: dict = {}  # name -> rollup 上次的 (状态, digest)
    last_screen_check: dict = {}
    # B6：working 时定期取 worktree 指纹，长时间没变化就提示（只是提示，跑长测试时也会这样）。
    progress: dict = {}  # name -> {"fp", "changed", "checked"}
    stall_seconds = a.stall_minutes * 60 if a.stall_minutes > 0 else 0
    quiet_seconds = a.quiet_minutes * 60 if a.quiet_minutes > 0 else 0
    # --until-event：先输出一遍当前状态，之后第一次有变化就退出（Codex 没有 Monitor，用阻塞等待代替）。
    started = time.time()
    first_round = True
    while True:
        if a.timeout and not a.once and time.time() - started >= a.timeout:
            print(f"EVENT timeout @{time.strftime('%H:%M:%S')}", flush=True)
            return 0
        agents = list_agents()
        if agents is None:
            print(f"EVENT herdr unreachable @{time.strftime('%H:%M:%S')}", flush=True)
            if a.once or a.until_event:
                return 1
            time.sleep(10)
            continue
        by_name = {x.get("name"): x for x in agents if x.get("name")}
        now = time.time()
        changed = False
        # 每轮重新解析：watch 起来之后才写的 orch.json、resume 换人覆盖的 orch.json 都能跟上（几十个小文件，开销可以忽略）。
        rollup_files = orch_rollups(a.agents)
        for name in a.agents:
            agent = by_name.get(name)
            status = agent.get("agent_status", "unknown") if agent else "gone"
            seq = agent.get("state_change_seq") if agent else None
            prev_status, prev_shown = previous.get(name, ("", ""))
            # 状态和上一轮一样、序号却变了：中间经历过别的状态，没被轮询到（worker 连着弹两个确认，编排者批完第一个，
            # 中间那下 working 没轮到，看到的是 blocked → blocked 就不报，三次各空等 10～24 分钟）。
            # blocked / done / idle 当作状态刚变重报一次；working 不因序号变化重报（免得噪音）。
            again = (status == prev_status and status in ("blocked", "done", "idle")
                     and seq is not None and seqs.get(name) not in (None, seq))
            seqs[name] = seq
            screen = None
            # herdr 报 working 也看屏幕：主 agent 在等后台子 agent 时，子 agent 的确认框被 herdr 报成 working（见 screen_override）。
            # 节流见 WORKING_DIALOG_CHECK_SECONDS：刚变成 working、上一轮判成 blocked、--once 时立刻读，否则隔这么久读一次。
            # codex 不读（没有这种弹框）。读屏失败沿用上一轮的判断（判成 blocked 的不因为一次读不到就报回 working）。
            working_dialog = False
            kind = agent.get("agent") if agent else None
            if (status == "working" and kind != "codex"
                    and (prev_status != status or prev_shown == "blocked" or a.once
                         or now - last_screen_check.get(name, 0) >= WORKING_DIALOG_CHECK_SECONDS)):
                last_screen_check[name] = now
                screen = screen_or_empty(name)
                working_dialog = (screen_override(status, screen, kind) == "blocked" if screen
                                  else prev_shown == "blocked")
            if working_dialog:
                # 卡在弹框上的这段时间不算进 working-no-output / working-no-diff：清掉计时，批完回到 working 后从头算
                # （等批准时屏幕和 worktree 本来就不会动，算进去的话一批完就会误报没动静）。
                shown = "blocked"
                progress.pop(name, None)
            elif status in ("done", "idle"):
                # herdr 报 done / idle 时看一眼屏幕：确认弹框改报 blocked；还有后台命令改报 waiting-background，
                # 免得编排者去读还不存在的报告；停在接口错误上改报 api-error。
                # 状态刚变（包括序号变了）时读，之后每 30 秒复查一次；改报成 blocked 的每轮都读（要看弹框换没换）。
                if (prev_status != status or again or prev_shown == "blocked" or a.once
                        or now - last_screen_check.get(name, 0) >= BACKGROUND_RECHECK_SECONDS):
                    last_screen_check[name] = now
                    screen = agent_screen(name, DIALOG_SCREEN_LINES)
                    shown = screen_override(status, screen) or status
                else:
                    shown = prev_shown
                if again and shown == prev_shown and shown.startswith("waiting-background"):
                    # 编排者挂着 Monitor 时，每处理一个 worker 事件都会 done → working → done；这个事件本来就只是"继续等"，不重报。
                    again = False
            elif status == "working" and (stall_seconds or quiet_seconds) and not a.once:
                info = progress.get(name)
                if info is None or prev_status != "working":
                    # 刚进入 working：从现在开始计时。指纹这时就超时（空串）的，之后的轮次补取，取到时才开始算没改动
                    cwd = agent.get("foreground_cwd") or agent.get("cwd") or ""
                    out_fp = output_fingerprint(name)[0] if quiet_seconds else None
                    info = progress[name] = {"cwd": cwd,
                                             "fp": worktree_fingerprint(cwd) if cwd and stall_seconds else None,
                                             "changed": now, "checked": now,
                                             "out_fp": out_fp, "out_changed": now, "out_checked": now}
                else:
                    if info["fp"] is not None and now - info["checked"] >= a.diff_interval:
                        info["checked"] = now
                        fp = worktree_fingerprint(info["cwd"])
                        # 空串是这一轮 git 超时没取到：不算有变化也不算没变化，隔 --diff-interval 再取
                        if fp != "" and fp != info["fp"]:
                            info.update(fp=fp, changed=now)
                    if quiet_seconds and now - info["out_checked"] >= a.output_interval:
                        info["out_checked"] = now
                        out_fp, running = output_fingerprint(name)
                        # 正在跑命令时不计没动静的时间（长测试交给 working-no-diff）
                        if out_fp != info["out_fp"] or running:
                            info.update(out_fp=out_fp, out_changed=now)
                quiet_for = now - info["out_changed"]
                idle_for = now - info["changed"]
                if quiet_seconds and info["out_fp"] is not None and quiet_for >= quiet_seconds:
                    # 屏幕输出 N 分钟没变、也没在跑命令：多半是卡在模型调用上，比 no-diff 早得多发现
                    bucket = int(quiet_for // quiet_seconds) * a.quiet_minutes
                    shown = f"working-no-output({bucket:g}m)"
                elif stall_seconds and info["fp"] and idle_for >= stall_seconds:
                    # 按阈值的整数倍报，限频：20 分钟报一次，40 分钟再报一次……
                    bucket = int(idle_for // stall_seconds) * a.stall_minutes
                    shown = f"working-no-diff({bucket:g}m)"
                else:
                    shown = status
            else:
                shown = status
            if shown == "blocked" and not a.once:
                # 兜底：herdr 自己也可能没看到中间那下 working（实测：一条回复里并行两个工具调用，批完第一个，
                # 第二个弹框立刻出来，herdr 一直是 blocked、序号也不变）。每轮取弹框指纹，弹框换了就重报。读屏失败时不动指纹。
                # herdr 报 working、屏幕上是后台子 agent 的弹框时同样适用（子 agent 连着弹，herdr 一直是 working）。
                if screen is None:
                    screen = agent_screen(name, DIALOG_SCREEN_LINES)
                if screen:
                    fp = dialog_fingerprint(screen)
                    if prev_shown == "blocked" and dialog_fps.get(name) not in (None, fp):
                        again = True
                    dialog_fps[name] = fp
                # 上一轮也是 blocked、herdr 的原始状态却变了：可能已经换了一个弹框（实测：子 agent 的第一个确认框 herdr 报 blocked，
                # 批完第二个紧接着弹出来，herdr 因为 "Waiting for N background agent" 那行改报 working，第二个没人报）。
                # 当作换了弹框重报一次：重报一个还没批的弹框无害（处理的一方总是先读屏再按键），漏报才有害。
                if prev_shown == "blocked" and status != prev_status:
                    again = True
            else:
                dialog_fps.pop(name, None)
            if a.once or prev_shown != shown or again:
                # 带上时间，方便事后分开算"agent 实际耗时"和"编排者自己的耗时"。
                print(f"EVENT {name} {shown} @{time.strftime('%H:%M:%S')}", flush=True)
                changed = changed or not first_round
            previous[name] = (status, shown)
            # rollup 事件单独一行，和 agent 状态那行互不影响（可以同时有 waiting-background(1) 和 rollup:完成）。
            if name in rollup_files and rollup_event(name, rollup_files[name], rollups, a.once):
                changed = changed or not first_round
        if a.once:
            return 0
        if a.until_event and changed:
            return 0
        first_round = False
        time.sleep(a.interval)


# ---------------------------------------------------------------- 主会话：watch --main、board、rollup 已读

def top_orch_tasks(names=()) -> list:
    """主会话盯的任务：顶层编排者（orch.json 里没有 parent；子编排者由上层追踪），每个编排者名取最新的一份 orch.json
    （latest_orch_metas）；names 给了只留这些名字。按 slug 排序：[{slug, name, kind, dir}]。"""
    wanted = set(names)
    tasks = []
    for name, found in latest_orch_metas().items():
        meta = found["meta"]
        if meta.get("parent") or (wanted and name not in wanted):
            continue
        tasks.append({"slug": meta.get("slug") or found["dir"].name, "name": name, "kind": meta.get("kind"),
                      "dir": found["dir"]})
    return sorted(tasks, key=lambda t: t["slug"])


def main_shown(agent: dict, kind: Optional[str], cache: dict, now: float) -> tuple[str, Optional[str]]:
    """watch --main、board：编排者按屏幕修正后的状态（规则同 watch，screen_override）和这一轮读到的屏幕（没读是 None，读失败是
    空串）。读屏节流同 watch：herdr 的状态或序号变了、上次判成 blocked 时立刻读，否则 done / idle 每 BACKGROUND_RECHECK_SECONDS 秒、
    working 每 WORKING_DIALOG_CHECK_SECONDS 秒读一次，中间沿用上次的判断；读屏失败、状态没变时也沿用。codex working 不读。
    board 每次传空的 cache：每个编排者都读一次屏（herdr 报 blocked 的也读，算弹框指纹）。"""
    name, status, seq = agent["name"], agent.get("agent_status", "unknown"), agent.get("state_change_seq")
    prev = cache.get(name)
    same = prev is not None and (prev["status"], prev["seq"]) == (status, seq)
    if status == "blocked":
        screen, shown = screen_or_empty(name), "blocked"  # 每轮都读：要看弹框换没换
    elif status in ("done", "idle") or (status == "working" and kind != "codex"):
        every = WORKING_DIALOG_CHECK_SECONDS if status == "working" else BACKGROUND_RECHECK_SECONDS
        if same and prev["shown"] != "blocked" and now - prev["checked"] < every:
            return prev["shown"], None
        screen = screen_or_empty(name)
        shown = ((screen_override(status, screen, kind) or status) if screen
                 else prev["shown"] if same else status)
    else:
        screen, shown = None, status
    cache[name] = {"status": status, "seq": seq, "shown": shown, "checked": now}
    return shown, screen


def note_agent_state(task: dict, shown: str, seq: Any, screen: Optional[str], now: float, source: str) -> Optional[float]:
    """把编排者现在的状态记进 <slug>/AGENT_STATE_FILE：name、shown（按屏幕修正后的状态，退出了是 gone）、since（这一段
    第一次被看到的时间）、seq（herdr 的 state_change_seq），blocked 时加 dialog_fp（弹框指纹；读屏失败沿用记录里的）。
    和记录相比 编排者换了人、shown 变了、seq 变了（中间换过状态没轮询到，比如批完一个弹框又弹一个）、弹框指纹变了（herdr
    没看到中间那下 working，见 cmd_watch 的兜底）都算新的一段，since 记成 now；变了才写（原子写）。
    返回这一段的 since；这一段是这次才记下的返回 None——之前没在这个状态上看到过它，不知道已经持续多久，看板写"刚发现"。
    watch --main、board（文本、--json、--live）每一轮都调，谁先看到谁记。每换一段在时间线记一条 agent（shown、prev、seq，
    统计确认框、接口错误、意外退出的次数和时长，编排者自己干活的时长）：读-比-写都在时间线锁里，两边同时看只记一次。"""
    path = task["dir"] / AGENT_STATE_FILE
    with timeline_session(task["dir"]) as (_, new):
        old = read_json_dict(path)
        since = as_float(old.get("since"))
        fp = (dialog_fingerprint(screen) if screen else old.get("dialog_fp")) if shown == "blocked" else None
        same = (since is not None and (old.get("name"), old.get("shown"), old.get("seq")) == (task["name"], shown, seq)
                and old.get("dialog_fp") in (None, fp))
        record = {"name": task["name"], "shown": shown, "since": since if same else now, "seq": seq,
                  **({"dialog_fp": fp} if fp else {})}
        if record != old:
            write_json_atomic(path, record)
        if not same:
            new.append(timeline_event("agent", now, source, name=task["name"], shown=shown, prev=old.get("shown"), seq=seq,
                                      **({"dialog_fp": fp} if fp else {})))
    return since if same else None


def main_watch_task(task: dict, agent: Optional[dict], cache: dict, idle_seconds: float, now: float) -> list:
    """watch --main 一轮里一个任务要报的事件（不带名字和时间），同时更新它的 main-watch.json（变了才写）。
    每件事只报一次、跨重挂：报过的 rollup digest、弹框指纹、api-error、退出的编排者名、停下的时间都记在 main-watch.json；
    rollup 已读看 main-seen.json（主会话用 drover rollup 读时写）。编排者现在的状态从什么时候开始另记在 agent-state.json
    （note_agent_state，看板也记）：它是"现在怎样"，main-watch.json 是"报过什么"，后者只有 watch --main 读写、整轮拿着 MAIN_WATCH_LOCK。
    时间线（统计用）也在这里补：note_agent_state 记编排者换的每一段，timeline_observe 记显示状态的变化和停了没更新。"""
    d, name = task["dir"], task["name"]
    roll = read_rollup(d / "rollup.md")
    rstatus = roll["status"] if roll else ""
    if closed_after_done(agent.get("agent_status", "unknown") if agent else "gone", rstatus):
        return []
    path = d / MAIN_WATCH_FILE
    state = read_json_dict(path)
    before = dict(state)
    events = []
    if agent is None:
        # 意外退出：rollup 不是完成（上面已经排除）、也不是需要换编排者（编排者自己说要换人，按 rollup 事件报）。
        if not rstatus.startswith("需要换编排者") and state.get("gone_reported") != name:
            events.append("gone")
            state["gone_reported"] = name
        shown, screen = "gone", None
    else:
        shown, screen = main_shown(agent, agent.get("agent") or task["kind"], cache, now)
        if shown == "blocked":
            # 同一个弹框只报一次：指纹和报过的一样就不报（重挂也不重报）。读屏失败时沿用报过的指纹，没报过就报。
            fp = dialog_fingerprint(screen) if screen else (state.get("blocked_fp") or "unknown")
            if fp != state.get("blocked_fp"):
                events.append("blocked")
                state["blocked_fp"] = fp
        else:
            state.pop("blocked_fp", None)  # 弹框没了：之后再弹会再报
        if shown == "api-error":
            if not state.get("api_error"):
                events.append("api-error")
                state["api_error"] = True
        else:
            state.pop("api_error", None)
    note_agent_state(task, shown, agent.get("state_change_seq") if agent else None, screen, now, "watch-main")
    timeline_observe(task, now, "watch-main")
    unread, answered_at = rollup_flags(d, roll)
    # 停着却没更新（routing.md"停了却没改状态"）：rollup 是进行中，或者转过答复之后 rollup 还没更新。屏幕上是后台命令、弹框、
    # 接口错误的不算（后台命令会自己接着干，另外两种各有事件）。从第一次看到开始计时，满了报一次；条件不成立（变回 working、
    # rollup 改成要处理的状态）就清掉计时。stalled_emitted 记"这一段已经报过"：idle_since 要留着给看板算停了多久。
    if shown in ("done", "idle") and (rstatus.startswith("进行中") or answered_at is not None):
        since = as_float(state.get("idle_since")) or now
        state["idle_since"] = since
        if now - since >= idle_seconds and not state.get("stalled_emitted"):
            events.append(f"stalled({int((now - since) // 60)}m)")
            state["stalled_emitted"] = True
    else:
        state.pop("idle_since", None)
        state.pop("stalled_emitted", None)
    if unread and roll["digest"] != state.get("rollup_emitted"):
        events.append(f"rollup:{rstatus}")
        state["rollup_emitted"] = roll["digest"]
    if state != before:
        write_json_atomic(path, state)
    return events


def watch_main(a: argparse.Namespace) -> int:
    """watch --main（见 WATCH_DESCRIPTION 的 --main 一节）。和普通 watch 不同：不输出当前状态，只输出要处理、还没报过的事；
    --until-event 时启动那一轮的输出也算事件（这里输出的都是新的）。
    每一轮还做三件 drover 自己的事：触发自动更新检查（auto_update_tick）；报自动更新的结果（drover_main_events）；
    认出主会话重开（main-session.json 的 session_id 变了、source 是 clear / startup：/clear 之前挂着的后台 watch 会活到
    /clear 之后，实测它退出时会叫醒新对话）。
    同时跑着两个 watch --main 时（/clear 之后新对话自己挂了一个、旧的还没退）："算事件 + 写去重记录"整轮拿 MAIN_WATCH_LOCK，
    同一件事只有一个进程报。"""
    idle_seconds = a.idle_minutes * 60
    cache: dict = {}
    started = time.time()
    session = read_json_dict(MAIN_SESSION_FILE).get("session_id")  # 启动时的主会话
    while True:
        if a.timeout and time.time() - started >= a.timeout:
            print(f"EVENT timeout @{time.strftime('%H:%M:%S')}", flush=True)
            return 0
        auto_update_tick()
        agents = list_agents()
        if agents is None:
            print(f"EVENT herdr unreachable @{time.strftime('%H:%M:%S')}", flush=True)
            if a.until_event:
                return 1
            time.sleep(10)
            continue
        by_name = {x.get("name"): x for x in agents if x.get("name")}
        now = time.time()
        note_observed(now)
        with flock_file(MAIN_WATCH_LOCK, None):
            session, restarted = session_restart_events(session)
            # 名字位置写 drover：是 drover 自己的事，不是哪个编排者的
            lines = [f"drover {event}" for event in restarted + drover_main_events(now)]
            # 每轮重新找编排者：watch 起来之后 orch-start 的新任务、resume 换上的编排者都能跟上，不用重挂。
            for task in top_orch_tasks(a.agents):
                lines += [f"{task['name']} {event}"
                          for event in main_watch_task(task, by_name.get(task["name"]), cache, idle_seconds, now)]
        for line in lines:
            print(f"EVENT {line} @{time.strftime('%H:%M:%S')}", flush=True)
        if a.until_event and lines:
            return 0
        time.sleep(a.interval)


def session_restart_events(known: Optional[str]) -> tuple[Optional[str], list]:
    """main-session.json 的 session_id 和 known（这个 watch 上次看到的）不同：新的 source 是 clear / startup 时报一次
    session-restarted（报过哪个 session 记在 MAIN_WATCH_DROVER_FILE，两个 watch 只有一个报）；compact、resume 不算重开
    （上下文还在），只跟上新的 session_id。返回 (现在的 session_id, 事件)。调用方持有 MAIN_WATCH_LOCK。"""
    cur = read_json_dict(MAIN_SESSION_FILE)
    sid = cur.get("session_id")
    if sid == known:
        return known, []
    if cur.get("source") not in ("clear", "startup"):
        return sid, []
    seen = read_json_dict(MAIN_WATCH_DROVER_FILE)
    if seen.get("session_restarted") == sid:
        return sid, []
    seen["session_restarted"] = sid
    write_json_atomic(MAIN_WATCH_DROVER_FILE, seen)
    return sid, ["session-restarted"]


